/* 共享互动动画层样式（自记分页迁出） */
/* Demo：🍅 飞行动画层（旧头像命中；demo 已改撞屏） */
.player-action-tomato-fly {
  position: fixed;
  z-index: 400;
  width: 28px;
  height: 28px;
  margin: 0;
  padding: 0;
  font-size: 26px;
  line-height: 28px;
  text-align: center;
  pointer-events: none;
}
.player-action-tomato-fly.is-flying {
  transition: none;
}

/*
 * Demo：reaction-screen-layer（tomato / flower / egg / boxing）
 * 禁止：全屏 flash / 大面积 filter blur / 纯红蒙版
 */
.reaction-screen-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 520;
  pointer-events: none;
  overflow: hidden;
  opacity: 1;
  transition: opacity 0.7s ease;
}
.reaction-screen-layer.is-fading {
  opacity: 0;
}

/* 🌹 flower-screen-reaction：柔和庆祝花雨（非爆炸） */
.reaction-screen-layer .flower-screen-reaction {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 523;
  pointer-events: none;
}
.reaction-screen-layer .flower-screen-reaction__fly {
  position: fixed;
  z-index: 530;
  width: 72px;
  height: 72px;
  margin: 0;
  padding: 0;
  font-size: 64px;
  line-height: 72px;
  text-align: center;
  pointer-events: none;
  transition: none;
  will-change: left, top, transform, opacity;
  opacity: 1;
}
.reaction-screen-layer .flower-screen-reaction__bloom {
  position: fixed;
  z-index: 524;
  width: 44px;
  height: 44px;
  margin: 0;
  padding: 0;
  font-size: 40px;
  line-height: 44px;
  text-align: center;
  pointer-events: none;
}
.reaction-screen-layer .flower-screen-reaction__petal {
  position: fixed;
  z-index: 525;
  border-radius: 60% 40% 60% 40%;
  pointer-events: none;
  opacity: 0.92;
}

/* 🥚 Self：中央临时头像连击 + cartoon egg face（固定方向；与 Observer 分离） */
.reaction-screen-layer .egg-self-reaction {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 523;
  pointer-events: none;
  overflow: visible;
}
.reaction-screen-layer .egg-self-avatar-layer {
  position: absolute;
  z-index: 2;
  border-radius: 50%;
  overflow: visible;
  will-change: left, top, width, height, transform;
}
.reaction-screen-layer .egg-self-avatar-layer__avatar {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #1a2330;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
}
.reaction-screen-layer .egg-self-avatar-layer__img {
  width: 100%;
  height: 100%;
  display: block;
}
.reaction-screen-layer .egg-self-avatar-layer__fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42px;
}
.reaction-screen-layer .egg-self-avatar-layer.is-shake .egg-self-avatar-layer__avatar,
.reaction-screen-layer .egg-self-avatar-layer.is-shake .egg-self-cover,
.reaction-screen-layer .egg-self-avatar-layer.is-shake .cartoon-egg-face {
  animation: egg-self-avatar-shake 0.14s ease-out;
}
.reaction-screen-layer .egg-self-avatar-layer.is-drip-hold.is-shake .egg-self-avatar-layer__avatar,
.reaction-screen-layer .egg-self-avatar-layer.is-drip-hold.is-shake .cartoon-egg-face {
  animation: egg-self-avatar-sway 0.55s ease-in-out;
}
@keyframes egg-self-avatar-shake {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  30% { transform: translate(-4px, 2px) rotate(-2deg); }
  60% { transform: translate(5px, -1px) rotate(2deg); }
}
@keyframes egg-self-avatar-sway {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  50% { transform: translate(2px, 0) rotate(1deg); }
}
.reaction-screen-layer .egg-self-cover {
  position: absolute;
  inset: 0;
  z-index: 3;
  border-radius: 50%;
  overflow: hidden;
  pointer-events: none;
}
.reaction-screen-layer .egg-self-cover__blot {
