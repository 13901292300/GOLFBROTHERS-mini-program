.reaction-screen-layer .cartoon-tomato-face__eye-cut.eye-r { right: 24%; }
.reaction-screen-layer .cartoon-tomato-face__eye {
  position: absolute;
  top: 40%;
  width: 12%;
  height: 8%;
  border-radius: 50%;
  border: 2px solid rgba(40, 20, 20, 0.75);
  background: rgba(255, 255, 255, 0.15);
  z-index: 4;
}
.reaction-screen-layer .cartoon-tomato-face__eye.eye-l { left: 27%; }
.reaction-screen-layer .cartoon-tomato-face__eye.eye-r { right: 27%; }
.reaction-screen-layer .cartoon-tomato-face__brow {
  position: absolute;
  top: 34%;
  width: 16%;
  height: 3%;
  border-radius: 40%;
  background: rgba(40, 20, 20, 0.7);
  z-index: 4;
}
.reaction-screen-layer .cartoon-tomato-face__brow.brow-l {
  left: 24%;
  transform: rotate(-12deg);
}
.reaction-screen-layer .cartoon-tomato-face__brow.brow-r {
  right: 24%;
