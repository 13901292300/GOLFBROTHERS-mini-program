}
.reaction-screen-layer .egg-self-cover.level-1 .b0,
.reaction-screen-layer .egg-self-cover.level-2 .b0,
.reaction-screen-layer .egg-self-cover.level-2 .b1,
.reaction-screen-layer .egg-self-cover.level-3 .b0,
.reaction-screen-layer .egg-self-cover.level-3 .b1,
.reaction-screen-layer .egg-self-cover.level-3 .b2,
.reaction-screen-layer .egg-self-cover.level-4 .b0,
.reaction-screen-layer .egg-self-cover.level-4 .b1,
.reaction-screen-layer .egg-self-cover.level-4 .b2,
.reaction-screen-layer .egg-self-cover.level-4 .b3,
.reaction-screen-layer .egg-self-cover.level-5 .b0,
.reaction-screen-layer .egg-self-cover.level-5 .b1,
.reaction-screen-layer .egg-self-cover.level-5 .b2,
.reaction-screen-layer .egg-self-cover.level-5 .b3,
.reaction-screen-layer .egg-self-cover.level-5 .b4,
.reaction-screen-layer .egg-self-cover.level-6 .b0,
.reaction-screen-layer .egg-self-cover.level-6 .b1,
.reaction-screen-layer .egg-self-cover.level-6 .b2,
.reaction-screen-layer .egg-self-cover.level-6 .b3,
.reaction-screen-layer .egg-self-cover.level-6 .b4,
.reaction-screen-layer .egg-self-cover.level-6 .b5 {
  opacity: 1;
  transform: scale(1);
}
.reaction-screen-layer .cartoon-egg-face {
  position: absolute;
  inset: 0;
  z-index: 4;
  border-radius: 50%;
  overflow: hidden;
  pointer-events: none;
  animation: cartoon-egg-face-in 0.22s ease-out;
}
.reaction-screen-layer .cartoon-egg-face__white.egg-white-overlay {
