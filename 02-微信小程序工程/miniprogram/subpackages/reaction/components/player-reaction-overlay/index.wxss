  position: absolute;
  inset: 0;
  z-index: 3;
  border-radius: 50%;
  overflow: hidden;
  pointer-events: none;
  animation: cartoon-tomato-face-in 0.2s ease-out;
}
.reaction-screen-layer .cartoon-tomato-face__juice-cover {
  position: absolute;
  inset: 0;
  /* 双眼区留白，保留眼睛可见 */
  background:
    radial-gradient(circle at 33% 44%, transparent 0 9%, rgba(170, 30, 28, 0.78) 11%),
    radial-gradient(circle at 67% 44%, transparent 0 9%, rgba(170, 30, 28, 0.78) 11%),
    linear-gradient(
      180deg,
      rgba(190, 40, 35, 0.55) 0%,
      rgba(170, 30, 28, 0.72) 48%,
      rgba(140, 22, 22, 0.78) 100%
    );
}
.reaction-screen-layer .cartoon-tomato-face__crown {
  position: absolute;
  left: 10%;
  right: 10%;
  top: 0;
  height: 34%;
  border-radius: 0 0 48% 48%;
  background: linear-gradient(
    180deg,
    rgba(220, 55, 45, 0.92) 0%,
    rgba(190, 40, 35, 0.55) 70%,
    transparent 100%
  );
  animation: tomato-self-juice-crown 0.55s ease-out forwards;
}
.reaction-screen-layer .cartoon-tomato-face__run {
  position: absolute;
  top: 18%;
  width: 16%;
  height: 0;
  border-radius: 0 0 40% 40%;
  background: linear-gradient(
    180deg,
    rgba(210, 50, 40, 0.9) 0%,
    rgba(170, 30, 28, 0.55) 70%,
    transparent 100%
  );
  animation: tomato-self-juice-run 1.1s ease-out forwards;
}
.reaction-screen-layer .cartoon-tomato-face__run.run-left {
  left: 16%;
  animation-delay: 0.04s;
}
.reaction-screen-layer .cartoon-tomato-face__run.run-mid {
  left: 42%;
  width: 20%;
  animation-delay: 0s;
}
.reaction-screen-layer .cartoon-tomato-face__run.run-right {
  left: 68%;
  animation-delay: 0.08s;
}
/* 眼睛开窗提示圈（与 juice-cover 留白对齐） */
.reaction-screen-layer .cartoon-tomato-face__eye-cut {
  position: absolute;
  top: 38%;
