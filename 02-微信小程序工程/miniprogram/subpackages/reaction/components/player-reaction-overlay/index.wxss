/* Demo：🌹 Observer 花束飞入（position/scale 由 inline style 驱动） */
.player-action-flower {
  position: fixed;
  z-index: 520;
  width: 48px;
  height: 48px;
  margin: 0;
  padding: 0;
  font-size: 42px;
  line-height: 48px;
  text-align: center;
  pointer-events: none;
  will-change: left, top, transform, opacity;
}
.player-action-flower.is-bloom {
  /* 仅本地轻缩放，避免大范围发光闪屏 */
  animation: player-action-flower-bloom 0.4s ease-out;
}
@keyframes player-action-flower-bloom {
  0% {
    transform: translate(-50%, -50%) scale(1);
  }
  55% {
    transform: translate(-50%, -50%) scale(1.12);
  }
  100% {
    transform: translate(-50%, -50%) scale(1.05);
  }
}

.player-action-flower-petals {
  position: fixed;
  z-index: 405;
  width: 0;
  height: 0;
  pointer-events: none;
}
/* 动态花瓣：下落速度 / 旋转 / 方向由 inline style 控制 */
.player-action-flower-petals__item {
  position: absolute;
  left: 0;
  top: 0;
  border-radius: 60% 40% 60% 40%;
  opacity: 0.92;
  pointer-events: none;
  will-change: transform, opacity;
}

/* Demo：🌹 Observer 盛开完整花朵花环（bloom-flower-ring-final-v7） */
