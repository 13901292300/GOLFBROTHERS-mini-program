  width: 14px;
  height: 11px;
}
.reaction-screen-layer .egg-self-reaction__yolk-pop {
  position: absolute;
  left: -14px;
  top: -14px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 210, 70, 0.95) 0%, rgba(245, 170, 40, 0.5) 60%, transparent 100%);
  animation: egg-self-yolk-pop 0.26s ease-out forwards;
  opacity: 0;
}
.reaction-screen-layer .egg-self-reaction__burst.is-finale .egg-self-reaction__yolk-pop {
  left: -22px;
  top: -22px;
  width: 44px;
  height: 44px;
  animation: egg-self-yolk-pop-finale 0.4s ease-out forwards;
}
@keyframes cartoon-egg-face-in {
  0% { opacity: 0; transform: scale(1.04); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes egg-self-white-flow {
  0% { transform: translateY(-18%); opacity: 0.4; }
  100% { transform: translateY(0); opacity: 1; }
}
@keyframes egg-self-yolk-flow {
  0% { transform: translateY(-30%) scale(0.7); opacity: 0.3; }
  100% { transform: translateY(8%) scale(1); opacity: 1; }
}
@keyframes egg-self-juice-run {
  0% { height: 0; opacity: 0.4; }
  100% { height: 64%; opacity: 1; }
}
@keyframes egg-self-drip {
  0% { transform: translateY(0); opacity: 0.9; }
  75% { opacity: 0.65; }
  100% { transform: translateY(150%); opacity: 0; }
}
@keyframes egg-self-shard0 {
  0% { opacity: 1; transform: translate(0, 0) rotate(0); }
  100% { opacity: 0; transform: translate(-28px, -22px) rotate(-40deg); }
}
@keyframes egg-self-shard1 {
  0% { opacity: 1; transform: translate(0, 0) rotate(0); }
  100% { opacity: 0; transform: translate(30px, -18px) rotate(36deg); }
}
@keyframes egg-self-shard2 {
  0% { opacity: 1; transform: translate(0, 0) rotate(0); }
  100% { opacity: 0; transform: translate(-22px, 26px) rotate(50deg); }
}
@keyframes egg-self-shard3 {
  0% { opacity: 1; transform: translate(0, 0) rotate(0); }
  100% { opacity: 0; transform: translate(26px, 24px) rotate(-30deg); }
}
@keyframes egg-self-shard4 {
  0% { opacity: 1; transform: translate(0, 0) rotate(0); }
  100% { opacity: 0; transform: translate(4px, -32px) rotate(12deg); }
}
@keyframes egg-self-yolk-pop {
  0% { opacity: 0.9; transform: scale(0.4); }
  100% { opacity: 0; transform: scale(1.6); }
}
@keyframes egg-self-yolk-pop-finale {
  0% { opacity: 1; transform: scale(0.5); }
  100% { opacity: 0; transform: scale(2.1); }
}

