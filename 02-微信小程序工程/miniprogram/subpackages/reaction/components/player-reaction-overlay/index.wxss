.reaction-screen-layer .cartoon-egg-face__shell.sh1 { right: 10%; top: 14%; transform: rotate(22deg); width: 14%; }
.reaction-screen-layer .cartoon-egg-face__shell.sh2 { left: 14%; bottom: 16%; transform: rotate(40deg); }
.reaction-screen-layer .cartoon-egg-face__shell.sh3 { right: 16%; bottom: 20%; transform: rotate(-18deg); height: 11%; }
.reaction-screen-layer .cartoon-egg-face__shell.sh4 { left: 44%; top: 6%; transform: rotate(8deg); width: 10%; }
.reaction-screen-layer .cartoon-egg-face__drop {
  position: absolute;
