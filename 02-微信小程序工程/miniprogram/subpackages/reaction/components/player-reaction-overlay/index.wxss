}
.reaction-screen-layer .cartoon-egg-face__drop.d0 { left: 22%; animation-delay: 0s; }
.reaction-screen-layer .cartoon-egg-face__drop.d1 { left: 40%; animation-delay: 0.16s; background: rgba(255, 210, 80, 0.85); }
.reaction-screen-layer .cartoon-egg-face__drop.d2 { left: 58%; animation-delay: 0.08s; }
.reaction-screen-layer .cartoon-egg-face__drop.d3 { left: 74%; animation-delay: 0.24s; background: rgba(255, 220, 100, 0.8); }
