  width: 72px;
  height: 72px;
  font-size: 64px;
  line-height: 72px;
}
.reaction-screen-layer .egg-self-reaction__burst {
  position: absolute;
  z-index: 7;
  width: 0;
  height: 0;
  pointer-events: none;
}
.reaction-screen-layer .egg-self-reaction__shard {
  position: absolute;
  left: 0;
  top: 0;
  width: 10px;
  height: 8px;
  background: #fff8e8;
  border: 1px solid rgba(210, 190, 150, 0.7);
  border-radius: 2px 6px 3px 5px;
  opacity: 0;
}
.reaction-screen-layer .egg-self-reaction__burst .s0 { animation: egg-self-shard0 0.28s ease-out forwards; }
.reaction-screen-layer .egg-self-reaction__burst .s1 { animation: egg-self-shard1 0.28s ease-out 0.01s forwards; }
.reaction-screen-layer .egg-self-reaction__burst .s2 { animation: egg-self-shard2 0.28s ease-out 0.02s forwards; }
.reaction-screen-layer .egg-self-reaction__burst .s3 { animation: egg-self-shard3 0.28s ease-out 0.015s forwards; }
.reaction-screen-layer .egg-self-reaction__burst .s4 { animation: egg-self-shard4 0.28s ease-out 0.025s forwards; }
