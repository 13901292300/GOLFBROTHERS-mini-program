.reaction-screen-layer .cartoon-egg-face.is-dripping .cartoon-egg-face__run { height: 70%; }
.reaction-screen-layer .egg-self-reaction__fly {
  position: absolute;
  z-index: 6;
  width: 56px;
  height: 56px;
  font-size: 48px;
  line-height: 56px;
  text-align: center;
  pointer-events: none;
}
