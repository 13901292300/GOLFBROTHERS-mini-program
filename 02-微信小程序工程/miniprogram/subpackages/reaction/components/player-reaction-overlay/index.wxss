}
.reaction-screen-layer .cartoon-tomato-face__mouth {
  position: absolute;
  left: 36%;
  top: 62%;
  width: 28%;
  height: 10%;
  border-radius: 0 0 50% 50%;
  border: 2px solid rgba(40, 20, 20, 0.7);
  border-top: 0;
  background: rgba(90, 20, 20, 0.35);
  z-index: 4;
}
.reaction-screen-layer .cartoon-tomato-face__seed {
  position: absolute;
  width: 5%;
  height: 7%;
  border-radius: 40%;
  background: rgba(255, 220, 120, 0.75);
  z-index: 3;
}
.reaction-screen-layer .cartoon-tomato-face__seed.sd0 { left: 30%; top: 52%; transform: rotate(-20deg); }
.reaction-screen-layer .cartoon-tomato-face__seed.sd1 { left: 52%; top: 48%; transform: rotate(10deg); }
.reaction-screen-layer .cartoon-tomato-face__seed.sd2 { left: 66%; top: 56%; transform: rotate(28deg); }
.reaction-screen-layer .cartoon-tomato-face__drop {
  position: absolute;
  width: 6%;
  height: 10%;
  border-radius: 45% 45% 55% 55%;
  background: rgba(200, 45, 40, 0.88);
  top: 78%;
  z-index: 5;
  animation: tomato-self-juice-drip 1.15s ease-in infinite;
}
.reaction-screen-layer .cartoon-tomato-face__drop.d0 { left: 18%; animation-delay: 0s; }
.reaction-screen-layer .cartoon-tomato-face__drop.d1 { left: 34%; animation-delay: 0.18s; }
.reaction-screen-layer .cartoon-tomato-face__drop.d2 { left: 48%; animation-delay: 0.08s; }
.reaction-screen-layer .cartoon-tomato-face__drop.d3 { left: 58%; animation-delay: 0.26s; }
.reaction-screen-layer .cartoon-tomato-face__drop.d4 { left: 70%; animation-delay: 0.12s; }
.reaction-screen-layer .cartoon-tomato-face__drop.d5 { left: 82%; animation-delay: 0.3s; }
.reaction-screen-layer .cartoon-tomato-face.is-dripping .cartoon-tomato-face__drop {
  animation-duration: 1.35s;
}
.reaction-screen-layer .cartoon-tomato-face.is-dripping .cartoon-tomato-face__run {
  height: 68%;
}

@keyframes cartoon-tomato-face-in {
  0% { opacity: 0; transform: scale(1.05); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes tomato-self-juice-crown {
  0% { height: 0; opacity: 0.3; }
  100% { height: 34%; opacity: 1; }
}
@keyframes tomato-self-juice-run {
  0% { height: 0; opacity: 0.4; }
  100% { height: 62%; opacity: 1; }
}
@keyframes tomato-self-juice-drip {
  0% { transform: translateY(0); opacity: 0.9; }
  75% { opacity: 0.7; }
  100% { transform: translateY(160%); opacity: 0; }
}

/* 🪣 Self：中央临时头像浇水（水流自桶口，非屏顶；与 Observer 分离） */
.reaction-screen-layer .bucket-self-reaction {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 523;
  pointer-events: none;
  overflow: visible;
}
.reaction-screen-layer .bucket-self-avatar-layer {
  position: absolute;
  z-index: 2;
  border-radius: 50%;
  overflow: visible;
  will-change: left, top, width, height, transform;
}
.reaction-screen-layer .bucket-self-avatar-layer__avatar {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #1a2330;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
}
.reaction-screen-layer .bucket-self-avatar-layer__img {
