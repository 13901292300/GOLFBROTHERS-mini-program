  <!-- Demo：reaction-screen-layer（tomato / flower / egg / boxing / kiss / beer / rocket） -->
  <view
    wx:if="{{reactionScreenVisible}}"
    class="reaction-screen-layer {{reactionScreenFading ? 'is-fading' : ''}}"
  >
    <block wx:if="{{reactionScreenMode === 'tomato'}}">
      <!-- Self：中央临时头像（拳击尺寸）+ cartoon tomato face（不改真实头像） -->
      <view
        wx:if="{{reactionTomatoAnchorMode === 'self' && reactionTomatoSelfAvatarVisible}}"
        class="tomato-self-avatar-layer phase-{{reactionTomatoSelfAvatarPhase}} {{reactionTomatoSelfShake ? 'is-shake' : ''}} {{reactionTomatoSelfDripHold ? 'is-drip-hold' : ''}}"
        style="{{reactionTomatoSelfAvatarStyle}}"
      >
        <view class="tomato-self-avatar-layer__avatar">
          <image
            wx:if="{{reactionTomatoSelfAvatarUrl}}"
            class="tomato-self-avatar-layer__img"
            src="{{reactionTomatoSelfAvatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="tomato-self-avatar-layer__fallback">🍅</view>
        </view>

        <view
          wx:if="{{reactionTomatoSelfFaceVisible}}"
          class="cartoon-tomato-face {{reactionTomatoSelfDripHold ? 'is-dripping' : ''}}"
        >
          <view class="cartoon-tomato-face__juice-cover"></view>
          <view class="cartoon-tomato-face__crown"></view>
          <view class="cartoon-tomato-face__run run-left"></view>
          <view class="cartoon-tomato-face__run run-mid"></view>
          <view class="cartoon-tomato-face__run run-right"></view>
          <view class="cartoon-tomato-face__eye-cut eye-l"></view>
          <view class="cartoon-tomato-face__eye-cut eye-r"></view>
          <view class="cartoon-tomato-face__eye eye-l"></view>
          <view class="cartoon-tomato-face__eye eye-r"></view>
          <view class="cartoon-tomato-face__brow brow-l"></view>
          <view class="cartoon-tomato-face__brow brow-r"></view>
          <view class="cartoon-tomato-face__mouth"></view>
          <view class="cartoon-tomato-face__seed sd0"></view>
          <view class="cartoon-tomato-face__seed sd1"></view>
          <view class="cartoon-tomato-face__seed sd2"></view>
          <view class="cartoon-tomato-face__drop d0"></view>
          <view class="cartoon-tomato-face__drop d1"></view>
          <view class="cartoon-tomato-face__drop d2"></view>
          <view class="cartoon-tomato-face__drop d3"></view>
          <view class="cartoon-tomato-face__drop d4"></view>
          <view class="cartoon-tomato-face__drop d5"></view>
        </view>
      </view>

      <view
        wx:if="{{reactionTomatoFlyVisible}}"
        class="tomato-fly {{reactionTomatoAnchorMode === 'self' ? 'is-self' : ''}}"
        style="{{reactionTomatoFlyStyle}}"
      >🍅</view>

      <view
        wx:if="{{reactionTomatoSplashVisible}}"
        class="tomato-hit tomato-hit--{{reactionTomatoImpactPhase}} {{reactionTomatoAnchorMode === 'avatar' ? 'is-avatar-anchor' : ''}} {{reactionTomatoAnchorMode === 'self' ? 'is-self-anchor' : ''}}"
        style="{{reactionTomatoHitStyle}}"
      >
        <view class="tomato-hit__shockwave"></view>
        <view class="tomato-hit__crack c0"></view>
        <view class="tomato-hit__crack c1"></view>
        <view class="tomato-hit__crack c2"></view>
        <view class="tomato-hit__crack c3"></view>
        <view class="tomato-hit__crack c4"></view>
        <view class="tomato-hit__blotch"></view>
        <view class="tomato-hit__pulp p0"></view>
        <view class="tomato-hit__pulp p1"></view>
        <view class="tomato-hit__pulp p2"></view>
        <view class="tomato-hit__pulp p3"></view>
        <view class="tomato-hit__pulp p4"></view>
        <view class="tomato-hit__pulp p5"></view>
      </view>

    </block>

    <!-- 🪣 Self：中央临时头像 + 桶口水流 + 湿 overlay（不改真实头像；与 Observer 分离） -->
    <view
      wx:if="{{reactionScreenMode === 'bucket'}}"
      class="bucket-self-reaction"
    >
      <view
        wx:if="{{reactionBucketSelfAvatarVisible}}"
        class="bucket-self-avatar-layer phase-{{reactionBucketSelfAvatarPhase}} {{reactionBucketSelfWetVisible ? 'is-wet' : ''}} {{reactionBucketSelfDripHold ? 'is-drip-hold' : ''}}"
        style="{{reactionBucketSelfAvatarStyle}}"
      >
        <view class="bucket-self-avatar-layer__avatar">
          <image
            wx:if="{{reactionBucketSelfAvatarUrl}}"
            class="bucket-self-avatar-layer__img"
            src="{{reactionBucketSelfAvatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="bucket-self-avatar-layer__fallback">🪣</view>
        </view>

        <!-- wet-avatar-overlay：水覆 / 变深 / 水光 / 边缘水滴（不改真实头像） -->
        <view wx:if="{{reactionBucketSelfWetVisible}}" class="wet-avatar-overlay">
          <view class="wet-avatar-overlay__tint"></view>
          <view class="wet-avatar-overlay__sheen"></view>
          <view class="wet-avatar-overlay__sheet"></view>
          <view class="wet-avatar-overlay__edge e0"></view>
          <view class="wet-avatar-overlay__edge e1"></view>
          <view class="wet-avatar-overlay__edge e2"></view>
          <view class="wet-avatar-overlay__edge e3"></view>
          <view class="wet-avatar-overlay__drop d0"></view>
          <view class="wet-avatar-overlay__drop d1"></view>
          <view class="wet-avatar-overlay__drop d2"></view>
          <view class="wet-avatar-overlay__drop d3"></view>
          <view class="wet-avatar-overlay__drop d4"></view>
        </view>

        <!-- cartoon-wet-face：卡通湿漉漉（贴发 / 水滴 / 表情） -->
        <view wx:if="{{reactionBucketSelfCartoonWet}}" class="cartoon-wet-face">
          <view class="cartoon-wet-face__hair">
            <view class="cartoon-wet-face__strand s0"></view>
            <view class="cartoon-wet-face__strand s1"></view>
            <view class="cartoon-wet-face__strand s2"></view>
            <view class="cartoon-wet-face__strand s3"></view>
            <view class="cartoon-wet-face__strand s4"></view>
            <view class="cartoon-wet-face__strand s5"></view>
          </view>
          <view class="cartoon-wet-face__eye eye-l"></view>
          <view class="cartoon-wet-face__eye eye-r"></view>
          <view class="cartoon-wet-face__mouth"></view>
          <view class="cartoon-wet-face__drip dr0"></view>
          <view class="cartoon-wet-face__drip dr1"></view>
          <view class="cartoon-wet-face__drip dr2"></view>
        </view>
      </view>

      <!-- self bucket water stream：起点 = bucket mouth -->
      <view
        wx:if="{{reactionBucketSelfStreamVisible}}"
        class="bucket-self-water-stream {{reactionBucketSelfDripHold ? 'is-drip' : 'is-pour'}}"
        style="{{reactionBucketSelfStreamStyle}}"
      >
        <view class="bucket-self-water-stream__col c0"></view>
        <view class="bucket-self-water-stream__col c1"></view>
        <view class="bucket-self-water-stream__col c2"></view>
        <view class="bucket-self-water-stream__splash"></view>
      </view>

      <view
        wx:if="{{reactionBucketSelfBucketVisible}}"
        class="bucket-self-bucket {{reactionBucketSelfBucketDropping ? 'is-dropping' : ''}} {{reactionBucketSelfBucketPouring ? 'is-pouring' : ''}}"
        style="{{reactionBucketSelfBucketStyle}}"
      >
        <text class="bucket-self-bucket__icon">🪣</text>
        <view class="bucket-self-bucket__mouth"></view>
      </view>
    </view>

    <!-- 🌹 第一视角花雨：随机花束飞入 → 中心开放 → 多批冒出 → 花瓣飘落 -->
    <view
      wx:if="{{reactionScreenMode === 'flower'}}"
      class="flower-screen-reaction"
    >
      <view
        wx:if="{{reactionFlowerFlyVisible}}"
        class="flower-screen-reaction__fly"
        style="{{reactionFlowerFlyStyle}}"
      >{{reactionFlowerFlyEmoji}}</view>
      <view
        wx:for="{{reactionFlowerItems}}"
        wx:key="id"
        class="flower-screen-reaction__bloom"
        style="{{item.style}}"
      >{{item.emoji}}</view>
      <view
        wx:for="{{reactionFlowerPetals}}"
        wx:key="id"
        class="flower-screen-reaction__petal"
        style="{{item.style}}"
      ></view>
    </view>

    <!-- 🥚 Self：中央临时头像连击 + cartoon egg face（固定方向；不改真实头像 / 与 Observer 分离） -->
    <view
      wx:if="{{reactionScreenMode === 'egg'}}"
      class="egg-self-reaction {{reactionEggShake ? 'is-shake' : ''}} dir-{{reactionEggSelfDirection}}"
    >
      <view
        wx:if="{{reactionEggSelfAvatarVisible}}"
        class="egg-self-avatar-layer phase-{{reactionEggSelfAvatarPhase}} {{reactionEggShake ? 'is-shake' : ''}} {{reactionEggSelfDripHold ? 'is-drip-hold' : ''}}"
        style="{{reactionEggSelfAvatarStyle}}"
      >
        <view class="egg-self-avatar-layer__avatar">
          <image
            wx:if="{{reactionEggSelfAvatarUrl}}"
            class="egg-self-avatar-layer__img"
            src="{{reactionEggSelfAvatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="egg-self-avatar-layer__fallback">🥚</view>
        </view>

        <!-- 连击累积覆盖（不重置） -->
        <view class="egg-self-cover level-{{reactionEggHitLevel}}">
          <view class="egg-self-cover__blot b0"></view>
          <view class="egg-self-cover__blot b1"></view>
          <view class="egg-self-cover__blot b2"></view>
          <view class="egg-self-cover__blot b3"></view>
          <view class="egg-self-cover__blot b4"></view>
          <view class="egg-self-cover__blot b5"></view>
        </view>

        <!-- cartoon egg face：蛋清 + 蛋黄 + 碎壳（眼区可见） -->
        <view
          wx:if="{{reactionEggSelfFaceVisible}}"
          class="cartoon-egg-face {{reactionEggSelfDripHold ? 'is-dripping' : ''}}"
        >
          <view class="cartoon-egg-face__white egg-white-overlay"></view>
          <view class="cartoon-egg-face__yolk egg-yolk-overlay y0"></view>
          <view class="cartoon-egg-face__yolk egg-yolk-overlay y1"></view>
          <view class="cartoon-egg-face__run run-left"></view>
          <view class="cartoon-egg-face__run run-mid"></view>
          <view class="cartoon-egg-face__run run-right"></view>
          <view class="cartoon-egg-face__eye-cut eye-l"></view>
          <view class="cartoon-egg-face__eye-cut eye-r"></view>
          <view class="cartoon-egg-face__eye eye-l"></view>
          <view class="cartoon-egg-face__eye eye-r"></view>
          <view class="cartoon-egg-face__shell sh0"></view>
          <view class="cartoon-egg-face__shell sh1"></view>
          <view class="cartoon-egg-face__shell sh2"></view>
          <view class="cartoon-egg-face__shell sh3"></view>
          <view class="cartoon-egg-face__shell sh4"></view>
          <view class="cartoon-egg-face__drop d0"></view>
          <view class="cartoon-egg-face__drop d1"></view>
          <view class="cartoon-egg-face__drop d2"></view>
          <view class="cartoon-egg-face__drop d3"></view>
        </view>
      </view>

      <view
        wx:for="{{reactionEggFlies}}"
        wx:key="id"
        class="egg-self-reaction__fly {{item.finale ? 'is-finale' : ''}}"
        style="{{item.style}}"
      >🥚</view>

      <view
        wx:if="{{reactionEggBurstVisible}}"
        class="egg-self-reaction__burst {{reactionEggBurstFinale ? 'is-finale' : ''}}"
        style="{{reactionEggBurstStyle}}"
      >
        <view class="egg-self-reaction__shard s0"></view>
        <view class="egg-self-reaction__shard s1"></view>
        <view class="egg-self-reaction__shard s2"></view>
        <view class="egg-self-reaction__shard s3"></view>
        <view class="egg-self-reaction__shard s4"></view>
        <view class="egg-self-reaction__yolk-pop"></view>
      </view>
    </view>

    <!-- 👊 第一拳卡通脸 → 金星⭐ → 再连击 → 终拳@@ → 打回 → 落座转2圈 -->
    <view
      wx:if="{{reactionScreenMode === 'boxing'}}"
      class="boxing-reaction-layer {{reactionBoxingShake ? 'is-shake' : ''}} {{reactionBoxingDizzy ? 'is-dizzy' : ''}} {{reactionBoxingEyesSpinning ? 'is-land-sway' : ''}}"
    >
      <view class="boxing-reaction-layer__shell" style="{{reactionBoxingShellStyle}}">
        <!-- 金星阶段 / 落座晃动包裹层 -->
        <view class="boxing-reaction-layer__sway {{reactionBoxingDizzy || reactionBoxingEyesSpinning ? 'is-sway' : ''}}">
          <view class="boxing-reaction-layer__body" style="{{reactionBoxingBodyStyle}}">
            <view class="boxing-reaction-layer__mask mode-{{boxingFaceMode}}" style="{{reactionBoxingMaskStyle}}">
              <!-- normal/restore：原头像副本；sad/dizzy：独立卡通脸（不改原头像） -->
              <image
                wx:if="{{boxingFaceMode !== 'boxing_sad' && boxingFaceMode !== 'boxing_dizzy' && reactionBoxingAvatarUrl}}"
                class="boxing-reaction-layer__img"
                src="{{reactionBoxingAvatarUrl}}"
                mode="aspectFill"
              />
              <view
                wx:elif="{{boxingFaceMode !== 'boxing_sad' && boxingFaceMode !== 'boxing_dizzy'}}"
                class="boxing-reaction-layer__fallback"
              >拳</view>
              <image
                wx:if="{{boxingFaceMode === 'boxing_sad' || boxingFaceMode === 'boxing_dizzy'}}"
                class="boxing-reaction-layer__img boxing-sad-face-image"
                src="{{boxingSadFaceSrc}}"
                mode="aspectFill"
              />
              <!-- @眼睛：仅最终晕眩 / 返回 / 落座；连击阶段不出现 -->
              <view
                wx:if="{{reactionBoxingSpiralEyes && boxingFaceMode === 'boxing_dizzy'}}"
                class="boxing-spiral-eyes {{reactionBoxingEyesSpinning ? 'is-spin-2' : 'is-idle'}}"
              >
                <view class="boxing-spiral-eyes__eye eye-l"><text class="boxing-spiral-eyes__glyph">@</text></view>
                <view class="boxing-spiral-eyes__eye eye-r"><text class="boxing-spiral-eyes__glyph">@</text></view>
              </view>
            </view>
          </view>
        </view>

        <!-- 金星环：连续拳后前兆（顺时针环绕 + 轻浮），非最终@@ -->
        <view
          wx:if="{{reactionBoxingDizzy}}"
          class="boxing-dizzy-layer stars-{{reactionBoxingDizzyStarCount}}"
        >
          <view class="boxing-dizzy-layer__stage">
            <view class="boxing-dizzy-layer__carousel">
              <view class="boxing-dizzy-layer__star s0"><text class="boxing-dizzy-layer__glyph">⭐</text></view>
              <view class="boxing-dizzy-layer__star s1"><text class="boxing-dizzy-layer__glyph">⭐</text></view>
              <view class="boxing-dizzy-layer__star s2"><text class="boxing-dizzy-layer__glyph">⭐</text></view>
              <view class="boxing-dizzy-layer__star s3"><text class="boxing-dizzy-layer__glyph">⭐</text></view>
              <view class="boxing-dizzy-layer__star s4"><text class="boxing-dizzy-layer__glyph">⭐</text></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 左下↗ 漫画红拳套 -->
      <view
        wx:if="{{reactionBoxingGloveLeftPhase}}"
        class="boxing-comic-glove is-bl phase-{{reactionBoxingGloveLeftPhase}}"
      >
        <view class="boxing-comic-glove__wrist"></view>
        <view class="boxing-comic-glove__fist">
          <view class="boxing-comic-glove__shine"></view>
          <view class="boxing-comic-glove__crease c0"></view>
          <view class="boxing-comic-glove__crease c1"></view>
        </view>
        <view class="boxing-comic-glove__thumb"></view>
      </view>
      <!-- 右下↖ / 右侧蓄力·终结 漫画红拳套 -->
      <view
        wx:if="{{reactionBoxingGloveRightPhase}}"
        class="boxing-comic-glove is-br phase-{{reactionBoxingGloveRightPhase}}"
      >
        <view class="boxing-comic-glove__wrist"></view>
        <view class="boxing-comic-glove__fist">
          <view class="boxing-comic-glove__shine"></view>
          <view class="boxing-comic-glove__crease c0"></view>
          <view class="boxing-comic-glove__crease c1"></view>
        </view>
        <view class="boxing-comic-glove__thumb"></view>
      </view>

      <!-- 漫画冲击：爆炸环 + 速度线 + 拟声词 + 黄星 -->
      <view
        wx:if="{{reactionBoxingImpactVisible}}"
        class="boxing-comic-impact side-{{reactionBoxingImpactSide}}"
      >
        <view class="boxing-comic-impact__burst"></view>
        <view class="boxing-comic-impact__ring r0"></view>
        <view class="boxing-comic-impact__ring r1"></view>
        <view class="boxing-comic-impact__line l0"></view>
        <view class="boxing-comic-impact__line l1"></view>
        <view class="boxing-comic-impact__line l2"></view>
        <text class="boxing-comic-impact__word">{{reactionBoxingImpactWord}}</text>
        <text class="boxing-comic-impact__star s0">✦</text>
        <text class="boxing-comic-impact__star s1">✦</text>
        <text class="boxing-comic-impact__star s2">✦</text>
      </view>
    </view>

    <!-- 👄 亲吻：目标头像中央舞台（reaction-view-model-v2） -->
    <view
      wx:if="{{reactionScreenMode === 'kiss'}}"
      class="kiss-screen-reaction {{reactionKissIsSelf ? 'is-self' : 'is-observer'}} {{reactionKissSelfHeartsFading ? 'is-hearts-fading' : ''}}"
    >
      <!-- Self：临时层 — normal=原头像 / kissShy=独立卡通害羞脸整图（不改真实头像） -->
      <view
        wx:if="{{reactionKissIsSelf && reactionKissSelfAvatarVisible}}"
        class="kiss-self-avatar-layer phase-{{reactionKissSelfAvatarPhase}} mode-{{reactionAvatarMode}}"
        style="{{reactionKissSelfAvatarStyle}}"
      >
        <view class="kiss-self-avatar-layer__avatar">
          <!-- before kiss：用户头像副本 -->
          <image
            wx:if="{{reactionAvatarMode !== 'kissShy' && reactionKissSelfAvatarUrl}}"
            class="kiss-self-avatar-layer__img avatar-image"
            src="{{reactionKissSelfAvatarUrl}}"
            mode="aspectFill"
          />
          <view
            wx:elif="{{reactionAvatarMode !== 'kissShy'}}"
            class="kiss-self-avatar-layer__fallback avatar-image"
          >👄</view>

          <!-- after kiss：独立卡通害羞脸（完整圆形资源，非透明五官 overlay） -->
          <image
            wx:if="{{reactionAvatarMode === 'kissShy'}}"
            class="kiss-self-avatar-layer__img kiss-shy-face-image"
            src="{{kissShyFaceSrc}}"
            mode="aspectFill"
          />
        </view>
        <block wx:for="{{reactionKissHearts}}" wx:key="id">
          <view
            wx:if="{{item.attached}}"
            class="kiss-self-avatar-layer__heart {{item.pop ? 'is-pop' : ''}}"
            style="{{item.style}}"
          >❤️</view>
        </block>
      </view>

      <!-- 飞行嘴唇：Self=kiss_lips.png + mouth idle/close/open 开合形变；Observer 飞入仍用 emoji -->
      <view
        wx:if="{{reactionKissLipsVisible}}"
        class="kiss-screen-reaction__lips phase-{{reactionKissLipsPhase}} mouth-{{reactionKissLipsMouth}} {{reactionKissLipsPress ? 'is-press' : ''}} {{reactionKissIsSelf ? 'is-asset' : ''}}"
        style="{{reactionKissLipsStyle}}"
      >
        <image
          wx:if="{{reactionKissIsSelf}}"
          class="kiss-lips-image mouth-{{reactionKissLipsMouth}}"
          src="{{kissLipsSrc}}"
          mode="aspectFit"
        />
        <text wx:else class="kiss-lips-emoji">👄</text>
      </view>

      <!-- Self 回座后：屏幕层红心继续漂浮再淡出 -->
      <block wx:if="{{reactionKissIsSelf}}">
        <block wx:for="{{reactionKissHearts}}" wx:key="id">
          <view
            wx:if="{{!item.attached}}"
            class="kiss-screen-reaction__heart {{item.pop ? 'is-pop' : ''}}"
            style="{{item.style}}"
          >❤️</view>
        </block>
      </block>

    </view>

    <!-- 🍺 干杯：Self 双杯碰杯 / Observer 主杯+左右侧杯 -->
    <view
      wx:if="{{reactionScreenMode === 'beer'}}"
      class="beer-screen-reaction {{reactionBeerShaking ? 'is-shake' : ''}} {{reactionBeerIsSelf ? 'is-self' : ''}}"
    >
      <view
        wx:if="{{reactionBeerMainVisible}}"
        class="beer-main phase-{{reactionBeerMainPhase}} {{reactionBeerIsSelf ? 'is-self' : ''}}"
        style="{{reactionBeerMainStyle}}"
      >
        <text class="beer-cup__emoji">🍺</text>
        <view class="beer-cup__liquid"></view>
        <view class="beer-cup__bubbles">
          <view
            wx:for="{{reactionBeerBubbles}}"
            wx:key="id"
            class="beer-bubble"
            style="{{item.style}}"
          ></view>
        </view>
      </view>

      <view
        wx:if="{{!reactionBeerIsSelf && reactionBeerLeftVisible}}"
        class="beer-left phase-{{reactionBeerLeftPhase}}"
        style="{{reactionBeerLeftStyle}}"
      >
        <text class="beer-cup__emoji">🍺</text>
        <view class="beer-cup__liquid"></view>
      </view>

      <!-- Self 第二杯复用 beer-right；Observer 仍为右侧杯 -->
      <view
        wx:if="{{reactionBeerRightVisible}}"
        class="beer-right phase-{{reactionBeerRightPhase}} {{reactionBeerIsSelf ? 'is-self beer-self-second' : ''}}"
        style="{{reactionBeerRightStyle}}"
      >
        <text class="beer-cup__emoji">🍺</text>
        <view class="beer-cup__liquid"></view>
      </view>

      <view
        wx:if="{{reactionBeerFlashVisible}}"
        class="beer-clash-flash {{reactionBeerIsSelf ? 'is-self' : ''}}"
        style="{{reactionBeerFlashStyle}}"
      ></view>

      <view
        wx:if="{{reactionBeerSplashVisible}}"
        class="beer-splash {{reactionBeerIsSelf ? 'is-self' : ''}}"
        style="{{reactionBeerSplashStyle}}"
      >
        <view class="beer-splash__arc a0"></view>
        <view class="beer-splash__arc a1"></view>
        <view class="beer-splash__arc a2"></view>
        <view class="beer-splash__arc a3"></view>
        <view class="beer-splash__arc a4"></view>
        <view class="beer-splash__arc a5"></view>
        <view class="beer-splash__arc a6"></view>
        <view class="beer-splash__arc a7"></view>
        <block wx:if="{{reactionBeerIsSelf}}">
          <view class="beer-splash__arc a8"></view>
          <view class="beer-splash__arc a9"></view>
          <view class="beer-splash__arc a10"></view>
          <view class="beer-splash__arc a11"></view>
          <view class="beer-splash__lip l0"></view>
          <view class="beer-splash__lip l1"></view>
          <view class="beer-splash__lip l2"></view>
          <view class="beer-splash__lip l3"></view>
          <view class="beer-splash__lip l4"></view>
          <view class="beer-splash__lip l5"></view>
          <view class="beer-splash__stream s0"></view>
          <view class="beer-splash__stream s1"></view>
          <view class="beer-splash__stream s2"></view>
          <view class="beer-splash__overflow o0"></view>
          <view class="beer-splash__overflow o1"></view>
        </block>
        <view class="beer-splash__foam f0"></view>
        <view class="beer-splash__foam f1"></view>
        <view class="beer-splash__foam f2"></view>
        <view class="beer-splash__foam f3"></view>
        <view class="beer-splash__foam f4"></view>
        <view class="beer-splash__foam f5"></view>
        <block wx:if="{{reactionBeerIsSelf}}">
          <view class="beer-splash__foam f6"></view>
          <view class="beer-splash__foam f7"></view>
          <view class="beer-splash__foam f8"></view>
          <view class="beer-splash__foam f9"></view>
          <view class="beer-splash__foam f10"></view>
          <view class="beer-splash__foam f11"></view>
        </block>
        <view class="beer-splash__drop d0"></view>
        <view class="beer-splash__drop d1"></view>
        <view class="beer-splash__drop d2"></view>
        <view class="beer-splash__drop d3"></view>
        <view class="beer-splash__drop d4"></view>
        <view class="beer-splash__drop d5"></view>
        <block wx:if="{{reactionBeerIsSelf}}">
          <view class="beer-splash__drop d6"></view>
          <view class="beer-splash__drop d7"></view>
          <view class="beer-splash__drop d8"></view>
          <view class="beer-splash__drop d9"></view>
        </block>
        <view class="beer-splash__rise r0"></view>
        <view class="beer-splash__rise r1"></view>
        <view class="beer-splash__rise r2"></view>
        <view class="beer-splash__rise r3"></view>
        <block wx:if="{{reactionBeerIsSelf}}">
          <view class="beer-splash__rise r4"></view>
          <view class="beer-splash__rise r5"></view>
          <view class="beer-splash__rise r6"></view>
          <view class="beer-splash__rise r7"></view>
        </block>
      </view>
    </view>

    <!-- 🚀 rocket Self v5：超级爆炸2→黑脸返回→落座→头顶青烟→恢复 -->
    <view
      wx:if="{{reactionScreenMode === 'rocket'}}"
      class="rocket-screen-reaction is-self-front {{reactionRocketShaking ? 'is-shake' : ''}}"
    >
      <!--
        层级：克隆头像(541) → 火箭(548) → 爆炸(560) → 卡通脸阶段抬至(550)
        卡通脸为独立资源，不改真实头像
      -->
      <view
        wx:if="{{reactionRocketAvatarVisible}}"
        class="avatar-blast-layer phase-{{reactionRocketAvatarPhase}} face-{{rocketFaceMode}} {{reactionRocketSmokeActive ? 'is-smoking' : ''}} {{reactionRocketFaceShake ? 'is-face-shake' : ''}} {{reactionRocketHairPop ? 'is-hair-pop' : ''}} {{reactionRocketTrailVisible ? 'is-trail' : ''}} {{reactionRocketLandSmoke ? 'is-land-smoke' : ''}} {{reactionRocketLandSmokeFading ? 'is-land-smoke-fading' : ''}}"
        style="{{reactionRocketAvatarStyle}}"
      >
        <!-- 飞天烟雾尾迹（头像后方） -->
        <view wx:if="{{reactionRocketTrailVisible}}" class="rocket-launch-trail">
          <view class="rocket-launch-trail__puff p0"></view>
          <view class="rocket-launch-trail__puff p1"></view>
          <view class="rocket-launch-trail__puff p2"></view>
          <view class="rocket-launch-trail__puff p3"></view>
        </view>

        <view class="avatar-blast-layer__avatar">
          <image
            wx:if="{{reactionRocketAvatarUrl}}"
            class="avatar-blast-layer__img"
            src="{{reactionRocketAvatarUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="avatar-blast-layer__fallback">🚀</view>
        </view>

        <!-- 浓烟覆盖：第一次爆炸瞬间 -->
        <view
          wx:if="{{reactionRocketSmokeCover}}"
          class="rocket-smoke-cover {{reactionRocketSmokeClearing ? 'is-clearing' : 'is-thick'}}"
        >
          <view class="rocket-smoke-cover__blob b0"></view>
          <view class="rocket-smoke-cover__blob b1"></view>
          <view class="rocket-smoke-cover__blob b2"></view>
          <view class="rocket-smoke-cover__blob b3"></view>
          <view class="rocket-smoke-cover__glow"></view>
        </view>

        <!-- 独立卡通脸：黑脸 / 全黑双眼（覆盖克隆层，非改原头像） -->
        <image
          wx:if="{{rocketFaceMode === 'black'}}"
          class="rocket-cartoon-face rocket-cartoon-face--black"
          src="{{rocketBlackFaceSrc}}"
          mode="aspectFill"
        />
        <image
          wx:if="{{rocketFaceMode === 'eyes_only'}}"
          class="rocket-cartoon-face rocket-cartoon-face--eyes"
          src="{{rocketEyesOnlyFaceSrc}}"
          mode="aspectFill"
        />

        <!-- 爆炸头：第二次爆炸后竖起炸毛（返回/落座全程保持） -->
        <view
          wx:if="{{reactionRocketHairPop && rocketFaceMode === 'eyes_only'}}"
          class="rocket-explosion-hair"
        >
          <view class="rocket-explosion-hair__strand h0"></view>
          <view class="rocket-explosion-hair__strand h1"></view>
          <view class="rocket-explosion-hair__strand h2"></view>
          <view class="rocket-explosion-hair__strand h3"></view>
          <view class="rocket-explosion-hair__strand h4"></view>
          <view class="rocket-explosion-hair__strand h5"></view>
          <view class="rocket-explosion-hair__strand h6"></view>
          <view class="rocket-explosion-hair__strand h7"></view>
        </view>

        <!-- 落座后头顶青烟（不遮眼睛） -->
        <view
          wx:if="{{reactionRocketLandSmoke}}"
          class="rocket-land-smoke {{reactionRocketLandSmokeFading ? 'is-fading' : ''}}"
        >
          <view class="rocket-land-smoke__wisp w0"></view>
          <view class="rocket-land-smoke__wisp w1"></view>
          <view class="rocket-land-smoke__wisp w2"></view>
          <view class="rocket-land-smoke__wisp w3"></view>
        </view>

        <view class="avatar-blast-layer__smoke blast-smoke s0"></view>
        <view class="avatar-blast-layer__smoke blast-smoke s1"></view>
        <view class="avatar-blast-layer__smoke blast-smoke s2"></view>
        <view class="avatar-blast-layer__spark sp0"></view>
        <view class="avatar-blast-layer__spark sp1"></view>
        <view class="avatar-blast-layer__spark sp2"></view>
        <view class="avatar-blast-layer__spark sp3"></view>
      </view>

      <!-- 层级中：火箭弹体（必须在头像前方） -->
      <view
        wx:if="{{reactionRocketFlyVisible}}"
        class="rocket-projectile"
        style="{{reactionRocketFlyStyle}}"
      >
        <view class="rocket-projectile__flame f0"></view>
        <view class="rocket-projectile__flame f1"></view>
        <view class="rocket-projectile__flame f2"></view>
        <text class="rocket-projectile__emoji">🚀</text>
      </view>

      <!-- 层级顶：双爆炸（large / super） -->
      <view
        wx:if="{{reactionRocketBlastVisible}}"
        class="rocket-explosion-layer {{reactionRocketBlastBurst ? 'is-burst' : ''}} is-{{reactionRocketBlastSize || 'large'}}"
        style="{{reactionRocketBlastStyle}}"
      >
        <view class="rocket-explosion-layer__shock"></view>
        <view class="rocket-explosion-layer__shock rocket-explosion-layer__shock--ring"></view>
        <view class="rocket-explosion-layer__flash"></view>
        <view class="rocket-explosion-layer__flame fl0"></view>
        <view class="rocket-explosion-layer__flame fl1"></view>
        <view class="rocket-explosion-layer__flame fl2"></view>
        <view class="rocket-explosion-layer__flame fl3"></view>
        <view class="rocket-explosion-layer__smoke sm0"></view>
        <view class="rocket-explosion-layer__smoke sm1"></view>
        <view class="rocket-explosion-layer__smoke sm2"></view>
        <view class="rocket-explosion-layer__smoke sm3"></view>
        <view class="rocket-explosion-layer__smoke sm4"></view>
        <view class="rocket-explosion-layer__debris d0"></view>
        <view class="rocket-explosion-layer__debris d1"></view>
        <view class="rocket-explosion-layer__debris d2"></view>
        <view class="rocket-explosion-layer__debris d3"></view>
        <view class="rocket-explosion-layer__debris d4"></view>
        <view class="rocket-explosion-layer__debris d5"></view>
        <view class="rocket-explosion-layer__debris d6"></view>
        <view class="rocket-explosion-layer__debris d7"></view>
        <view class="rocket-explosion-layer__ember e0"></view>
        <view class="rocket-explosion-layer__ember e1"></view>
        <view class="rocket-explosion-layer__ember e2"></view>
        <view class="rocket-explosion-layer__ember e3"></view>
        <view class="rocket-explosion-layer__dot p0"></view>
        <view class="rocket-explosion-layer__dot p1"></view>
        <view class="rocket-explosion-layer__dot p2"></view>
      </view>
    </view>
  </view>
  <!-- Demo：🌹 送花 Observer（花束飞入 → 开放花朵花环 → 少量花瓣飘落） -->
  <view
    wx:if="{{playerActionFlowerVisible}}"
    class="player-action-flower {{playerActionFlowerBloom ? 'is-bloom' : ''}}"
    style="{{playerActionFlowerStyle}}"
  >{{playerActionFlowerEmoji}}</view>
  <view
    wx:if="{{playerActionPetalVisible}}"
    class="player-action-flower-petals"
    style="{{playerActionPetalStyle}}"
  >
    <view
      wx:for="{{playerActionPetalItems}}"
      wx:key="id"
      class="player-action-flower-petals__item"
      style="{{item.style}}"
    ></view>
  </view>
  <!-- Demo：🌹 Observer 盛开完整花朵花环（bloom-flower-ring-final-v7） -->
  <view
    wx:if="{{playerActionWreathVisible}}"
    class="player-action-flower-wreath is-open-bloom {{playerActionWreathAppear ? 'is-appear' : ''}} {{playerActionWreathExpand ? 'is-expand' : ''}} {{playerActionWreathFading ? 'is-fading' : ''}}"
    style="{{playerActionWreathStyle}}"
  >
    <view
      wx:for="{{playerActionWreathItems}}"
      wx:key="id"
      class="player-action-flower-wreath__item batch-{{item.batch}}"
      style="{{item.style}}"
    >
      <!-- 盛开完整花朵：花瓣 + 花心（非花瓣主体 / 非小图标） -->
      <view
        class="player-action-flower-wreath__bloom open-bloom-flower petals-{{item.petalCount || 5}} type-{{item.type}} color-{{item.color}}"
        style="{{item.bloomStyle}}"
      >
        <view class="open-bloom-flower__petal p0" style="{{item.petalStyle}}"></view>
        <view class="open-bloom-flower__petal p1" style="{{item.petalStyle}}"></view>
        <view class="open-bloom-flower__petal p2" style="{{item.petalStyle}}"></view>
        <view class="open-bloom-flower__petal p3" style="{{item.petalStyle}}"></view>
        <view class="open-bloom-flower__petal p4" style="{{item.petalStyle}}"></view>
        <view wx:if="{{item.hasSixPetals}}" class="open-bloom-flower__petal p5" style="{{item.petalStyle}}"></view>
        <view class="open-bloom-flower__center" style="{{item.centerStyle}}"></view>
        <view class="open-bloom-flower__center-dot"></view>
      </view>
    </view>
  </view>
