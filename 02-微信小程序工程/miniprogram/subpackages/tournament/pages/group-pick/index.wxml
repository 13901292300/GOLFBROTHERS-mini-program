<view class="group-pick-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">TOURNAMENT</text>
          <text class="gb-header__title">选择球员</text>
        </view>
      </view>
    </view>
  </view>

  <view class="slots-fixed">
    <view class="group-title">{{groupName}}</view>
    <view class="gb-group-player-grid">
      <view wx:for="{{slots}}" wx:key="position" class="gb-group-player slot-item {{item.teamLabel ? 'gb-group-player--with-team' : ''}}">
        <view class="gb-group-player-main-row">
          <view class="gb-group-player-avatar-col">
            <view class="gb-group-player-avatar-wrap">
              <image wx:if="{{item.avatar}}" class="gb-group-player-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
              <view wx:else class="gb-group-player-avatar gb-group-player-avatar--empty">+</view>
            </view>
            <text wx:if="{{item.teamLabel}}" class="gb-group-player-team-label">{{item.teamLabel}}</text>
          </view>
          <view class="gb-group-player-meta">
            <text class="gb-group-player-name">{{item.displayName || item.nickname || item.name || ''}}</text>
            <view wx:if="{{item.teeText || item.teeLabel}}" class="gb-group-player-tee">
              <view wx:if="{{item.teeMarkerClass}}" class="gb-group-player-tee-dot {{item.teeMarkerClass}}"></view>
              <text class="gb-group-player-tee-text">{{item.teeText || item.teeLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="pick-scroll" scroll-y>
    <view class="pick-title">选择球员</view>
    <view class="register-subtabs-wrap">
      <scroll-view class="register-subtabs" scroll-x enable-flex>
        <view
          wx:for="{{registerSubTabs}}"
          wx:key="id"
          bindtap="switchSubTab"
          data-id="{{item.id}}"
          class="register-subtab {{activeSubTabId === item.id ? 'register-subtab--active' : ''}}"
        >
          <text class="register-subtab__label">{{item.name}}（{{item.count}}）</text>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{displayUsers.length}}" class="roster-body">
      <view
        wx:for="{{displayUsers}}"
        wx:key="userId"
        class="roster-row {{item.isSelected ? 'roster-row--selected' : ''}} {{item.isDisabled ? 'roster-row--disabled' : ''}}"
        bindtap="onTogglePlayer"
        data-user="{{item}}"
      >
        <view class="roster-checkbox {{item.isSelected ? 'roster-checkbox--checked' : ''}} {{item.isOccupied ? 'roster-checkbox--occupied' : ''}}">
          <text wx:if="{{item.isSelected}}" class="roster-checkbox__mark">✓</text>
          <text wx:elif="{{item.isOccupied}}" class="roster-checkbox__mark">✓</text>
        </view>
        <view class="roster-col roster-col--player">
          <image class="roster-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="roster-player-main">
            <view class="roster-player-line">
              <text class="roster-name">{{item.displayName}}</text>
              <text wx:if="{{item.genderIcon}}" class="roster-gender {{item.genderClass}}">{{item.genderIcon}}</text>
            </view>
            <text wx:if="{{item.isOccupied}}" class="roster-occupied-tip">已加入{{item.occupiedGroupName}}</text>
          </view>
        </view>
        <view class="roster-col roster-col--handicap"><text>{{item.handicap}}</text></view>
      </view>
    </view>
    <view wx:else class="pick-empty">暂无可选球员</view>
  </scroll-view>

  <view class="group-pick-cta-bar">
    <view class="group-pick-cta-btn" bindtap="onConfirm">确定</view>
  </view>
</view>
