/* 讨论区宿主：撑满 detail-main 剩余高度，避免 min-height 空隙露出页面白底 */
.discussion-inline {
  display: block;
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}
/* 与 components/discussion .ds-bright/.ds-dark 的 --ds-surface 同色，空态与有会话一致 */
.detail-page.bright-mode .detail-main--flush {
  background: #ededed;
}
.detail-page.dark-mode .detail-main--flush {
  background: #0a0a0a;
}
.game-tab-panel { margin-bottom: 32rpx; }
.game-tab-body { margin-bottom: 0; }
.game-tab-spacer {
  width: 100%;
  background: var(--bg-card);
  pointer-events: none;
}

/* ===== Bottom sheet ===== */

/* 替他人报名 · 手工添加底部弹窗（对齐记分页 manual-sheet） */
.manual-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 700;
}

.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  background: var(--bg-card);
  border: 1px solid var(--border-color, var(--border));
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--text-primary);
}

.manual-sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover, var(--border-color, var(--border)));
  margin: 0 auto 28rpx;
}

.manual-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.manual-sheet__overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--data-blue, #00aeef);
}

.manual-sheet__title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.manual-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1px solid var(--border-color, var(--border));
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-muted, var(--text-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.manual-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.manual-field__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.manual-field__input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color, var(--border));
  background: var(--bg-subtle, var(--bg-primary));
  color: var(--text-primary);
  font-size: 28rpx;
}

.manual-field__placeholder {
  color: var(--text-muted, #9ca3af);
}

.manual-gender {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.manual-gender__tag {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color, var(--border));
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-gender__tag.is-active {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

.manual-sheet__footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.manual-sheet__btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.manual-sheet__btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
  border: 1px solid var(--border-color, var(--border));
}

.manual-sheet__btn--confirm {
  color: #ffffff;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}


.leaderboard-setting-sheet { padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom)); }
.leaderboard-setting__head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32rpx; }
.leaderboard-setting__overline { display: block; color: var(--champion-gold); font-size: 20rpx; font-weight: 900; letter-spacing: 0.16em; line-height: 1.2; }
.leaderboard-setting__title { display: block; margin-top: 8rpx; color: var(--text-primary); font-size: 36rpx; font-weight: 900; line-height: 1.2; }
.leaderboard-setting__close { width: 64rpx; height: 64rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 36rpx; line-height: 1; }
.leaderboard-setting__section { margin-top: 28rpx; }
.leaderboard-setting__label { display: block; margin-bottom: 16rpx; color: var(--text-secondary); font-size: 24rpx; font-weight: 800; }
.leaderboard-setting__options { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.leaderboard-setting-option { min-height: 88rpx; padding: 18rpx 20rpx; border-radius: 20rpx; border: 2rpx solid var(--border-color); background: var(--bg-subtle); color: var(--text-primary); display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.leaderboard-setting-option.is-active { border-color: var(--champion-gold); background: rgba(201, 164, 92, 0.16); color: var(--champion-gold); }
.leaderboard-setting-option.is-disabled { opacity: 0.46; color: var(--text-muted); }
.leaderboard-setting-option__text { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.leaderboard-setting-option__name { font-size: 26rpx; font-weight: 900; text-align: center; line-height: 1.3; }
.leaderboard-setting-option__sub { font-size: 20rpx; font-weight: 700; text-align: center; line-height: 1.2; color: var(--text-muted); }
.leaderboard-setting__footer { display: flex; gap: 20rpx; margin-top: 40rpx; }
.leaderboard-setting__btn { flex: 1; height: 88rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 900; }
.leaderboard-setting__btn--cancel { color: var(--text-secondary); background: var(--bg-subtle); border: 1px solid var(--border-color); }
.leaderboard-setting__btn--confirm { color: #ffffff; background: var(--champion-gold); border: 1px solid var(--champion-gold); }

/* ===== 围观弹层 ===== */
.watchers-modal { position: fixed; inset: 0; z-index: 260; display: flex; align-items: flex-end; justify-content: center; background: rgba(0, 0, 0, 0.45); }
.watchers-sheet { width: 100%; max-height: 72vh; background: var(--bg-card); border: 1px solid var(--border); border-bottom: none; border-radius: 48rpx 48rpx 0 0; overflow: hidden; box-shadow: 0 -36rpx 80rpx rgba(0, 0, 0, 0.22); }
.watchers-sheet-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 36rpx; border-bottom: 1px solid var(--border); }
.watchers-sheet-title { display: block; color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.watchers-sheet-subtitle { display: block; color: var(--text-muted); font-size: 20rpx; margin-top: 4rpx; }
.watchers-close-btn { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); }
.watchers-list { max-height: calc(72vh - 148rpx); padding: 16rpx 0 36rpx; }
.watcher-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 36rpx; border-bottom: 1px solid var(--border); color: var(--text-primary); }
.watcher-item image { width: 84rpx; height: 84rpx; border-radius: 9999rpx; flex-shrink: 0; }
.watcher-col { display: flex; flex-direction: column; }
.watcher-name { font-size: 28rpx; }
.watcher-hint { color: var(--text-muted); font-size: 22rpx; margin-top: 4rpx; }
.watcher-at { margin-left: auto; color: var(--data-blue); font-size: 24rpx; font-weight: 700; }

/* ===== 收费管理（极简实收登记） ===== */
.payment-sheet {
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.payment-sheet .register-sheet__head {
  position: relative;
  padding-right: 72rpx;
}
.payment-sheet__close {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--bg-subtle);
  color: var(--text-muted);
  font-size: 36rpx;
  font-weight: 700;
}
.payment-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}
.payment-summary__item {
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border);
}
.payment-summary__label {
  display: block;
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.payment-summary__value {
  display: block;
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 900;
}
.payment-filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}
.payment-filter-tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--bg-secondary);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 800;
  border: 1px solid var(--border);
}
.payment-filter-tab.is-active {
  background: var(--data-blue, #00aeef);
  border-color: var(--data-blue, #00aeef);
  color: #fff;
}
.payment-sheet__body {
  flex: 1;
  min-height: 0;
  max-height: 52vh;
  box-sizing: border-box;
}
.payment-sheet__empty {
  color: var(--text-muted);
  font-size: 24rpx;
  padding: 28rpx 0;
  text-align: center;
}
.payment-user-card {
  padding: 20rpx 0;
  border-bottom: 1px solid var(--border);
}
.payment-user-card:last-child {
  border-bottom: none;
}
.payment-user-card__head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.payment-user-card__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.payment-user-card__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.payment-user-card__name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.payment-user-card__name {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 800;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.payment-user-card__status {
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 700;
}
.payment-user-card__arrow {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--text-muted);
  font-size: 36rpx;
  transform: rotate(0deg);
  transition: transform 0.15s ease;
}
.payment-user-card__arrow.is-open {
  transform: rotate(-90deg);
}
.payment-user-card__body {
  padding: 18rpx 0 6rpx 84rpx;
}
.payment-confirm-groups {
  margin-bottom: 20rpx;
}
.payment-field-label {
  margin-top: 20rpx;
}
.payment-input {
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  color: var(--text-primary);
  padding: 0 24rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.detail-page.dark-mode .payment-input {
  background: var(--bg-card);
}
.detail-page.dark-mode .payment-filter-tab.is-active {
  background: var(--data-blue, #00aeef);
  color: #fff;
}


/* ===== G5-G8 match-play scoreboard (mock UI only; do not reuse leaderboard classes) ===== */
.mp-sb-root {
  background: #f8f9fa;
  padding-bottom: 48rpx;
  width: 100%;
  box-sizing: border-box;
  align-self: stretch;
}
/* 双方得分行：挂在 TAB 下二级吸顶层，与屏幕同宽 */
.mp-sb-score-summary {
  width: 100%;
  box-sizing: border-box;
  align-self: stretch;
  max-width: none;
  background: var(--bg-card);
}
.mp-sb-progress {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  background: #eee;
  position: relative;
  overflow: hidden;
}
.mp-sb-progress__b {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 5;
  box-sizing: border-box;
  overflow: hidden;
}
.mp-sb-progress__a {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 5;
  box-sizing: border-box;
  overflow: hidden;
  background: #E31837;
}
.mp-sb-progress__b { background: #004B87; }
/* 半区内固定竖线：纯视觉装饰，数量固定，不读对局/比分 */
.mp-sb-progress__grid {
  position: absolute;
  inset: 0;
  display: flex;
  z-index: 10;
  pointer-events: none;
}
.mp-sb-progress__line {
  flex: 1;
  border-right: 2rpx solid rgba(255, 255, 255, 0.4);
  box-sizing: border-box;
}
.mp-sb-progress__line:last-child { border-right: none; }
/* 中间分界线：保留 */
.mp-sb-score-divider {
  width: 4rpx;
  flex-shrink: 0;
  align-self: stretch;
  background: rgba(255, 255, 255, 0.85);
  z-index: 15;
}
/* 半区内容：队名(可收缩省略) + 比分(固定宽)，互不挤压 */
.mp-sb-progress__score {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 100%;
  color: #fff;
  font-weight: 900;
  font-style: italic;
  z-index: 20;
  box-sizing: border-box;
  min-width: 0;
  gap: 12rpx;
}
.mp-sb-progress__score--a {
  justify-content: flex-start;
  padding: 0 16rpx 0 24rpx;
}
.mp-sb-progress__score--b {
  justify-content: flex-end;
  padding: 0 24rpx 0 16rpx;
}
/* 分队名槽：固定占用剩余宽度，超出省略，不撑破卡片 */
.mp-sb-progress__name {
  flex: 1 1 0%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.mp-sb-progress__logo {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-secondary, #f3f4f6);
}
.mp-sb-progress__score--b .mp-sb-progress__name {
  flex-direction: row-reverse;
}
.mp-sb-progress__name-text {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 900;
  font-style: normal; /* 顶部队名不斜体；球员昵称仍用 .mp-sb-side__name italic */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}
.mp-sb-progress__score--a .mp-sb-progress__name-text {
  text-align: left;
}
.mp-sb-progress__score--b .mp-sb-progress__name-text {
  text-align: right;
}
/* 数字槽：固定宽度，不随队名伸缩 */
.mp-sb-progress__num-slot {
  --mp-sb-num-slot-width: 80rpx;
  flex: 0 0 var(--mp-sb-num-slot-width);
  width: var(--mp-sb-num-slot-width);
  height: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: var(--mp-sb-num-slot-width);
}
.mp-sb-progress__num-slot.left {
  justify-content: flex-end;
  text-align: right;
}
.mp-sb-progress__num-slot.right {
  justify-content: flex-start;
  text-align: left;
}
.mp-sb-progress__num {
  font-size: 44rpx;
  font-weight: 900;
  font-style: normal;
  line-height: 1;
  width: 100%;
}
.mp-sb-summary {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 16rpx 0;
  font-size: 20rpx;
  font-weight: 900;
  color: #9ca3af;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
}
/* 左右与领先榜 .leaderboard-table-wrap 对齐：同处 detail-main 内容宽（左右各 32rpx），不再额外水平 margin */
.mp-sb-card,
.mp-sb-match-card {
  width: 100%;
  box-sizing: border-box;
  margin: 24rpx 0 0;
  background: var(--bg-card);
  border-radius: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  overflow: hidden;
  border: 1px solid var(--border);
}
.mp-sb-card__header {
  height: 200rpx;
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
}
/* ===== 状态层（仅背景/三角/边线，与内容分离；四态互斥） ===== */
.mp-sb-status-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}
.mp-sb-st-fill,
.mp-sb-st-chevron,
.mp-sb-st-edge {
  display: none;
}
.mp-sb-st-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 0;
}
.mp-sb-st-chevron {
  position: absolute;
  top: 0;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 1; /* 叠在矩形上，接缝处由同色三角盖住 */
}
.mp-sb-st-edge {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3px;
  z-index: 2; /* 压在填充/三角之上，球队色边线不受影响 */
}
/* winner-a：左侧红覆盖 + 红三角朝右；蓝方不填；右侧 3px 蓝边 */
.mp-sb-status.winner-a .mp-sb-st-fill--a,
.mp-sb-status.winner-a .mp-sb-st-chevron--a,
.mp-sb-status.winner-a .mp-sb-st-edge--b {
  display: block;
}
.mp-sb-st-fill--a {
  left: 0;
  width: 33.33%;
  background: #E31837;
}
.mp-sb-st-chevron--a {
  left: 33.33%;
  border-top: 100rpx solid transparent;
  border-bottom: 100rpx solid transparent;
  border-left: 36rpx solid #E31837;
}
.mp-sb-st-edge--b {
  right: 0;
  background: #004B87;
}
/* winner-b：右侧蓝覆盖 + 蓝三角朝左；红方不填；左侧 3px 红边 */
.mp-sb-status.winner-b .mp-sb-st-fill--b,
.mp-sb-status.winner-b .mp-sb-st-chevron--b,
.mp-sb-status.winner-b .mp-sb-st-edge--a {
  display: block;
}
.mp-sb-st-fill--b {
  right: 0;
  width: 33.33%;
  background: #004B87;
}
.mp-sb-st-chevron--b {
  right: 33.33%;
  border-top: 100rpx solid transparent;
  border-bottom: 100rpx solid transparent;
  border-right: 36rpx solid #004B87;
}
.mp-sb-st-edge--a {
  left: 0;
  background: #E31837;
}
/* all-square：左右灰区+尖角（长度同领先态）+ 红蓝双边线；无红蓝胜负填充 */
.mp-sb-status.all-square .mp-sb-st-fill--as-l,
.mp-sb-status.all-square .mp-sb-st-chevron--as-l,
.mp-sb-status.all-square .mp-sb-st-fill--as-r,
.mp-sb-status.all-square .mp-sb-st-chevron--as-r,
.mp-sb-status.all-square .mp-sb-st-edge--a,
.mp-sb-status.all-square .mp-sb-st-edge--b {
  display: block;
}
/* not-started：无胜负覆盖，仅红蓝双边线 */
.mp-sb-status.not-started .mp-sb-st-edge--a,
.mp-sb-status.not-started .mp-sb-st-edge--b {
  display: block;
}
.mp-sb-st-fill--as-l {
  left: 0;
  width: 33.33%;
  background: #9ca3af;
}
.mp-sb-st-chevron--as-l {
  left: 33.33%;
  border-top: 100rpx solid transparent;
  border-bottom: 100rpx solid transparent;
  border-left: 36rpx solid #9ca3af;
}
.mp-sb-st-fill--as-r {
  right: 0;
  width: 33.33%;
  background: #9ca3af;
}
.mp-sb-st-chevron--as-r {
  right: 33.33%;
  border-top: 100rpx solid transparent;
  border-bottom: 100rpx solid transparent;
  border-right: 36rpx solid #9ca3af;
}
/* ===== 内容层（文案/头像，透明底，叠在状态层之上） ===== */
.mp-sb-content-layer {
  position: relative;
  z-index: 2;
  display: flex;
  height: 100%;
  width: 100%;
  align-items: stretch;
}
.mp-sb-side {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  min-width: 0;
  background: transparent;
}
.mp-sb-side--left { align-items: flex-start; }
.mp-sb-side--right { align-items: flex-end; text-align: right; }
.mp-sb-side__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  height: 100%;
}
.mp-sb-side__content--right {
  align-items: flex-end;
}
/* G5 单人：头像 + 单行昵称，垂直居中 */
.mp-sb-side__identity--single {
  display: flex;
  flex-direction: row;
  align-items: center; /* 单人垂直居中 */
  gap: 12rpx;
  min-width: 0;
  max-width: 100%;
  overflow: visible;
}
.mp-sb-side__content--right .mp-sb-side__identity--single {
  flex-direction: row-reverse;
}
.mp-sb-side__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(255,255,255,0.7);
  background: rgba(0,0,0,0.06);
}
/* G6/G7/G8 组合：双头像横向并排（不重叠）+ 两行昵称 */
.mp-sb-side__identity--pair {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  max-width: 100%;
  overflow: visible;
}
.mp-sb-side__content--right .mp-sb-side__identity--pair {
  align-items: flex-end;
}
.mp-sb-side__names {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  gap: 4rpx;
  min-width: 0;
  overflow: visible;
}
/* 蓝方：昵称区整体右对齐（含组合多行） */
.mp-sb-side__content--right .mp-sb-side__names {
  align-items: flex-end;
  text-align: right;
}
/* 得分榜卡片球员昵称：单人/组合统一斜体 */
.mp-sb-side__name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  font-style: italic;
  line-height: 1.4; /* 不低于字号，避免上下裁切 */
  white-space: nowrap;
  max-width: 180rpx;
  overflow: visible; /* 取消 hidden，避免斜体/字重右上角被切 */
  padding-right: 4rpx; /* 斜体字形外伸余量 */
}
.mp-sb-side__content--right .mp-sb-side__name {
  text-align: right;
  padding-right: 0;
  padding-left: 4rpx; /* 右对齐时斜体左侧外伸余量 */
}
.mp-sb-side__identity--single .mp-sb-side__name {
  font-size: 28rpx;
  font-weight: 900;
  text-transform: uppercase;
  line-height: 1.4;
}
/* 文案色随互斥 status class */
.mp-sb-status.winner-a .mp-sb-side--left,
.mp-sb-status.winner-b .mp-sb-side--right,
.mp-sb-status.all-square .mp-sb-side--left,
.mp-sb-status.all-square .mp-sb-side--right {
  color: #fff;
}
.mp-sb-status.winner-a .mp-sb-side--right,
.mp-sb-status.winner-b .mp-sb-side--left,
.mp-sb-status.not-started .mp-sb-side--left,
.mp-sb-status.not-started .mp-sb-side--right {
  color: #1f2937;
}
.mp-sb-status.winner-a .mp-sb-side--right .mp-sb-side__name,
.mp-sb-status.winner-b .mp-sb-side--left .mp-sb-side__name {
  color: #1f2937;
}
/* 双人头像：与单头像同尺寸，横向并排、固定间距、不重叠 */
.mp-sb-pair {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.mp-sb-pair__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  border: 2rpx solid rgba(255,255,255,0.7);
  background: rgba(0,0,0,0.06);
  margin: 0;
}
.mp-sb-status.winner-a .mp-sb-side--right .mp-sb-pair__avatar,
.mp-sb-status.winner-b .mp-sb-side--left .mp-sb-pair__avatar,
.mp-sb-status.winner-a .mp-sb-side--right .mp-sb-side__avatar,
.mp-sb-status.winner-b .mp-sb-side--left .mp-sb-side__avatar,
.mp-sb-status.not-started .mp-sb-pair__avatar,
.mp-sb-status.not-started .mp-sb-side__avatar {
  border-color: #e5e7eb;
}
/* 中部三层：顶/中/底绝对定位，DETAILS 不随状态高度移动 */
.mp-sb-center {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  z-index: 30;
  width: 240rpx;
  height: 100%;
  pointer-events: none;
}
.mp-sb-center__top {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}
.mp-sb-center__mid {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
}
.mp-sb-center__bot {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  pointer-events: auto;
}
.mp-sb-center__phase {
  font-size: 20rpx;
  font-weight: 900;
  color: #9ca3af;
  text-transform: uppercase;
}
.mp-sb-center__status {
  display: flex;
  align-items: baseline;
  font-style: italic;
  font-weight: 900;
  line-height: 1;
}
.mp-sb-center__main { font-size: 56rpx; }
.mp-sb-center__sub { font-size: 26rpx; margin-left: 8rpx; }
.mp-sb-lead--a { color: #E31837; }
.mp-sb-lead--b { color: #004B87; }
.mp-sb-lead--as { color: #6b7280; }
.mp-sb-lead--as .mp-sb-center__main { font-size: 32rpx; }
.mp-sb-lead--vs { color: #002244; }
.mp-sb-lead--vs .mp-sb-center__main {
  font-size: 48rpx;
  font-style: italic;
  font-weight: 900;
}
.mp-sb-center__btn {
  background: #002244;
  color: #fff;
  font-size: 18rpx;
  font-weight: 900;
  text-transform: uppercase;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.mp-sb-center__chevron { transition: transform 0.2s ease; display: inline-block; }
.mp-sb-center__chevron.is-open { transform: rotate(180deg); }
.mp-sb-card__body {
  padding: 20rpx 16rpx 28rpx;
  border-top: 1px solid var(--border);
  background: var(--bg-card);
}
.mp-sb-coming-soon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}
.mp-sb-coming-soon__text {
  font-size: 26rpx;
  font-weight: 600;
  font-style: italic;
  color: var(--text-muted);
  letter-spacing: 0.02em;
  text-align: center;
}
.mp-sb-holes {
  display: flex;
  justify-content: space-between;
  gap: 2rpx;
  margin-bottom: 0;
  padding: 0 4rpx;
}
/* 卡片内直接展示：DETAILS 按钮下方，展开面板上方 */
.mp-sb-holes--summary {
  padding: 16rpx 16rpx 20rpx;
  border-top: 1px solid var(--border);
  background: var(--bg-card);
  box-sizing: border-box;
}
.mp-sb-details-panel {
  padding-top: 0;
}
.mp-sb-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  font-size: 14rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--bg-subtle, #f3f4f6); /* 无结果：浅灰底 */
  color: #111; /* 无结果：黑字洞号（BRIGHT/DARK 未进行态均保持） */
}
/* 未进行：浅灰底 + 黑字 + 深灰外圈（仅 empty） */
.mp-sb-dot.empty {
  background: #f3f4f6;
  color: #111;
  border: 2rpx solid #6b7280;
}
.mp-sb-dot--a { background: #E31837; color: #fff; border: none; } /* 红胜 */
.mp-sb-dot--b { background: #004B87; color: #fff; border: none; } /* 蓝胜 */
.mp-sb-dot--as { background: #6b7280; color: #fff; border: none; } /* 平局：深灰底白字 */
.mp-sb-table {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  box-sizing: border-box;
}
/* 固定左列：不参与横向滚动 */
.mp-sb-table__labels {
  flex-shrink: 0;
  width: 100rpx;
  background: var(--bg-card);
  z-index: 2;
}
/* 右侧洞数据：仅此区域 scroll-x */
.mp-sb-table__scroll {
  flex: 1;
  min-width: 0;
  width: 0; /* 配合 flex:1，避免撑破父级导致无法滚动 */
  white-space: nowrap;
  background: var(--bg-card);
}
.mp-sb-table__data {
  display: flex;
  flex-direction: column;
  /* 18×76rpx 格 + 17×8rpx 间距 + 左 padding，保证可横向滚出 */
  min-width: 1520rpx;
  box-sizing: border-box;
}
.mp-sb-row {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
  padding-left: 8rpx;
}
.mp-sb-cell {
  background: var(--bg-secondary);
  color: var(--text-primary);
  height: 48rpx;
  width: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 6rpx;
  box-sizing: border-box;
}
.mp-sb-cell--label {
  background: #002244;
  color: #fff;
  width: 100rpx;
  margin-bottom: 8rpx;
  text-transform: uppercase;
  font-size: 18rpx;
}
.mp-sb-st--up { background: #E31837; color: #fff; }
.mp-sb-st--dn { background: #004B87; color: #fff; }
.mp-sb-st--as { background: #6b7280; color: #fff; }
.mp-sb-split {
  position: relative;
  overflow: hidden;
}
.mp-sb-split--a {
  background: linear-gradient(to bottom right, #E31837 50%, var(--bg-secondary) 50%);
}
.mp-sb-split--b {
  background: linear-gradient(to top left, #004B87 50%, var(--bg-secondary) 50%);
}
.mp-sb-split--tie {
  background: linear-gradient(to bottom right, var(--bg-secondary) 49%, #ccc 49.5%, #ccc 50.5%, var(--bg-secondary) 51%);
}
/* 未进行：双「-」+ 中间分割线，保持比洞分格结构 */
.mp-sb-split--pending {
  background: linear-gradient(to bottom right, var(--bg-secondary) 49%, #9ca3af 49.5%, #9ca3af 50.5%, var(--bg-secondary) 51%);
}
.mp-sb-split__a {
  position: absolute;
  top: 2rpx;
  left: 8rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  z-index: 2;
}
.mp-sb-split--tie .mp-sb-split__a,
.mp-sb-split--b .mp-sb-split__a,
.mp-sb-split--pending .mp-sb-split__a { color: var(--text-primary); }
.mp-sb-split__b {
  position: absolute;
  bottom: 2rpx;
  right: 8rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: var(--text-primary);
  z-index: 2;
}
.mp-sb-split--b .mp-sb-split__b { color: #fff; }
.mp-sb-split--pending .mp-sb-split__b { color: var(--text-primary); }
.detail-page.dark-mode .mp-sb-root { background: var(--bg-primary); }
.detail-page.dark-mode .mp-sb-card,
.detail-page.dark-mode .mp-sb-summary,
.detail-page.dark-mode .mp-sb-card__body,
.detail-page.dark-mode .mp-sb-holes--summary,
.detail-page.dark-mode .mp-sb-table__labels {
  background: var(--bg-card);
  color: var(--text-primary);
  border-color: var(--border-color);
}
.detail-page.dark-mode .mp-sb-card__body,
.detail-page.dark-mode .mp-sb-holes--summary {
  border-top-color: var(--border);
}
.detail-page.dark-mode .mp-sb-coming-soon__text {
  color: var(--text-muted);
}
.detail-page.dark-mode .mp-sb-table__scroll {
  background: var(--bg-card);
}
.detail-page.dark-mode .mp-sb-card__header {
  background: var(--bg-card);
}
.detail-page.dark-mode .mp-sb-status.winner-a .mp-sb-side--right,
.detail-page.dark-mode .mp-sb-status.winner-b .mp-sb-side--left,
.detail-page.dark-mode .mp-sb-status.not-started .mp-sb-side--left,
.detail-page.dark-mode .mp-sb-status.not-started .mp-sb-side--right {
  color: var(--text-primary);
}
.detail-page.dark-mode .mp-sb-status.winner-a .mp-sb-side--right .mp-sb-side__name,
.detail-page.dark-mode .mp-sb-status.winner-b .mp-sb-side--left .mp-sb-side__name,
.detail-page.dark-mode .mp-sb-status.not-started .mp-sb-side--left .mp-sb-side__name,
.detail-page.dark-mode .mp-sb-status.not-started .mp-sb-side--right .mp-sb-side__name {
  color: var(--text-primary);
}
/* VS / 阶段说明：覆盖 Bright 硬编码深色，避免贴深色卡片底 */
.detail-page.dark-mode .mp-sb-lead--vs {
  color: var(--text-primary);
}
.detail-page.dark-mode .mp-sb-center__phase,
.detail-page.dark-mode .mp-sb-summary {
  color: var(--text-muted);
}
.detail-page.dark-mode .mp-sb-lead--as {
  color: var(--text-muted);
}
/* 胜方红/蓝语义色 Dark 保持 */
.detail-page.dark-mode .mp-sb-lead--a { color: #E31837; }
.detail-page.dark-mode .mp-sb-lead--b { color: #004B87; }
.detail-page.dark-mode .mp-sb-center__btn {
  background: var(--cloud-blue);
  color: #ffffff;
}
/* HOLE/PAR 等普通格；STATUS 用 .mp-sb-cell.mp-sb-st--* 更高优先级保住 */
.detail-page.dark-mode .mp-sb-cell { background: var(--bg-secondary); color: var(--text-primary); }
.detail-page.dark-mode .mp-sb-cell--label { background: #002244; color: #fff; }
.detail-page.dark-mode .mp-sb-cell.mp-sb-st--up { background: #E31837; color: #fff; }
.detail-page.dark-mode .mp-sb-cell.mp-sb-st--dn { background: #004B87; color: #fff; }
.detail-page.dark-mode .mp-sb-cell.mp-sb-st--as { background: #6b7280; color: #fff; }
/* 未进行洞：固定浅灰底黑字，避免 DARK 浅字不可读 */
.detail-page.dark-mode .mp-sb-dot.empty {
  background: #f3f4f6;
  color: #111;
  border: 2rpx solid #6b7280;
}
.detail-page.dark-mode .mp-sb-dot--a { background: #E31837; color: #fff; border: none; }
.detail-page.dark-mode .mp-sb-dot--b { background: #004B87; color: #fff; border: none; }
.detail-page.dark-mode .mp-sb-dot--as { background: #6b7280; color: #fff; border: none; }
/* SCORE 对角分格：浅区跟主题，胜方仍红/蓝白字 */
.detail-page.dark-mode .mp-sb-split--a {
  background: linear-gradient(to bottom right, #E31837 50%, var(--bg-secondary) 50%);
}
.detail-page.dark-mode .mp-sb-split--b {
  background: linear-gradient(to top left, #004B87 50%, var(--bg-secondary) 50%);
}
.detail-page.dark-mode .mp-sb-split--tie {
  background: linear-gradient(to bottom right, var(--bg-secondary) 49%, #6b7280 49.5%, #6b7280 50.5%, var(--bg-secondary) 51%);
}
.detail-page.dark-mode .mp-sb-split--pending {
  background: linear-gradient(to bottom right, var(--bg-secondary) 49%, #6b7280 49.5%, #6b7280 50.5%, var(--bg-secondary) 51%);
}
.detail-page.dark-mode .mp-sb-split--tie .mp-sb-split__a,
.detail-page.dark-mode .mp-sb-split--b .mp-sb-split__a,
.detail-page.dark-mode .mp-sb-split--pending .mp-sb-split__a,
.detail-page.dark-mode .mp-sb-split__b,
.detail-page.dark-mode .mp-sb-split--pending .mp-sb-split__b {
  color: var(--text-primary);
}
.detail-page.dark-mode .mp-sb-split--a .mp-sb-split__a,
.detail-page.dark-mode .mp-sb-split--b .mp-sb-split__b {
  color: #fff;
}

/* 队际赛：参赛球队列表（详情 TAB） */
.participating-teams-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.participating-team-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.participating-team-row__logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-secondary, #f3f4f6);
}
.participating-team-row__name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 超过 4 支时底部「更多/收起」：复用 perm-section-card__toggle（含 Dark） */
.participating-teams-more {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding-top: 8rpx;
}
.participating-teams-more .perm-section-card__toggle {
  margin-top: 0;
  padding: 8rpx 16rpx;
}

