<view class="stats-page {{themeClass}}" style="--stats-header-chrome: {{statsHeaderChrome}}px;">
  <view class="stats-header" style="padding-top: {{headerPadY}}px; padding-bottom: {{headerPadY}}px;">
    <view
      class="stats-header__inner"
      style="padding-right: {{headerPadRight}}px; height: {{headerInnerH}}px;"
    >
      <view class="stats-header__left" bindtap="onBack">
        <text class="stats-header__back">‹</text>
        <view class="stats-header__titles">
          <text class="stats-header__eyebrow">STATISTICS</text>
          <text class="stats-header__title">数据统计</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="stats-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="stats-table">
      <view class="stats-thead">
        <text class="st-cell st-player">PLAYER</text>
        <text bindtap="onSortHeaderTap" data-field="eag" class="st-cell {{sortField === 'eag' ? 'active-sort' : ''}}">EAG<text wx:if="{{sortField === 'eag'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="bir" class="st-cell {{sortField === 'bir' ? 'active-sort' : ''}}">BIR<text wx:if="{{sortField === 'bir'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="par" class="st-cell {{sortField === 'par' ? 'active-sort' : ''}}">PAR<text wx:if="{{sortField === 'par'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="bog" class="st-cell {{sortField === 'bog' ? 'active-sort' : ''}}">BOG<text wx:if="{{sortField === 'bog'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="dbl" class="st-cell {{sortField === 'dbl' ? 'active-sort' : ''}}">DBL+<text wx:if="{{sortField === 'dbl'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="gir" class="st-cell st-pct {{sortField === 'gir' ? 'active-sort' : ''}}">GIR%<text wx:if="{{sortField === 'gir'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="putts" class="st-cell {{sortField === 'putts' ? 'active-sort' : ''}}">PUT<text wx:if="{{sortField === 'putts'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="fwy" class="st-cell st-pct {{sortField === 'fwy' ? 'active-sort' : ''}}">FWY%<text wx:if="{{sortField === 'fwy'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="sand" class="st-cell {{sortField === 'sand' ? 'active-sort' : ''}}">SAND<text wx:if="{{sortField === 'sand'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="pen" class="st-cell {{sortField === 'pen' ? 'active-sort' : ''}}">PEN<text wx:if="{{sortField === 'pen'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="score8421" class="st-cell {{sortField === 'score8421' ? 'active-sort' : ''}}">8421<text wx:if="{{sortField === 'score8421'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
        <text bindtap="onSortHeaderTap" data-field="total" class="st-cell st-total {{sortField === 'total' ? 'active-sort' : ''}}">TOT<text wx:if="{{sortField === 'total'}}">{{sortOrder === 'asc' ? ' ▲' : ' ▼'}}</text></text>
      </view>

      <block wx:for="{{rows}}" wx:key="id">
        <view class="stats-row">
          <view class="st-cell st-player">
            <view class="st-avatar-slot {{item.avatarSlotClass}}">
              <block wx:if="{{item.showPairedAvatars}}">
                <view class="st-paired-avatars">
                  <view
                    wx:for="{{item.members}}"
                    wx:for-item="m"
                    wx:key="userId"
                    class="st-pair-avatar"
                  >
                    <image class="st-avatar st-avatar--stack" src="{{m.avatar}}" mode="aspectFill"></image>
                  </view>
                </view>
              </block>
              <image wx:else class="st-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
            </view>
            <view class="st-identity">
              <text class="st-name">{{item.name}}</text><text wx:if="{{item.genderIcon}}" class="st-gender {{item.genderClass}}">{{item.genderIcon}}</text>
            </view>
            <view wx:if="{{item.teeMarkerClass}}" class="st-tee-marker {{item.teeMarkerClass}}"></view>
          </view>
          <text class="st-cell {{item.eagMuted ? 'st-muted' : ''}}">{{item.eag}}</text>
          <text class="st-cell {{item.birMuted ? 'st-muted' : ''}}">{{item.bir}}</text>
          <text class="st-cell">{{item.par}}</text>
          <text class="st-cell">{{item.bog}}</text>
          <text class="st-cell">{{item.dbl}}</text>
          <text class="st-cell st-pct">{{item.gir}}</text>
          <text class="st-cell">{{item.putts}}</text>
          <text class="st-cell st-pct">{{item.fwy}}</text>
          <text class="st-cell {{item.sandMuted ? 'st-muted' : ''}}">{{item.sand}}</text>
          <text class="st-cell">{{item.pen}}</text>
          <text class="st-cell st-score8421">{{item.score8421}}</text>
          <text class="st-cell st-total-val">{{item.total}}</text>
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="stats-footer">
    <text class="stats-footer__note">骨架预览 · 真实数据接入后默认按 TOTAL 升序</text>
  </view>
</view>
