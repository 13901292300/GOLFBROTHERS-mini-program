}
.reaction-screen-layer .boxing-comic-glove.is-br.phase-punch {
  animation: boxing-glove-punch-br 0.28s cubic-bezier(0.15, 0.8, 0.25, 1) forwards;
}
/* 蓄力：右侧巨大拳套停住抖动 */
.reaction-screen-layer .boxing-comic-glove.is-br.phase-charge {
  width: 240rpx;
  height: 240rpx;
  right: -4%;
  bottom: 28%;
  filter: drop-shadow(0 12px 18px rgba(40, 10, 0, 0.38));
  transform: rotate(8deg);
  animation: boxing-glove-charge-pulse 0.5s ease-in-out infinite;
