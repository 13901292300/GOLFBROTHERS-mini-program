/* 复刻原型 .actions / .action-btn：横向并列、卡片底 + 描边 */
.group-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.group-action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
