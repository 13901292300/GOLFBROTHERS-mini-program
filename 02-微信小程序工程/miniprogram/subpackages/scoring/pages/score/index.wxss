/* Demo：番茄汁糊脸 — fixed 锚定目标头像（约 4.5s；无全屏/邻头像影响） */
.player-action-tomato-juice {
  position: fixed;
  z-index: 397;
  border-radius: 50%;
  pointer-events: none;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
  animation: player-action-tomato-juice-fade 4.5s ease forwards;
