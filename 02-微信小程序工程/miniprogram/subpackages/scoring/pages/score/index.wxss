.section-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.section-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section-count {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--champion-gold);
}

.players-strip {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  /* 恒定 4 列：增删只切换填充/空位，列数与对齐不随 children 数量变化（中心轴绝对稳定） */
