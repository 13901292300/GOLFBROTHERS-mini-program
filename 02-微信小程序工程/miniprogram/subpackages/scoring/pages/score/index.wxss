  height: 92rpx;
  border-radius: 999rpx;
}

.delete-dot {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg-card);
}

.player-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

/* 添加/删除：昵称下方分队小胶囊（仅展示，不改座位布局） */
.group-manage-team-label {
  max-width: 96rpx;
  margin-top: -6rpx;
  padding: 0 6rpx;
  height: 24rpx;
  line-height: 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 45, 98, 0.08);
  color: var(--text-muted, #6b7280);
  font-size: 16rpx;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}
.score-page.dark-mode .group-manage-team-label {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-secondary);
}

/* 空槽位占位（复刻原型 .empty-slot）：虚线圆 + ＋，名称弱化；保持 4 列布局恒定 */
.empty-slot .avatar-wrap {
  border: 1px dashed var(--border-color);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
}

.empty-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 36rpx;
}

.empty-slot .player-name {
  color: var(--text-secondary);
  opacity: 0.65;
}

/* 可继承空位：该槽位保留了上一位球员成绩，高亮提示可继承 */
.empty-slot .empty-avatar--cache {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .avatar-wrap {
  position: relative;
}
.slot-cache-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--accent-gold, #d4af37);
  color: #1a1a1a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

/* 待扫码加入（pending）：高亮虚线 + 省略号脉冲，提示该槽位正在等待扫码 */
.empty-avatar--pending {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .empty-avatar--pending {
  animation: slotPendingPulse 1.2s ease-in-out infinite;
}
@keyframes slotPendingPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.friend-sheet {
