.hole-cell-meta,
.special-cell-meta {
  position: absolute;
  bottom: 4rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.hole-cell-putt,
.special-cell-putt {
  font-size: 16rpx;
  font-weight: 700;
  color: #00aeef;
  opacity: 0.8;
  line-height: 1;
}

.hole-cell-diff,
.special-cell-diff {
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
}

.triangle-red,
.triangle-blue {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 28rpx 28rpx 0;
  z-index: 5;
  pointer-events: none;
}

.triangle-red { border-color: transparent #ef4444 transparent transparent; }
.triangle-blue { border-color: transparent #3b82f6 transparent transparent; }

/* 名次腰线（第三/第四名）：在右上三角内部画一条白色斜线（左上→右下），裁剪于三角形内不外溢。
   三角尺寸/位置不变（仍为 28rpx 角标），本元素只叠加白线，颜色由下层 triangle 提供。 */
.corner-waist {
  position: absolute;
  top: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  z-index: 6;
  pointer-events: none;
  /* 与红/蓝三角同形：右上角三角（斜边由左上 → 右下），用于裁剪白线，确保不超出三角边界 */
  clip-path: polygon(0 0, 100% 0, 100% 100%);
}
.corner-waist::after {
  content: "";
  position: absolute;
  /* 统一中腰位置：直角顶点(右上,100%,0)到斜边(左上→右下)垂足(50%,50%)的中点 = (75%,25%) */
  top: 25%;
  left: 75%;
  width: 24rpx;
  height: 3rpx;
  background: #ffffff;
  /* 左上 → 右下方向的斜线（屏幕坐标顺时针 45°），并裁剪在三角内部 */
  transform: translate(-50%, -50%) rotate(45deg);
  transform-origin: center;
}

/* Floating Actions */
.score-actions {
  flex-shrink: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
  display: flex;
  gap: 24rpx;
}

.score-actions__primary {
  flex: 1;
  background: #002d62;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
}

.score-actions__primary.is-disabled {
  background: #9ca3af;
  color: #f3f4f6;
  opacity: 0.72;
}

.score-actions__secondary {
  flex: 1;
  background: transparent;
