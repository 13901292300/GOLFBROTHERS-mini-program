/* 🌹 仅目标头像轻微缩放，无发光、不影响其它头像 */
.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__hit-wrap.is-flower-pulse {
  animation: player-action-flower-avatar-pulse 0.55s ease;
}
@keyframes player-action-flower-avatar-pulse {
  0%,
  100% {
    transform: scale(1);
  }
  40% {
    transform: scale(1.06);
  }
}
@keyframes player-action-tomato-shake {
  0%,
  100% {
    transform: translate(0, 0) rotate(0deg);
  }
  20% {
    transform: translate(-2px, 1px) rotate(-3deg);
  }
  40% {
    transform: translate(2px, -1px) rotate(3deg);
  }
  60% {
    transform: translate(-1px, 1px) rotate(-2deg);
  }
  80% {
    transform: translate(1px, 0) rotate(2deg);
  }
}

/* Demo：番茄汁糊脸 — fixed 锚定目标头像（约 4.5s；无全屏/邻头像影响） */
.player-action-tomato-juice {
  position: fixed;
  z-index: 397;
  border-radius: 50%;
  pointer-events: none;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
  animation: player-action-tomato-juice-fade 4.5s ease forwards;
}

/* 层1：顶部爆裂原点 */
.player-action-tomato-juice__impact {
  position: absolute;
  left: 18%;
  top: -4%;
  width: 58%;
  height: 34%;
  border-radius: 48% 55% 60% 42%;
  background:
    radial-gradient(ellipse 80% 70% at 42% 48%, rgba(255, 75, 48, 0.92) 0%, rgba(210, 30, 22, 0.55) 38%, transparent 72%),
    radial-gradient(circle at 68% 40%, rgba(190, 22, 18, 0.7) 0 18%, transparent 46%),
    radial-gradient(circle at 28% 62%, rgba(160, 14, 12, 0.55) 0 14%, transparent 40%);
  opacity: 0;
  animation: player-action-tomato-juice-impact 4.5s ease forwards;
}

/* 头顶残留：砸烂后黏在顶部，慢慢变薄淡出 */
.player-action-tomato-juice__crown {
  position: absolute;
  left: 12%;
  top: -2%;
  width: 72%;
  height: 26%;
  border-radius: 50% 50% 45% 55% / 70% 65% 40% 45%;
  background:
    radial-gradient(ellipse 90% 80% at 40% 55%, rgba(230, 45, 32, 0.88) 0%, rgba(180, 20, 16, 0.45) 45%, transparent 75%),
    radial-gradient(circle at 70% 40%, rgba(200, 30, 22, 0.55) 0 16%, transparent 42%);
  opacity: 0;
  animation: player-action-tomato-juice-crown 4.5s ease forwards;
}

/* 层2：多股不对称汁流 —— 先拉长再整体下移（不是只拉高后停住） */
.player-action-tomato-juice__stream {
  position: absolute;
  top: 4%;
  height: 0;
  border-radius: 45% 55% 50% 50% / 8% 10% 85% 80%;
  transform-origin: top center;
  animation: player-action-tomato-juice-stream 3.2s cubic-bezier(0.33, 0.12, 0.25, 1) forwards;
}
.player-action-tomato-juice__stream.st0 {
  left: 6%;
  width: 17%;
  background: linear-gradient(
    180deg,
    rgba(240, 55, 40, 0.9) 0%,
    rgba(200, 28, 22, 0.62) 42%,
    rgba(160, 16, 14, 0.28) 82%,
    transparent 100%
  );
  animation-delay: 0.04s;
  animation-duration: 3.05s;
}
.player-action-tomato-juice__stream.st1 {
  left: 22%;
  width: 11%;
  top: 8%;
  background: linear-gradient(
    180deg,
    rgba(220, 40, 30, 0.72) 0%,
    rgba(175, 20, 16, 0.42) 50%,
    rgba(140, 12, 10, 0.18) 88%,
    transparent 100%
  );
  animation-delay: 0.18s;
  animation-duration: 3.45s;
  animation-name: player-action-tomato-juice-stream-slow;
}
.player-action-tomato-juice__stream.st2 {
  left: 34%;
  width: 23%;
  top: 2%;
  background: linear-gradient(
    180deg,
    rgba(255, 70, 45, 0.95) 0%,
    rgba(210, 32, 24, 0.7) 35%,
    rgba(170, 18, 15, 0.38) 75%,
    rgba(130, 10, 10, 0.12) 92%,
    transparent 100%
  );
  animation-delay: 0s;
  animation-duration: 2.9s;
}
.player-action-tomato-juice__stream.st3 {
  left: 58%;
  width: 9%;
  top: 10%;
  background: linear-gradient(
    180deg,
    rgba(200, 30, 22, 0.65) 0%,
    rgba(160, 16, 14, 0.35) 55%,
    transparent 100%
  );
  animation-delay: 0.24s;
  animation-duration: 3.55s;
  animation-name: player-action-tomato-juice-stream-slow;
}
.player-action-tomato-juice__stream.st4 {
  left: 68%;
  width: 19%;
  top: 6%;
  background: linear-gradient(
    180deg,
    rgba(235, 50, 38, 0.85) 0%,
    rgba(185, 24, 18, 0.55) 40%,
    rgba(145, 12, 12, 0.22) 80%,
    transparent 100%
  );
  animation-delay: 0.1s;
  animation-duration: 3.15s;
}

/* 层3：途中小滴（全程下移） */
.player-action-tomato-juice__drop {
  position: absolute;
  width: 7%;
  height: 7%;
  border-radius: 50% 45% 55% 48%;
  background: radial-gradient(circle at 40% 35%, rgba(255, 90, 55, 0.9) 0%, rgba(180, 22, 18, 0.55) 55%, transparent 78%);
  opacity: 0;
  animation: player-action-tomato-juice-drop 3.4s ease-in forwards;
}
.player-action-tomato-juice__drop.dp0 {
  left: 14%;
  top: 18%;
  width: 6%;
  height: 8%;
  animation-delay: 0.35s;
}
.player-action-tomato-juice__drop.dp1 {
  left: 40%;
  top: 14%;
  width: 9%;
  height: 9%;
  animation-delay: 0.22s;
}
.player-action-tomato-juice__drop.dp2 {
  left: 52%;
  top: 24%;
  width: 5%;
  height: 6%;
  animation-delay: 0.55s;
  background: radial-gradient(circle at 45% 40%, rgba(200, 30, 22, 0.75) 0%, rgba(140, 12, 10, 0.35) 60%, transparent 80%);
}
.player-action-tomato-juice__drop.dp3 {
  left: 72%;
  top: 20%;
  width: 7%;
  height: 7%;
  animation-delay: 0.42s;
}
.player-action-tomato-juice__drop.dp4 {
  left: 30%;
  top: 32%;
  width: 5%;
  height: 5%;
  animation-delay: 0.7s;
  background: radial-gradient(circle at 40% 35%, rgba(220, 45, 35, 0.7) 0%, transparent 72%);
}

/* 层4：底部滴落 —— 汁流到脚后往下滴出 */
.player-action-tomato-juice__bottom-drip {
  position: absolute;
  bottom: -4%;
  width: 10%;
  height: 0;
  border-radius: 40% 40% 55% 55%;
  background: linear-gradient(
    180deg,
    rgba(220, 40, 30, 0.75) 0%,
    rgba(170, 18, 15, 0.45) 55%,
    transparent 100%
  );
  opacity: 0;
  animation: player-action-tomato-juice-bottom-drip 2.2s ease-in forwards;
}
.player-action-tomato-juice__bottom-drip.bd0 {
  left: 22%;
  width: 12%;
  animation-delay: 1.35s;
}
.player-action-tomato-juice__bottom-drip.bd1 {
  left: 44%;
  width: 16%;
  animation-delay: 1.15s;
  background: linear-gradient(
    180deg,
    rgba(240, 55, 40, 0.85) 0%,
    rgba(185, 22, 18, 0.5) 50%,
    transparent 100%
  );
}
.player-action-tomato-juice__bottom-drip.bd2 {
  left: 68%;
  width: 11%;
  animation-delay: 1.5s;
}

/* 层5：局部溅点 */
.player-action-tomato-juice__speck {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  animation: player-action-tomato-juice-speck 4.5s ease forwards;
}
.player-action-tomato-juice__speck.sk0 {
  left: 8%;
  top: 42%;
  width: 12%;
  height: 10%;
  background: radial-gradient(ellipse at 50% 45%, rgba(190, 25, 20, 0.7) 0%, transparent 70%);
  animation-delay: 0.2s;
}
.player-action-tomato-juice__speck.sk1 {
  left: 78%;
  top: 55%;
  width: 10%;
  height: 9%;
  background: radial-gradient(ellipse at 40% 50%, rgba(170, 18, 15, 0.6) 0%, transparent 68%);
  animation-delay: 0.35s;
}
.player-action-tomato-juice__speck.sk2 {
  left: 44%;
  top: 72%;
  width: 14%;
  height: 11%;
  background: radial-gradient(ellipse at 50% 40%, rgba(200, 30, 22, 0.55) 0%, transparent 72%);
  animation-delay: 0.85s;
}

/* 爆裂瞬间 → 头顶糊住 → 慢淡 */
@keyframes player-action-tomato-juice-impact {
  0% {
    opacity: 0;
    transform: scale(0.4);
  }
  5% {
    opacity: 1;
    transform: scale(1.15);
  }
  12% {
    opacity: 0.95;
    transform: scale(1);
  }
  45% {
    opacity: 0.55;
  }
  70% {
    opacity: 0.28;
  }
  100% {
    opacity: 0;
    transform: scale(1.02);
  }
}
@keyframes player-action-tomato-juice-crown {
  0% {
    opacity: 0;
    transform: scaleX(0.7) scaleY(0.5);
  }
  6% {
    opacity: 0.95;
    transform: scaleX(1.05) scaleY(1.1);
  }
  14% {
    opacity: 0.9;
    transform: scaleX(1) scaleY(1);
  }
  55% {
    opacity: 0.72;
  }
  78% {
    opacity: 0.4;
  }
  100% {
    opacity: 0;
    transform: scaleX(1) scaleY(0.85);
  }
}
/* 主流：拉长 → 整段下移到脚 → 淡出 */
@keyframes player-action-tomato-juice-stream {
  0% {
    height: 0;
    opacity: 0.45;
    transform: translateY(0);
  }
  18% {
    height: 48%;
    opacity: 0.95;
    transform: translateY(0);
  }
  38% {
    height: 78%;
    opacity: 0.88;
    transform: translateY(8%);
  }
  58% {
    height: 62%;
    opacity: 0.7;
    transform: translateY(38%);
  }
  78% {
    height: 42%;
    opacity: 0.42;
    transform: translateY(72%);
  }
  100% {
    height: 28%;
    opacity: 0;
    transform: translateY(105%);
  }
}
/* 细流更慢、更拖沓 */
@keyframes player-action-tomato-juice-stream-slow {
  0% {
    height: 0;
    opacity: 0.4;
    transform: translateY(0);
  }
  22% {
    height: 40%;
    opacity: 0.85;
    transform: translateY(0);
  }
  45% {
    height: 70%;
    opacity: 0.75;
    transform: translateY(12%);
  }
  68% {
    height: 50%;
    opacity: 0.55;
    transform: translateY(48%);
  }
  88% {
    height: 32%;
    opacity: 0.28;
    transform: translateY(88%);
  }
  100% {
    height: 20%;
    opacity: 0;
    transform: translateY(115%);
  }
}
@keyframes player-action-tomato-juice-drop {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.55);
  }
  8% {
    opacity: 0.95;
    transform: translateY(4%) scale(1);
  }
  55% {
    opacity: 0.7;
    transform: translateY(85%) scale(0.9);
  }
  85% {
    opacity: 0.35;
    transform: translateY(130%) scale(0.7);
  }
  100% {
    opacity: 0;
    transform: translateY(160%) scale(0.4);
  }
}
@keyframes player-action-tomato-juice-bottom-drip {
  0% {
    height: 0;
    opacity: 0;
    transform: translateY(0);
  }
  15% {
    height: 18%;
    opacity: 0.9;
    transform: translateY(0);
  }
  45% {
    height: 32%;
    opacity: 0.75;
    transform: translateY(10%);
  }
  75% {
    height: 28%;
    opacity: 0.4;
    transform: translateY(35%);
  }
  100% {
    height: 16%;
    opacity: 0;
    transform: translateY(70%);
  }
}
@keyframes player-action-tomato-juice-speck {
  0% {
    opacity: 0;
    transform: scale(0.4);
  }
  10% {
    opacity: 0.9;
    transform: scale(1.1);
  }
  40% {
    opacity: 0.7;
    transform: scale(1);
  }
  75% {
    opacity: 0.35;
  }
  100% {
    opacity: 0;
    transform: scale(0.95);
  }
}
/* 前大半段保持可见，最后慢慢淡出（避免 0→1 白闪） */
@keyframes player-action-tomato-juice-fade {
  0% {
    opacity: 0.4;
  }
  6% {
    opacity: 1;
  }
  68% {
    opacity: 1;
  }
  85% {
    opacity: 0.55;
  }
  100% {
    opacity: 0;
  }
}

/* Demo：撞击爆裂碎裂（头像中心局部，非页面闪光） */
.player-action-tomato-burst {
  position: fixed;
  z-index: 401;
  width: 0;
  height: 0;
  pointer-events: none;
  overflow: visible;
}
.player-action-tomato-burst__core {
  position: absolute;
  left: 0;
  top: 0;
  width: 22px;
  height: 22px;
  margin: -11px 0 0 -11px;
  border-radius: 50%;
  background: radial-gradient(circle, #ff6b4a 0%, #c62828 45%, transparent 72%);
  animation: player-action-tomato-burst-core 0.38s ease-out forwards;
}
.player-action-tomato-burst__shard {
  position: absolute;
  left: 0;
  top: 0;
  width: 10px;
  height: 8px;
  margin: -4px 0 0 -5px;
  border-radius: 40% 60% 50% 40%;
  background: #e53935;
  opacity: 0.95;
  animation: player-action-tomato-burst-shard 0.4s ease-out forwards;
}
.player-action-tomato-burst__shard.s0 {
  background: #ef5350;
  animation-name: player-action-tomato-burst-s0;
}
.player-action-tomato-burst__shard.s1 {
  background: #c62828;
  width: 8px;
  height: 7px;
  animation-name: player-action-tomato-burst-s1;
}
.player-action-tomato-burst__shard.s2 {
  background: #ff7043;
  animation-name: player-action-tomato-burst-s2;
}
.player-action-tomato-burst__shard.s3 {
  background: #d32f2f;
  width: 7px;
  height: 9px;
  animation-name: player-action-tomato-burst-s3;
}
.player-action-tomato-burst__shard.s4 {
  background: #ff8a65;
  animation-name: player-action-tomato-burst-s4;
}
.player-action-tomato-burst__shard.s5 {
  background: #b71c1c;
  width: 9px;
  height: 6px;
  animation-name: player-action-tomato-burst-s5;
}
@keyframes player-action-tomato-burst-core {
  0% {
    transform: scale(0.6);
    opacity: 1;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}
@keyframes player-action-tomato-burst-s0 {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(18px, -14px) rotate(50deg) scale(0.4);
    opacity: 0;
  }
}
@keyframes player-action-tomato-burst-s1 {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-16px, -12px) rotate(-40deg) scale(0.35);
    opacity: 0;
  }
}
@keyframes player-action-tomato-burst-s2 {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(20px, 10px) rotate(70deg) scale(0.3);
    opacity: 0;
  }
}
@keyframes player-action-tomato-burst-s3 {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-18px, 14px) rotate(-55deg) scale(0.35);
    opacity: 0;
  }
}
@keyframes player-action-tomato-burst-s4 {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(6px, 20px) rotate(25deg) scale(0.3);
    opacity: 0;
  }
}
@keyframes player-action-tomato-burst-s5 {
  0% {
    transform: translate(0, 0) rotate(0deg) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(-8px, -20px) rotate(-30deg) scale(0.3);
    opacity: 0;
  }
}

/* 修改半场：panel 必须高于 mask，否则遮罩拦截全部点击 */
.bottom-sheet.half-course-sheet {
  z-index: 230;
  pointer-events: auto;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  background: #fff;
}
.half-course-sheet .half-course-panel {
  pointer-events: auto;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* Score Input Sheet */
.score-input-sheet {
  position: fixed;
  inset: 0;
  z-index: 500;
}

.score-input-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.score-input-sheet__panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: 96rpx 96rpx 0 0;
  border-top: 6rpx solid #002d62;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.score-input-sheet__panel--open { transform: translateY(0); }

.score-input-sheet__handle {
  width: 128rpx;
  height: 8rpx;
  background: var(--border-color);
  border-radius: 999rpx;
  margin: 24rpx auto 32rpx;
}

.panel-mode-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  margin: 0 auto 24rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
}

.panel-mode-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
}

.panel-mode-btn--active {
  background: #002d62;
  color: #ffffff;
}

.sheet-hole-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.sheet-hole-nav__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.sheet-hole-label {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #002d62;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  border: 4rpx solid #ffffff;
}

.sheet-hole-meta {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.sheet-hole-meta__item { display: flex; gap: 8rpx; align-items: center; }
.sheet-hole-meta__val { color: var(--text-primary); font-size: 24rpx; }
.sheet-hole-meta__val--light { color: var(--aux-text); }

.score-sheet-layout {
  display: flex;
  padding: 0 32rpx;
  gap: 16rpx;
  height: 600rpx;
}

.sheet-player-list {
  width: 264rpx;
  min-width: 264rpx;
  background: var(--bg-primary);
  border-radius: 48rpx;
  padding: 16rpx 12rpx;
  overflow: hidden;
}

.sheet-player-item {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  border-radius: 24rpx;
}

.sheet-player-item--active {
  background: var(--highlight-surface);
  border-right: 4rpx solid var(--highlight-color);
}

/* 非 active 不通过 opacity 灰化，保持正常可读 */
.sheet-player-item--inactive { opacity: 1; }

.sheet-player-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.sheet-player-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border-color);
}

.sheet-player-name {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-primary);
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* 选中行球员名使用高亮色文字，进一步强化当前选中态 */
.sheet-player-item--active .sheet-player-name { color: var(--highlight-text); }

.sheet-hole-score {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--score-surface);
  border: 1px solid var(--score-border);
  color: var(--score-color);
  font-size: 30rpx;
  font-weight: 900;
  font-style: italic;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 当前编辑未确认草稿（通用兜底；Bright active 另有覆盖） */
.sheet-hole-score--draft {
  color: var(--text-muted, #9ca3af);
  border-color: var(--border-color, #d1d5db);
  background: transparent;
  font-weight: 700;
}

/* ===== Dark 模式：普通单组技术面板当前球员冠军金高亮 ===== */
.score-page.dark-mode .sheet-player-item--active {
  background: #CE9224;
  border-right: 4rpx solid #CE9224;
}

.score-page.dark-mode .sheet-player-item--active .sheet-player-name {
  color: #111111;
}

/* Dark：正式成绩格冠军金边 + 深底 + 白字（非 draft / 非 empty） */
.score-page.dark-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  border: 2rpx solid #CE9224;
  background: #111111;
  color: #ffffff;
}

/* Dark：草稿成绩 PGA 蓝字；背景/边框保持原草稿样式 */
.score-page.dark-mode .sheet-hole-score--draft {
  color: #002D62;
}

/* ===== Bright 模式：普通单组技术面板 PGA 蓝高亮 ===== */
.score-page.bright-mode .sheet-player-item--active {
  background: #002D62;
  border-right: 4rpx solid #002D62;
}

.score-page.bright-mode .sheet-player-item--active .sheet-player-name {
  color: #ffffff;
}

/* active + 已确认成绩：白底 PGA 蓝字，压在深蓝行上仍清晰 */
.score-page.bright-mode .sheet-player-item--active .sheet-hole-score:not(.sheet-hole-score--draft) {
  color: #002D62;
  background: #ffffff;
  border-color: rgba(255, 255, 255, 0.95);
}

/* active + draft：浅蓝/半透明白，表示未确认输入 */
.score-page.bright-mode .sheet-player-item--active .sheet-hole-score--draft {
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.5);
  font-weight: 700;
}

/* 非 active + 无正式成绩：PGA 蓝边 + 浅蓝底，可记未完 */
.score-page.bright-mode .sheet-player-item--inactive .sheet-hole-score--empty {
  color: transparent;
  background: rgba(0, 45, 98, 0.12);
  border: 2rpx solid #002D62;
}

/* 非 active + 正式成绩：PGA 蓝边 + 白底 + PGA 蓝字 */
.score-page.bright-mode .sheet-player-item--inactive .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  color: #002D62;
  background: #ffffff;
  border: 2rpx solid #002D62;
}

/* Bright 快捷：头像旁成绩格与技术面板同规范（复用 PGA 蓝体系；draft 不覆盖） */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score--empty {
  color: transparent;
  background: rgba(0, 45, 98, 0.12);
  border: 2rpx solid #002D62;
}

.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  color: #002D62;
  background: #ffffff;
  border: 2rpx solid #002D62;
}

/* Bright 快捷：默认 PAR 等为草稿 — 弱化浅灰，不用正式 PGA 蓝 */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score--draft {
  color: #9ca3af;
  background: rgba(148, 163, 184, 0.16);
  border: 2rpx solid #d1d5db;
  font-weight: 700;
}

/* ===== Dark 快捷：成绩格与技术面板 Dark 视觉语言统一（仅 quick-mode） ===== */
/* 正式成绩：冠军金边 + 深底 + 白字 */
.score-page.dark-mode .score-input-sheet.quick-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  border: 2rpx solid #CE9224;
  background: #111111;
  color: #ffffff;
}

/* 草稿成绩：PGA 蓝字 + Dark 背景，不用冠军金 */
.score-page.dark-mode .score-input-sheet.quick-mode .sheet-hole-score--draft {
  color: #4A90E2;
  background: #111111;
  border: 2rpx solid #222222;
  font-weight: 700;
}

/* 空成绩：不覆盖，沿用现有 Dark .sheet-hole-score / --empty 表现 */

/* Bright 快捷：中间记分控件视觉对齐正式成绩格 */
.score-page.bright-mode .quick-score-control {
  background: #ffffff;
  border: 2rpx solid #002D62;
  box-shadow: none;
}

.score-page.bright-mode .quick-score-control-value {
  color: #002D62;
}

.sheet-main-panel {
  flex: 1;
  min-width: 0;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 48rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Bright：技术面板控件区 PGA 蓝边框，呼应左侧球员高亮；背景/内控件不变 */
.score-page.bright-mode .tech-score-panel {
  border: 3px solid #002D62;
  background: #ffffff;
}

/* Dark：技术面板控件区冠军金边框，呼应左侧球员高亮；背景/内控件不变 */
.score-page.dark-mode .tech-score-panel {
  border: 3px solid #CE9224;
}

/* 焦点切换 pulse：颜色跟随主题变量（Bright PGA蓝 / Dark 冠军金） */
.tech-score-panel--focus-pulse {
  animation: tech-panel-focus-pulse 500ms ease;
}

@keyframes tech-panel-focus-pulse {
  0% { border-color: var(--tech-panel-pulse); }
  50% { border-color: var(--tech-panel-pulse-mid); }
  100% { border-color: var(--tech-panel-pulse); }
}

.sheet-control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-control-label {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.stepper-btn {
  background: var(--bg-card);
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  gap: 16rpx;
}

.control-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #facc15;
  color: #002d55;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.stepper-val {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-primary);
  min-width: 64rpx;
  text-align: center;
}

.direction-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.direction-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.direction-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
}

.direction-circle--active {
  background: var(--highlight-strong);
  color: var(--highlight-on);
}

.direction-label {
  font-size: 16rpx;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
}

.direction-label--gold { color: var(--highlight-color); font-weight: 900; }

/* Dark：技术面板 FAIRWAY 选中态冠军金；未选保持原样 */
.score-page.dark-mode .tech-score-panel .direction-circle--active {
  background: #CE9224;
  color: #111111;
}

.score-page.dark-mode .tech-score-panel .direction-label--gold {
  color: #CE9224;
}

.quick-score-control-list {
  display: flex;
  flex-direction: column;
  transform: translateY(-26rpx);
}

.quick-score-control-row {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center; /* 控件在行内水平居中；高度不变，与左侧头像行垂直对齐 */
}

.quick-score-control {
  min-width: 224rpx;
  height: 72rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 16rpx;
}

.quick-score-control-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #facc15;
  color: #002d62;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

/* Bright：快捷面板 +/- PGA 蓝；不改技术面板 / Dark */
.score-page.bright-mode .quick-score-control-btn {
  background: #002D62;
  color: #ffffff;
}

/* Dark：快捷面板 +/- 冠军金 */
.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control-btn {
  background: #CE9224;
  color: #111111;
}

/* Dark：快捷记分控件容器（包裹 +/- 与数值） */
.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control {
  background: var(--bg-card);
  border: 2rpx solid #CE9224;
  box-shadow: none;
}

.quick-score-control-value {
  min-width: 56rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #0f172a;
}

.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control-value {
  color: white;
}

.sheet-footer-btns {
  display: flex;
  padding: 48rpx 80rpx 0;
  gap: 32rpx;
}

.sheet-footer-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

.sheet-footer-btn--clear {
  background: var(--bg-primary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.sheet-footer-btn--confirm {
  background: var(--champion-gold);
  color: #000000;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.2);
}

/* finished 只读：编辑控件置灰，成绩展示布局不变 */
.score-input-sheet.is-readonly .control-icon.is-disabled,
.score-input-sheet.is-readonly .quick-score-control-btn.is-disabled,
.score-input-sheet.is-readonly .sheet-footer-btn.is-disabled {
  opacity: 0.42;
  filter: grayscale(0.35);
}
.score-input-sheet.is-readonly .tech-score-panel.is-disabled .direction-row,
.score-input-sheet.is-readonly .direction-row.is-disabled,
.score-input-sheet.is-readonly .quick-score-panel.is-disabled {
  opacity: 0.55;
}

/* Bright：技术面板操作色统一（+/- / 确认）；不改快捷面板、不改 Dark */
.score-page.bright-mode .tech-score-panel .control-icon {
  background: #002D62;
  color: #ffffff;
}

.score-page.bright-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Bright：快捷面板确认 PGA 蓝；不改技术面板选择器、不改 Dark */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Dark：技术面板 +/- 冠军金；不改 Bright / 快捷 */
.score-page.dark-mode .tech-score-panel .control-icon {
  background: #CE9224;
  color: #111111;
}

/* Dark：技术面板确认按钮冠军金；不改快捷面板 */
.score-page.dark-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #CE9224;
  color: #111111;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.28);
}

/* Group Manage Page */
.group-manage-page {
  position: fixed;
  inset: 0;
  z-index: 650;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
}

.group-manage-content {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  /* 与固定底栏为 flex 同级、互不重叠；额外补偿确保滚动到底内容不被遮挡 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 固定底部操作栏：作为 group-manage-page(flex column) 的最后一个 flex 同级，
   恒贴底、不随 scroll-view 滚动、不被内容挤压；不使用 margin 伪造。 */
.group-manage-footer {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
  z-index: 100;
}

/* 人员来源弹层挂在添加/删除内：抬高层级，避免被底栏(z-index:100)遮挡 */
.group-manage-source-sheet {
  position: relative;
  z-index: 200;
}

/* 手工添加底部弹窗：高于来源选择与底栏 */
.manual-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 700;
}

.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--text-primary);
}

.manual-sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover, var(--border-color));
  margin: 0 auto 28rpx;
}

.manual-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.manual-sheet__overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--data-blue, #00aeef);
}

.manual-sheet__title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.manual-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-muted, var(--text-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.manual-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.manual-field__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.manual-field__input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-primary));
  color: var(--text-primary);
  font-size: 28rpx;
}

.manual-field__placeholder {
  color: var(--text-muted, #9ca3af);
}

.manual-gender {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.manual-gender__tag {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-gender__tag.is-active {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

.manual-sheet__footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.manual-sheet__btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.manual-sheet__btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
  border: 1px solid var(--border-color);
}

.manual-sheet__btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}

.player-source-list-sheet {
