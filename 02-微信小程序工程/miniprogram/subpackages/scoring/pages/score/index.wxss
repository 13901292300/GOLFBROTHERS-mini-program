/* 👊 boxing-reaction-layer：卡通格斗（壳层位移 / 本体变形带图 / 漫画红拳套） */
.reaction-screen-layer .boxing-reaction-layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 523;
  pointer-events: none;
}
.reaction-screen-layer .boxing-reaction-layer.is-shake {
  animation: boxing-layer-shake 0.14s ease-out;
}

/* 壳：只位移；不写 scale，避免盖住变形 */
.reaction-screen-layer .boxing-reaction-layer__shell {
  position: fixed;
  z-index: 526;
  pointer-events: none;
  will-change: left, top;
}
/* 击晕左右摇晃（与 body 变形 transform 分离） */
.reaction-screen-layer .boxing-reaction-layer__sway {
  width: 100%;
  height: 100%;
}
.reaction-screen-layer .boxing-reaction-layer__sway.is-sway {
  animation: boxing-dizzy-sway 0.42s ease-in-out infinite;
}
/* 本体：scale + scaleX/Y + rotate + skew；内部 mask+image 一起变形 */
.reaction-screen-layer .boxing-reaction-layer__body {
  width: 100%;
  height: 100%;
  transform-origin: 50% 50%;
  will-change: transform;
}
.reaction-screen-layer .boxing-reaction-layer__mask {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #d8d2c6;
  box-shadow: 0 12px 28px rgba(20, 16, 10, 0.3);
  will-change: border-radius;
}
.reaction-screen-layer .boxing-reaction-layer__img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: inherit;
}
/* boxing_sad：独立卡通苦脸整图（与 kiss_shy_face 同级；替换临时层，非改原头像） */
/* @螺旋眼睛：覆盖卡通脸眼部，不改原头像资源 */
.reaction-screen-layer .boxing-spiral-eyes {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
  pointer-events: none;
}
.reaction-screen-layer .boxing-spiral-eyes__eye {
  position: absolute;
  top: 38%;
  width: 28%;
  height: 28%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.reaction-screen-layer .boxing-spiral-eyes__eye.eye-l {
  left: 16%;
}
.reaction-screen-layer .boxing-spiral-eyes__eye.eye-r {
  right: 16%;
  left: auto;
}
.reaction-screen-layer .boxing-spiral-eyes__glyph {
  font-size: 22px;
  font-weight: 800;
  line-height: 1;
  color: #111;
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
  display: block;
}
.reaction-screen-layer .boxing-spiral-eyes.is-idle .boxing-spiral-eyes__glyph {
  animation: boxing-spiral-eye-idle 0.7s linear infinite;
}
.reaction-screen-layer .boxing-spiral-eyes.is-spin-2 .boxing-spiral-eyes__glyph {
  animation: boxing-spiral-eye-spin2 1.1s linear forwards;
}
.reaction-screen-layer .boxing-spiral-eyes.is-spin-2 .eye-r .boxing-spiral-eyes__glyph {
  animation-direction: reverse;
}
@keyframes boxing-spiral-eye-idle {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
@keyframes boxing-spiral-eye-spin2 {
  from {
    transform: rotate(0deg) scale(1);
  }
  50% {
    transform: rotate(360deg) scale(1.08);
  }
  to {
    transform: rotate(720deg) scale(1);
  }
}

.reaction-screen-layer .boxing-reaction-layer.is-land-sway .boxing-reaction-layer__sway.is-sway {
  animation: boxing-dizzy-sway 0.36s ease-in-out infinite;
}
.reaction-screen-layer .boxing-reaction-layer__mask.mode-boxing_sad,
.reaction-screen-layer .boxing-reaction-layer__mask.mode-boxing_dizzy {
  background: transparent;
}
.reaction-screen-layer .boxing-sad-face-image {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: inherit;
  animation: boxing-sad-face-pop 0.28s cubic-bezier(0.2, 0.85, 0.3, 1) forwards;
}
@keyframes boxing-sad-face-pop {
  0% { opacity: 0; transform: scale(1.08); }
  60% { opacity: 1; transform: scale(0.98); }
  100% { opacity: 1; transform: scale(1); }
}
.reaction-screen-layer .boxing-reaction-layer__fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #6b6358;
  background: #ebe4d8;
  border-radius: inherit;
}

/*
 * 击晕层 boxing-dizzy-layer：头像顶部倾斜轨道的 3D 环绕星
 * perspective + rotateX 倾角 + carousel rotateY；远处小/淡，近处大/亮
 */
.reaction-screen-layer .boxing-dizzy-layer {
  position: absolute;
  left: 50%;
  top: 0;
  z-index: 527;
  width: 180rpx;
  height: 110rpx;
  margin-left: -90rpx;
  margin-top: -78rpx;
  pointer-events: none;
  perspective: 360rpx;
  transform-style: preserve-3d;
  animation: boxing-dizzy-appear 0.32s ease-out both;
}
.reaction-screen-layer .boxing-dizzy-layer__stage {
  position: absolute;
  left: 50%;
  top: 55%;
  width: 140rpx;
  height: 140rpx;
  margin-left: -70rpx;
  margin-top: -70rpx;
  transform-style: preserve-3d;
  /* 俯视倾斜 + 轻浮：椭圆金星轨道 */
  animation: boxing-star-float 1.1s ease-in-out infinite;
}
.reaction-screen-layer .boxing-dizzy-layer__carousel {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  animation: boxing-dizzy-spinY 1.35s linear infinite;
}
.reaction-screen-layer .boxing-dizzy-layer__star {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  margin-left: -18rpx;
  margin-top: -18rpx;
  transform-style: preserve-3d;
  /* 各星初始角位 + 半径；随 carousel 公转产生远近 */
}
.reaction-screen-layer .boxing-dizzy-layer__glyph {
  display: block;
  width: 36rpx;
  height: 36rpx;
  font-size: 32rpx;
  line-height: 36rpx;
  text-align: center;
  /* 亮黄金星：对比蓝绿卡通脸 */
  color: #ffd84a;
  text-shadow:
    0 0 2rpx rgba(255, 250, 200, 0.95),
    0 1rpx 0 rgba(120, 70, 0, 0.55),
    0 2rpx 4rpx rgba(0, 0, 0, 0.35);
  /* 抵消倾角，星星正向朝向观众 */
  transform: rotateX(-66deg);
  animation: boxing-dizzy-star-depth 1.35s linear infinite;
}
/* 均匀分布在 Y 轴轨道上（角度偏移） */
.reaction-screen-layer .boxing-dizzy-layer__star.s0 {
  transform: rotateY(0deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer__star.s1 {
  transform: rotateY(72deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer__star.s1 .boxing-dizzy-layer__glyph {
  animation-delay: -0.27s;
}
.reaction-screen-layer .boxing-dizzy-layer__star.s2 {
  transform: rotateY(144deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer__star.s2 .boxing-dizzy-layer__glyph {
  animation-delay: -0.54s;
}
.reaction-screen-layer .boxing-dizzy-layer__star.s3 {
  transform: rotateY(216deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer__star.s3 .boxing-dizzy-layer__glyph {
  animation-delay: -0.81s;
}
.reaction-screen-layer .boxing-dizzy-layer__star.s4 {
  transform: rotateY(288deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer__star.s4 .boxing-dizzy-layer__glyph {
  animation-delay: -1.08s;
}
/* 按数量隐藏多余星 */
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s3,
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s4 {
  display: none;
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s4 {
  display: none;
}
/* 3 星时改 120° 均分 */
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s0 {
  transform: rotateY(0deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s1 {
  transform: rotateY(120deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s2 {
  transform: rotateY(240deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s1 .boxing-dizzy-layer__glyph {
  animation-delay: -0.45s;
}
.reaction-screen-layer .boxing-dizzy-layer.stars-3 .s2 .boxing-dizzy-layer__glyph {
  animation-delay: -0.9s;
}
/* 4 星 90° 均分 */
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s0 {
  transform: rotateY(0deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s1 {
  transform: rotateY(90deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s2 {
  transform: rotateY(180deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s3 {
  transform: rotateY(270deg) translateZ(58rpx);
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s1 .boxing-dizzy-layer__glyph {
  animation-delay: -0.3375s;
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s2 .boxing-dizzy-layer__glyph {
  animation-delay: -0.675s;
}
.reaction-screen-layer .boxing-dizzy-layer.stars-4 .s3 .boxing-dizzy-layer__glyph {
  animation-delay: -1.0125s;
}

/* 漫画红拳套（纯 CSS；普通约 135rpx，终结约 240rpx） */
.reaction-screen-layer .boxing-comic-glove {
  position: fixed;
  z-index: 528;
  width: 135rpx;
  height: 135rpx;
  pointer-events: none;
}
.reaction-screen-layer .boxing-comic-glove.is-bl {
  left: -10%;
  bottom: -8%;
  transform: rotate(-28deg) scaleX(-1);
}
.reaction-screen-layer .boxing-comic-glove.is-br {
  right: -10%;
  bottom: -8%;
  left: auto;
  transform: rotate(28deg);
}
.reaction-screen-layer .boxing-comic-glove.is-bl.phase-punch {
