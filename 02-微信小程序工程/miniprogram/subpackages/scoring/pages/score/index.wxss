.join-match-team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
}

.join-match-team-name {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.join-match-team-action {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
