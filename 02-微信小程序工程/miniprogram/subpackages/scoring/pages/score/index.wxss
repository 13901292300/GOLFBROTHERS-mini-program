  min-height: 112rpx;
  background: var(--bg-card);
  box-sizing: border-box;
}

.track-lead-diff--par,
.track-lead-tee--par {
  background: var(--bg-primary);
}

.track-lead-diff__wrap {
  flex: none;
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  max-width: none;
  overflow: visible;
  opacity: 1 !important;
}

.scoreboard-shell--basic .track-lead-diff .player-diff-score {
  font-size: 32rpx;
  line-height: 1.1;
  white-space: nowrap;
}
/* game-single：diff 字阶对齐 G5（40rpx）；颜色/under·even·over 仍走全局 */
.scoreboard-shell--game-single .track-lead-diff .player-diff-score {
  font-size: 40rpx;
  line-height: 1.2;
  white-space: nowrap;
}

/* 普通创建单组：双栏 player-column + score-track（diff/T 在 track 内随横滑） */
.scoreboard-shell--game-single {
  position: relative;
}

/*
 * 纯 4+0：HOLE 以下完全复用 game-single；
 * 仅身份列改为 TEAM SCORE + 赛制名（宽仍 128rpx）。
 * HOLE 以上球员卡片走页面级 .bestball-roster-strip，不进本壳。
 */
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score {
  padding: 12rpx 6rpx;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-wrap {
  width: 100%;
  padding-right: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-kicker {
  font-size: 14rpx;
  letter-spacing: 0.12em;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-main {
  font-size: 24rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 4+0：成绩行合成 T 线 — 满行高、四色上下均分；不改列宽 / 行高 */
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .scoreboard-row--player .track-lead-tee {
  align-items: stretch;
  justify-content: stretch;
  overflow: hidden;
  padding: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .track-lead-tee__composite,
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .tee-sticky-overlay__row .track-lead-tee__composite {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
  align-self: stretch;
  box-sizing: border-box;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .track-lead-tee__seg {
  flex: 1 1 0;
  width: 100%;
  min-height: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .tee-sticky-overlay__row {
  align-items: stretch;
  padding: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40.is-tee-sticky
  .score-track
  .track-lead-tee__composite {
  opacity: 0;
}

/* HOLE/PAR 方案A：初始标签 — 宽=身份区(128+96+6)，水平中心对齐；HOLE/PAR 分占 head/par 行 */
.scoreboard-shell--game-single .hole-par-normal-container {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 230rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole,
.scoreboard-shell--game-single .hole-par-normal-container__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
/* 与身份 spacer 同 token：HOLE=交叉蓝、PAR=身份蓝（避免横滑露白缝） */
.scoreboard-shell--game-single .hole-par-normal-container__hole {
  height: 112rpx;
  background: var(--score-header-intersection);
  background-color: var(--score-header-intersection);
}
.scoreboard-shell--game-single .hole-par-normal-container__par {
  height: 72rpx;
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
}
/* HOLE/PAR 字阶对齐 G5 col-head/par-label；保留光学上移 */
.scoreboard-shell--game-single .hole-par-normal-container__hole text,
.scoreboard-shell--game-single .hole-par-normal-container__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole text {
  transform: translateY(-3rpx);
}
.scoreboard-shell--game-single .hole-par-normal-container__par text {
  transform: translateY(-2rpx);
}

/* HOLE/PAR 方案A：吸边紧凑标签 — 宽=player-column 128rpx，水平中心对齐头像区；HOLE/PAR 分占 head/par 行 */
.scoreboard-shell--game-single .hole-par-compact-container {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 128rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
}
/* Phase1：compact 保留节点但不参与显示 */
.scoreboard-shell--game-single .hole-par-compact-container--phase1-hidden {
  opacity: 0;
  visibility: hidden;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole,
.scoreboard-shell--game-single .hole-par-compact-container__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole {
  height: 112rpx;
}
.scoreboard-shell--game-single .hole-par-compact-container__par {
  height: 72rpx;
}
/* compact 与 normal 统一字阶；保留光学上移 */
.scoreboard-shell--game-single .hole-par-compact-container__hole text,
.scoreboard-shell--game-single .hole-par-compact-container__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole text {
  transform: translateY(-3rpx);
}
.scoreboard-shell--game-single .hole-par-compact-container__par text {
  transform: translateY(-2rpx);
}
/*
 * 身份列接缝对齐 fourball-player-column：
 * 页面底 + 右侧 identity 遮罩，避免横滑露壳层白底。
 */
.scoreboard-shell--game-single .player-column {
  position: relative;
  z-index: 3;
  background: var(--bg-primary);
  background-color: var(--bg-primary);
  border-right: none;
  box-shadow: 12rpx 0 0 0 var(--score-header-identity);
  box-sizing: border-box;
}
.scoreboard-shell--game-single .player-column__inner {
  width: 100%;
  box-sizing: border-box;
  box-shadow: inset -1px 0 0 var(--score-header-intersection);
}
/* game-single：头像对齐 fourball / G5 80rpx；T 色仅走 T 线 */
.scoreboard-shell--game-single .player-column__card .player-avatar-img {
  width: 80rpx;
  height: 80rpx;
}
/* 昵称对齐 fourball-single name-group__name */
.scoreboard-shell--game-single .player-column__card .player-name-line,
.scoreboard-shell--game-single .player-column__card .player-column__name {
  margin-top: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  font-style: normal;
  text-transform: none;
  color: var(--text-primary);
  max-width: 100%;
}
.scoreboard-shell--game-single .player-column__card {
  padding: 12rpx 8rpx;
}

/*
 * ===== G1 个人比杆专用（scoreboard-shell--g1-stroke）=====
 * 对齐 demo fourball 视觉；不改 fourball / fourball40 / match-play。
 */
/*
 * G1 identity 定宽：仅 player-column / spacer / row
 * hole-par-normal 沿用 game-single 230rpx + JS translateX（中心 115→64）；不压宽、不冻 transform
 */
.scoreboard-shell--g1-stroke {
  --g1-identity-width: 128rpx;
}
.scoreboard-shell--g1-stroke .player-column {
  width: var(--g1-identity-width);
  min-width: var(--g1-identity-width);
  max-width: var(--g1-identity-width);
}
.scoreboard-shell--g1-stroke .player-column__inner,
.scoreboard-shell--g1-stroke .player-column__spacer,
.scoreboard-shell--g1-stroke .player-column__row {
  width: var(--g1-identity-width);
  min-width: var(--g1-identity-width);
  max-width: var(--g1-identity-width);
  box-sizing: border-box;
}
.scoreboard-shell--g1-stroke .tee-sticky-overlay {
  left: var(--g1-identity-width);
}

.scoreboard-shell--g1-stroke .player-column__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
}
.scoreboard-shell--g1-stroke .player-column__card .player-name-line,
.scoreboard-shell--g1-stroke .player-column__card .player-column__name {
  margin-top: 0;
}
.scoreboard-shell--g1-stroke .track-lead-diff .player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
  color: var(--text-primary);
}
.scoreboard-shell--g1-stroke .track-lead-diff .player-diff-score.diff-under {
  color: #ef4444 !important;
}

/*
 * G1 identity Classic / Elite 字体体系（压过全局 .player-name-line / .player-diff-score）
 * 颜色继续走既有 .diff-under / .diff-even / .diff-over；不新增硬编码色
 */
.score-page.is-score-classic .scoreboard-shell--g1-stroke .player-column__card .player-name-line,
.score-page.is-score-classic .scoreboard-shell--g1-stroke .player-column__card .player-column__name {
  font-size: 22rpx;
  line-height: 1.2;
  min-height: 28rpx;
}
.score-page.is-score-classic.font-large .scoreboard-shell--g1-stroke .player-column__card .player-name-line,
.score-page.is-score-classic.font-large .scoreboard-shell--g1-stroke .player-column__card .player-column__name {
  font-size: 26rpx;
}
.score-page.is-score-classic .scoreboard-shell--g1-stroke .track-lead-diff .player-diff-score {
  font-size: 32rpx;
}
.score-page.is-score-classic.font-large .scoreboard-shell--g1-stroke .track-lead-diff .player-diff-score {
  font-size: 40rpx;
}
.score-page.is-score-elite-demo .scoreboard-shell--g1-stroke .track-lead-diff .player-diff-score {
  font-weight: 400;
}

/* OUT/IN/TOT 汇总列字阶与 demo special 列一致 */
.scoreboard-shell--g1-stroke .scoreboard-cell--hole-special-col .special-cell-val,
.scoreboard-shell--g1-stroke .scoreboard-cell--tot-col .special-cell-val {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}
.scoreboard-shell--g1-stroke .scoreboard-row--par > .scoreboard-cell--special-par,
.scoreboard-shell--g1-stroke .scoreboard-row--par > .scoreboard-cell--tot-col {
  min-height: 72rpx;
}
.scoreboard-shell--g1-stroke .scoreboard-row--player .score-cell.scoreboard-cell--hole-special-col,
.scoreboard-shell--g1-stroke .scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
}

/*
 * G1 stroke 基础分隔线（对齐 demo fourball 默认线源；不含 Classic/Elite）
 * 单源：cell/lead 横线 + cell 竖线；禁止 row 级 border-bottom
 */
.scoreboard-shell.scoreboard-shell--g1-stroke .scoreboard-row.shell-row--head,
.scoreboard-shell.scoreboard-shell--g1-stroke .scoreboard-row.shell-row--par,
.scoreboard-shell.scoreboard-shell--g1-stroke .scoreboard-row.shell-row--player,
.scoreboard-shell.scoreboard-shell--g1-stroke .scoreboard-row.scoreboard-row--head,
.scoreboard-shell.scoreboard-shell--g1-stroke .scoreboard-row.scoreboard-row--par,
.scoreboard-shell.scoreboard-shell--g1-stroke .scoreboard-row.scoreboard-row--player {
  border-bottom: none;
  box-shadow: none;
}
/* head 行勿裁切 cell 底边线 */
.scoreboard-shell--g1-stroke .scoreboard-row.scoreboard-row--head.shell-row--head {
  overflow: visible;
}
/* 横线：HOLE / PAR / 成绩（含 OUT/IN/TOT）+ lead */
.scoreboard-shell--g1-stroke .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-shell--g1-stroke .scoreboard-row--par > .scoreboard-cell,
.scoreboard-shell--g1-stroke .scoreboard-row.scoreboard-row--player .score-cell,
.scoreboard-shell--g1-stroke .track-lead-diff--head,
.scoreboard-shell--g1-stroke .track-lead-tee--head,
.scoreboard-shell--g1-stroke .track-lead-diff--par,
.scoreboard-shell--g1-stroke .track-lead-tee--par,
.scoreboard-shell--g1-stroke .scoreboard-row--player .track-lead-diff,
.scoreboard-shell--g1-stroke .scoreboard-row--player .track-lead-tee {
  border-bottom: 1px solid var(--fourball-score-row-border);
  box-sizing: border-box;
}
/* 左区 HOLE|PAR 横线（身份 spacer + HOLE/PAR overlay） */
.scoreboard-shell--g1-stroke .player-column__spacer.shell-row--head {
  border-bottom: 1px solid var(--fourball-score-row-border);
}
.scoreboard-shell--g1-stroke .hole-par-normal-container__hole {
  border-bottom: 1px solid var(--fourball-score-row-border);
  box-sizing: border-box;
}
/* 竖线：player-column|track 接缝（inner inset）+ T|第一洞（横滑左缘） */
.scoreboard-shell--g1-stroke .player-column__inner {
  box-shadow: inset -1px 0 0 var(--score-header-intersection);
}
.scoreboard-shell--g1-stroke .track-lead-tee {
  border-right: 1px solid var(--border-color);
  box-sizing: border-box;
}
/* 竖线：洞格 + OUT/IN/TOT（同一套 scoreboard-cell / score-cell） */
.scoreboard-shell--g1-stroke .scoreboard-row--head .scoreboard-cell,
.scoreboard-shell--g1-stroke .scoreboard-row--par > .scoreboard-cell,
.scoreboard-shell--g1-stroke .scoreboard-row--player .score-cell {
  border-right: 1px solid var(--border-color);
  box-sizing: border-box;
}

.scoreboard-shell--game-single .score-track {
  position: relative;
  z-index: 1;
  background: transparent;
  margin: 0;
  padding: 0;
}
/* HEADER：身份蓝（头像列 / lead 身）；TOTAL 头=交叉；TOTAL 身=身份 */
.scoreboard-shell--game-single .player-column__spacer.shell-row--par,
.scoreboard-shell--game-single .player-column__row {
  background: var(--score-header-identity);
  border-right: none;
  /* identity 区行分隔：交叉蓝，避免与 identity 底色过近 */
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}
/* 末行以下不留横线（对齐 fourball identity 列） */
.scoreboard-shell--game-single .player-column__inner > .player-column__row:last-child {
  border-bottom: none;
}
/* HOLE × 身份交叉蓝（仅 head；无右边框/底边，底边由 track header row 统一绘制） */
.scoreboard-shell--game-single .player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-right: none;
  border-bottom: none;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--par,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player {
  background: transparent;
}
/*
 * 记分行横向分隔：与 fourball 同 token（Light=border-color；Dark=增强灰）
 * head / par / player 的 cell + lead 统一自绘底边
 */
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-shell--game-single .scoreboard-row--par > .scoreboard-cell,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player .score-cell,
.scoreboard-shell--game-single .track-lead-diff--head,
.scoreboard-shell--game-single .track-lead-tee--head,
.scoreboard-shell--game-single .track-lead-diff--par,
.scoreboard-shell--game-single .track-lead-tee--par,
.scoreboard-shell--game-single .scoreboard-row--player .track-lead-diff,
.scoreboard-shell--game-single .scoreboard-row--player .track-lead-tee {
  border-bottom: 1px solid var(--fourball-score-row-border);
  box-sizing: border-box;
}
/* lead 身份蓝；HOLE 行 lead 用交叉蓝覆盖 */
.scoreboard-shell--game-single .track-lead-diff,
.scoreboard-shell--game-single .track-lead-diff--par,
.scoreboard-shell--game-single .track-lead-tee,
.scoreboard-shell--game-single .track-lead-tee--par {
  background: var(--score-header-identity) !important;
  background-color: var(--score-header-identity) !important;
}
.scoreboard-shell--game-single .track-lead-diff--head,
.scoreboard-shell--game-single .track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection) !important;
  background-color: var(--score-header-intersection) !important;
  box-sizing: border-box;
}
/* head 底边不占高度，保证与左侧 spacer 交叉蓝同高 112rpx */
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--head.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  box-shadow: none;
  overflow: hidden;
  box-sizing: border-box;
}
/* HOLE 行：1–18 + OUT/IN = HOLE蓝；TOTAL 头 = 交叉蓝（HOLE×身份） */
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
  background-color: var(--score-header-hole);
}
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
  background-color: var(--score-header-hole);
}
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
  background-color: var(--score-header-intersection);
}
/* OUT/IN 整列（含 PAR / 成绩 special）= HOLE蓝；压过 bg-primary */
.scoreboard-shell--game-single .scoreboard-cell--hole-special-col,
.scoreboard-shell--game-single .scoreboard-row--par > .scoreboard-cell--special-par:not(.scoreboard-cell--tot-col),
.scoreboard-shell--game-single .scoreboard-row--player .score-cell.scoreboard-cell--hole-special-col {
  background: var(--score-header-hole) !important;
  background-color: var(--score-header-hole) !important;
}
/* TOTAL 身（PAR + 成绩格）= 身份蓝 */
.scoreboard-shell--game-single .scoreboard-cell--tot-col,
.scoreboard-shell--game-single .scoreboard-row--player .score-cell.scoreboard-cell--tot-col,
.scoreboard-shell--game-single .scoreboard-row--player .score-cell.score-cell--total {
  background: var(--score-header-identity) !important;
  background-color: var(--score-header-identity) !important;
}
/* PAR 行 1–18 / 普通洞格：页面底 */
.scoreboard-shell--game-single .scoreboard-row--par > .scoreboard-cell:nth-child(n + 3):not(.scoreboard-cell--special-par):not(.scoreboard-cell--tot-col):not(.scoreboard-cell--hole-special-col),
.scoreboard-shell--game-single .scoreboard-row--player .score-cell:not(.scoreboard-cell--special-cell):not(.scoreboard-cell--hole-special-col):not(.scoreboard-cell--tot-col) {
  background: var(--bg-primary);
  background-color: var(--bg-primary);
}
/* track 内 T 列：宽=T线；底色同身份区；高度随成绩行 stretch */
.scoreboard-shell--game-single .track-lead-tee {
  width: 6rpx !important;
  min-width: 6rpx !important;
  max-width: 6rpx !important;
  flex: 0 0 6rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  border-right: none;
  overflow: hidden;
  box-sizing: border-box;
}
/* track 与 sticky overlay 共用：单色 T = 满行高 */
.scoreboard-shell--game-single .track-lead-tee .player-tee-marker,
.scoreboard-shell--game-single .track-lead-tee .track-lead-tee__mark,
.scoreboard-shell--game-single .tee-sticky-overlay__row .player-tee-marker,
.scoreboard-shell--game-single .tee-sticky-overlay__row .track-lead-tee__mark {
  position: static;
  right: auto;
  top: auto;
  bottom: auto;
  transform: none;
  width: 100%;
  height: 100%;
  align-self: stretch;
  margin: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}
/* T sticky overlay：宽=T线；左缘=player-column 右缘；高度=表内容（head+par+players） */
.scoreboard-shell--game-single .tee-sticky-overlay {
  position: absolute;
  left: 128rpx;
  top: 0;
  /* 禁止 bottom/height:100% 撑满 shell，避免底部灰色延长线 */
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}
.scoreboard-shell--game-single .tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}
/* head spacer = 交叉蓝；par spacer = 身份蓝（与 lead 对齐） */
.scoreboard-shell--game-single .tee-sticky-overlay__spacer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  background: var(--score-header-identity) !important;
  border-bottom: 1px solid var(--border-color);
}
.scoreboard-shell--game-single .tee-sticky-overlay__inner > .tee-sticky-overlay__spacer.shell-row--head {
  background: var(--score-header-intersection) !important;
}
/* player row：与 .shell-row--player 同高；stretch 使 T 线顶底对齐成绩行 */
.scoreboard-shell--game-single .tee-sticky-overlay__row {
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  background: var(--score-header-identity) !important;
  box-sizing: border-box;
}
/* sticky 显示时隐藏 track 内原始 T，避免双线（不改 DOM） */
.scoreboard-shell--game-single.is-tee-sticky .score-track .track-lead-tee .player-tee-marker,
.scoreboard-shell--game-single.is-tee-sticky .score-track .track-lead-tee .track-lead-tee__mark {
  opacity: 0;
}

/* ===== Match Play Shell：对齐 stroke shell（player-column + HOLE/PAR overlay + track lead + T sticky）===== */
.scoreboard-shell--match-play {
  position: relative;
}

/* G6/G7 pair：复用 fourball 身份列宽 / 折叠几何（G5 single 不进此分支） */
.scoreboard-shell--match-play.is-match-play-pair {
  --fourball-identity-width-start: 220rpx;
  --fourball-identity-width-delta: 72rpx;
  --fourball-identity-width: calc(
    var(--fourball-identity-width-start) - var(--fourball-identity-width-delta) *
      var(--fourball-identity-collapse, 0)
  );
  --fourball-diff-lead-width: 96rpx;
  --fourball-tee-lead-width: 6rpx;
  --fourball-hole-par-anchor-width: calc(
    var(--fourball-identity-width) + var(--fourball-diff-lead-width) +
      var(--fourball-tee-lead-width)
  );
  --fourball-avatar-collapse-shift: -48rpx;
}

.scoreboard-shell--match-play .player-column {
  width: 128rpx;
  min-width: 128rpx;
  height: 100%;
  position: relative;
  z-index: 3;
  background: transparent;
  border-right: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play.is-match-play-pair .player-column {
  width: var(--fourball-identity-width);
  min-width: var(--fourball-identity-width);
  max-width: var(--fourball-identity-width);
  transition: none;
}

.scoreboard-shell--match-play .score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 1;
  background: transparent;
}

/* HOLE/PAR normal：G5=230rpx；G6/G7 pair=identity+diff+T（随折叠变宽） */
.scoreboard-shell--match-play .match-play-hole-par-normal {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 230rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
  background: transparent;
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole,
.scoreboard-shell--match-play .match-play-hole-par-normal__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole {
  height: 112rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__par {
  height: 72rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole text,
.scoreboard-shell--match-play .match-play-hole-par-normal__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole text {
  transform: translateY(-3rpx);
}

.scoreboard-shell--match-play .match-play-hole-par-normal__par text {
  transform: translateY(-2rpx);
}

/* compact：宽=头像列 128rpx + 浅蓝底；仅 T sticky 吸边后显示 */
.scoreboard-shell--match-play .match-play-hole-par-compact {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 128rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  /* 吸边时：上 HOLE 交叉蓝 + 下 PAR 身份蓝（实色分段，非 rgba） */
  background: linear-gradient(
    to bottom,
    var(--score-header-intersection) 0,
    var(--score-header-intersection) 112rpx,
    var(--score-header-identity) 112rpx,
    var(--score-header-identity) 100%
  );
  opacity: 0;
  visibility: hidden;
}

.scoreboard-shell--match-play .match-play-hole-par-compact--hidden {
  opacity: 0;
  visibility: hidden;
}

/* 未吸边：只允许 normal；compact 强制隐藏（互斥） */
.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-normal {
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-compact,
.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-compact.match-play-hole-par-compact--hidden {
  opacity: 0 !important;
  visibility: hidden !important;
}

/* 已吸边：只允许 compact；normal 强制隐藏（互斥） */
.scoreboard-shell--match-play.is-match-play-tee-sticky .match-play-hole-par-normal {
  opacity: 0 !important;
  visibility: hidden !important;
}

.scoreboard-shell--match-play.is-match-play-tee-sticky .match-play-hole-par-compact,
.scoreboard-shell--match-play.is-match-play-tee-sticky .match-play-hole-par-compact.match-play-hole-par-compact--hidden {
  opacity: 1 !important;
  visibility: visible !important;
}

.scoreboard-shell--match-play .match-play-hole-par-compact__hole,
.scoreboard-shell--match-play .match-play-hole-par-compact__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-hole-par-compact__hole {
  height: 112rpx;
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-hole-par-compact__par {
  height: 72rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-compact__hole text,
.scoreboard-shell--match-play .match-play-hole-par-compact__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.scoreboard-shell--match-play .player-column__card .player-avatar-img {
  width: 80rpx;
  height: 80rpx;
}

/* G6/G7：pair 身份布局（同构 fourball-pair-identity；挂 paired-avatars/paired-names 类名） */
.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .avatar-group,
.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .paired-avatars {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 80rpx;
  margin: 0 auto;
  box-sizing: border-box;
  gap: calc(16rpx * (1 - var(--fourball-identity-collapse, 0)));
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .avatar-group__item {
  position: relative;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .avatar-group__item--first {
  z-index: 2;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .avatar-group__item--second {
  z-index: 1;
  margin-left: calc(
    var(--fourball-avatar-collapse-shift, -48rpx) * var(--fourball-identity-collapse, 0)
  );
  transform: translateX(0);
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .avatar-group__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: block;
  background: var(--bg-secondary);
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .name-stack {
  position: relative;
  width: 100%;
  min-height: 28rpx;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .name-group,
.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .paired-names {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  min-height: 28rpx;
  opacity: calc(1 - var(--fourball-identity-collapse, 0));
  /* 覆盖 legacy .paired-names absolute 叠名样式 */
  position: relative;
  height: auto;
  transform: none;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .name-group__name {
  flex: 1 1 0;
  min-width: 0;
  max-width: 50%;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .pair-name-compact {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 28rpx;
  box-sizing: border-box;
  opacity: var(--fourball-identity-collapse, 0);
  pointer-events: none;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .pair-name-compact--combined .pair-name-compact__text {
  max-width: 100%;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .pair-name-compact--dual {
  justify-content: center;
  gap: 0;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .pair-name-compact__part {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--match-play.is-match-play-pair .fourball-pair-identity .pair-name-compact__sep {
  flex: 0 0 auto;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.scoreboard-shell--match-play.is-match-play-pair .match-play-hole-par-normal,
.scoreboard-shell--match-play.is-match-play-pair .match-play-status-title-normal {
  width: var(--fourball-hole-par-anchor-width);
}

.scoreboard-shell--match-play.is-match-play-pair .match-play-tee-sticky-overlay {
  left: var(--fourball-identity-width);
}

.scoreboard-shell--match-play.is-match-play-pair .match-play-status-title-compact {
  width: calc(var(--fourball-identity-width) + 6rpx);
}

/* G6/G7 pair：阶段1 track 补偿（对齐 fourball-score-track__inner）；不影响 G5 */
.scoreboard-shell--match-play.is-match-play-pair .score-track__inner {
  position: relative;
  z-index: 1;
  will-change: transform;
  transition: none;
}

/* HEADER V2：身份蓝 / HOLE×lead 交叉蓝 */
.scoreboard-shell--match-play .player-column__spacer.shell-row--par,
.scoreboard-shell--match-play .player-column__row {
  background: var(--score-header-identity);
  border-right: none;
  /* identity 区行分隔：交叉蓝，避免与 identity 底色过近 */
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

.scoreboard-shell--match-play .player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-right: none;
  border-bottom: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-side-row {
  height: 156rpx;
  min-height: 156rpx;
}

.scoreboard-shell--match-play .match-play-status-row {
  height: 100rpx;
  min-height: 100rpx;
  justify-content: center;
  /* 对齐 FINAL 胜洞格 .match-status-cell--tot（DARK） */
  background: rgba(0, 45, 98, 0.22);
}

/* 胜洞走势标题 overlay：初始覆盖头像+diff+T（230rpx），与 HOLE/PAR 共用横移 style */
.scoreboard-shell--match-play .match-play-status-title-normal {
  position: absolute;
  /* head 112 + par 72 + Side A 156 */
  left: 0;
  top: 340rpx;
  z-index: 4;
  width: 230rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
  /* 透出下层 FINAL 固定区底色，避免横移时涂到洞列 */
  background: transparent;
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-status-title-normal.is-faded {
  opacity: 0;
  visibility: hidden;
}

.scoreboard-shell--match-play .match-play-status-title-normal .match-label-wrap {
  width: 100%;
  padding: 0 8rpx;
}

/* 吸边 compact：宽=头像列 128 + T线 6，阈值后显示 */
.scoreboard-shell--match-play .match-play-status-title-compact {
  position: absolute;
  left: 0;
  top: 340rpx;
  z-index: 4;
  width: 134rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  opacity: 0;
  visibility: hidden;
  background: rgba(0, 45, 98, 0.22);
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-status-title-compact.is-visible {
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-status-title-compact .match-label-wrap {
  width: 100%;
  padding: 0 4rpx;
}

.scoreboard-shell--match-play .match-play-status-title-compact .match-label-main {
  font-size: 20rpx;
}

/* track-lead：与 game-single 同宽（diff 96 / T 6）；底色见下方 HEADER V2 */
.scoreboard-shell--match-play .track-lead-diff,
.scoreboard-shell--match-play .track-lead-diff--head,
.scoreboard-shell--match-play .track-lead-diff--par,
.scoreboard-shell--match-play .track-lead-diff--status {
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  flex: 0 0 96rpx !important;
  flex-shrink: 0 !important;
  justify-content: center;
  padding: 8rpx 4rpx;
  border-right: none;
  overflow: visible;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-diff .player-diff-score {
  font-size: 40rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.scoreboard-shell--match-play .track-lead-tee,
.scoreboard-shell--match-play .track-lead-tee--head,
.scoreboard-shell--match-play .track-lead-tee--par,
.scoreboard-shell--match-play .track-lead-tee--status {
  width: 6rpx !important;
  min-width: 6rpx !important;
  max-width: 6rpx !important;
  flex: 0 0 6rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: stretch;
  border-right: none;
  overflow: hidden;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-tee .player-tee-marker,
.scoreboard-shell--match-play .track-lead-tee .track-lead-tee__mark,
.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row .player-tee-marker,
.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row .track-lead-tee__mark {
  position: static;
  right: auto;
  top: auto;
  bottom: auto;
  transform: none;
  width: 100%;
  height: 100%;
  align-self: stretch;
  margin: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* G6/G7 pair：双色 T 半条（对齐 fourball lead.tee） */
.scoreboard-shell--match-play .track-lead-tee .track-lead-tee__half,
.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row .track-lead-tee__half {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

/* HEADER V2：lead 身份蓝；HOLE 行 lead 交叉蓝 */
.scoreboard-shell--match-play .track-lead-diff,
.scoreboard-shell--match-play .track-lead-diff--par,
.scoreboard-shell--match-play .track-lead-tee,
.scoreboard-shell--match-play .track-lead-tee--par {
  background: var(--score-header-identity) !important;
}

/* diff/T 身份区行分隔（par + 球员行；head 仍由 header row 统一绘制） */
.scoreboard-shell--match-play .track-lead-diff--par,
.scoreboard-shell--match-play .track-lead-tee--par,
.scoreboard-shell--match-play .scoreboard-row--player .track-lead-diff,
.scoreboard-shell--match-play .scoreboard-row--player .track-lead-tee {
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-diff--head,
.scoreboard-shell--match-play .track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection) !important;
  box-sizing: border-box;
}
/* head 底边由 row 绘制且不占高度，保证与左侧 spacer 交叉蓝同高 112rpx */
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--head.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  box-shadow: 0 1px 0 var(--border-color);
  overflow: hidden;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-diff--status,
.scoreboard-shell--match-play .track-lead-tee--status {
  height: 100rpx;
  min-height: 100rpx;
  /* 对齐 FINAL 胜洞格 .match-status-cell--tot（DARK） */
  background: rgba(0, 45, 98, 0.22) !important;
}

.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--par,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player {
  background: transparent;
}

/* 与 game-single 一致：HOLE/PAR 行保留分隔线；球员行仍由 cell 绘底边 */
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--par {
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player {
  border-bottom: none;
}

/* HOLE 1–18 = HOLE蓝；FINAL 头 = 交叉蓝；FINAL 身 = 身份蓝 */
.scoreboard-shell--match-play .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
}

.scoreboard-shell--match-play .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}

.scoreboard-shell--match-play .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
}

/* OUT/IN 整列身 = HOLE蓝（与 1–18 一致） */
.scoreboard-shell--match-play .scoreboard-cell--hole-special-col {
  background: var(--score-header-hole);
}

.scoreboard-shell--match-play .scoreboard-cell--tot-col {
  background: var(--score-header-identity);
}
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--par .scoreboard-cell--tot-col,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  border-bottom: 1px solid var(--score-header-intersection);
}

/* PAR 行洞格：保持原规则 */
.scoreboard-shell--match-play .scoreboard-row--par > .scoreboard-cell:nth-child(n + 3):not(.scoreboard-cell--special-par) {
  background: var(--bg-primary);
}

.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player .score-cell {
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .scoreboard-row.match-status-row .match-status-cell,
.scoreboard-shell--match-play .scoreboard-row.match-status-row .track-lead-diff--status,
.scoreboard-shell--match-play .scoreboard-row.match-status-row .track-lead-tee--status {
  border-bottom: 1px solid var(--border-color);
}

/* match-play T sticky overlay（独立类名，不改 G1 tee-sticky-overlay） */
.scoreboard-shell--match-play .match-play-tee-sticky-overlay {
  position: absolute;
  left: 128rpx;
  top: 0;
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__spacer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  background: var(--score-header-identity) !important;
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__inner > .match-play-tee-sticky-overlay__spacer.shell-row--head {
  background: var(--score-header-intersection) !important;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: stretch;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  background: var(--score-header-identity) !important;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__status {
  width: 100%;
  height: 100rpx;
  min-height: 100rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  /* 对齐 FINAL 胜洞格 .match-status-cell--tot（DARK） */
  background: rgba(0, 45, 98, 0.22) !important;
  box-sizing: border-box;
}

.scoreboard-shell--match-play.is-match-play-tee-sticky .score-track .track-lead-tee .player-tee-marker,
.scoreboard-shell--match-play.is-match-play-tee-sticky .score-track .track-lead-tee .track-lead-tee__mark {
  opacity: 0;
}

/* 胜洞趋势固定区 + compact + sticky T 状态段：对齐 FINAL bright */
.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-row,
.score-page.bright-mode .scoreboard-shell--match-play .track-lead-diff--status,
.score-page.bright-mode .scoreboard-shell--match-play .track-lead-tee--status,
.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-title-compact,
.score-page.bright-mode .scoreboard-shell--match-play .match-play-tee-sticky-overlay__status {
  background: rgba(0, 45, 98, 0.04) !important;
}

.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-title-normal .match-label-main,
.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-title-compact .match-label-main {
  color: #002d62;
}

/* 公共单色 T：高度 = 成绩行（父级 track-lead-tee / sticky row）100% */
.track-lead-tee__mark,
.track-lead-tee .player-tee-marker {
  position: static;
  flex-shrink: 0;
  width: 6rpx;
  height: 100%;
  align-self: stretch;
  top: auto;
  right: auto;
  bottom: auto;
  box-sizing: border-box;
}

.scoreboard-inner { display: inline-block; min-width: 100%; }

.scoreboard-row {
  display: flex;
  border-bottom: 1px solid var(--border-color);
  min-width: max-content;
}

.scoreboard-row--head { background: var(--bg-card); }
.scoreboard-row--par { background: var(--bg-primary); }
.scoreboard-row--player { height: 156rpx; }

.scoreboard-cell {
  width: 144rpx;
  min-width: 144rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  border-right: 1px solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.sticky-col {
  position: sticky;
  left: 0;
  z-index: 20;
  /* 原型机制：球员列宽度由 CSS 变量驱动（所有行共用，故缩放时不会错位） */
  width: var(--player-col-width, 240rpx);
  min-width: var(--player-col-width, 240rpx);
  background: var(--bg-secondary);
  transition: width 0.25s ease, min-width 0.25s ease;
}

.scoreboard-row--head .sticky-col { background: var(--bg-card); }

.player-col-header {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
  padding-left: var(--player-col-padding-x, 24rpx);
  padding-right: var(--player-col-padding-x, 24rpx);
  transition: padding 0.25s ease;
}

.col-head-label,
.col-par-label {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.par-val { font-size: 24rpx; font-weight: 700; color: var(--text-secondary); }

.scoreboard-cell--special-head { background: rgba(0, 45, 98, 0.2); }
.scoreboard-cell--special-par { background: var(--bg-card); }
.scoreboard-cell--special-cell { background: rgba(0, 45, 98, 0.05); }

.hole-label-wrap { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }

.hole-number,
.hole-label-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.hole-number {
  background: #002d62 !important;
  color: #ffffff !important;
  border: 1px solid #002d62;
}

/* G5–G8 比洞：自动起始洞 HOLE 金底白字 */
.hole-label-circle--start {
  background: var(--champion-gold, #ce9224) !important;
  color: #ffffff !important;
  border: 1px solid var(--champion-gold, #ce9224);
}

.hole-label-circle--special {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

/* DARK：OUT/IN/TOTAL special label 独立于 HOLE 数字圆标（不套用蓝底白字） */
.score-page.dark-mode .hole-label-circle--special {
  background: var(--score-header-identity);
  border: 1px solid var(--score-header-intersection);
  color: var(--text-secondary);
}

/* Player cell */
.player-cell {
  justify-content: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  padding-left: var(--player-col-padding-x, 24rpx);
  padding-right: var(--player-col-padding-x, 24rpx);
  transition: padding 0.25s ease;
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
}

.player-card { width: 100%; min-width: 0; }

.player-top-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.player-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  /* T 色统一由 T 线展示；取消头像 colorClass / 内联 teeColor 色环 */
  border: none !important;
}

.player-avatar-img.border-red,
.player-avatar-img.border-gold,
.player-avatar-img.border-white,
.player-avatar-img.border-light,
.player-avatar-img.border-black {
  border: none !important;
}

.player-diff-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
  overflow: hidden;
  opacity: var(--player-diff-opacity, 1);
  transition: opacity 0.25s ease;
}

.player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1.2;
}

.player-name-line {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-secondary);
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: var(--player-name-width, 192rpx);
  transition: max-width 0.25s ease;
}

/* Legacy 身份列绝对定位 T：顶底贴齐成绩行（不再只盖头像区中段） */
.player-tee-marker {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.player-tee-marker.border-red { background: #dc2626; }
.player-tee-marker.border-gold { background: var(--champion-gold); }
/* 白T：真实白色；细描边避免浅色 identity 底上消失（勿用 --text-primary，亮色主题会变成近黑） */
.player-tee-marker.border-white {
  background: #ffffff;
  box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.28);
}
.player-tee-marker.border-light { background: #00aeef; }
.player-tee-marker.border-black { background: #111827; }

.diff-under { color: #ef4444 !important; }
.diff-even { color: var(--par-color) !important; }
.diff-over { color: var(--text-secondary) !important; }

.player-diff-score.diff-under { color: #ef4444; }
.player-diff-score.diff-even { color: var(--par-color); }

/* Score cells */
.score-cell { padding: 8rpx; min-height: 156rpx; }

.hole-cell-inner,
.special-cell-inner {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 注意：不要 position:relative，否则底部推杆/杆差会被锚到本内框（居中漂浮），
     而不是记分格真正的底边。让其锚定到 .scoreboard-cell。 */
}

.hole-cell-score,
.special-cell-val {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
}

.special-cell-val { color: var(--text-secondary); font-style: italic; }

/* 杆差模式：仅缩小主成绩文字（含正负号），圆圈/方框容器尺寸保持不变 */
.hole-cell-score--diff { font-size: 40rpx; }

/* 无成绩：T 台码数提示（浅灰小字） */
.hole-cell-score--hint {
  font-size: 24rpx;
  font-weight: 500;
  color: #9ca3af;
}

/* TOT 列：主题联动颜色，!important 防止任何局部/语义色覆盖 */
.special-cell-val--tot,
.tot-value { color: var(--tot-color) !important; }

/* ===== 成绩标记统一外框系统：四类共用同一 marker-size + border-box，仅视觉不同（圆/圈/框/底） =====
   关键：固定 width/height + box-sizing:border-box，border 不撑大外框、内容不撑形状，四态外轮廓完全一致 */
.score-birdie,
.score-eagle,
.score-bogey,
.score-double {
  --score-marker-size: 72rpx;
  width: var(--score-marker-size);
  height: var(--score-marker-size);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小鸟：红圈（描边、内部透明） */
.score-birdie { border: 4rpx solid #ef4444; border-radius: 9999rpx; }
.score-birdie .hole-cell-score { color: #ef4444; }

/* 老鹰及更好（-2 及更好）：圆底白字（实心圆，固定外框，非内容撑圆） */
.score-eagle { background: #ef4444; border-radius: 9999rpx; }
.score-eagle .hole-cell-score { color: #ffffff; }

/* 加一：方框（描边、内部透明） */
.score-bogey { border: 2rpx solid var(--text-secondary); }

/* 加二及更差（+2 及以上）：灰底白字（实心灰底） */
.score-double { background: #6b7280; border-radius: 8rpx; }
.score-double .hole-cell-score { color: #ffffff; }

/*
 * ===== 临时 Classic Style（仅 .score-page.is-score-classic / demo-weekend-amateur）=====
 * classicClass 挂在 score-cell：整格传统记分卡色块；禁止 :has。
 * scoreClass / bestScoreClass / scoreStyle / 成绩逻辑不改。
 */

/* Classic 下取消 Elite marker 外形（保留 DOM / scoreClass） */
.score-page.is-score-classic .score-eagle,
.score-page.is-score-classic .score-birdie,
.score-page.is-score-classic .score-bogey,
.score-page.is-score-classic .score-double {
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  width: auto;
  height: auto;
  min-width: 0;
  min-height: 0;
}

.score-page.is-score-classic .hole-cell-score--hint {
  color: #9ca3af;
}

/* Classic：洞格内数字普通字重（覆盖 Elite 900/700） */
.score-page.is-score-classic .hole-cell-score {
  font-weight: normal;
}
.score-page.is-score-classic .hole-cell-putt {
  font-weight: normal;
}
.score-page.is-score-classic .hole-cell-diff {
  font-weight: normal;
}

/* 整格色块：压过 fourball .score-cell 的 bg-primary；传统表格无圆角 */
.score-page.is-score-classic .score-cell.classic-eagle {
  border-radius: 0 !important;
  background: #ffe1cf !important;
  background-color: #ffe1cf !important;
}
.score-page.is-score-classic .score-cell.classic-birdie {
  border-radius: 0 !important;
  background: #fff8f2 !important;
  background-color: #fff8f2 !important;
}
.score-page.is-score-classic .score-cell.classic-par {
  border-radius: 0 !important;
  background: #ffffff !important;
  background-color: #ffffff !important;
}
.score-page.is-score-classic .score-cell.classic-bogey {
  border-radius: 0 !important;
  background: #e6e6e6 !important;
  background-color: #e6e6e6 !important;
}
.score-page.is-score-classic .score-cell.classic-double {
  border-radius: 0 !important;
  background: #cecece !important;
  background-color: #cecece !important;
}
.score-page.is-score-classic .score-cell.classic-triple {
  border-radius: 0 !important;
  background: #b5b5b5 !important;
  background-color: #b5b5b5 !important;
}

/* 数字色 */
.score-page.is-score-classic .score-cell.classic-eagle .hole-cell-score,
.score-page.is-score-classic .score-cell.classic-birdie .hole-cell-score {
  color: #f5620d;
}
.score-page.is-score-classic .score-cell.classic-par .hole-cell-score {
  color: #1c94de;
}
.score-page.is-score-classic .score-cell.classic-bogey .hole-cell-score,
.score-page.is-score-classic .score-cell.classic-double .hole-cell-score,
.score-page.is-score-classic .score-cell.classic-triple .hole-cell-score {
  color: #000000;
}

/* putt */
.score-page.is-score-classic .score-cell.classic-eagle .hole-cell-putt,
.score-page.is-score-classic .score-cell.classic-birdie .hole-cell-putt,
.score-page.is-score-classic .score-cell.classic-par .hole-cell-putt,
.score-page.is-score-classic .score-cell.classic-bogey .hole-cell-putt,
.score-page.is-score-classic .score-cell.classic-double .hole-cell-putt,
.score-page.is-score-classic .score-cell.classic-triple .hole-cell-putt {
  color: #000000;
  opacity: 1;
}

/* Classic 右下角杆差：统一小鸟/老鹰色（压过 .diff-under/even/over !important） */
.score-page.is-score-classic .hole-cell-diff,
.score-page.is-score-classic .hole-cell-diff.diff-under,
.score-page.is-score-classic .hole-cell-diff.diff-even,
.score-page.is-score-classic .hole-cell-diff.diff-over {
  color: #f5620d !important;
}

/*
 * Classic fourball identity 后 lead diff：仅 diff<0（.diff-under）改小鸟橙；
 * diff>=0 保持原色。不改洞格 / OUT·IN·TOT / Elite。
 */
.score-page.is-score-classic .scoreboard-shell--fourball .fourball-track-lead__diff.diff-under {
  color: #f5620d !important;
}

/* Classic OUT/IN：左下推杆与本格半场汇总总杆同色（.special-cell-val = text-secondary） */
.score-page.is-score-classic .scoreboard-cell--hole-special-col .special-cell-putt {
  color: var(--text-secondary);
  opacity: 1;
}

/* Classic TOT：左下推杆黑 */
.score-page.is-score-classic .score-cell--total .special-cell-putt,
.score-page.is-score-classic .scoreboard-cell--tot-col .special-cell-putt {
  color: #000000;
  opacity: 1;
}

.score-page.is-score-classic .special-cell-diff,
.score-page.is-score-classic .special-cell-diff.diff-under,
.score-page.is-score-classic .special-cell-diff.diff-even,
.score-page.is-score-classic .special-cell-diff.diff-over {
  color: #f5620d !important;
}

/*
 * Classic DARK：仅六档成绩格色板（不改 LIGHT、HOLE/PAR、T、OUT/IN/TOT、分隔线）
 * 语义同亮色纸面：暖橙鹰/鸟、冷蓝平杆、灰阶超杆；字色随底对比
 */
.score-page.is-score-classic.dark-mode .score-cell.classic-eagle {
  background: #4a2c1a !important;
  background-color: #4a2c1a !important;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-birdie {
  background: #3a281c !important;
  background-color: #3a281c !important;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-par {
  background: #1c2430 !important;
  background-color: #1c2430 !important;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-bogey {
  background: #2e2e2e !important;
  background-color: #2e2e2e !important;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-double {
  background: #252525 !important;
  background-color: #252525 !important;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-triple {
  background: #1c1c1c !important;
  background-color: #1c1c1c !important;
}

.score-page.is-score-classic.dark-mode .score-cell.classic-eagle .hole-cell-score,
.score-page.is-score-classic.dark-mode .score-cell.classic-birdie .hole-cell-score {
  color: #ff8c42;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-par .hole-cell-score {
  color: #5eb4e8;
}
.score-page.is-score-classic.dark-mode .score-cell.classic-bogey .hole-cell-score,
.score-page.is-score-classic.dark-mode .score-cell.classic-double .hole-cell-score,
.score-page.is-score-classic.dark-mode .score-cell.classic-triple .hole-cell-score {
