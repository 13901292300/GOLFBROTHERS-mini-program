/* 修改半场：panel 必须高于 mask，否则遮罩拦截全部点击 */
.bottom-sheet.half-course-sheet {
  z-index: 230;
  pointer-events: auto;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  background: #fff;
}
.half-course-sheet .half-course-panel {
  pointer-events: auto;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* Score Input Sheet */
.score-input-sheet {
  position: fixed;
  inset: 0;
  z-index: 500;
}

.score-input-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.score-input-sheet__panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: 96rpx 96rpx 0 0;
  border-top: 6rpx solid #002d62;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.score-input-sheet__panel--open { transform: translateY(0); }

.score-input-sheet__handle {
  width: 128rpx;
  height: 8rpx;
  background: var(--border-color);
  border-radius: 999rpx;
  margin: 24rpx auto 32rpx;
}

.panel-mode-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  margin: 0 auto 24rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
}

.panel-mode-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
}

.panel-mode-btn--active {
  background: #002d62;
  color: #ffffff;
}

.sheet-hole-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.sheet-hole-nav__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.sheet-hole-label {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #002d62;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  border: 4rpx solid #ffffff;
}

.sheet-hole-meta {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.sheet-hole-meta__item { display: flex; gap: 8rpx; align-items: center; }
.sheet-hole-meta__val { color: var(--text-primary); font-size: 24rpx; }
.sheet-hole-meta__val--light { color: var(--aux-text); }

.score-sheet-layout {
  display: flex;
  padding: 0 32rpx;
  gap: 16rpx;
  height: 600rpx;
}

.sheet-player-list {
  width: 264rpx;
  min-width: 264rpx;
  background: var(--bg-primary);
  border-radius: 48rpx;
  padding: 16rpx 12rpx;
  overflow: hidden;
}

.sheet-player-item {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  border-radius: 24rpx;
}

.sheet-player-item--active {
  background: var(--highlight-surface);
  border-right: 4rpx solid var(--highlight-color);
}

/* 非 active 不通过 opacity 灰化，保持正常可读 */
.sheet-player-item--inactive { opacity: 1; }

.sheet-player-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.sheet-player-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border-color);
}

.sheet-player-name {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-primary);
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* 选中行球员名使用高亮色文字，进一步强化当前选中态 */
.sheet-player-item--active .sheet-player-name { color: var(--highlight-text); }

.sheet-hole-score {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--score-surface);
  border: 1px solid var(--score-border);
  color: var(--score-color);
  font-size: 30rpx;
  font-weight: 900;
  font-style: italic;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 当前编辑未确认草稿（通用兜底；Bright active 另有覆盖） */
.sheet-hole-score--draft {
  color: var(--text-muted, #9ca3af);
  border-color: var(--border-color, #d1d5db);
  background: transparent;
  font-weight: 700;
}

/* ===== Dark 模式：普通单组技术面板当前球员冠军金高亮 ===== */
.score-page.dark-mode .sheet-player-item--active {
  background: #CE9224;
  border-right: 4rpx solid #CE9224;
}

.score-page.dark-mode .sheet-player-item--active .sheet-player-name {
  color: #111111;
}

/* Dark：正式成绩格冠军金边 + 深底 + 白字（非 draft / 非 empty） */
.score-page.dark-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  border: 2rpx solid #CE9224;
  background: #111111;
  color: #ffffff;
}

/* Dark：草稿成绩 PGA 蓝字；背景/边框保持原草稿样式 */
.score-page.dark-mode .sheet-hole-score--draft {
  color: #002D62;
}

/* ===== Bright 模式：普通单组技术面板 PGA 蓝高亮 ===== */
.score-page.bright-mode .sheet-player-item--active {
  background: #002D62;
  border-right: 4rpx solid #002D62;
}

.score-page.bright-mode .sheet-player-item--active .sheet-player-name {
  color: #ffffff;
}

/* active + 已确认成绩：白底 PGA 蓝字，压在深蓝行上仍清晰 */
.score-page.bright-mode .sheet-player-item--active .sheet-hole-score:not(.sheet-hole-score--draft) {
  color: #002D62;
  background: #ffffff;
  border-color: rgba(255, 255, 255, 0.95);
}

/* active + draft：浅蓝/半透明白，表示未确认输入 */
.score-page.bright-mode .sheet-player-item--active .sheet-hole-score--draft {
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.5);
  font-weight: 700;
}

/* 非 active + 无正式成绩：PGA 蓝边 + 浅蓝底，可记未完 */
.score-page.bright-mode .sheet-player-item--inactive .sheet-hole-score--empty {
  color: transparent;
  background: rgba(0, 45, 98, 0.12);
  border: 2rpx solid #002D62;
}

/* 非 active + 正式成绩：PGA 蓝边 + 白底 + PGA 蓝字 */
.score-page.bright-mode .sheet-player-item--inactive .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  color: #002D62;
  background: #ffffff;
  border: 2rpx solid #002D62;
}

/* Bright 快捷：头像旁成绩格与技术面板同规范（复用 PGA 蓝体系；draft 不覆盖） */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score--empty {
  color: transparent;
  background: rgba(0, 45, 98, 0.12);
  border: 2rpx solid #002D62;
}

.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  color: #002D62;
  background: #ffffff;
  border: 2rpx solid #002D62;
}

/* Bright 快捷：默认 PAR 等为草稿 — 弱化浅灰，不用正式 PGA 蓝 */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score--draft {
  color: #9ca3af;
  background: rgba(148, 163, 184, 0.16);
  border: 2rpx solid #d1d5db;
  font-weight: 700;
}

/* ===== Dark 快捷：成绩格与技术面板 Dark 视觉语言统一（仅 quick-mode） ===== */
/* 正式成绩：冠军金边 + 深底 + 白字 */
.score-page.dark-mode .score-input-sheet.quick-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  border: 2rpx solid #CE9224;
  background: #111111;
  color: #ffffff;
}

/* 草稿成绩：PGA 蓝字 + Dark 背景，不用冠军金 */
.score-page.dark-mode .score-input-sheet.quick-mode .sheet-hole-score--draft {
  color: #4A90E2;
  background: #111111;
  border: 2rpx solid #222222;
  font-weight: 700;
}

/* 空成绩：不覆盖，沿用现有 Dark .sheet-hole-score / --empty 表现 */

/* Bright 快捷：中间记分控件视觉对齐正式成绩格 */
.score-page.bright-mode .quick-score-control {
  background: #ffffff;
  border: 2rpx solid #002D62;
  box-shadow: none;
}

.score-page.bright-mode .quick-score-control-value {
  color: #002D62;
}

.sheet-main-panel {
  flex: 1;
  min-width: 0;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 48rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Bright：技术面板控件区 PGA 蓝边框，呼应左侧球员高亮；背景/内控件不变 */
.score-page.bright-mode .tech-score-panel {
  border: 3px solid #002D62;
  background: #ffffff;
}

/* Dark：技术面板控件区冠军金边框，呼应左侧球员高亮；背景/内控件不变 */
.score-page.dark-mode .tech-score-panel {
  border: 3px solid #CE9224;
}

/* 焦点切换 pulse：颜色跟随主题变量（Bright PGA蓝 / Dark 冠军金） */
.tech-score-panel--focus-pulse {
  animation: tech-panel-focus-pulse 500ms ease;
}

@keyframes tech-panel-focus-pulse {
  0% { border-color: var(--tech-panel-pulse); }
  50% { border-color: var(--tech-panel-pulse-mid); }
  100% { border-color: var(--tech-panel-pulse); }
}

.sheet-control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-control-label {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.stepper-btn {
  background: var(--bg-card);
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  gap: 16rpx;
}

.control-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #facc15;
  color: #002d55;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.stepper-val {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-primary);
  min-width: 64rpx;
  text-align: center;
}

.direction-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.direction-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.direction-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
}

.direction-circle--active {
  background: var(--highlight-strong);
  color: var(--highlight-on);
}

.direction-label {
  font-size: 16rpx;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
}

.direction-label--gold { color: var(--highlight-color); font-weight: 900; }

/* Dark：技术面板 FAIRWAY 选中态冠军金；未选保持原样 */
.score-page.dark-mode .tech-score-panel .direction-circle--active {
  background: #CE9224;
  color: #111111;
}

.score-page.dark-mode .tech-score-panel .direction-label--gold {
  color: #CE9224;
}

.quick-score-control-list {
  display: flex;
  flex-direction: column;
  transform: translateY(-26rpx);
}

.quick-score-control-row {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center; /* 控件在行内水平居中；高度不变，与左侧头像行垂直对齐 */
}

.quick-score-control {
  min-width: 224rpx;
  height: 72rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 16rpx;
}

.quick-score-control-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #facc15;
  color: #002d62;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

/* Bright：快捷面板 +/- PGA 蓝；不改技术面板 / Dark */
.score-page.bright-mode .quick-score-control-btn {
  background: #002D62;
  color: #ffffff;
}

/* Dark：快捷面板 +/- 冠军金 */
.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control-btn {
  background: #CE9224;
  color: #111111;
}

/* Dark：快捷记分控件容器（包裹 +/- 与数值） */
.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control {
  background: var(--bg-card);
  border: 2rpx solid #CE9224;
  box-shadow: none;
}

.quick-score-control-value {
  min-width: 56rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #0f172a;
}

.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control-value {
  color: white;
}

.sheet-footer-btns {
  display: flex;
  padding: 48rpx 80rpx 0;
  gap: 32rpx;
}

.sheet-footer-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

.sheet-footer-btn--clear {
  background: var(--bg-primary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.sheet-footer-btn--confirm {
  background: var(--champion-gold);
  color: #000000;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.2);
}

/* finished 只读：编辑控件置灰，成绩展示布局不变 */
.score-input-sheet.is-readonly .control-icon.is-disabled,
.score-input-sheet.is-readonly .quick-score-control-btn.is-disabled,
.score-input-sheet.is-readonly .sheet-footer-btn.is-disabled {
  opacity: 0.42;
  filter: grayscale(0.35);
}
.score-input-sheet.is-readonly .tech-score-panel.is-disabled .direction-row,
.score-input-sheet.is-readonly .direction-row.is-disabled,
.score-input-sheet.is-readonly .quick-score-panel.is-disabled {
  opacity: 0.55;
}

/* Bright：技术面板操作色统一（+/- / 确认）；不改快捷面板、不改 Dark */
.score-page.bright-mode .tech-score-panel .control-icon {
  background: #002D62;
  color: #ffffff;
}

.score-page.bright-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Bright：快捷面板确认 PGA 蓝；不改技术面板选择器、不改 Dark */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Dark：技术面板 +/- 冠军金；不改 Bright / 快捷 */
.score-page.dark-mode .tech-score-panel .control-icon {
  background: #CE9224;
  color: #111111;
}

/* Dark：技术面板确认按钮冠军金；不改快捷面板 */
.score-page.dark-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #CE9224;
  color: #111111;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.28);
}

/* Group Manage Page */
.group-manage-page {
  position: fixed;
  inset: 0;
  z-index: 650;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
}

.group-manage-content {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  /* 与固定底栏为 flex 同级、互不重叠；额外补偿确保滚动到底内容不被遮挡 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 固定底部操作栏：作为 group-manage-page(flex column) 的最后一个 flex 同级，
   恒贴底、不随 scroll-view 滚动、不被内容挤压；不使用 margin 伪造。 */
.group-manage-footer {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
  z-index: 100;
}

/* 人员来源弹层挂在添加/删除内：抬高层级，避免被底栏(z-index:100)遮挡 */
.group-manage-source-sheet {
  position: relative;
  z-index: 200;
}

/* 手工添加底部弹窗：高于来源选择与底栏 */
.manual-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 700;
}

.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--text-primary);
}

.manual-sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover, var(--border-color));
  margin: 0 auto 28rpx;
}

.manual-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.manual-sheet__overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--data-blue, #00aeef);
}

.manual-sheet__title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.manual-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-muted, var(--text-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.manual-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.manual-field__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.manual-field__input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-primary));
  color: var(--text-primary);
  font-size: 28rpx;
}

.manual-field__placeholder {
  color: var(--text-muted, #9ca3af);
}

.manual-gender {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.manual-gender__tag {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-gender__tag.is-active {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

.manual-sheet__footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.manual-sheet__btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.manual-sheet__btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
  border: 1px solid var(--border-color);
}

.manual-sheet__btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}

.player-source-list-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--bg-card);
  color: var(--text-primary);
  box-sizing: border-box;
}

.player-source-list {
  max-height: 56vh;
}

.player-source-list__empty {
  padding: 48rpx 24rpx;
  border-radius: 22rpx;
  border: 1px dashed var(--border-color);
  background: var(--bg-primary);
  color: var(--text-secondary);
  text-align: center;
  font-size: 26rpx;
}

.player-source-list__item {
  min-height: 108rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.player-source-list__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.player-source-list__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.player-source-list__title {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.player-source-list__subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-source-list__action {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
  flex-shrink: 0;
}

.join-match-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--bg-card);
  color: var(--text-primary);
}

.join-match-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.join-match-sheet__desc {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.join-match-team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.join-match-team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
}

.join-match-team-name {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.join-match-team-action {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
}

.section-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.section-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section-count {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--champion-gold);
}

.players-strip {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  /* 恒定 4 列：增删只切换填充/空位，列数与对齐不随 children 数量变化（中心轴绝对稳定） */
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.player-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.slot-index {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
}

.avatar-wrap {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.avatar-wrap image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
}

.delete-dot {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg-card);
}

.player-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

/* 添加/删除：昵称下方分队小胶囊（仅展示，不改座位布局） */
.group-manage-team-label {
  max-width: 96rpx;
  margin-top: -6rpx;
  padding: 0 6rpx;
  height: 24rpx;
  line-height: 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 45, 98, 0.08);
  color: var(--text-muted, #6b7280);
  font-size: 16rpx;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}
.score-page.dark-mode .group-manage-team-label {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-secondary);
}

/* 空槽位占位（复刻原型 .empty-slot）：虚线圆 + ＋，名称弱化；保持 4 列布局恒定 */
.empty-slot .avatar-wrap {
  border: 1px dashed var(--border-color);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
}

.empty-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 36rpx;
}

.empty-slot .player-name {
  color: var(--text-secondary);
  opacity: 0.65;
}

/* 可继承空位：该槽位保留了上一位球员成绩，高亮提示可继承 */
.empty-slot .empty-avatar--cache {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .avatar-wrap {
  position: relative;
}
.slot-cache-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--accent-gold, #d4af37);
  color: #1a1a1a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

/* 待扫码加入（pending）：高亮虚线 + 省略号脉冲，提示该槽位正在等待扫码 */
.empty-avatar--pending {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .empty-avatar--pending {
  animation: slotPendingPulse 1.2s ease-in-out infinite;
}
@keyframes slotPendingPulse {
