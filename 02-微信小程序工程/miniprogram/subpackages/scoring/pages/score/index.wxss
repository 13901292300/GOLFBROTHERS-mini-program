  gap: 20rpx;
  width: 100%;
}
.slot-qr-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}
.slot-qr-btn--ghost {
  background: var(--bg-page, rgba(255, 255, 255, 0.06));
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}
.slot-qr-btn--primary {
  background: var(--accent-gold, #d4af37);
  color: #1a1a1a;
}

.qr-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
  text-align: center;
}

.qr-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  margin: 16rpx 0 32rpx;
}

.qr-box {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.qr-image {
  width: 420rpx;
  height: 420rpx;
  border-radius: 36rpx;
  background: #ffffff;
}

.share-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.divider {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 24rpx 0;
}

/* 复刻原型 .actions / .action-btn：横向并列、卡片底 + 描边 */
.group-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.group-action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
}

/* 取消：次要描边按钮 */
.group-action-btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
}

/* 确认：金色主按钮 */
.group-action-btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

/* 主题切换完全由 .dark-mode / .bright-mode 上的 Theme Token 驱动，
   无需任何局部 bright/dark 覆盖规则。 */

/* ===================================================================
   四人最佳球位模式（fourball_best）专用样式 —— 复刻 HTML 原型
   仅在 mode === 'fourball_best' 时渲染，不影响其他模式
   =================================================================== */

/* 球员花名册条（位于赛况信息与记分表之间） */
.bestball-roster-strip {
  background: linear-gradient(90deg, rgba(0, 45, 98, 0.18), rgba(17, 17, 17, 0.98), rgba(206, 146, 36, 0.1));
  border-bottom: 1rpx solid var(--border-color);
  padding: 18rpx 20rpx 20rpx;
  flex-shrink: 0;
}

.bestball-roster-inner {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.bestball-player-card {
  min-width: 0;
  height: 124rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.035);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx;
  position: relative;
  overflow: hidden;
}

.bestball-player-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--tee-color, #ce9224);
}

/* 3+0：第 4 槽空白占位 — 尺寸/间距与实卡一致，不参与内容展示 */
.bestball-player-card--empty {
  background: transparent;
  border-color: transparent;
  pointer-events: none;
}

.bestball-player-card--empty::before {
  display: none;
}

/* 分组高亮（仅视觉：背景 + 边框）：同一 group 内球员共享同一高亮，区分不同组。
   不改变头像排列方式 / 昵称位置 / 布局结构。颜色循环复用 4 组调色板。 */
.bestball-player-card.bestball-group-0 {
  background: rgba(206, 146, 36, 0.12);
  border-color: rgba(206, 146, 36, 0.5);
}
.bestball-player-card.bestball-group-1 {
  background: rgba(0, 174, 239, 0.12);
  border-color: rgba(0, 174, 239, 0.5);
}
.bestball-player-card.bestball-group-2 {
  background: rgba(34, 197, 94, 0.12);
  border-color: rgba(34, 197, 94, 0.5);
}
.bestball-player-card.bestball-group-3 {
  background: rgba(220, 38, 38, 0.12);
  border-color: rgba(220, 38, 38, 0.5);
}

.bestball-player-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 9999rpx;
  border: 1rpx solid var(--tee-color, #ce9224);
  flex-shrink: 0;
  background: #000;
}

/* 左侧球员区：头像在上、昵称在下，纵向居中排列 */
.bestball-player-id {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.bestball-player-name {
  max-width: 100%;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  color: #ffffff;
  font-style: italic;
  text-transform: uppercase;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧 T 台区：独立固定右侧，不参与头像/昵称布局 */
.bestball-tee-line {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--text-secondary);
  white-space: nowrap;
}

.bestball-tee-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 9999rpx;
  background: var(--tee-color, #ce9224);
  flex-shrink: 0;
}

/* 球队最佳球位行 —— sticky 列 */
.bestball-mode-cell {
  background: #08111d !important;
}

/* 第一列横向 3 区布局：左右弹性 spacer 居中 + 中部「标题块 + 杆差」。
   缩进时杆差宽度收缩，spacer 自动回收空间，保持左右平衡、无死白。 */
/* 与个人比杆赛 player-top-line 一致：左侧标题块（自然宽度，类比头像），
   右侧 diff 包裹层 flex 撑满剩余区域并把杆差居中 → 杆差落在「中偏右」视觉位置。 */
.bestball-mode-layout {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  min-height: 152rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  /* 文案在「杆差列」左侧区域内水平居中（预留右侧固定杆差列宽度） */
  justify-content: center;
  padding-right: var(--bb-diff-col-w, 96rpx);
  box-sizing: border-box;
  gap: 0;
}

.bestball-mode-wrap {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  min-width: 0;
}

/* 球队杆差：复用 .player-diff-wrap（flex:1 + 居中 + --player-diff-opacity 淡出）。
   仅把 flex-grow 改为状态变量：未缩进=1（撑满剩余区、杆差居中→中偏右）；
   缩进时 --bestball-diff-grow→0，flex-basis:0 使其宽度塌缩为 0，标题块自动回正居中。 */
/* 杆差列：固定宽度 + 绝对定位贯穿整行高度，作为全行对齐基准。
   横向：居中于「文案列右边界~单元格右边界」之间；纵向：middle align to row height。
   所有记分行（主组 / 单人）共用同一规则 → 同一 x、同一垂直中线。 */
.bestball-mode-diff {
  position: absolute;
  right: var(--player-col-padding-x, 24rpx);
  top: 0;
  bottom: 0;
  width: var(--bb-diff-col-w, 96rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.25s ease;
}

.bestball-mode-kicker {
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 0.18em;
  color: var(--champion-gold);
  font-weight: 900;
  text-transform: uppercase;
}

.bestball-mode-main {
  font-size: var(--bestball-label-size, 30rpx);
  line-height: 1.1;
  color: #ffffff;
  font-weight: 900;
  letter-spacing: 0.08em;
  /* 左滑压缩时字体随 --bestball-label-size 缩小，但始终单行完整显示 */
  white-space: nowrap;
  text-align: center;
}

/* 2+2 / pair 组记分行 sticky 列：复刻「四人四球」原型 absolute 坐标 */
.bestball-pair-cell {
  justify-content: flex-start;
  padding-top: 0;
  padding-bottom: 0;
}

/* Legacy pair（entity 等）：content + absolute diff/tee */
.bestball-pair-cell .player-cell-content {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/*
 * fourball_best pair 视觉分区：identity | diff | T（第三段，非 absolute）
 * 不改 sticky / --player-col-width / --pair-*-shift / --bb-diff-col-w 滚动逻辑
 * 不碰 .tee-marker-strip-right（entity 旧路径）
 */
.bestball-pair-cell.bestball-pair-cell--split {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: flex-start;
  box-sizing: border-box;
  /* T 贴浅色 sticky 右缘；左 padding 保留给头像坐标系 */
  padding-right: 0;
  /* 取消 width/padding transition，避免横滑时 sticky 与成绩区脱节 */
  transition: none;
}

/* 2+2 / 4+0：整段 sticky 身份区统一身份蓝（identity/diff 同色，diff 不再单独铺底） */
.scoreboard-scroll.is-fourball-pair22 .bestball-pair-cell--split,
.scoreboard-scroll.is-fourball-team-layout .bestball-pair-cell--split {
  background: var(--score-header-identity);
  /* 交叉蓝：右缘增强 + 身份区底边（头像/diff/T）；成绩格仍用 border-color */
  box-shadow:
    inset -1px 0 0 var(--score-header-intersection),
    inset 0 -1px 0 var(--score-header-intersection);
}

/* 2+2 / 4+0：整列 sticky 同步取消宽过渡（HOLE/PAR 左列共用 --player-col-width） */
.scoreboard-scroll.is-fourball-pair22 .sticky-col,
.scoreboard-scroll.is-fourball-team-layout .sticky-col {
  transition: none;
}

.scoreboard-scroll.is-fourball-pair22 .player-cell,
.scoreboard-scroll.is-fourball-team-layout .player-cell {
  transition: none;
}

.bestball-pair-cell--split .pair-identity {
  flex: 1 1 auto;
  min-width: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  /* 防止第二头像/transform 画进 diff/T */
  overflow: hidden;
  z-index: 0;
}

.bestball-pair-cell--split .pair-diff {
  position: relative;
  flex: 0 0 auto;
  width: var(--bb-diff-col-w, 96rpx);
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: var(--player-diff-opacity, 1);
  overflow: hidden;
  transition: none;
  box-sizing: border-box;
  z-index: 1;
}

.bestball-pair-cell--split .pair-diff .player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

/* fourball 2+2 / 4+0：pair-diff 宽跟 --bb-diff-col-w（阶段2 96→0）；背景继承 --split */
.scoreboard-scroll.is-fourball-pair22 .bestball-pair-cell--split .pair-diff,
.scoreboard-scroll.is-fourball-team-layout .bestball-pair-cell--split .pair-diff {
  width: var(--bb-diff-col-w, 96rpx);
  min-width: 0;
  max-width: var(--bb-diff-col-w, 96rpx);
  flex: 0 0 var(--bb-diff-col-w, 96rpx);
}

.scoreboard-scroll.is-fourball-pair22 .bestball-pair-cell--split .pair-diff .player-diff-score,
.scoreboard-scroll.is-fourball-team-layout .bestball-pair-cell--split .pair-diff .player-diff-score {
  white-space: nowrap;
}

/* 独立 T 段：显式取消任何 absolute/right 残留，固定在 flex 第三段 */
.bestball-pair-cell--split .pair-tee {
  position: static;
  top: auto;
  right: auto;
  bottom: auto;
  left: auto;
  flex: 0 0 8rpx;
  width: 8rpx;
  min-width: 8rpx;
  max-width: 8rpx;
  height: auto;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 0;
  z-index: 2;
  box-sizing: border-box;
}

/* 2+2 / 4+0：T 宽对齐 game-single track-lead-tee（6rpx）；保留满高 tee-half */
.scoreboard-scroll.is-fourball-pair22 .bestball-pair-cell--split .pair-tee,
.scoreboard-scroll.is-fourball-team-layout .bestball-pair-cell--split .pair-tee {
  flex: 0 0 6rpx;
  width: 6rpx;
  min-width: 6rpx;
  max-width: 6rpx;
}

.bestball-pair-cell--split .pair-tee .tee-half {
  position: static;
  top: auto;
  right: auto;
  bottom: auto;
  left: auto;
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
}

/* 4+0：四人 T 各占 25% 高度（flex 均分） */
.bestball-pair-cell--split .pair-tee.pair-tee--quad .tee-half {
  flex: 1 1 25%;
  max-height: 25%;
}

/* 4+0：identity 仅 TEAM SCORE + label（teamMembers 只进 tee） */
.bestball-pair-cell--split .pair-identity--team {
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.bestball-pair-cell--split .pair-identity--team .bestball-mode-wrap {
  width: auto;
  max-width: 100%;
  margin: 0 auto;
  min-width: 0;
  padding: 0 4rpx;
  box-sizing: border-box;
  transform: translateX(-3rpx);
}

.bestball-pair-cell--split .pair-identity--team .bestball-mode-main {
  overflow: hidden;
  text-overflow: ellipsis;
}

.paired-avatars {
  position: relative;
  height: 104rpx;
  width: 100%;
}

/* swipe indent：头像+昵称组随 --pair-container-shift 居中（杆差列不参与平移） */
.pair-avatar-group {
  position: relative;
  height: 104rpx;
  width: 100%;
  transform: translateX(var(--pair-container-shift, 0rpx));
  transition: transform 0.1s linear;
}

/* pair22：整体再左移 8rpx（叠在 container-shift 上；不改 second-shift / 半遮挡） */
.scoreboard-scroll.is-fourball-pair22 .pair-avatar-group {
  transform: translateX(calc(var(--pair-container-shift, 0rpx) - 8rpx));
}

.paired-avatars .avatar-with-diff {
  position: absolute;
  top: 0;
  width: 80rpx;
  transition: transform 0.1s linear;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

/* pair22：头像中心 Y 对齐 game-single（在 104 容器内下移 12） */
.scoreboard-scroll.is-fourball-pair22 .paired-avatars .avatar-with-diff {
  top: 12rpx;
}

.paired-avatars .avatar-with-diff:nth-child(1) {
  left: 24rpx;
  z-index: 10;
}

.paired-avatars .avatar-with-diff:nth-child(2) {
  left: 128rpx;
  z-index: 5;
}

.paired-avatars .player-avatar-img {
  width: 72rpx;
  height: 72rpx;
}

/* pair22：双头像与 G1 单头像同为 80；.avatar-with-diff 已是 80 宽可容纳 */
.scoreboard-scroll.is-fourball-pair22 .paired-avatars .player-avatar-img {
  width: 80rpx;
  height: 80rpx;
}

/*
 * 2+1 single：挂在 pair-avatar-group 内（已有 container-shift−8）。
 * 组合中心随第二头像 --pair-second-shift 左移：center = 116 + shift/2 → left = 76 + shift/2
 * （与双头像同一套 CSS 变量，无第二套 scroll 几何）
 */
.scoreboard-scroll.is-fourball-pair22 .pair-identity--single .avatar-with-diff--single {
  left: calc(76rpx + var(--pair-second-shift, 0rpx) * 0.5);
  z-index: 10;
}

/* 昵称与头像同坐标系：paired-names 补上与 group 相同的 −8，left 跟 second-shift */
.scoreboard-scroll.is-fourball-pair22 .pair-identity--single .paired-names {
  transform: translateX(calc(var(--pair-container-shift, 0rpx) - 8rpx));
}

.scoreboard-scroll.is-fourball-pair22 .pair-identity--single .player-name-line--single {
  left: calc(76rpx + var(--pair-second-shift, 0rpx) * 0.5);
  width: 80rpx;
  max-width: 80rpx;
}

/* entity 等仍把 diff 叠在头像区右侧 */
.paired-avatars .player-diff-wrap {
  position: absolute;
  right: 0;
  top: 20rpx;
  left: auto;
  width: var(--bb-diff-col-w, 96rpx);
  flex: none;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  overflow: visible;
  opacity: var(--player-diff-opacity, 1);
  transition: opacity 0.1s, width 0.25s ease;
}

.paired-avatars .player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.paired-names {
  position: relative;
  height: 28rpx;
  width: 100%;
  transform: translateX(var(--pair-container-shift, 0rpx));
  transition: transform 0.1s linear;
}

.paired-names .player-name-line {
  position: absolute;
  top: 0;
  width: 80rpx;
  max-width: 80rpx;
  transition: transform 0.1s linear;
  margin: 0;
  text-align: center;
  font-size: 18rpx;
}

.paired-names .player-name-line:nth-child(1) {
  left: 24rpx;
}

.paired-names .player-name-line:nth-child(2) {
  left: 128rpx;
}

.tee-marker-strip-right {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  display: flex;
  flex-direction: column;
}

.tee-marker-strip-right .tee-half {
  flex: 1;
  width: 100%;
}

/* 3+1 单人记分行 sticky 列：复用个人比杆赛 .player-card 结构，
   但在记分行内整体垂直 + 水平居中，使头像/昵称/杆差与「主组记分行」及 HOLE 格共享同一视觉中线。
   仅作用于 fourball_best 的单人行，标准个人比杆赛球员行不受影响。 */
.bestball-single-cell {
  justify-content: center;
  padding-top: 0;
  padding-bottom: 0;
}

.bestball-single-cell .player-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 预留右侧固定杆差列宽度，头像/昵称在左侧区域居中（与主组文案同一中线） */
  padding-right: var(--bb-diff-col-w, 96rpx);
  box-sizing: border-box;
}

.bestball-single-cell .player-top-line {
  justify-content: center;
}

/* 单人行杆差：与主组共用同一「固定宽度 + 绝对定位贯穿整行」的杆差列 → 双轴严格对齐 */
.bestball-single-cell .player-diff-wrap {
  position: absolute;
  right: var(--player-col-padding-x, 24rpx);
  top: 0;
  bottom: 0;
  width: var(--bb-diff-col-w, 96rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* BRIGHT 模式覆盖（与原型 body.bright-mode 一致） */
.score-page.bright-mode .bestball-roster-strip {
  background: linear-gradient(90deg, rgba(0, 45, 98, 0.05), #f8fafc, rgba(206, 146, 36, 0.08));
  border-bottom-color: var(--border-color);
}

.score-page.bright-mode .bestball-player-card {
  /* 轻微压灰/压蓝（仅 BRIGHT）：让白色 T 台线/分隔更清晰，球员行不再融入白底 */
  background: #f2f5f9;
  border-color: var(--border-color);
}

.score-page.bright-mode .bestball-player-name,
.score-page.bright-mode .bestball-mode-main {
  color: var(--pga-blue);
}

.score-page.bright-mode .bestball-mode-cell {
  background: var(--bg-card) !important;
}

/* ── Stroke Entity 记分行（Patch-02C1 展示专用，不覆盖 player-*） ── */
.entity-sticky-cell {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx var(--player-col-padding-x, 24rpx);
  box-sizing: border-box;
}

.entity-card {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.entity-top-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.entity-name {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 0.04em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entity-member {
  display: block;
  font-size: 20rpx;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.62);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entity-diff-wrap {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
}

.entity-diff-score {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.score-page.bright-mode .entity-name {
  color: var(--pga-blue);
}

.score-page.bright-mode .entity-member {
  color: rgba(0, 45, 98, 0.55);
}

/* ===== G5 个人比洞：胜洞走势行（仅 isG5MatchPlay 渲染，不改通用球员行） ===== */
.match-status-row {
  height: 100rpx;
  min-height: 100rpx;
  background: linear-gradient(
    90deg,
    rgba(206, 146, 36, 0.08),
    rgba(0, 45, 98, 0.14),
    rgba(206, 146, 36, 0.06)
  );
}

.match-status-sticky {
  justify-content: center;
  background: #08111d;
  height: 100rpx;
  box-shadow: inset -1px 0 0 var(--border-color);
}

.match-label-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  width: 100%;
  padding: 0 var(--player-col-padding-x, 24rpx);
  box-sizing: border-box;
}

.match-label-kicker {
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 0.18em;
  font-weight: 900;
  color: #ce9224;
  text-transform: uppercase;
}

.match-label-main {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: 0.06em;
  white-space: nowrap;
}

.match-status-cell {
  height: 100rpx;
  position: relative;
  overflow: hidden;
}

.match-status-cell--tot,
.match-status-summary {
  background: rgba(0, 45, 98, 0.22);
}

.match-cell-inner {
  min-height: 72rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  z-index: 1;
}

.match-win-line {
  position: absolute;
  left: 0;
  right: 0;
  width: 100%;
  height: 16rpx;
  z-index: 2;
  pointer-events: none;
}

/* 与详情页得分榜一致：红 #E31837 / 蓝 #004B87 */
.match-win-line--a {
  top: 0;
  background: #E31837;
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}

.match-win-line--b {
  bottom: 0;
  background: #004B87;
  clip-path: polygon(50% 0, 0 100%, 100% 100%);
}

/* 原型 FINAL 角标 */
.match-summary-label {
  font-size: 16rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0.1em;
  color: #ce9224;
  text-transform: uppercase;
  white-space: nowrap;
}

.match-cumulative {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 900;
  font-style: italic;
  color: #ce9224;
  letter-spacing: -0.02em;
  white-space: nowrap;
}

/* 与详情页得分榜一致：红方领先红 / 蓝方领先蓝 / TIED 灰 */
.match-cumulative.team-a-lead {
  color: #E31837;
}

.match-cumulative.team-b-lead {
  color: #004B87;
}

.match-cumulative.all-square {
  color: #6b7280;
}

.score-page.bright-mode .match-status-row {
  background: #ffffff;
}

.score-page.bright-mode .match-status-sticky {
  background: #f8fafc;
  box-shadow: inset -1px 0 0 #e2e8f0;
}

.score-page.bright-mode .match-label-main {
  color: #002d62;
}

.score-page.bright-mode .match-status-cell--tot,
.score-page.bright-mode .match-status-summary {
  background: rgba(0, 45, 98, 0.04);
}

.score-page.bright-mode .match-summary-label {
  color: #ce9224;
}

