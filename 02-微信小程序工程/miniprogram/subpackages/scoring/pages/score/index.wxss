}

/* 胜洞走势标题 overlay：初始覆盖头像+diff+T（230rpx），与 HOLE/PAR 共用横移 style */
.scoreboard-shell--match-play .match-play-status-title-normal {
  position: absolute;
  /* head 112 + par 72 + Side A 156 */
  left: 0;
  top: 340rpx;
