  border-radius: 45% 55% 50% 50% / 8% 10% 85% 80%;
  transform-origin: top center;
  animation: player-action-tomato-juice-stream 3.2s cubic-bezier(0.33, 0.12, 0.25, 1) forwards;
}
.player-action-tomato-juice__stream.st0 {
  left: 6%;
  width: 17%;
  background: linear-gradient(
    180deg,
    rgba(240, 55, 40, 0.9) 0%,
    rgba(200, 28, 22, 0.62) 42%,
    rgba(160, 16, 14, 0.28) 82%,
    transparent 100%
  );
  animation-delay: 0.04s;
  animation-duration: 3.05s;
}
.player-action-tomato-juice__stream.st1 {
  left: 22%;
  width: 11%;
  top: 8%;
  background: linear-gradient(
    180deg,
    rgba(220, 40, 30, 0.72) 0%,
    rgba(175, 20, 16, 0.42) 50%,
    rgba(140, 12, 10, 0.18) 88%,
    transparent 100%
  );
  animation-delay: 0.18s;
  animation-duration: 3.45s;
  animation-name: player-action-tomato-juice-stream-slow;
}
.player-action-tomato-juice__stream.st2 {
  left: 34%;
  width: 23%;
  top: 2%;
  background: linear-gradient(
    180deg,
    rgba(255, 70, 45, 0.95) 0%,
    rgba(210, 32, 24, 0.7) 35%,
    rgba(170, 18, 15, 0.38) 75%,
    rgba(130, 10, 10, 0.12) 92%,
    transparent 100%
  );
  animation-delay: 0s;
  animation-duration: 2.9s;
}
.player-action-tomato-juice__stream.st3 {
  left: 58%;
  width: 9%;
  top: 10%;
  background: linear-gradient(
    180deg,
    rgba(200, 30, 22, 0.65) 0%,
    rgba(160, 16, 14, 0.35) 55%,
    transparent 100%
  );
  animation-delay: 0.24s;
  animation-duration: 3.55s;
  animation-name: player-action-tomato-juice-stream-slow;
}
.player-action-tomato-juice__stream.st4 {
  left: 68%;
  width: 19%;
  top: 6%;
  background: linear-gradient(
    180deg,
    rgba(235, 50, 38, 0.85) 0%,
    rgba(185, 24, 18, 0.55) 40%,
    rgba(145, 12, 12, 0.22) 80%,
    transparent 100%
  );
  animation-delay: 0.1s;
  animation-duration: 3.15s;
}

/* 层3：途中小滴（全程下移） */
.player-action-tomato-juice__drop {
  position: absolute;
  width: 7%;
  height: 7%;
  border-radius: 50% 45% 55% 48%;
  background: radial-gradient(circle at 40% 35%, rgba(255, 90, 55, 0.9) 0%, rgba(180, 22, 18, 0.55) 55%, transparent 78%);
  opacity: 0;
  animation: player-action-tomato-juice-drop 3.4s ease-in forwards;
}
.player-action-tomato-juice__drop.dp0 {
  left: 14%;
  top: 18%;
  width: 6%;
  height: 8%;
  animation-delay: 0.35s;
}
.player-action-tomato-juice__drop.dp1 {
  left: 40%;
  top: 14%;
  width: 9%;
  height: 9%;
  animation-delay: 0.22s;
}
.player-action-tomato-juice__drop.dp2 {
  left: 52%;
  top: 24%;
  width: 5%;
  height: 6%;
  animation-delay: 0.55s;
  background: radial-gradient(circle at 45% 40%, rgba(200, 30, 22, 0.75) 0%, rgba(140, 12, 10, 0.35) 60%, transparent 80%);
}
.player-action-tomato-juice__drop.dp3 {
  left: 72%;
  top: 20%;
  width: 7%;
  height: 7%;
  animation-delay: 0.42s;
}
.player-action-tomato-juice__drop.dp4 {
  left: 30%;
  top: 32%;
  width: 5%;
  height: 5%;
  animation-delay: 0.7s;
  background: radial-gradient(circle at 40% 35%, rgba(220, 45, 35, 0.7) 0%, transparent 72%);
}

/* 层4：底部滴落 —— 汁流到脚后往下滴出 */
.player-action-tomato-juice__bottom-drip {
  position: absolute;
  bottom: -4%;
  width: 10%;
  height: 0;
  border-radius: 40% 40% 55% 55%;
  background: linear-gradient(
    180deg,
    rgba(220, 40, 30, 0.75) 0%,
    rgba(170, 18, 15, 0.45) 55%,
    transparent 100%
  );
  opacity: 0;
  animation: player-action-tomato-juice-bottom-drip 2.2s ease-in forwards;
}
.player-action-tomato-juice__bottom-drip.bd0 {
  left: 22%;
  width: 12%;
  animation-delay: 1.35s;
}
.player-action-tomato-juice__bottom-drip.bd1 {
  left: 44%;
  width: 16%;
  animation-delay: 1.15s;
  background: linear-gradient(
    180deg,
    rgba(240, 55, 40, 0.85) 0%,
    rgba(185, 22, 18, 0.5) 50%,
    transparent 100%
  );
}
.player-action-tomato-juice__bottom-drip.bd2 {
  left: 68%;
  width: 11%;
  animation-delay: 1.5s;
}

/* 层5：局部溅点 */
.player-action-tomato-juice__speck {
  position: absolute;
  border-radius: 50%;
  opacity: 0;
  animation: player-action-tomato-juice-speck 4.5s ease forwards;
}
.player-action-tomato-juice__speck.sk0 {
  left: 8%;
  top: 42%;
  width: 12%;
  height: 10%;
  background: radial-gradient(ellipse at 50% 45%, rgba(190, 25, 20, 0.7) 0%, transparent 70%);
  animation-delay: 0.2s;
}
.player-action-tomato-juice__speck.sk1 {
  left: 78%;
  top: 55%;
  width: 10%;
  height: 9%;
  background: radial-gradient(ellipse at 40% 50%, rgba(170, 18, 15, 0.6) 0%, transparent 68%);
  animation-delay: 0.35s;
}
.player-action-tomato-juice__speck.sk2 {
  left: 44%;
  top: 72%;
  width: 14%;
  height: 11%;
  background: radial-gradient(ellipse at 50% 40%, rgba(200, 30, 22, 0.55) 0%, transparent 72%);
  animation-delay: 0.85s;
}

/* 爆裂瞬间 → 头顶糊住 → 慢淡 */
@keyframes player-action-tomato-juice-impact {
  0% {
    opacity: 0;
    transform: scale(0.4);
  }
  5% {
    opacity: 1;
    transform: scale(1.15);
  }
  12% {
    opacity: 0.95;
    transform: scale(1);
  }
  45% {
    opacity: 0.55;
  }
  70% {
    opacity: 0.28;
  }
  100% {
    opacity: 0;
    transform: scale(1.02);
  }
}
@keyframes player-action-tomato-juice-crown {
  0% {
    opacity: 0;
    transform: scaleX(0.7) scaleY(0.5);
  }
  6% {
    opacity: 0.95;
    transform: scaleX(1.05) scaleY(1.1);
  }
  14% {
    opacity: 0.9;
    transform: scaleX(1) scaleY(1);
  }
  55% {
    opacity: 0.72;
  }
  78% {
    opacity: 0.4;
  }
  100% {
    opacity: 0;
    transform: scaleX(1) scaleY(0.85);
  }
}
/* 主流：拉长 → 整段下移到脚 → 淡出 */
@keyframes player-action-tomato-juice-stream {
  0% {
    height: 0;
    opacity: 0.45;
    transform: translateY(0);
  }
  18% {
    height: 48%;
    opacity: 0.95;
    transform: translateY(0);
  }
  38% {
    height: 78%;
    opacity: 0.88;
    transform: translateY(8%);
  }
  58% {
    height: 62%;
    opacity: 0.7;
    transform: translateY(38%);
  }
  78% {
    height: 42%;
    opacity: 0.42;
    transform: translateY(72%);
  }
  100% {
    height: 28%;
    opacity: 0;
    transform: translateY(105%);
  }
}
/* 细流更慢、更拖沓 */
@keyframes player-action-tomato-juice-stream-slow {
  0% {
    height: 0;
    opacity: 0.4;
    transform: translateY(0);
  }
  22% {
    height: 40%;
    opacity: 0.85;
    transform: translateY(0);
  }
  45% {
    height: 70%;
    opacity: 0.75;
    transform: translateY(12%);
  }
  68% {
    height: 50%;
    opacity: 0.55;
    transform: translateY(48%);
  }
  88% {
    height: 32%;
    opacity: 0.28;
    transform: translateY(88%);
  }
  100% {
    height: 20%;
    opacity: 0;
    transform: translateY(115%);
  }
}
@keyframes player-action-tomato-juice-drop {
  0% {
    opacity: 0;
    transform: translateY(0) scale(0.55);
  }
  8% {
    opacity: 0.95;
    transform: translateY(4%) scale(1);
  }
  55% {
    opacity: 0.7;
    transform: translateY(85%) scale(0.9);
  }
  85% {
    opacity: 0.35;
    transform: translateY(130%) scale(0.7);
  }
  100% {
    opacity: 0;
    transform: translateY(160%) scale(0.4);
  }
}
@keyframes player-action-tomato-juice-bottom-drip {
  0% {
    height: 0;
    opacity: 0;
    transform: translateY(0);
  }
  15% {
    height: 18%;
    opacity: 0.9;
    transform: translateY(0);
  }
  45% {
    height: 32%;
    opacity: 0.75;
    transform: translateY(10%);
  }
  75% {
    height: 28%;
    opacity: 0.4;
    transform: translateY(35%);
  }
  100% {
    height: 16%;
    opacity: 0;
    transform: translateY(70%);
  }
}
@keyframes player-action-tomato-juice-speck {
  0% {
    opacity: 0;
    transform: scale(0.4);
  }
  10% {
    opacity: 0.9;
    transform: scale(1.1);
  }
  40% {
    opacity: 0.7;
    transform: scale(1);
  }
  75% {
    opacity: 0.35;
  }
  100% {
    opacity: 0;
    transform: scale(0.95);
  }
}
/* 前大半段保持可见，最后慢慢淡出（避免 0→1 白闪） */
@keyframes player-action-tomato-juice-fade {
  0% {
    opacity: 0.4;
  }
  6% {
    opacity: 1;
  }
  68% {
    opacity: 1;
  }
  85% {
    opacity: 0.55;
  }
  100% {
    opacity: 0;
  }
}

/* Demo：撞击爆裂碎裂（头像中心局部，非页面闪光） */
.player-action-tomato-burst {
  position: fixed;
