  background: var(--discussion-bubble);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--champion-gold);
  font-size: 32rpx;
}

.discussion-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--discussion-border);
  background: var(--discussion-bar);
}

.discussion-input {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1px solid var(--discussion-border);
  background: var(--discussion-input-bg);
  color: var(--text-primary);
  padding: 0 24rpx;
  font-size: 26rpx;
}

.discussion-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  flex-shrink: 0;
  font-size: 36rpx;
}

.discussion-send {
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: #002d62;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* ===== 更多功能面板（与中间页 M 按钮 bottom-sheet 规范一致） ===== */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 150; }
.bottom-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; color: var(--tour-blue); border-radius: 80rpx 80rpx 0 0; overflow: hidden; z-index: 180; box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35); padding-bottom: env(safe-area-inset-bottom); }
.sheet-handle { width: 96rpx; height: 8rpx; border-radius: 999rpx; background: #e5e7eb; margin: 24rpx auto 40rpx; }
.feature-section { padding: 0 48rpx 24rpx; }
.feature-section--menu { max-height: 62vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
/* Sheet Header 统一：左对齐主标题 + 副标题 */
.feature-section-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin: 0 0 24rpx;
  padding: 0;
  color: var(--golf-blue);
}
.fst-main {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--golf-blue);
  line-height: 1.3;
}
.fst-sub {
  font-style: normal;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary, #9ca3af);
  letter-spacing: 0.08em;
  line-height: 1.3;
}
.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 24rpx; row-gap: 32rpx; }
.feature-item { display: flex; flex-direction: column; align-items: center; min-height: 156rpx; }
.feature-item.is-disabled {
  opacity: 0.46;
}
.feature-icon { width: 112rpx; height: 112rpx; border-radius: 24rpx; background: var(--tour-blue); color: var(--champion-gold); display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; font-size: 44rpx; box-shadow: 0 12rpx 24rpx rgba(0, 45, 98, 0.18); }
.feature-icon.danger { background: #ff5722; color: #fff; }
.feature-icon.warning { background: #ffc107; color: var(--tour-blue); }
.feature-label { color: var(--tour-blue); font-size: 20rpx; line-height: 1.2; font-weight: 800; text-align: center; }
.feature-item--empty { visibility: hidden; pointer-events: none; }
.sheet-cancel-wrap { padding: 4rpx 48rpx 48rpx; }
/* Score Sheet 主按钮规范：88 / 12 / 蓝底白字 */
.sheet-cancel-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-weight: 900;
  font-size: 24rpx;
  letter-spacing: 0.18em;
  box-sizing: border-box;
}


/* ===== 显示设置 sheet（对齐 Hub/M · detail .style-sheet） ===== */
.style-sheet { position: fixed; left: 0; right: 0; bottom: 0; transform: translateY(100%); background: var(--bg-card); color: var(--text-primary); border-radius: 48rpx 48rpx 0 0; border: 1px solid var(--border); z-index: 260; transition: transform 0.25s ease; box-shadow: 0 -36rpx 80rpx rgba(0, 0, 0, 0.35); padding-bottom: max(40rpx, env(safe-area-inset-bottom)); }
.style-sheet.active { transform: translateY(0); }
.style-sheet__head { display: flex; align-items: flex-start; justify-content: space-between; padding: 36rpx 40rpx 8rpx; }
.style-sheet__title { display: block; font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.style-sheet__sub { display: block; font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; }
.style-sheet__close { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; }
.style-section { padding: 36rpx 40rpx 0; }
.style-section-title { display: block; font-size: 24rpx; font-weight: 700; color: var(--text-secondary); margin-bottom: 20rpx; }
.style-option-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.style-option { height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 12rpx; border: 1px solid var(--border-hover); background: var(--bg-subtle); color: var(--text-secondary); font-size: 26rpx; font-weight: 700; }
.style-option.active { border-color: var(--champion-gold); background: var(--golf-blue); color: #fff; box-shadow: inset 0 -6rpx 0 var(--champion-gold); }
.style-done-wrap { padding: 48rpx 40rpx 0; }
.style-done-btn { height: 88rpx; line-height: 88rpx; text-align: center; background: var(--golf-blue); color: #fff; border-radius: 12rpx; font-weight: 700; font-size: 28rpx; }

/* Bottom Sheet 通用 Dark：背景/标题/辅助字/边框走页面 token，避免白底 */
.score-page.dark-mode .bottom-sheet {
  background: var(--bg-card);
  color: var(--text-primary);
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.55);
}
.score-page.dark-mode .sheet-handle {
  background: var(--border-color);
}
.score-page.dark-mode .feature-section-title,
.score-page.dark-mode .fst-main {
  color: var(--text-primary);
}
.score-page.dark-mode .fst-sub {
  color: var(--text-secondary);
}
.score-page.dark-mode .feature-label {
  color: var(--text-primary);
}
/* Dark 主按钮保持蓝底白字，不受文字 token 影响 */
.score-page.dark-mode .sheet-cancel-btn {
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
}

.score-page.dark-mode .edit-tee-row {
  border-bottom-color: var(--border-color);
}
.score-page.dark-mode .edit-tee-row__name {
  color: var(--text-primary);
}

/* ===== 编辑类 Sheet 统一：修改T台 / 修改起始洞（Header=fst，Footer/按钮同规） ===== */
.edit-tee-sheet,
.start-hole-sheet {
  z-index: 190;
  padding: 0 48rpx 32rpx;
}
.edit-tee-sheet {
  max-height: 78vh;
}
.edit-tee-sheet__title,
.start-hole-sheet__title {
  margin-bottom: 24rpx;
}
.edit-tee-sheet__list {
  max-height: 52vh;
  margin-bottom: 24rpx;
}
.edit-tee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.28);
}
.edit-tee-row:last-child { border-bottom: none; }
.edit-tee-row__player {
  width: 120rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.edit-tee-row__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.25);
}
.edit-tee-row__name {
  max-width: 120rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.edit-tee-row__dots {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 34rpx;
  padding-right: 4rpx;
}
/* 扩大可点区域，视觉圆点仍居中 */
.edit-tee-dot-hit {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.edit-tee-dot {
  width: 23rpx;
  height: 23rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  opacity: 1;
  transition: width 0.15s ease, height 0.15s ease;
}
/* BRIGHT：白T需边框才可辨认 */
.edit-tee-dot--white {
  border-color: rgba(100, 116, 139, 0.65);
}
/* DARK：黑T需边框才可辨认（亮色模式黑T本身对比足够，边框保持淡） */
.edit-tee-dot--black {
  border-color: transparent;
}
.edit-tee-dot--selected {
  width: 54rpx;
  height: 54rpx;
  opacity: 1;
  transform: none;
  box-shadow: none;
}
.edit-tee-dot--selected.edit-tee-dot--white {
  border-color: rgba(100, 116, 139, 0.65);
}
.edit-tee-dot--selected.edit-tee-dot--black {
  border-color: transparent;
}
.score-page.dark-mode .edit-tee-dot--white {
  border-color: rgba(226, 232, 240, 0.7);
}
.score-page.dark-mode .edit-tee-dot--black {
  border-color: rgba(226, 232, 240, 0.55);
}
.score-page.dark-mode .edit-tee-dot--selected.edit-tee-dot--white {
  border-color: rgba(226, 232, 240, 0.7);
}
.score-page.dark-mode .edit-tee-dot--selected.edit-tee-dot--black {
  border-color: rgba(226, 232, 240, 0.55);
}

.start-hole-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
  justify-items: center;
}
/* 未选中：蓝底白字圆钮；选中：金底白字（真实洞号 A1–B9） */
.start-hole-cell {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  border: none;
  background: #002d62;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.start-hole-cell--active {
  background: #ce9224;
  border: none;
  color: #fff;
}
.score-page.dark-mode .start-hole-cell {
  background: #002d62;
  border: none;
  color: #fff;
}
.score-page.dark-mode .start-hole-cell--active {
  background: #ce9224;
  border: none;
  color: #fff;
}

/* 编辑类 Footer + 取消/确认（确认继承主按钮；取消描边次级） */
.edit-tee-sheet__footer,
.start-hole-sheet__footer {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0 16rpx;
  flex-shrink: 0;
}
.edit-tee-sheet__btn-cancel,
.edit-tee-sheet__btn-confirm,
.start-hole-sheet__btn-cancel,
.start-hole-sheet__btn-confirm {
  flex: 1;
}
.edit-tee-sheet__btn-cancel,
.start-hole-sheet__btn-cancel {
  background: transparent;
  color: var(--text-primary, #111827);
  border: 2rpx solid rgba(148, 163, 184, 0.45);
  font-weight: 900;
  font-size: 24rpx;
}
.edit-tee-sheet__btn-confirm,
.start-hole-sheet__btn-confirm {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
}
.score-page.dark-mode .edit-tee-sheet__btn-cancel,
.score-page.dark-mode .start-hole-sheet__btn-cancel {
  background: transparent;
  color: var(--text-primary);
  border-color: var(--border-color);
}
.score-page.dark-mode .edit-tee-sheet__btn-confirm,
.score-page.dark-mode .start-hole-sheet__btn-confirm {
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
}

/* More / 编辑 Sheet — DARK：顶蓝线 + handle（通用 bottom-sheet） */
.bottom-sheet--more-menu { overflow: hidden; }
.sheet-top-accent { display: none; }
.score-page.dark-mode .bottom-sheet .sheet-top-accent {
  display: block;
  width: 100%;
  height: 3px;
  background: #002d62;
  flex-shrink: 0;
}
.score-page.dark-mode .bottom-sheet--more-menu .feature-section-title,
.score-page.dark-mode .bottom-sheet--more-menu .feature-label { color: var(--text-primary); }
.score-page.dark-mode .bottom-sheet--more-menu .fst-sub { color: var(--text-secondary); }
.score-page.dark-mode .bottom-sheet--more-menu .feature-item:active { opacity: 0.72; }

.sheet-overlay--half { z-index: 210; }

/* Demo：球员头像互动面板 */
.sheet-overlay--player-action { z-index: 220; }
.bottom-sheet--player-action { z-index: 230; }
.player-action-sheet {
  padding: 8rpx 48rpx 32rpx;
}
.player-action-sheet__profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
}
.player-action-sheet__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e5e7eb;
  border: 4rpx solid rgba(0, 45, 98, 0.12);
  box-sizing: border-box;
}
.player-action-sheet__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
}
.player-action-sheet__name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--golf-blue, #002d62);
  line-height: 1.25;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.player-action-sheet__gender {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary, #9ca3af);
  letter-spacing: 0.06em;
}
.player-action-sheet__actions {
  margin-top: 40rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 28rpx;
}
.player-action-sheet__tomato,
.player-action-sheet__bucket,
.player-action-sheet__egg,
.player-action-sheet__flower {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}
.player-action-sheet__tomato:active,
.player-action-sheet__bucket:active,
.player-action-sheet__egg:active,
.player-action-sheet__flower:active {
  opacity: 0.72;
  transform: scale(0.96);
}
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__name {
  color: var(--text-primary);
}
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__gender {
  color: var(--text-secondary);
}
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__avatar {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.08);
}
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__tomato,
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__bucket,
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__egg,
.score-page.dark-mode .bottom-sheet--player-action .player-action-sheet__flower {
  background: rgba(255, 255, 255, 0.08);
}

/* Demo：🍅 飞行动画层 */
.player-action-tomato-fly {
  position: fixed;
  z-index: 400;
  width: 28px;
  height: 28px;
  margin: 0;
  padding: 0;
  font-size: 26px;
  line-height: 28px;
  text-align: center;
  pointer-events: none;
  /* 不用 will-change：微信端易整页合成闪白 */
}
/* 飞行轨迹由 JS 弧线驱动（约 0.8s），不再用直线 transition */
.player-action-tomato-fly.is-flying {
  transition: none;
}

/* Demo：🥚 连击飞入（transition 时长由 inline style 控制） */
.player-action-egg-fly {
  position: fixed;
  z-index: 405;
  width: 30px;
  height: 30px;
  margin: 0;
  padding: 0;
  font-size: 28px;
  line-height: 30px;
  text-align: center;
  pointer-events: none;
}
.player-action-egg-fly.is-finale {
  z-index: 406;
}

/* Demo：🥚 累积蛋清/蛋黄 — fixed 锚定头像矩形（left/top/w/h 由 JS） */
.player-action-egg-splat {
  position: fixed;
  z-index: 398;
  border-radius: 50%;
  pointer-events: none;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
  /* 禁止 filter / drop-shadow / blur / will-change：微信端易留合成白块 */
}
.player-action-egg-splat__white,
.player-action-egg-splat__stream,
.player-action-egg-splat__yolk,
.player-action-egg-splat__drop,
.player-action-egg-splat__finale-white,
.player-action-egg-splat__finale-stream,
.player-action-egg-splat__finale-yolk,
.player-action-egg-splat__finale-drip {
  position: absolute;
  pointer-events: none;
}

/*
 * 结束清理阶段：动画 forwards 常停在高 opacity + translateY。
 * 先卸合成层，再由 JS 延迟 ~160ms wx:if 销毁，避免乳白色块残留。
 */
.player-action-egg-splat.is-hiding {
  opacity: 0 !important;
  visibility: hidden !important;
}
.player-action-egg-splat.is-hiding .player-action-egg-splat__white,
.player-action-egg-splat.is-hiding .player-action-egg-splat__stream,
.player-action-egg-splat.is-hiding .player-action-egg-splat__yolk,
.player-action-egg-splat.is-hiding .player-action-egg-splat__drop,
.player-action-egg-splat.is-hiding .player-action-egg-splat__finale-white,
.player-action-egg-splat.is-hiding .player-action-egg-splat__finale-stream,
.player-action-egg-splat.is-hiding .player-action-egg-splat__finale-yolk,
.player-action-egg-splat.is-hiding .player-action-egg-splat__finale-drip {
  opacity: 0 !important;
  visibility: hidden !important;
  animation: none !important;
  transform: none !important;
  background: transparent !important;
}

/* 蛋清斑块（半透明乳白，挂载后淡入并残留） */
.player-action-egg-splat__white {
  border-radius: 48% 52% 45% 55%;
  background: radial-gradient(
    ellipse at 45% 40%,
    rgba(255, 252, 240, 0.72) 0%,
    rgba(245, 240, 220, 0.35) 55%,
    transparent 78%
  );
  opacity: 0.85;
  animation: player-action-egg-fade-in 0.28s ease forwards;
}
.player-action-egg-splat__white.w0 {
  left: 18%;
  top: 6%;
  width: 42%;
  height: 28%;
}
.player-action-egg-splat__white.w1 {
  left: 48%;
  top: 10%;
  width: 36%;
  height: 24%;
  border-radius: 55% 45% 50% 48%;
}
.player-action-egg-splat__white.w2 {
  left: 10%;
  top: 28%;
  width: 34%;
  height: 30%;
}
.player-action-egg-splat__white.w3 {
  left: 52%;
  top: 36%;
  width: 38%;
  height: 32%;
}

/* 不规则蛋清流线：顶→底，结束后保持可见 */
.player-action-egg-splat__stream {
  top: 4%;
  width: 14%;
  height: 0;
  border-radius: 40% 50% 45% 55% / 8% 10% 85% 80%;
  background: linear-gradient(
    180deg,
    rgba(255, 252, 245, 0.72) 0%,
    rgba(240, 235, 215, 0.42) 55%,
    rgba(230, 225, 200, 0.18) 90%,
    transparent 100%
  );
  transform-origin: top center;
  animation: player-action-egg-stream-flow 1.4s ease-out forwards;
}
.player-action-egg-splat__stream.s0 { left: 8%; width: 16%; }
.player-action-egg-splat__stream.s1 { left: 28%; width: 11%; animation-duration: 1.5s; }
.player-action-egg-splat__stream.s2 { left: 42%; width: 18%; animation-duration: 1.55s; }
.player-action-egg-splat__stream.s3 { left: 62%; width: 12%; animation-duration: 1.6s; }
.player-action-egg-splat__stream.s4 { left: 74%; width: 15%; animation-duration: 1.65s; }

/* 蛋黄块状（无 scale 弹跳，避免闪） */
.player-action-egg-splat__yolk {
  border-radius: 50%;
  background: radial-gradient(
    circle at 40% 35%,
    rgba(255, 205, 70, 0.92) 0%,
    rgba(245, 170, 35, 0.75) 45%,
    rgba(230, 140, 20, 0.2) 72%,
    transparent 85%
  );
  opacity: 0.9;
  animation: player-action-egg-fade-in 0.32s ease forwards;
}
.player-action-egg-splat__yolk.y0 {
  left: 30%;
  top: 22%;
  width: 28%;
  height: 26%;
}
.player-action-egg-splat__yolk.y1 {
  left: 48%;
  top: 40%;
  width: 22%;
  height: 20%;
  background: radial-gradient(
    circle at 45% 40%,
    rgba(255, 190, 50, 0.88) 0%,
    rgba(235, 150, 25, 0.55) 55%,
    transparent 80%
  );
}
