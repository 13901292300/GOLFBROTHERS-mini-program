/**
 * 记分页面样式 — 对齐 记分及添加删除页面汇总.html
 */
@import '../../../../styles/half-course-panel.wxss';

/* =========================================================
   THEME TOKEN SYSTEM (single source of truth)
   所有结构性背景 / 文字 / 边框颜色都来自这些变量。
   品牌色（蓝色 Header、金色、记分语义色）不参与主题切换。
   ========================================================= */
.score-page.dark-mode {
  --bg-primary: #000000;
  --bg-secondary: #0a0a0a;
  --bg-card: #111111;
  --bg-panel: #000000;
  --text-primary: #ffffff;
  --text-secondary: #888888;
  --border-color: #222222;
  /* HEADER 三色 DARK：hole 最浅 → identity 中 → intersection 最深（相对纯黑成绩区拉开） */
  --score-header-hole: #202b3a;
  --score-header-identity: #172231;
  --score-header-intersection: #0d1724;
  /* fourball 成绩行横线：比 --border-color 更可读，仍弱于成绩主体 */
  --fourball-score-row-border: #3f3f46;
  /* style-sheet 兼容别名（对齐 detail/hub） */
  --bg-subtle: #0a0a0a;
  --text-muted: #888888;
  --border: var(--border-color);
  --border-hover: #333333;

  /* TOT 列主题联动：DARK = 冠军金（用字面量，避免嵌套 var 在部分基础库解析失败） */
  --tot-color: #CE9224;

  /* 记分面板视觉层级：DARK 维持金色高亮体系，成绩金色 */
  --highlight-color: #CE9224;
  --highlight-surface: #fff9c4;
  --highlight-text: #002d62;
  --score-color: #CE9224;
  --score-surface: rgba(206, 146, 36, 0.16);
  --score-border: rgba(206, 146, 36, 0.48);
  --aux-text: #00aeef;
  --highlight-strong: #facc15;
  --highlight-on: #002d55;
  --par-color: #CE9224;

  /* 技术面板焦点 pulse：冠军金 → 浅金 → 冠军金 */
  --tech-panel-pulse: #CE9224;
  --tech-panel-pulse-mid: #E4C078;

  --discussion-bg: #0b0f14;
  --discussion-strip: #101820;
  --discussion-bubble: #182330;
  --discussion-bar: #111827;
  --discussion-input-bg: #0b1220;
  --discussion-border: #263241;
}

.score-page.bright-mode {
  --bg-primary: #ffffff;
  --bg-secondary: #f1f5f9;
  --bg-card: #f8fafc;
  --bg-panel: #ffffff;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --border-color: #e2e8f0;
  /* HEADER 三色 V2.2：hole 最浅 → identity 中 → intersection 最深 */
  --score-header-hole: #f4f7fb;
  --score-header-identity: #e2eaf3;
  --score-header-intersection: #c2d2e4;
  /* fourball 成绩行横线：Light 保持现有浅灰 */
  --fourball-score-row-border: var(--border-color);
  /* style-sheet 兼容别名（对齐 detail/hub） */
  --bg-subtle: #f3f4f6;
  --text-muted: #6b7280;
  --border: var(--border-color);
  --border-hover: #d1d5db;

  /* TOT 列主题联动：BRIGHT = PGA蓝 #002D62 */
  --tot-color: #002D62;

  /* 记分面板：BRIGHT 单一 PGA 藏蓝高对比体系（成绩与高亮同色 #002D62，靠底色/边框/加粗区分；辅助文字灰） */
  --highlight-color: #002D62;
  --highlight-surface: rgba(0, 45, 98, 0.12);
  --highlight-text: #002D62;
  --score-color: #002D62;
  --score-surface: rgba(0, 45, 98, 0.10);
  --score-border: rgba(0, 45, 98, 0.42);
  --aux-text: #6B7280;
  --highlight-strong: #002D62;
  --highlight-on: #ffffff;
  --par-color: #002D62;

  /* 技术面板焦点 pulse：PGA蓝 → 浅蓝 → PGA蓝 */
  --tech-panel-pulse: #002D62;
  --tech-panel-pulse-mid: #5BA3D9;

  --discussion-bg: #f3f4f6;
  --discussion-strip: #ffffff;
  --discussion-bubble: #ffffff;
  --discussion-bar: #f8fafc;
  --discussion-input-bg: #ffffff;
  --discussion-border: #e2e8f0;
}

page {
  height: 100%;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.score-page {
  /* Bottom Sheet 主按钮品牌色（页面内定义，避免 var(--golf-blue) 未声明失效） */
  --golf-blue: #002d62;
  --champion-gold: #ce9224;

  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-primary);
  color: var(--text-primary);
  box-sizing: border-box;
}

/* ===== Header ===== */
/* height / padding-top / padding-right are computed in JS (initHeaderNav) and
   applied via inline headerRootStyle / headerBarStyle, matching the home page. */
.gb-header {
  flex-shrink: 0;
  background: #002d62;
  border-bottom: 2px solid var(--champion-gold);
  color: #ffffff;
  box-sizing: border-box;
}

.gb-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
}

.gb-header__left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.gb-header__right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.gb-header__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gb-header__chevron {
  font-size: 40rpx;
  color: #ffffff;
  line-height: 1;
}

.gb-header__eyebrow {
  display: block;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 8rpx;
}

.gb-header__title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  color: #ffffff;
  line-height: 1;
}

/* D/B 开关已收口到首页（唯一入口），记分页不再提供任何主题控件。 */

/* The real WeChat system capsule occupies the top-right; reserve space via
   headerPaddingRight (JS) and hide this mock pill, exactly like the home page. */
.mini-program-pill {
  display: none;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  align-items: center;
  gap: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.mini-program-pill__dots { display: flex; gap: 8rpx; }
.mini-program-pill__dot { width: 12rpx; height: 12rpx; background: #fff; border-radius: 999rpx; }
.mini-program-pill__line { width: 2rpx; height: 32rpx; background: rgba(255, 255, 255, 0.2); }
.mini-program-pill__circle {
  width: 40rpx; height: 40rpx;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
}
.mini-program-pill__circle-inner { width: 20rpx; height: 20rpx; background: #fff; border-radius: 999rpx; }

/* ===== Tab Nav ===== */
/* 容器不居中项（用 stretch 让 item 铺满高度），文字由 .tab-nav__item 自身 flex 居中，指示器贴容器底边 */
.tab-nav {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  height: var(--tab-height);
  background: #002d62;
  border-bottom: 1px solid var(--border-color);
}

.tab-nav__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}

.tab-nav__label {
  font-size: var(--tab-font-size);
  line-height: 1;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.tab-nav__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 112rpx;
  height: var(--tab-indicator-height);
  background: var(--tab-indicator-color);
  opacity: 1;
  border-radius: 999rpx;
}

/* ===== Main ===== */
.score-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.score-tab-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Course & Game Info */
.course-game-info {
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
}

.course-game-info__head {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
}

/* 信息栏三段式：左(球场名+下拉) / 中(占位) / 右(总杆·杆差开关) */
.score-info-row {
  justify-content: space-between;
  gap: 24rpx;
}

.score-info-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

/* 下拉按钮紧挨球场名右侧：名字按内容收缩并省略号，按钮不收缩 */
.score-info-left .course-name {
  flex: 0 1 auto;
}

.course-dropdown-btn {
  flex-shrink: 0;
}

/* 右侧切换开关 */
.score-display-switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 999rpx;
  padding: 4rpx;
}

.score-display-switch__btn {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  border-radius: 999rpx;
  line-height: 1.2;
}

.score-display-switch__btn--active {
  background: #002D62;
  color: #ffffff;
}

.course-game-info__accent {
  width: 6rpx;
  height: 32rpx;
  background: var(--champion-gold);
  border-radius: 999rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.course-game-info__course {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-game-info__toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.course-game-info__chevron {
  font-size: 24rpx;
  color: var(--champion-gold);
  transition: transform 0.2s;
}

.course-game-info__chevron--open { transform: rotate(180deg); }

.game-info-panel {
  padding: 8rpx 32rpx 24rpx;
  border-top: 1px solid var(--border-color);
}

/* 外部遮罩：点击空白处收起（全屏 fixed、透明、不参与记分布局流） */
.game-info-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: transparent;
}

/* Context 面板：根级 fixed 浮层，与 TAB / HOLE / score grid 完全解耦，
   不占布局高度、不 push 任何元素、不触发 reflow。top / max-height 由 JS 实测注入。 */
.game-context-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  max-height: 60vh;
  box-sizing: border-box;
  padding: 16rpx 24rpx 28rpx;
  background: var(--bg-card);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.18);
}

/* 最小必要信息：纯文本 label + value 列表（无卡片嵌套、无头像、无分组展开） */
.gc-list {
  margin-top: 4rpx;
  font-size: 26rpx;
}
.gc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1px solid var(--border-color);
}
.gc-item--last { border-bottom: none; }
.gc-item-label {
  color: var(--text-secondary);
  flex-shrink: 0;
}
.gc-item-value {
  color: var(--text-primary);
  font-weight: 700;
  margin-left: 24rpx;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 围观密码：数值 + 复制按钮（单行追加，不新增模块） */
.gc-code-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 24rpx;
  flex: 1;
}
.gc-code-value {
  margin-left: 0;
  flex: 0 1 auto;
  letter-spacing: 4rpx;
  color: var(--champion-gold);
}
.gc-copy-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--champion-gold);
  border: 1px solid var(--champion-gold);
  border-radius: 999rpx;
  line-height: 1.6;
}
.gc-copy-btn:active { opacity: 0.7; }

.game-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid var(--border-color);
}

.game-info-row--last { border-bottom: none; }

.game-info-label { color: var(--text-secondary); }
.game-info-value { color: var(--text-primary); font-weight: 700; margin-left: 24rpx; flex: 1; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Scoreboard */
.scoreboard-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  background: var(--bg-primary);
}

/*
 * 普通创建 fourball_best 2+2 / 4+0：HOLE/PAR/TOT 对齐 score-shell-ui-v2.4（game-single）视觉。
 * 门控：.is-fourball-pair22（2+2/2+1）| .is-fourball-team-layout（4+0）；selector 合并，不复制两套。
 * TOTAL 无 tot-head class：列序末格 :last-child（buildColumns idx===20）
 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row.scoreboard-row--head,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row.scoreboard-row--head {
  height: 112rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  /* visible：避免 overflow:hidden 打断 sticky-col 横滑吸边 */
  overflow: visible;
  background: transparent;
  border-bottom: none;
  box-shadow: 0 1px 0 var(--border-color);
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row.scoreboard-row--par,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row.scoreboard-row--par {
  height: 72rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  overflow: visible;
  background: transparent;
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head > .scoreboard-cell,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head > .scoreboard-cell {
  height: 112rpx;
  min-height: 112rpx;
  box-sizing: border-box;
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell {
  height: 72rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

/* PAR 成绩区 cell：普通表格底边（cell 自画，避免铺底盖住 row border） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell:not(.sticky-col),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell:not(.sticky-col) {
  border-bottom: 1px solid var(--border-color);
}

/* HOLE 左侧 = 交叉蓝（对齐 game-single head spacer / lead--head） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .sticky-col,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .sticky-col {
  background: var(--score-header-intersection);
  /* 压缩原 32+32，保证 112 行内居中；不改 --player-col-width */
  padding-top: 0;
  padding-bottom: 0;
}

/* HOLE 1–18 + OUT/IN 头 = hole 蓝 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .scoreboard-cell--special-head,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}

/* HOLE TOTAL 头 = 交叉蓝（压过 special-head） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .scoreboard-cell--special-head:last-child,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .scoreboard-cell--special-head:last-child {
  background: var(--score-header-intersection);
}

/* PAR 左侧 = 身份蓝；底边交叉蓝（对齐 game-single 身份区） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .sticky-col,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .sticky-col {
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

/* PAR 1–18 洞格 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell:not(.sticky-col):not(.scoreboard-cell--special-par),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell:not(.sticky-col):not(.scoreboard-cell--special-par) {
  background: var(--bg-primary);
}

/* PAR OUT/IN = hole 蓝（对齐 hole-special-col） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell--special-par,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell--special-par {
  background: var(--score-header-hole);
}

/* PAR TOTAL = 身份蓝（对齐 tot-col）；底边交叉蓝（PAR 无 score-cell--total class） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell--special-par:last-child,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell--special-par:last-child {
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

/* 兼容命名：若日后 PAR 挂上 score-cell--total，同交叉蓝底边 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par .score-cell--total,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par .score-cell--total {
  border-bottom: 1px solid var(--score-header-intersection);
}

/* HOLE / PAR 文案：对齐 hole-par-normal-container 字阶与光学上移 */
.scoreboard-scroll.is-fourball-pair22 .col-head-label,
.scoreboard-scroll.is-fourball-team-layout .col-head-label,
.scoreboard-scroll.is-fourball-pair22 .col-par-label,
.scoreboard-scroll.is-fourball-team-layout .col-par-label {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  line-height: 1;
  text-transform: uppercase;
}

.scoreboard-scroll.is-fourball-pair22 .col-head-label,
.scoreboard-scroll.is-fourball-team-layout .col-head-label {
  transform: translateY(-3rpx);
}

.scoreboard-scroll.is-fourball-pair22 .col-par-label,
.scoreboard-scroll.is-fourball-team-layout .col-par-label {
  transform: translateY(-2rpx);
}

/* 洞号圆：与基准共用全局数值，提高优先级避免被其它 Legacy 规则干扰 */
.scoreboard-scroll.is-fourball-pair22 .hole-number,
.scoreboard-scroll.is-fourball-team-layout .hole-number,
.scoreboard-scroll.is-fourball-pair22 .hole-label-circle,
.scoreboard-scroll.is-fourball-team-layout .hole-label-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.scoreboard-scroll.is-fourball-pair22 .hole-number,
.scoreboard-scroll.is-fourball-team-layout .hole-number {
  background: #002d62 !important;
  color: #ffffff !important;
  border: 1px solid #002d62;
}

/* OUT/IN/TOTAL 圆标：对齐基准 special（bright / dark token） */
.scoreboard-scroll.is-fourball-pair22 .hole-label-circle--special,
.scoreboard-scroll.is-fourball-team-layout .hole-label-circle--special {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

.score-page.dark-mode .scoreboard-scroll.is-fourball-pair22 .hole-label-circle--special,
.score-page.dark-mode .scoreboard-scroll.is-fourball-team-layout .hole-label-circle--special {
  background: var(--score-header-identity);
  border: 1px solid var(--score-header-intersection);
  color: var(--text-secondary);
}

/* PAR 数字：与基准 par-val 一致 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par .par-val,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par .par-val {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

/* 成绩格 special：OUT/IN=hole蓝，TOTAL=身份蓝（对齐 game-single；不改 columns） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--player > .score-cell:nth-child(11),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--player > .score-cell:nth-child(11),
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--player > .score-cell:nth-child(21),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--player > .score-cell:nth-child(21) {
  background: var(--score-header-hole);
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--player > .score-cell.score-cell--total,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--player > .score-cell.score-cell--total {
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

/* ===== Shell：G1 basic / 普通创建单组 game-single（左 player-column + 右 score-track）===== */
.scoreboard-shell,
.scoreboard-shell--basic,
.scoreboard-shell--game-single,
.scoreboard-shell--match-play,
.scoreboard-shell--fourball {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: var(--bg-primary);
  overflow: hidden;
}

/* ===== fourball shell v2（Phase4：identity 固定 + track lead + 独立横滑；不改 Legacy）===== */
.scoreboard-shell--fourball {
  position: relative;
  /* Phase5.5：壳级折叠进度，驱动列宽 / tee sticky left / 头像叠合 */
  --fourball-identity-collapse: 0;
  --fourball-identity-width-start: 220rpx;
  --fourball-identity-width-delta: 72rpx;
  --fourball-identity-width: calc(
    var(--fourball-identity-width-start) - var(--fourball-identity-width-delta) *
      var(--fourball-identity-collapse)
  );
  /* Phase7.2：HOLE/PAR 锚点 = identity + diff(96) + tee(6) */
  --fourball-diff-lead-width: 96rpx;
  --fourball-tee-lead-width: 6rpx;
  --fourball-hole-par-anchor-width: calc(
    var(--fourball-identity-width) + var(--fourball-diff-lead-width) +
      var(--fourball-tee-lead-width)
  );
}

/*
 * 实验：fixed-collapse
 * - 默认折叠宽（collapse=1 → 148rpx）；expanded 时 collapse=0 → 220rpx
 * - 禁止 width transition；不改动态折叠路径
 * - 关闭全高接缝 box-shadow（避免头像|diff 灰竖条拉到成绩区底部）
 */
.scoreboard-shell--fourball.is-fourball-identity-fixed-collapse .fourball-player-column,
.scoreboard-shell--fourball.is-fourball-identity-fixed-collapse .fourball-score-track__inner,
.scoreboard-shell--fourball.is-fourball-identity-fixed-collapse .fourball-hole-par-overlay {
  transition: none !important;
}

.scoreboard-shell--fourball.is-fourball-identity-fixed-collapse .fourball-player-column {
  box-shadow: none;
}

/*
 * match-play pair fixed-collapse（G6/G7/G8）
 * - 默认折叠宽 collapse=1 → 148rpx；expanded collapse=0 → 220rpx
 * - 禁止 width transition；不改 fourball fixed-collapse / G5 single
 */
.scoreboard-shell--match-play.is-match-play-identity-fixed-collapse .player-column,
.scoreboard-shell--match-play.is-match-play-identity-fixed-collapse .score-track__inner {
  transition: none !important;
}

/* Phase5.5：列宽 220→148 随 progress；禁止 width transition（跟手） */
/* Phase5.4：最高层遮挡。列底用页面底，避免末行以下被 identity 蓝铺满 */
.scoreboard-shell--fourball .fourball-player-column {
  flex-shrink: 0;
  width: var(--fourball-identity-width);
  min-width: var(--fourball-identity-width);
  max-width: var(--fourball-identity-width);
  height: 100%;
  position: relative;
  z-index: 3;
  background: var(--bg-primary);
  background-color: var(--bg-primary);
  box-sizing: border-box;
  transition: none;
  /*
   * 视觉兜底验证（不改宽度/translateX/scroll/setData）：
   * 向右延伸与接缝同色的遮罩，盖住透明 track 露出的壳层白底。
   * box-shadow 不占布局宽，不影响 --fourball-identity-width 计算。
   */
  box-shadow: 12rpx 0 0 0 var(--score-header-identity);
}

/* identity|diff 竖线：挂在内容 inner（表头+球员行高度），不随全高 column 伸入空白区 */
.scoreboard-shell--fourball .fourball-player-column__inner {
  width: 100%;
  box-sizing: border-box;
  box-shadow: inset -1px 0 0 var(--score-header-intersection);
}

.scoreboard-shell--fourball .fourball-player-column__spacer {
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid var(--score-header-intersection);
}

.scoreboard-shell--fourball .fourball-player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-bottom: none;
}

.scoreboard-shell--fourball .fourball-player-column__spacer.shell-row--par {
  height: 72rpx;
  min-height: 72rpx;
  background: var(--score-header-identity);
}

.scoreboard-shell--fourball .fourball-player-column__row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
}

/* 末行以下空白区不留横线；行间分隔仍由非 last-child 的 border-bottom 承担 */
.scoreboard-shell--fourball .fourball-player-column__inner > .fourball-player-column__row:last-child {
  border-bottom: none;
}

/* Phase5.2-b / 5.5 / 5.6：内容折叠；collapse 继承壳级；头像组随列宽居中 */
.scoreboard-shell--fourball .fourball-pair-identity {
  --fourball-avatar-collapse-shift: -48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/*
 * Phase5.6：avatar-group 相对当前 identity 宽居中（无固定 left）。
 * gap / 第二头像 margin-left 随 collapse 收紧布局盒，避免 148rpx 下挤出左边界。
 * 折叠距离仍为 --fourball-avatar-collapse-shift（-48rpx）。
 */
.scoreboard-shell--fourball .fourball-pair-identity .avatar-group {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 80rpx;
  margin: 0 auto;
  box-sizing: border-box;
  gap: calc(16rpx * (1 - var(--fourball-identity-collapse)));
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__item {
  position: relative;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__item--first {
  z-index: 2;
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__item--second {
  z-index: 1;
  /* margin 参与 flex 布局宽度，居中才能跟列宽收缩；位移量仍为 -48rpx×progress */
  margin-left: calc(
    var(--fourball-avatar-collapse-shift) * var(--fourball-identity-collapse)
  );
  transform: translateX(0);
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: block;
  background: var(--bg-secondary);
}

.scoreboard-shell--fourball .fourball-pair-identity .name-stack {
  position: relative;
  width: 100%;
  min-height: 28rpx;
}

.scoreboard-shell--fourball .fourball-pair-identity .name-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  min-height: 28rpx;
  opacity: calc(1 - var(--fourball-identity-collapse));
}

.scoreboard-shell--fourball .fourball-pair-identity .name-group__name {
  flex: 1 1 0;
  min-width: 0;
  max-width: 50%;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/*
 * fourball 双球员壳：type=single（members 仅 1 人）时 identity 内头像/昵称居中。
 * 列宽与 collapse 不变；type=pair 双头像不受影响。
 */
.scoreboard-shell--fourball .fourball-pair-identity--single .avatar-group {
  justify-content: center;
}

.scoreboard-shell--fourball .fourball-pair-identity--single .avatar-group__item,
.scoreboard-shell--fourball .fourball-pair-identity--single .avatar-group__item--first {
  margin-left: 0;
  margin-right: 0;
}

.scoreboard-shell--fourball .fourball-pair-identity--single .name-group {
  justify-content: center;
  /* single 无 pair-name-compact；collapse 后仍显示单昵称，禁止随 --fourball-identity-collapse 淡出 */
  opacity: 1;
}

.scoreboard-shell--fourball .fourball-pair-identity--single .name-group__name {
  flex: 0 1 auto;
  max-width: 100%;
  width: auto;
  text-align: center;
}

/* Phase5.2-d：折叠昵称 combined（整串）/ dual（短侧优先宽，长侧省略） */
.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 28rpx;
  box-sizing: border-box;
  opacity: var(--fourball-identity-collapse);
  pointer-events: none;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact--combined .pair-name-compact__text {
  max-width: 100%;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact--dual {
  justify-content: center;
  gap: 0;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact__part {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact__sep {
  flex: 0 0 auto;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

/* Phase7.4：宽= identity+diff+tee；translateX 仅阶段2（fourballHoleParOffsetX） */
.scoreboard-shell--fourball .fourball-hole-par-overlay {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: var(--fourball-hole-par-anchor-width);
  height: 184rpx;
  display: flex;
  flex-direction: column;
  pointer-events: none;
  box-sizing: border-box;
  transition: none;
  will-change: transform;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__hole,
.scoreboard-shell--fourball .fourball-hole-par-overlay__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__hole {
  height: 112rpx;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__par {
  height: 72rpx;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__hole text,
.scoreboard-shell--fourball .fourball-hole-par-overlay__par text {
  color: var(--text-secondary);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  line-height: 1;
}

/* HOLE/PAR sticky 内真实 6rpx T 区节点（与成绩行同列；默认透传，Elite 再上色） */
.scoreboard-shell--fourball .fourball-tee-sticky-overlay__tee {
  width: 6rpx;
  height: 100%;
  box-sizing: border-box;
  background: transparent;
}

/* Phase6 / 5.5 / 6.2：T sticky — left=压缩后 identity 右缘；显隐无过渡，防交接回跳 */
.scoreboard-shell--fourball .fourball-tee-sticky-overlay {
  position: absolute;
  left: var(--fourball-identity-width);
  top: 0;
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
  transition: none;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
  transition: none;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__spacer {
  width: 100%;
  box-sizing: border-box;
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__inner > .fourball-tee-sticky-overlay__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-bottom: none;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__spacer.shell-row--par {
  height: 72rpx;
  min-height: 72rpx;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__row {
  display: flex;
  align-items: stretch;
  justify-content: center;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 1px solid var(--score-header-intersection);
  background: var(--score-header-identity);
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip {
  display: flex;
  /* 与 track lead T 一致：上下双色合成，吸边前后视觉统一 */
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  height: 100%;
  background: transparent;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip .tee-left,
.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip .tee-right {
  flex: 0 0 50%;
  width: 100%;
  min-width: 0;
  min-height: 0;
  height: 50%;
}

/* 单色 sticky T（2+1 / 1+1）：满行高；双 T 仍走上方 50%/50% */
.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip.tee-single .tee-left {
  flex: 0 0 100%;
  height: 100%;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip.tee-single .tee-right {
  flex: 0 0 0;
  height: 0;
  min-height: 0;
  overflow: hidden;
}

/* sticky 显示瞬间隐藏 track 内 T（同帧交接，无淡出，避免回跳观感） */
.scoreboard-shell--fourball.is-fourball-tee-sticky .fourball-track-lead--tee .fourball-track-lead__tee-half {
  opacity: 0;
  visibility: hidden;
  transition: none;
}

/* score-track：最低层（z-index:1）；勿抬高，保证 identity 可遮挡滚入成绩 */
.scoreboard-shell--fourball .fourball-score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 1;
  background: transparent;
}

/* Phase6.1：阶段1 用 translateX(scrollLeft) 抵消原生横滑，lead/score 视觉冻结 */
.scoreboard-shell--fourball .fourball-score-track__inner {
  display: inline-block;
  min-width: 100%;
  position: relative;
  z-index: 1;
  will-change: transform;
  transition: none;
}

.scoreboard-shell--fourball .scoreboard-row {
  display: flex;
  min-width: max-content;
  position: relative;
  z-index: 1;
}

/* 横线统一由 cell/lead 自绘；提高优先级，压过通用 .scoreboard-shell .shell-row border */
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.shell-row--head,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.shell-row--par,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.shell-row--player,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--head,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--par,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--player {
  border-bottom: none;
  box-shadow: none;
}

.scoreboard-shell--fourball .scoreboard-row.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
}

.scoreboard-shell--fourball .scoreboard-row.shell-row--par {
  min-height: 72rpx;
}

.scoreboard-shell--fourball .scoreboard-row.shell-row--player {
  height: 156rpx;
  min-height: 156rpx;
}

.scoreboard-shell--fourball .scoreboard-cell {
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/*
 * Phase7.5 / OUT·IN 修正：洞头与 OUT/IN 汇总列用 18洞浅底 --score-header-hole；
 * TOTAL 保持 intersection（头）/ identity（身）。spacer/lead/overlay 不改。
 */
.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
}

/* OUT/IN：HOLE/PAR 行 = 18洞浅底 */
.scoreboard-shell--fourball .scoreboard-cell--hole-special-col,
.scoreboard-shell--fourball .scoreboard-row--par > .scoreboard-cell--special-par:not(.scoreboard-cell--tot-col) {
  background: var(--score-header-hole);
  background-color: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-cell--tot-col {
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
}

.scoreboard-shell--fourball .scoreboard-row--par > .scoreboard-cell:not(.scoreboard-cell--special-par):not(.scoreboard-cell--tot-col):not(.scoreboard-cell--hole-special-col) {
  background: var(--bg-primary);
}

/* 成绩格不透明底，滚入视口时形成对 lead 的覆盖观感（同 G1；无 opacity/宽塌缩） */
.scoreboard-shell--fourball .scoreboard-row--player .score-cell {
  position: relative;
  z-index: 1;
  background: var(--bg-primary);
  background-color: var(--bg-primary);
}

/*
 * 横向业务分隔线唯一来源：HOLE/PAR/成绩 cell + 同行 lead
 * Light = --border-color；Dark = 增强灰（--fourball-score-row-border）
 */
.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-shell--fourball .scoreboard-row--par > .scoreboard-cell,
.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--player .score-cell,
.scoreboard-shell--fourball .fourball-track-lead--head,
.scoreboard-shell--fourball .fourball-track-lead--par,
.scoreboard-shell--fourball .scoreboard-row--player .fourball-track-lead {
  border-bottom: 1px solid var(--fourball-score-row-border);
  box-sizing: border-box;
}

/* OUT/IN 成绩区：覆盖默认 bg-primary → 18洞浅底；TOTAL 保持身份蓝（横线跟上方统一 token） */
.scoreboard-shell--fourball .scoreboard-row--player .score-cell.scoreboard-cell--hole-special-col {
  background: var(--score-header-hole);
  background-color: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-row--player .score-cell.score-cell--total,
.scoreboard-shell--fourball .scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
}

/* track lead：中间层；固定宽，禁止 opacity/width collapse */
.scoreboard-shell--fourball .fourball-track-lead {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
  transition: none;
  opacity: 1;
}

.scoreboard-shell--fourball .fourball-track-lead--diff {
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
}

.scoreboard-shell--fourball .fourball-track-lead--tee {
  width: 6rpx;
  min-width: 6rpx;
  max-width: 6rpx;
  padding: 0;
  flex-direction: column;
  align-items: stretch;
}

.scoreboard-shell--fourball .fourball-track-lead--head {
  background: var(--score-header-intersection);
}

.scoreboard-shell--fourball .fourball-track-lead__diff {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
  color: var(--text-primary);
}

.scoreboard-shell--fourball .fourball-track-lead__diff.diff-under {
  color: #ef4444 !important;
}

.scoreboard-shell--fourball .fourball-track-lead__tee-half {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.player-column {
  flex-shrink: 0;
  width: 128rpx;
  min-width: 128rpx;
  height: 100%;
  background: var(--bg-secondary);
  border-right: none;
  box-sizing: border-box;
}

.player-column__inner {
  width: 100%;
}

.player-column__spacer {
  width: 100%;
  border-bottom: 1px solid var(--border-color);
  box-sizing: border-box;
}

.player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  background: var(--bg-card);
  box-sizing: border-box;
}

.player-column__spacer.shell-row--par {
  background: var(--bg-primary);
}

.player-column__row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border-bottom: 1px solid var(--border-color);
  background: var(--bg-secondary);
  box-sizing: border-box;
}

.player-column__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.player-column__card .player-avatar-img {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

/* 昵称：字阶/字重/斜体/大写由 .player-name-line 提供；此处仅列内居中与宽度 */
.player-column__name {
  max-width: 100%;
  text-align: center;
}

.score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--bg-primary);
}

.score-track__inner {
  display: inline-block;
  min-width: 100%;
}

.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  box-sizing: border-box;
}

.shell-row--par {
  min-height: 72rpx;
  box-sizing: border-box;
}

.shell-row--player {
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
}

.scoreboard-shell .scoreboard-row.shell-row--head,
.scoreboard-shell .scoreboard-row.shell-row--par,
.scoreboard-shell .scoreboard-row.shell-row--player {
  border-bottom: 1px solid var(--border-color);
}

/* score-track 前缀：diff + T 固定列宽（禁止 flex 收缩） */
.scoreboard-shell--basic .track-lead-diff,
.scoreboard-shell--game-single .track-lead-diff,
.track-lead-diff {
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  flex: 0 0 96rpx !important;
  flex-shrink: 0 !important;
  justify-content: center;
  padding: 8rpx 4rpx;
  background: var(--bg-secondary);
  border-right: none;
  overflow: visible;
  box-sizing: border-box;
}

.scoreboard-shell--basic .track-lead-tee,
.track-lead-tee {
  width: 32rpx !important;
  min-width: 32rpx !important;
  max-width: 32rpx !important;
  flex: 0 0 32rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  display: flex;
  /* 成绩行 T 线：与行同高（顶/底对齐），子色块用 height:100% / flex 均分 */
  align-items: stretch;
  justify-content: stretch;
  background: var(--bg-secondary);
  border-right: 1px solid var(--border-color);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.track-lead-diff--head,
.track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--bg-card);
  box-sizing: border-box;
}

.track-lead-diff--par,
.track-lead-tee--par {
  background: var(--bg-primary);
}

.track-lead-diff__wrap {
  flex: none;
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  max-width: none;
  overflow: visible;
  opacity: 1 !important;
}

.scoreboard-shell--basic .track-lead-diff .player-diff-score {
  font-size: 32rpx;
  line-height: 1.1;
  white-space: nowrap;
}
/* game-single：diff 字阶对齐 G5（40rpx）；颜色/under·even·over 仍走全局 */
.scoreboard-shell--game-single .track-lead-diff .player-diff-score {
  font-size: 40rpx;
  line-height: 1.2;
  white-space: nowrap;
}

/* 普通创建单组：双栏 player-column + score-track（diff/T 在 track 内随横滑） */
.scoreboard-shell--game-single {
  position: relative;
}

/*
 * 纯 4+0：HOLE 以下完全复用 game-single；
 * 仅身份列改为 TEAM SCORE + 赛制名（宽仍 128rpx）。
 * HOLE 以上球员卡片走页面级 .bestball-roster-strip，不进本壳。
 */
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score {
  padding: 12rpx 6rpx;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-wrap {
  width: 100%;
  padding-right: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-kicker {
  font-size: 14rpx;
  letter-spacing: 0.12em;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-main {
  font-size: 24rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 4+0：成绩行合成 T 线 — 满行高、四色上下均分；不改列宽 / 行高 */
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .scoreboard-row--player .track-lead-tee {
  align-items: stretch;
  justify-content: stretch;
  overflow: hidden;
  padding: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .track-lead-tee__composite,
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .tee-sticky-overlay__row .track-lead-tee__composite {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
  align-self: stretch;
  box-sizing: border-box;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .track-lead-tee__seg {
  flex: 1 1 0;
  width: 100%;
  min-height: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .tee-sticky-overlay__row {
  align-items: stretch;
  padding: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40.is-tee-sticky
  .score-track
  .track-lead-tee__composite {
  opacity: 0;
}

/* HOLE/PAR 方案A：初始标签 — 宽=身份区(128+96+6)，水平中心对齐；HOLE/PAR 分占 head/par 行 */
.scoreboard-shell--game-single .hole-par-normal-container {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 230rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole,
.scoreboard-shell--game-single .hole-par-normal-container__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole {
  height: 112rpx;
}
.scoreboard-shell--game-single .hole-par-normal-container__par {
  height: 72rpx;
}
/* HOLE/PAR 字阶对齐 G5 col-head/par-label；保留光学上移 */
.scoreboard-shell--game-single .hole-par-normal-container__hole text,
.scoreboard-shell--game-single .hole-par-normal-container__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole text {
  transform: translateY(-3rpx);
}
.scoreboard-shell--game-single .hole-par-normal-container__par text {
  transform: translateY(-2rpx);
}

/* HOLE/PAR 方案A：吸边紧凑标签 — 宽=player-column 128rpx，水平中心对齐头像区；HOLE/PAR 分占 head/par 行 */
.scoreboard-shell--game-single .hole-par-compact-container {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 128rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
}
/* Phase1：compact 保留节点但不参与显示 */
.scoreboard-shell--game-single .hole-par-compact-container--phase1-hidden {
  opacity: 0;
  visibility: hidden;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole,
.scoreboard-shell--game-single .hole-par-compact-container__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole {
  height: 112rpx;
}
.scoreboard-shell--game-single .hole-par-compact-container__par {
  height: 72rpx;
}
/* compact 与 normal 统一字阶；保留光学上移 */
.scoreboard-shell--game-single .hole-par-compact-container__hole text,
.scoreboard-shell--game-single .hole-par-compact-container__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole text {
  transform: translateY(-3rpx);
}
.scoreboard-shell--game-single .hole-par-compact-container__par text {
  transform: translateY(-2rpx);
}
.scoreboard-shell--game-single .player-column {
  position: relative;
  z-index: 3;
  background: transparent;
  border-right: none;
}
/* game-single：头像对齐 G5 80rpx；T 色仅走 T 线，头像无色环 */
.scoreboard-shell--game-single .player-column__card .player-avatar-img {
  width: 80rpx;
  height: 80rpx;
}
.scoreboard-shell--game-single .score-track {
  position: relative;
  z-index: 1;
  background: transparent;
  margin: 0;
  padding: 0;
}
/* HEADER：身份蓝（头像列 / lead 身）；TOTAL 头=交叉；TOTAL 身=身份 */
.scoreboard-shell--game-single .player-column__spacer.shell-row--par,
.scoreboard-shell--game-single .player-column__row {
  background: var(--score-header-identity);
  border-right: none;
  /* identity 区行分隔：交叉蓝，避免与 identity 底色过近 */
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}
/* HOLE × 身份交叉蓝（仅 head；无右边框/底边，底边由 track header row 统一绘制） */
.scoreboard-shell--game-single .player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-right: none;
  border-bottom: none;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--par,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player {
  background: transparent;
}
/* 记分行横向分隔：score-cell 铺底会盖住 row 的 border-bottom，改由 cell 自身绘制 */
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player .score-cell {
  border-bottom: 1px solid var(--border-color);
}
/* lead 身份蓝；HOLE 行 lead 用交叉蓝覆盖 */
.scoreboard-shell--game-single .track-lead-diff,
.scoreboard-shell--game-single .track-lead-diff--par,
.scoreboard-shell--game-single .track-lead-tee,
.scoreboard-shell--game-single .track-lead-tee--par {
  background: var(--score-header-identity) !important;
}
/* diff/T 身份区行分隔（par + 球员行；head 仍由 header row 统一绘制） */
.scoreboard-shell--game-single .track-lead-diff--par,
.scoreboard-shell--game-single .track-lead-tee--par,
.scoreboard-shell--game-single .scoreboard-row--player .track-lead-diff,
.scoreboard-shell--game-single .scoreboard-row--player .track-lead-tee {
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}
.scoreboard-shell--game-single .track-lead-diff--head,
.scoreboard-shell--game-single .track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection) !important;
  box-sizing: border-box;
}
/* head 底边由 row 绘制且不占高度，保证与左侧 spacer 交叉蓝同高 112rpx */
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--head.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  box-shadow: 0 1px 0 var(--border-color);
  overflow: hidden;
  box-sizing: border-box;
}
/* HOLE 行：1–18 + OUT/IN = HOLE蓝；TOTAL 头 = 交叉蓝（HOLE×身份） */
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
}
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
}
/* OUT/IN 整列身 = HOLE蓝（与 1–18 一致；覆盖 special-par / special-cell） */
.scoreboard-shell--game-single .scoreboard-cell--hole-special-col {
  background: var(--score-header-hole);
}
/* TOTAL 身（PAR + 成绩格）= 身份蓝；行分隔用交叉蓝（不影响 1–18/OUT/IN） */
.scoreboard-shell--game-single .scoreboard-cell--tot-col {
  background: var(--score-header-identity);
}
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--par .scoreboard-cell--tot-col,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  border-bottom: 1px solid var(--score-header-intersection);
}
/* PAR 行 / 成绩格：保持原规则 */
.scoreboard-shell--game-single .scoreboard-row--par > .scoreboard-cell:nth-child(n + 3):not(.scoreboard-cell--special-par),
.scoreboard-shell--game-single .scoreboard-row--player .score-cell:not(.scoreboard-cell--special-cell) {
  background: var(--bg-primary);
}
/* track 内 T 列：宽=T线；底色同身份区；高度随成绩行 stretch */
.scoreboard-shell--game-single .track-lead-tee {
  width: 6rpx !important;
  min-width: 6rpx !important;
  max-width: 6rpx !important;
  flex: 0 0 6rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  border-right: none;
  overflow: hidden;
  box-sizing: border-box;
}
/* track 与 sticky overlay 共用：单色 T = 满行高 */
.scoreboard-shell--game-single .track-lead-tee .player-tee-marker,
.scoreboard-shell--game-single .track-lead-tee .track-lead-tee__mark,
.scoreboard-shell--game-single .tee-sticky-overlay__row .player-tee-marker,
.scoreboard-shell--game-single .tee-sticky-overlay__row .track-lead-tee__mark {
  position: static;
  right: auto;
  top: auto;
  bottom: auto;
  transform: none;
  width: 100%;
  height: 100%;
  align-self: stretch;
  margin: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}
/* T sticky overlay：宽=T线；左缘=player-column 右缘；高度=表内容（head+par+players） */
.scoreboard-shell--game-single .tee-sticky-overlay {
  position: absolute;
  left: 128rpx;
  top: 0;
  /* 禁止 bottom/height:100% 撑满 shell，避免底部灰色延长线 */
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}
.scoreboard-shell--game-single .tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}
/* head spacer = 交叉蓝；par spacer = 身份蓝（与 lead 对齐） */
.scoreboard-shell--game-single .tee-sticky-overlay__spacer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  background: var(--score-header-identity) !important;
  border-bottom: 1px solid var(--border-color);
}
.scoreboard-shell--game-single .tee-sticky-overlay__inner > .tee-sticky-overlay__spacer.shell-row--head {
  background: var(--score-header-intersection) !important;
}
/* player row：与 .shell-row--player 同高；stretch 使 T 线顶底对齐成绩行 */
.scoreboard-shell--game-single .tee-sticky-overlay__row {
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  background: var(--score-header-identity) !important;
  box-sizing: border-box;
}
/* sticky 显示时隐藏 track 内原始 T，避免双线（不改 DOM） */
.scoreboard-shell--game-single.is-tee-sticky .score-track .track-lead-tee .player-tee-marker,
.scoreboard-shell--game-single.is-tee-sticky .score-track .track-lead-tee .track-lead-tee__mark {
  opacity: 0;
}

/* ===== Match Play Shell：对齐 stroke shell（player-column + HOLE/PAR overlay + track lead + T sticky）===== */
.scoreboard-shell--match-play {
  position: relative;
}

/* G6/G7 pair：复用 fourball 身份列宽 / 折叠几何（G5 single 不进此分支） */
.scoreboard-shell--match-play.is-match-play-pair {
  --fourball-identity-width-start: 220rpx;
  --fourball-identity-width-delta: 72rpx;
  --fourball-identity-width: calc(
    var(--fourball-identity-width-start) - var(--fourball-identity-width-delta) *
      var(--fourball-identity-collapse, 0)
  );
  --fourball-diff-lead-width: 96rpx;
  --fourball-tee-lead-width: 6rpx;
  --fourball-hole-par-anchor-width: calc(
    var(--fourball-identity-width) + var(--fourball-diff-lead-width) +
      var(--fourball-tee-lead-width)
  );
  --fourball-avatar-collapse-shift: -48rpx;
}

.scoreboard-shell--match-play .player-column {
  width: 128rpx;
  min-width: 128rpx;
  height: 100%;
  position: relative;
  z-index: 3;
  background: transparent;
  border-right: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play.is-match-play-pair .player-column {
  width: var(--fourball-identity-width);
  min-width: var(--fourball-identity-width);
  max-width: var(--fourball-identity-width);
  transition: none;
}

.scoreboard-shell--match-play .score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 1;
  background: transparent;
}

/* HOLE/PAR normal：G5=230rpx；G6/G7 pair=identity+diff+T（随折叠变宽） */
.scoreboard-shell--match-play .match-play-hole-par-normal {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 230rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
  background: transparent;
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole,
.scoreboard-shell--match-play .match-play-hole-par-normal__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole {
  height: 112rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__par {
  height: 72rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole text,
.scoreboard-shell--match-play .match-play-hole-par-normal__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole text {
  transform: translateY(-3rpx);
}

.scoreboard-shell--match-play .match-play-hole-par-normal__par text {
  transform: translateY(-2rpx);
}

/* compact：宽=头像列 128rpx + 浅蓝底；仅 T sticky 吸边后显示 */
.scoreboard-shell--match-play .match-play-hole-par-compact {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 128rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  /* 吸边时：上 HOLE 交叉蓝 + 下 PAR 身份蓝（实色分段，非 rgba） */
  background: linear-gradient(
    to bottom,
    var(--score-header-intersection) 0,
    var(--score-header-intersection) 112rpx,
    var(--score-header-identity) 112rpx,
    var(--score-header-identity) 100%
  );
  opacity: 0;
  visibility: hidden;
}

.scoreboard-shell--match-play .match-play-hole-par-compact--hidden {
  opacity: 0;
  visibility: hidden;
}

/* 未吸边：只允许 normal；compact 强制隐藏（互斥） */
.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-normal {
  opacity: 1;
