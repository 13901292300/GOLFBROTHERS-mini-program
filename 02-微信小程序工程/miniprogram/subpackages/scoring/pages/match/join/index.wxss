.join-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 32rpx 40rpx;
  background: #f6f6f6;
  color: #172033;
}

.join-hero {
  position: relative;
  padding: 28rpx 0 36rpx;
}

.join-back {
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: #172033;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.join-overline {
  display: block;
  margin-left: 88rpx;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: #8a94a6;
}

.join-title {
  display: block;
  margin: 12rpx 0 0 88rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.join-subtitle {
  display: block;
  margin: 12rpx 0 0 88rpx;
  font-size: 26rpx;
  color: #667085;
}

.join-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.08);
}

.join-card__row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.join-card__row:last-child {
  border-bottom: 0;
}

.join-card__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #98a2b3;
}

.join-card__value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #172033;
  word-break: break-all;
}

.join-card__value--mono {
  font-family: monospace;
  font-size: 24rpx;
  color: #475467;
}

.join-action {
  margin-top: 28rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #172033;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
}

.join-action--disabled {
  opacity: 0.55;
}

.join-state {
  margin-top: 36rpx;
  padding: 56rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.08);
}

.join-state--error {
  border: 1rpx solid rgba(220, 38, 38, 0.18);
}

.join-state__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff4e5;
  color: #b45309;
  font-size: 40rpx;
  font-weight: 900;
}

.join-state--error .join-state__icon {
  background: #fef2f2;
  color: #dc2626;
}

.join-state__title {
  display: block;
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.join-state__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #667085;
}

.join-footer {
  margin-top: 32rpx;
  text-align: center;
}

.join-footer__hint {
  font-size: 24rpx;
  color: #98a2b3;
}

.join-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 800;
  background: rgba(15, 23, 42, 0.42);
}

.join-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 801;
  padding: 18rpx 32rpx 44rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 -18rpx 48rpx rgba(15, 23, 42, 0.16);
}

.join-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  margin: 0 auto 24rpx;
  background: #d0d5dd;
}

.join-sheet__title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #172033;
}

.join-sheet__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667085;
}

.join-team-list {
  margin-top: 24rpx;
}

.join-team-item {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: #f6f7f9;
}

.join-team-item__name {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
}

.join-team-item__id {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #98a2b3;
  font-family: monospace;
}

.join-sheet__cancel {
  height: 82rpx;
  border-radius: 22rpx;
  background: #eef1f5;
  color: #475467;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}
