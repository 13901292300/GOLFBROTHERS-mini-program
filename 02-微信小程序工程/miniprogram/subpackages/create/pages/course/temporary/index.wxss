.temp-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
}
.temp-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --border: #222222;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --text-disabled: #555555;
  --shadow-card: none;
}
.temp-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --text-disabled: #9ca3af;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.temp-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

.content { flex: 1; padding: 32rpx; box-sizing: border-box; overflow-y: auto; }

.section { margin-bottom: 40rpx; }
.section-label { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; gap: 24rpx; }
.section-label__h2 { font-size: 28rpx; line-height: 1.5; font-weight: 700; color: var(--text-secondary); }
.course-chips {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.course-chip {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-secondary);
}
.course-chip.is-on {
  border-color: var(--champion-gold);
  background: rgba(206, 146, 36, 0.12);
  color: var(--text-primary);
}

.ds-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16rpx; box-shadow: var(--shadow-card); }
.ds-field { min-height: 112rpx; padding: 0 32rpx; display: flex; align-items: center; }
.field-main { min-width: 0; flex: 1; }
.name-input { width: 100%; height: 80rpx; padding: 0; border: 0; background: transparent; color: var(--text-primary); font-size: 32rpx; font-weight: 800; }
.name-ph { color: var(--text-disabled); font-weight: 700; }

.par-grid {
  display: grid;
  grid-template-columns: repeat(9, minmax(0, 1fr));
  gap: 10rpx;
}
.par-cell {
  min-width: 0;
  padding: 12rpx 0;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: var(--bg-card);
  text-align: center;
}
.par-cell.filled { border-color: var(--champion-gold); background: rgba(206, 146, 36, 0.1); }
.par-cell__hole { display: block; font-size: 18rpx; font-weight: 700; color: var(--text-muted); }
.par-input {
  width: 100%;
  height: 48rpx;
  padding: 0;
  margin-top: 2rpx;
  border: 0;
  background: transparent;
  text-align: center;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
}
.par-ph { color: var(--text-disabled); font-weight: 800; }
.subtotal-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 8rpx;
}
.subtotal-label { font-size: 24rpx; font-weight: 700; color: var(--text-muted); }
.subtotal-value { font-size: 32rpx; font-weight: 900; color: var(--text-primary); font-style: italic; }

.total-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}
.total-label { font-size: 28rpx; font-weight: 700; color: var(--text-secondary); }
.total-value { font-size: 44rpx; font-weight: 900; color: var(--text-primary); font-style: italic; }
.par-error {
  margin: 0 8rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #b45309;
  line-height: 1.5;
}

.footer {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border);
}
.confirm-btn {
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.confirm-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}
