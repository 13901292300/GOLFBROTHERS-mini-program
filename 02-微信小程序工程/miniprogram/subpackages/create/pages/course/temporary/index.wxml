<view class="temp-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">COURSE</text>
          <text class="gb-header__title">临时球场</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="content" scroll-y>
    <view class="section">
      <view class="section-label"><text class="section-label__h2">球场名称（选填）</text></view>
      <view class="ds-card ds-field">
        <view class="field-main">
          <input
            class="name-input"
            type="text"
            value="{{courseName}}"
            placeholder="不填则显示为「临时球场」"
            placeholder-class="name-ph"
            bindinput="onNameInput"
          />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-label">
        <text class="section-label__h2">COURSE 1</text>
      </view>
      <view class="course-chips">
        <view
          wx:for="{{courseKeys}}"
          wx:key="*this"
          class="course-chip {{front9Course === item ? 'is-on' : ''}}"
          bindtap="onSelectFrontCourse"
          data-key="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
      <view class="par-grid">
        <view
          wx:for="{{frontHoles}}"
          wx:key="hole"
          class="par-cell {{item.filled ? 'filled' : ''}}"
        >
          <text class="par-cell__hole">{{item.hole}}</text>
          <input
            class="par-input"
            type="number"
            maxlength="1"
            value="{{item.parText}}"
            placeholder="—"
            placeholder-class="par-ph"
            focus="{{focusedHoleIndex === item.index}}"
            bindfocus="onParFocus"
            bindinput="onParInput"
            data-index="{{item.index}}"
          />
        </view>
      </view>
      <view class="subtotal-row">
        <text class="subtotal-label">前九 PAR</text>
        <text class="subtotal-value">{{front9ParTotal}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-label">
        <text class="section-label__h2">COURSE 2</text>
      </view>
      <view class="course-chips">
        <view
          wx:for="{{courseKeys}}"
          wx:key="*this"
          class="course-chip {{back9Course === item ? 'is-on' : ''}}"
          bindtap="onSelectBackCourse"
          data-key="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
      <view class="par-grid">
        <view
          wx:for="{{backHoles}}"
          wx:key="hole"
          class="par-cell {{item.filled ? 'filled' : ''}}"
        >
          <text class="par-cell__hole">{{item.hole}}</text>
          <input
            class="par-input"
            type="number"
            maxlength="1"
            value="{{item.parText}}"
            placeholder="—"
            placeholder-class="par-ph"
            focus="{{focusedHoleIndex === item.index}}"
            bindfocus="onParFocus"
            bindinput="onParInput"
            data-index="{{item.index}}"
          />
        </view>
      </view>
      <view class="subtotal-row">
        <text class="subtotal-label">后九 PAR</text>
        <text class="subtotal-value">{{back9ParTotal}}</text>
      </view>
    </view>

    <view class="total-row">
      <text class="total-label">TOTAL PAR</text>
      <text class="total-value">{{totalPar}}</text>
    </view>
    <view wx:if="{{duplicateCourseParError}}" class="par-error">相同 COURSE 的标准 PAR 必须一致</view>
  </scroll-view>

  <view class="footer">
    <button class="confirm-btn {{canConfirm ? '' : 'disabled'}}" bindtap="onConfirm">确认临时球场</button>
  </view>
</view>
