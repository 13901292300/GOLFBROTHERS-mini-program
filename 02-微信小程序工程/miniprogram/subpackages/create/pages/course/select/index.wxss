/* 选择球场页 —— HEADER / TAB / 卡片 视觉规范与赛事详情、普通创建完全统一 */

/* ===== 品牌色 + 主题 Token（与系统一致） ===== */
.course-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00AEEF;
}
.course-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --bg-hover: #1a1a1a;
  --border: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --shadow-card: none;
}
.course-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --bg-hover: #f9fafb;
  --border: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.course-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow-x: hidden;
}

/* ===== 标准 Header（与赛事详情页一致） ===== */
.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

/* ===== 搜索栏（圆角 input + 左侧放大镜 + 清除按钮，双主题适配） ===== */
.search-bar-wrap { flex-shrink: 0; background: var(--bg-primary); padding: 20rpx 32rpx; }
.search-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
}
.search-bar__icon { font-size: 28rpx; color: var(--text-muted); flex-shrink: 0; }
.search-bar__input { flex: 1; min-width: 0; font-size: 28rpx; color: var(--text-primary); }
.search-bar__ph { color: var(--text-muted); }
.search-bar__clear {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: var(--border-hover);
  color: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

/* 搜索结果卡片：名称 + 来源标签 */
.course-card__title-row { display: flex; align-items: center; gap: 14rpx; }
.course-source-tag {
  flex-shrink: 0;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  border: 1px solid transparent;
}
.course-source-tag.source-freq { color: var(--champion-gold); border-color: rgba(206, 146, 36, 0.4); background: rgba(206, 146, 36, 0.12); }
.course-source-tag.source-near { color: var(--data-blue); border-color: rgba(0, 174, 239, 0.4); background: rgba(0, 174, 239, 0.12); }
.course-source-tag.source-db { color: var(--text-muted); border-color: var(--border); background: var(--bg-subtle); }

/* ===== 吸顶 TAB（与赛事页 TAB 体系一致：金色指示线、深蓝底） ===== */
.tab-scroll-wrap { background: var(--tour-blue); flex-shrink: 0; }
.gb-tabs {
  height: var(--tab-height);
  background: var(--tour-blue);
  white-space: nowrap;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 20rpx 24rpx rgba(0, 0, 0, 0.18);
  display: flex;
  align-items: stretch;
}
/* 统一基线：flex 垂直居中（line-height:1），指示器以容器底边为基线 */
.tab-btn {
  position: relative;
  height: var(--tab-height);
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 50%;
  min-width: 0;
  text-align: center;
  font-size: var(--tab-font-size);
  color: rgba(255, 255, 255, 0.6);
  white-space: nowrap;
}
.tab-btn.active { color: #fff; }
.tab-btn.active::after {
  content: "";
  position: absolute;
  height: var(--tab-indicator-height);
  width: 112rpx;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  background: var(--tab-indicator-color);
  opacity: 1;
  border-radius: 999rpx;
}

/* ===== 列表 ===== */
.course-scroll { flex: 1; min-height: 0; }
.course-list { padding: 32rpx; display: flex; flex-direction: column; gap: 20rpx; }

/* 卡片：圆角 / 描边 / 顶边色与系统 ds-card 一致 */
.ds-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 6rpx solid var(--tour-blue);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.course-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
}
.course-card.selected {
  border-color: var(--champion-gold);
  border-top-color: var(--champion-gold);
}
.course-card__main { flex: 1; min-width: 0; }
.course-card__name {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
  letter-spacing: -0.01em;
  line-height: 1.3;
}
.course-card__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.4;
}

/* 右侧选择状态：未选空心圈，选中金色实心 ✓ */
.course-card__check {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
.course-card__check.on {
  background: var(--champion-gold);
  border-color: var(--champion-gold);
}

.course-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: var(--text-muted);
  font-size: 24rpx;
}
.course-empty__text { display: block; }
.temp-course-btn {
  margin: 32rpx auto 0;
  width: 360rpx;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--champion-gold);
  color: var(--champion-gold);
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.net-banner {
  margin: 16rpx 24rpx 8rpx;
  padding: 24rpx 24rpx 28rpx;
  border-radius: 16rpx;
  background: var(--bg-card, rgba(0, 0, 0, 0.04));
  box-sizing: border-box;
}
.net-banner__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.net-banner__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

/* ===== 二级弹窗：选择半场（全屏覆盖，HEADER 统一，双主题继承自 .course-page） ===== */
.half-popup {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}
.half-body { flex: 1; min-height: 0; padding: 48rpx 24rpx; box-sizing: border-box; width: 100%; overflow-x: hidden; }
.half-course-name {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1.3;
}
.half-hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.half-split {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 56rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}
.half-col {
  flex: 1 1 0;
  min-width: 0;
  max-width: 50%;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 6rpx solid var(--tour-blue);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
  padding: 28rpx 20rpx;
}
.half-col__title {
  display: block;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.half-tags { display: flex; flex-direction: column; gap: 16rpx; width: 100%; }
.half-tag {
  width: 100%;
  max-width: 100%;
  min-height: 80rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-secondary);
}
.half-tag__code { font-size: 28rpx; font-weight: 800; line-height: 1.2; }
.half-tag__name {
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 600;
  opacity: 0.75;
  line-height: 1.2;
  max-width: 100%;
  word-break: break-word;
}
.half-tag.active {
  background: var(--tour-blue);
  color: #fff;
  border-color: var(--tour-blue);
  box-shadow: inset 0 -6rpx 0 var(--champion-gold);
}

/* ===== 标准 PAR 值表（与半场选择联动高亮，同宽对齐、不溢出） ===== */
.par-table { width: 100%; box-sizing: border-box; margin-top: 48rpx; }
.par-table__title {
  display: block;
  font-size: 22rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 0.18em;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}
.par-row {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: transparent;
  opacity: 0.55;
}
.par-row + .par-row { margin-top: 12rpx; }
.par-row__head { display: flex; align-items: center; gap: 16rpx; width: 100%; }
.par-row__code { flex: 0 0 auto; width: 72rpx; font-size: 26rpx; font-weight: 800; color: var(--text-secondary); }
.par-row__name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.par-row__tags { flex: 0 0 auto; display: flex; gap: 8rpx; }
.par-side-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: var(--tour-blue);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
}
.par-row__total { flex: 0 0 auto; font-size: 22rpx; font-weight: 900; color: var(--text-primary); }

/* 逐洞 PAR：横向小格子，自动换行适配（与 hole index 1:1 对齐） */
.par-hole-row { display: flex; flex-wrap: wrap; gap: 10rpx; width: 100%; }
.par-hole-cell {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 8rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

/* 选中态：PGA 蓝体系浅底 + 字体加深 + 编号强调（按主题适配可读性） */
.par-row.active { opacity: 1; }
.course-page.bright-mode .par-row.active {
  background: rgba(0, 45, 98, 0.08);
  border-color: var(--tour-blue);
}
.course-page.bright-mode .par-row.active .par-row__code { color: var(--tour-blue); }
.course-page.dark-mode .par-row.active {
  background: rgba(0, 174, 239, 0.12);
  border-color: var(--data-blue);
}
.course-page.dark-mode .par-row.active .par-row__code { color: var(--data-blue); }
.course-page.dark-mode .par-side-tag { background: var(--data-blue); color: #001; }

/* 底部操作栏：透明悬浮（无背景块/无边框/无阴影），固定在 viewport 底部，不随内容滚动 */
.half-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
  border: none;
  box-shadow: none;
}
/* 主按钮（Primary Action）：PGA 蓝、12rpx 圆角、与系统 sheet-confirm-btn 统一 */
.half-confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}
.half-confirm-btn::after { border: none; }
.half-confirm-btn:active { transform: scale(0.98); }
.half-confirm-btn.is-disabled {
  background: var(--bg-hover);
  color: var(--text-muted);
}
/* 内容区为透明悬浮按钮预留空间，避免遮挡 */
.half-body { padding-bottom: 200rpx; }
