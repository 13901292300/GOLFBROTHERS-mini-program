  gap: 12rpx 20rpx;
}

.swatch {
  position: relative;
  flex: 0 0 60rpx;
  flex-shrink: 0;
  width: 60rpx;
  min-width: 60rpx;
  max-width: 60rpx;
  height: 60rpx;
  min-height: 60rpx;
  max-height: 60rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid var(--border-hover);
  border-radius: 50%;
  box-shadow: inset 0 0 0 3rpx #ffffff;
}

.swatch.active {
  border-color: #ce9224;
  box-shadow: 0 0 0 6rpx #002d62, inset 0 0 0 3rpx #ffffff;
  transform: scale(1.08);
}

.swatch.active::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #ce9224;
  box-shadow: 0 2rpx 6rpx rgba(0, 45, 98, 0.4);
  content: "";
  transform: translate(-50%, -50%);
}

.swatch.muted[disabled] {
  background: var(--border) !important;
  filter: grayscale(1);
  opacity: 0.48;
}

.swatch.locked[disabled] {
  opacity: 1;
}

.swatch.locked::after {
  display: none;
}

.lock-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 14rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: #002d62;
  box-shadow: 0 0 0 1rpx #ffffff;
  transform: translate(-50%, -24%);
}

.lock-icon::before {
  position: absolute;
  top: -9rpx;
  left: 3rpx;
  width: 8rpx;
  height: 10rpx;
  border: 3rpx solid #002d62;
  border-bottom: 0;
  border-radius: 8rpx 8rpx 0 0;
  content: "";
}

.lock-icon::after {
  position: absolute;
  top: 3rpx;
  left: 6rpx;
  width: 3rpx;
  height: 5rpx;
  border-radius: 2rpx;
  background: #ce9224;
  content: "";
}

