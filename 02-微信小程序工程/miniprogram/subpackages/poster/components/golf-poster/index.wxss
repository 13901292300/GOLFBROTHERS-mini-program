  background: #002d62;
}

.rotate-knob__arc {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 22rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -11rpx;
  border: 3rpx solid #002d62;
  border-top-color: transparent;
  border-radius: 50%;
  transform: rotate(20deg);
}

