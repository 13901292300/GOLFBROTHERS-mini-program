/* GOLFBROTHERS Design System V3.0 — golf-poster chrome only.
 * Layout / interaction selectors unchanged. Poster-art mock gradients kept. */

:host {
  display: block;
  height: 100%;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  border-radius: 6px; /* 规范四：按钮圆角 */
  font: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.38;
}

.poster-shell {
  --navy: #002d62;
  --navy-2: #002d62;
  --yellow: #ce9224;
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00AEEF;
  --type-title: 32rpx;
  --type-section: 28rpx;
  --type-label: 26rpx;
  --type-body: 24rpx;
  --type-hint: 22rpx;
  --type-meta: 20rpx;
  --lh-body: 36rpx;
  --lh-hint: 32rpx;
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.poster-shell.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --bg-hover: #f9fafb;
  --border: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --text-disabled: #9ca3af;
  --paper: #f3f4f6;
  --white: #ffffff;
  --ink: #002d62;
  --muted: #6b7280;
  --line: #e5e7eb;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

.poster-shell.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --bg-hover: #1a1a1a;
  --border: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --text-muted: #888888;
  --text-disabled: #555555;
  --paper: #111111;
  --white: #ffffff;
  --ink: #f1f5f9;
  --muted: #888888;
  --line: #222222;
  --shadow-card: none;
}

/* 规范三：HEADER */
.topbar {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
  height: 98rpx;
  padding: 0 32rpx; /* 规范八：页面水平内边距 */
  border-bottom: 2px solid #ce9224;
  background: #002d62;
  color: #ffffff;
}

.brand-lockup {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  min-width: 0;
  gap: 14rpx;
}

.brand-lockup > view:last-child {
  display: flex;
  flex-direction: column;
}

.brand-flag {
  position: relative;
  width: 5rpx;
  height: 52rpx;
  background: #ffffff;
}

.brand-flag::after {
  position: absolute;
  top: 3rpx;
  left: 8rpx;
  width: 0;
  height: 0;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 42rpx solid #ce9224; /* 规范一：金色装饰 */
  content: "";
}

.brand-name {
  display: block;
  padding-left: 46rpx;
  font-size: 32rpx; /* 规范三：标题 32rpx */
  font-style: italic;
  font-weight: 900;
  line-height: 1;
}

.brand-name text {
  color: #ce9224; /* 规范三：标题金色装饰字 */
}

.brand-studio {
  display: block;
  padding-left: 46rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
}

.topbar-actions {
  display: flex;
  flex: 0 0 146rpx;
  align-items: center;
  justify-content: flex-end;
  width: 146rpx;
  gap: 10rpx;
}

.language-button,
.reset-button {
  height: 58rpx;
  border: 1rpx solid var(--border);
  background: transparent;
  color: var(--text-primary);
}

.language-button {
  flex: 0 0 78rpx;
  width: 78rpx;
  min-width: 78rpx;
  max-width: 78rpx;
  padding: 0 18rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.reset-button {
  position: relative;
  flex: 0 0 58rpx;
  width: 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  padding: 0;
}

.reset-icon {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  width: 25rpx;
  height: 25rpx;
  border: 5rpx solid var(--text-primary);
  border-left-color: transparent;
  border-radius: 50%;
}

.reset-icon::before {
  position: absolute;
  top: -7rpx;
  left: -7rpx;
  width: 0;
  height: 0;
  border-top: 7rpx solid transparent;
  border-right: 10rpx solid var(--text-primary);
  border-bottom: 7rpx solid transparent;
  content: "";
  transform: rotate(24deg);
}

.template-screen,
.editor-screen {
  height: 100%;
}

.template-screen {
  display: flex;
  flex-direction: column;
  background: var(--bg-primary); /* 规范一：浅底 */
}

.template-heading {
  display: flex;
  flex-direction: column;
  padding: 16rpx 32rpx 20rpx;
  color: var(--text-primary);
}

.template-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
}

.step-kicker {
  color: #ce9224; /* 规范六：当前步骤强调 */
  font-size: 19rpx;
  font-weight: 900;
}

.page-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.template-scroll {
  flex: 1;
  min-height: 0;
}

.template-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 32rpx 26rpx;
}

/* 规范五：卡片 */
.template-card {
  display: flex;
  flex: 0 0 342rpx;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  width: 342rpx;
  min-width: 0;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1px solid var(--border);
  border-top: 6rpx solid #002d62;
  border-radius: 16rpx;
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  color: var(--text-primary);
  text-align: left;
}

.template-card.selected {
  border-color: #ce9224;
  border-top-color: #002d62;
  box-shadow: var(--shadow-card), inset 0 0 0 2rpx rgba(206, 146, 36, 0.28);
}

.template-art {
  position: relative;
  display: block;
  flex: 0 0 auto;
  box-sizing: border-box;
  width: 100%;
  height: auto;
  aspect-ratio: 1000 / 1265;
  overflow: hidden;
  border-radius: 10rpx;
  background: linear-gradient(160deg, #547b63, #14271d);
}

.template-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

.tone-dark {
  background: linear-gradient(160deg, #28392d, #070908);
}

.tone-soft {
  background: linear-gradient(160deg, #88aa90, #244933);
}

.tone-editorial {
  background: linear-gradient(90deg, #17271e, #59725e);
}

.tone-natural {
  background: linear-gradient(160deg, #78a17e, #253d2a);
}

.template-brand-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 25rpx;
  border-bottom: 2px solid #ce9224;
  background: #002d62;
}

.template-brand-line::before {
  position: absolute;
  top: 7rpx;
  left: 16rpx;
  width: 54rpx;
  height: 5rpx;
  background: #ffffff;
  content: "";
}

.template-brand-line::after {
  position: absolute;
  top: 7rpx;
  left: 74rpx;
  width: 36rpx;
  height: 5rpx;
  background: #ce9224;
  content: "";
}

.template-total {
  position: absolute;
  top: 38rpx;
  left: 0;
  right: 0;
  z-index: 1;
  font-size: 125rpx;
  font-weight: 800;
  font-style: italic;
  line-height: 1;
  text-align: center;
}

.template-subject {
  position: absolute;
  bottom: 22rpx;
  left: 50%;
  z-index: 2;
  width: 104rpx;
  height: 205rpx;
  border-radius: 50rpx 50rpx 8rpx 8rpx;
  background: rgba(230, 234, 232, 0.94);
  transform: translateX(-50%);
}

.template-subject::before {
  position: absolute;
  top: -44rpx;
  left: 28rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: inherit;
  content: "";
}

.template-score {
  position: absolute;
  right: 25rpx;
  bottom: 32rpx;
  left: 25rpx;
  z-index: 3;
  display: flex;
  height: 52rpx;
  border: 1rpx solid;
  opacity: 0.88;
}

.template-score.direction-horizontal {
  flex-direction: column;
}

.template-score.direction-horizontal view {
  flex: 1 1 0;
}

.template-score.direction-horizontal view:first-child {
  border-bottom: 1rpx solid currentColor;
}

.template-score.direction-vertical {
  top: 105rpx;
  right: 25rpx;
  bottom: 28rpx;
  left: auto;
  flex-direction: row;
  width: 60rpx;
  height: auto;
}

.template-score.direction-vertical view {
  flex: 1 1 0;
}

.template-score.direction-vertical view:first-child {
  border-right: 1rpx solid currentColor;
}

.template-card-copy {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  gap: 10rpx;
  padding: 16rpx 8rpx 10rpx;
}

.template-card-copy > view:first-child {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.template-card-copy > view:first-child text + text {
  margin-top: 7rpx;
}

.template-name,
.template-description {
  display: block;
}

.template-name {
  font-size: 25rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.template-description {
  overflow: hidden;
  color: var(--text-muted);
  font-size: 18rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radio-mark {
  display: flex;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  background: var(--border); /* 规范六：未选中步骤圆点 */
}

.template-card.selected .radio-mark {
  border-color: #ce9224;
  background: #ce9224;
}

.radio-mark view {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
}

.template-footer,
.wizard-footer {
  display: flex;
  flex: 0 0 auto;
  box-sizing: border-box;
  gap: 14rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--border);
  background: var(--bg-card);
}

.primary-action,
.back-action {
  height: 76rpx;
  min-height: 76rpx;
  max-height: 76rpx;
  font-size: 14px;
}

/* 规范四：主操作 */
.primary-action {
  flex: 1 1 0;
  padding: 10px 32px;
  border-radius: 6px;
  background: #ce9224;
  color: #ffffff;
  font-weight: 900;
  font-style: italic;
}

.primary-action[disabled] {
  background: var(--bg-hover);
  color: var(--text-muted);
  opacity: 1;
}

.button-arrow {
  margin-left: 18rpx;
  font-size: 38rpx;
  vertical-align: -2rpx;
}

.editor-screen {
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
}

.preview-zone {
  display: flex;
  flex: 0 0 578rpx;
  flex-direction: column;
  box-sizing: border-box;
  padding: 12rpx 32rpx 10rpx;
  border-bottom: 2px solid #ce9224;
  background: var(--bg-subtle);
  color: var(--text-primary);
}

.preview-zone--large {
  flex: 1 1 auto;
  min-height: 0;
  padding: 0;
  border-bottom: 0;
  background: #1a1a1a;
}

.preview-zone--large .canvas-frame-slot {
  flex: 1;
  min-height: 0;
  height: auto;
  overflow: hidden;
}

.nudge-dock {
  position: relative;
  z-index: 20;
  flex: 0 0 196rpx;
  padding: 8rpx 32rpx 12rpx;
  background: #1a1a1a;
}

.nudge-dock-label {
  display: block;
  margin-bottom: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--type-hint);
  font-weight: 400;
  line-height: var(--lh-hint);
  text-align: center;
}

.nudge-cross {
  position: relative;
  width: 280rpx;
  height: 196rpx;
  margin: 0 auto;
}

.nudge-cross .nudge-btn {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 64rpx;
  padding: 0;
  border: 0;
  border-radius: 12rpx;
  background: #ce9224;
}

.nudge-arrow {
  width: 0;
  height: 0;
}

.nudge-arrow-up {
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #002d62;
}

.nudge-arrow-down {
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 22rpx solid #002d62;
}

.nudge-arrow-left {
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-right: 22rpx solid #002d62;
}

.nudge-arrow-right {
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #002d62;
}

.nudge-up {
  top: 0;
  left: 98rpx;
}

.nudge-down {
  bottom: 0;
  left: 98rpx;
}

.nudge-left {
  top: 66rpx;
  left: 0;
}

.nudge-right {
  top: 66rpx;
  right: 0;
}

.control-area.preview-disabled {
  flex: 0 0 28%;
  max-height: 28%;
}

.preview-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 54rpx;
}

.preview-toolbar > view {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-toolbar-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.preview-title {
  font-size: 23rpx;
  font-weight: 900;
  color: var(--text-primary);
}

/* 规范四：次要 / 文字链 */
.preview-text-button,
.preview-close-button {
  min-width: 80rpx;
  height: 46rpx;
  padding: 0 16rpx;
  border: 0;
  background: transparent;
  color: var(--data-blue);
  font-size: 11px;
  font-weight: 700;
}

.canvas-frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 460rpx;
}

.canvas-frame-slot {
  height: 460rpx;
}

/* 规范九：保留 Canvas 尺寸，边框阴影对齐卡片 */
.poster-canvas {
  box-sizing: content-box;
  width: calc(450rpx * 1000 / 1265);
  height: 450rpx;
  background: #080b09;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.seg-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
  background: rgba(0, 0, 0, 0.6);
  padding: 40rpx 60rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 24rpx;
}

.seg-loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: seg-spin 0.8s linear infinite;
}

@keyframes seg-spin {
  to { transform: rotate(360deg); }
}

.gesture-hint {
  display: block;
  height: 38rpx;
  color: var(--text-muted);
  font-size: var(--type-hint);
  font-weight: 400;
  line-height: 38rpx;
  text-align: center;
}

.control-scroll {
  flex: 1;
  min-height: 0;
}

.control-area {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
}

.control-area .control-scroll {
  flex: 1;
  min-height: 0;
}

.preview-overlay {
  position: absolute;
  inset: 0;
  z-index: 15;
  background: rgba(0, 0, 0, 0.6);
}

.preview-disabled .control-scroll,
.preview-disabled .wizard-footer {
  pointer-events: none;
  filter: grayscale(0.35) blur(1px);
  opacity: 0.55;
}

.control-panel {
  display: flex;
  flex-direction: column;
  padding: 28rpx 32rpx 40rpx; /* 规范八 */
}

.control-panel > view,
.control-panel > button,
.control-panel > text,
.control-panel > scroll-view {
  flex: 0 0 auto;
}

.control-panel > .action-row,
.control-panel > .control-card,
.control-panel > .recognition-card,
.control-panel > .inline-fields,
.control-panel > .color-settings,
.control-panel > .identity-tabs,
.control-panel > .empty-note,
.control-panel > .sticker-list,
.control-panel > .danger-action,
.control-panel > .free-edit-action,
.control-panel > .summary-grid,
.control-panel > .download-action,
.control-panel > .tab-bar,
.control-panel > .config-panel {
  margin-top: 24rpx; /* 规范八：区块间距 */
}

.panel-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 18rpx;
  border-bottom: 1px solid var(--border);
}

/* 规范六：当前步骤数字（wxml 每屏只渲染当前步，无法画连线） */
.panel-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ce9224;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
}

.panel-heading > view {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.panel-heading > view text + text {
  margin-top: 5rpx;
}

.panel-title,
.panel-copy {
  display: block;
}

.panel-title {
  color: var(--text-primary);
  font-size: var(--type-title);
  font-weight: 800;
  line-height: 44rpx;
}

.panel-copy {
  color: var(--text-muted);
  font-size: var(--type-hint);
  font-weight: 400;
  line-height: var(--lh-hint);
}

.action-row,
.inline-fields {
  display: flex;
  align-items: stretch;
}

.action-row > button,
.action-row > text,
.action-row > view,
.inline-fields > view {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.action-row > button + button,
.action-row > button + text,
.action-row > button + view,
.action-row > text + button,
.action-row > view + button,
.inline-fields > view + view {
  margin-left: 16rpx;
}

.upload-action,
.secondary-action,
.danger-action,
.download-action {
  height: 76rpx;
  min-height: 76rpx;
  max-height: 76rpx;
  font-size: 14px;
  border-radius: 6px;
}

.upload-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 17rpx;
  padding: 10px 32px;
  background: #ce9224;
  color: #ffffff;
  font-weight: 900;
  font-style: italic;
}

.brand-logo-thumb {
  width: 96rpx;
  height: 96rpx;
  margin-top: 16rpx;
  background: #000000;
  border-radius: 8rpx;
}

/* 规范四：次要操作 */
.secondary-action {
  padding: 10px 24px;
  border: 0;
  background: #002d62;
  color: #ffffff;
  font-weight: 700;
}

.upload-icon,
.download-icon {
  position: relative;
  width: 24rpx;
  height: 27rpx;
  border-bottom: 6rpx solid currentColor;
}

.upload-icon::before,
.download-icon::before {
  position: absolute;
  left: 9rpx;
  width: 6rpx;
  height: 23rpx;
  background: currentColor;
  content: "";
}

.upload-icon::after {
  position: absolute;
  top: -2rpx;
  left: 3rpx;
  width: 15rpx;
  height: 15rpx;
  border-top: 6rpx solid currentColor;
  border-left: 6rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.download-icon::after {
  position: absolute;
  top: 8rpx;
  left: 3rpx;
  width: 15rpx;
