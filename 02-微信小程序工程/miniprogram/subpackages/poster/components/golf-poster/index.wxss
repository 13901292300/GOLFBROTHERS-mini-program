.dpad-entry {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  z-index: 2;
  box-sizing: border-box;
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  min-height: 64rpx;
  max-width: 64rpx;
  max-height: 64rpx;
  padding: 0;
  margin: 0;
  border: 2rpx solid #ce9224;
  border-radius: 50%;
  background: #002d62;
  box-shadow: 0 4rpx 10rpx rgba(0, 45, 98, 0.22);
}

.dpad-entry::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #ce9224;
