  position: absolute;
  top: 10rpx;
  right: 13rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 6rpx 10rpx 6rpx;
  border-color: transparent transparent #002d62 transparent;
  transform: rotate(78deg);
}

.rotate-knob.active .rotate-knob__tip {
  border-color: transparent transparent #ffd100 transparent;
}

.identity-tabs button {
