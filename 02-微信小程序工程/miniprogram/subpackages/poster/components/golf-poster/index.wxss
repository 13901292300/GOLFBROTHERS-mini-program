  font-size: var(--type-hint);
  font-weight: 400;
  line-height: var(--lh-hint);
  text-align: center;
}

.sticker-list {
  width: 100%;
}

.sticker-row {
  display: flex;
  gap: 12rpx;
  padding: 5rpx;
}

.sticker-item {
  display: flex;
  flex: 0 0 110rpx;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  padding: 8rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--bg-card);
}

.sticker-item.active {
  border-color: var(--text-primary);
  box-shadow: 0 0 0 3rpx #ce9224;
}

.sticker-item image {
  width: 90rpx;
  height: 90rpx;
}

.danger-action {
  border: 2rpx solid #dc2626;
  background: var(--bg-card);
  color: #dc2626;
}

.summary-panel {
  padding-bottom: 60rpx;
}

.free-edit-action {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx 32rpx;
  border: 1px solid var(--border);
  border-top: 6rpx solid #002d62;
  border-radius: 16rpx;
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  color: var(--text-primary);
  text-align: left;
}

.free-edit-action > view:last-child {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  min-width: 0;
  margin-left: 20rpx;
}

.free-edit-action > view:last-child text + text {
  margin-top: 7rpx;
}

.free-edit-action text:first-child {
  font-size: var(--type-body);
  font-weight: 800;
}

.free-edit-action text:last-child {
  color: var(--text-muted);
  font-size: var(--type-hint);
  font-weight: 400;
  line-height: var(--lh-hint);
}

.edit-icon {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #002d62;
}

.edit-icon::after {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 22rpx;
  height: 6rpx;
  background: #ce9224;
  content: "";
  transform: rotate(-45deg);
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.summary-grid button {
  flex: 0 0 319rpx;
  width: 319rpx;
  margin-bottom: 16rpx;
  height: 68rpx;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #002d62;
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
}

.download-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  height: 90rpx;
  padding: 10px 32px;
  background: #ce9224;
  color: #ffffff;
  font-weight: 900;
  font-style: italic;
}

.wizard-footer {
  flex: 0 0 auto;
}

.back-action {
  flex: 0 0 205rpx;
  padding: 10px 24px;
  border: 0;
  background: #002d62;
  color: #ffffff;
  font-weight: 700;
}

.back-action text {
  margin-right: 14rpx;
  font-size: 38rpx;
  vertical-align: -2rpx;
}

.canvas-frame--fullscreen {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1a1a1a;
}

.canvas-frame--fullscreen .poster-canvas {
  max-width: 100%;
  max-height: 100%;
  background: #080b09;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.large-edit-close {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  top: auto;
  z-index: 16;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #002d62;
  box-shadow: 0 8rpx 16rpx rgba(0, 45, 98, 0.28);
}

.large-edit-close .close-icon {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.large-edit-controls {
  display: flex;
  flex: 0 0 250rpx;
  flex-direction: column;
  width: 100%;
  padding-top: 8rpx;
}

.large-edit-controls > scroll-view,
.large-edit-controls > .control-card {
  margin-top: 10rpx;
}

.active-element-line {
  color: var(--text-primary);
  font-size: 19rpx;
  font-weight: 800;
}

.active-element-line text:last-child {
  color: #ce9224;
}

.edit-targets {
  width: 100%;
}

.edit-target-row {
  display: flex;
  gap: 8rpx;
}

.edit-target-row button {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 18rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-muted);
  font-size: 18rpx;
  font-weight: 800;
}

.edit-target-row button.active {
  border-color: #ce9224;
  background: #ce9224;
  color: #ffffff;
}

.compact .control-label,
.compact .control-label text:last-child {
  color: var(--text-primary);
}

.template-modal {
  position: fixed;
  z-index: 40;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 45, 98, 0.45);
}

.poster-shell.dark-mode .modal-backdrop {
  background: rgba(0, 0, 0, 0.72);
}

.modal-dialog {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 650rpx;
  padding: 32rpx;
  border: 1px solid var(--border);
  border-top: 6rpx solid #002d62;
  border-radius: 16rpx;
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  color: var(--text-primary);
}

.modal-dialog > .modal-canvas-frame,
.modal-dialog > .primary-action {
  margin-top: 24rpx;
}

.modal-heading {
  display: flex;
  flex: 0 0 54rpx;
  align-items: center;
  justify-content: space-between;
  min-height: 54rpx;
}

.modal-heading > view {
  display: flex;
  flex-direction: column;
}

.modal-heading > view text + text {
  margin-top: 6rpx;
}

.modal-heading > view text:last-child {
  font-size: 28rpx;
  font-weight: 900;
  font-style: italic;
}

.modal-heading button {
  flex: 0 0 54rpx;
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  max-height: 54rpx;
  padding: 0;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-primary);
  font-size: 40rpx;
}

.modal-dialog > .primary-action {
  flex: 0 0 76rpx;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  min-height: 76rpx;
  max-height: 76rpx;
  padding: 0 24rpx;
  line-height: 1.2;
}

.modal-canvas-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 760rpx;
  background: var(--bg-subtle);
  border-radius: 16rpx;
}

.modal-tools {
  display: flex;
  justify-content: center;
}

.modal-tools .style-btn {
  min-width: 240rpx;
}

.template-preview-canvas {
  width: 570rpx;
  height: calc(570rpx * 1265 / 1000);
  background: #080b09;
}

@media (max-height: 700px) {
  .preview-zone {
    flex-basis: 500rpx;
  }

  .canvas-frame-slot,
  .canvas-frame {
    height: 384rpx;
  }

  .poster-canvas {
    width: calc(382rpx * 1000 / 1265);
    height: 382rpx;
  }

  .large-edit-controls {
    flex-basis: 220rpx;
  }
}

.share-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.share-panel {
  width: 100%;
  padding: 40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: var(--bg-card);
}

.share-title {
  margin-bottom: 32rpx;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.share-options {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0 32rpx;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
}

.share-option:active {
  background: var(--bg-subtle);
}

.share-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--bg-subtle);
}

.share-icon {
  font-size: 48rpx;
}

.share-label {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.share-close {
  margin-top: 8rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--border);
  color: var(--text-muted);
  font-size: 28rpx;
  text-align: center;
}

.share-close:active {
  opacity: 0.6;
}
