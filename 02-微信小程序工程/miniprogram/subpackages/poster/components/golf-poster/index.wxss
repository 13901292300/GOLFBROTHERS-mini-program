  bottom: 8rpx;
  left: 50%;
  margin-left: -7rpx;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-top: 10rpx solid #ffffff;
}

.dpad-entry__arrow--left {
  top: 50%;
  left: 8rpx;
  margin-top: -7rpx;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  border-right: 10rpx solid #ffffff;
}

.dpad-entry__arrow--right {
  top: 50%;
  right: 8rpx;
  margin-top: -7rpx;
  border-top: 7rpx solid transparent;
  border-bottom: 7rpx solid transparent;
  border-left: 10rpx solid #ffffff;
}

