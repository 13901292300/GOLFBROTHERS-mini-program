<!-- 自定义导航栏 -->
<view class="poster-page {{themeClass}}">
<view class="gb-header" style="{{headerRootStyle}}">
  <view class="gb-header__inner" style="{{headerBarStyle}}">
    <view class="gb-header__left">
      <view bindtap="onBack" class="gb-header__back" aria-label="返回">
        <text class="gb-header__chevron">‹</text>
      </view>
      <view>
        <text class="gb-header__eyebrow">GOLF</text>
        <text class="gb-header__title">高尔夫海报</text>
      </view>
    </view>
  </view>
</view>

<!-- 海报组件：padding-top = headerEngine 算出的 headerTotalHeight，避免被固定顶栏遮挡 -->
<view class="poster-page-container" style="{{posterContainerStyle}}">
  <golf-poster
    id="golfPoster"
    round-id="{{roundId}}"
    bind:export="onPosterExport"
    bind:share="onPosterShare"
  />
</view>

<view wx:if="{{showLeaveSheet}}" class="leave-mask" catchtap="onLeaveContinue">
  <view class="leave-sheet" catchtap="stopLeaveBubble">
    <view class="leave-title">是否保存当前海报草稿？</view>
    <button class="leave-btn leave-btn-primary" bindtap="onLeaveSave" disabled="{{leaveBusy}}">保存并退出</button>
    <button class="leave-btn" bindtap="onLeaveDiscard" disabled="{{leaveBusy}}">不保存退出</button>
    <button class="leave-btn leave-btn-ghost" bindtap="onLeaveContinue" disabled="{{leaveBusy}}">继续编辑</button>
  </view>
</view>
</view>
