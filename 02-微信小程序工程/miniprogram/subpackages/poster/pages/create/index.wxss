page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg-primary, #fcfcfc);
}

.poster-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg-primary);
}

.poster-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --text-primary: #002d62;
}

.poster-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --text-primary: #f1f5f9;
}

.gb-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}

.gb-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gb-header__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.gb-header__back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gb-header__chevron {
  color: #fff;
  font-size: 52rpx;
  line-height: 1;
}

.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}

.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.poster-page-container {
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.poster-page-container golf-poster {
  display: block;
  width: 100%;
  height: 100%;
}

.leave-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.leave-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-card, #fff);
  border-radius: 24rpx 24rpx 0 0;
}

.leave-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #002d62);
  margin-bottom: 28rpx;
}

.leave-btn {
  width: 100%;
  margin: 0 0 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #f3f4f6;
  color: #111827;
}

.leave-btn-primary {
  background: #002d62;
  color: #fff;
}

.leave-btn-ghost {
  background: transparent;
  color: #6b7280;
}
