@import "../../styles/gb-shell.wxss";
@import "../../styles/game-ui.wxss";
@import "../config/index.wxss";
@import "../../styles/page-window.wxss";

.pick-top {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border);
}

.pick-top__meta {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 600;
}

.pick-top__actions {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.pick-link {
  font-size: 26rpx;
  color: var(--cloud-blue);
  font-weight: 700;
  padding: 8rpx 4rpx;
}

.pick-body {
  padding-bottom: 160rpx;
}

.pick-group {
  padding: 0 24rpx 8rpx;
}

.pick-group__label {
  margin: 20rpx 8rpx 12rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-muted);
}

.pick-group .player-grid,
.pick-group .player-grid--event {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 0;
  width: 100%;
  box-sizing: border-box;
}

.pick-group .player-slot {
  width: auto;
  max-width: none;
  flex: none;
  min-width: 0;
  box-sizing: border-box;
  opacity: 1;
  filter: none;
}

/* 本页：selected 只控边框，不置灰；勿沿用全局 .player-slot.off 的 opacity */
.pick-group .player-slot--selected {
  border-color: var(--champion-gold);
  opacity: 1;
  filter: none;
}

.pick-group .player-slot--idle {
  border-color: var(--border);
  opacity: 1;
  filter: none;
}

.pick-group .player-slot--disabled {
  opacity: 0.4;
  filter: none;
}

.pick-group .player-slot--selected .pick-face,
.pick-group .player-slot--idle .pick-face,
.pick-group .player-slot--selected .party-face__name,
.pick-group .player-slot--idle .party-face__name,
.pick-group .player-slot--selected .party-face__av,
.pick-group .player-slot--idle .party-face__av {
  opacity: 1;
  filter: none;
}

.pick-face {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  display: block;
  box-sizing: border-box;
}
