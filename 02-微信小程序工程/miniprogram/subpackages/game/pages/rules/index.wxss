@import "../../styles/gb-shell.wxss";
@import "../../styles/game-ui.wxss";

.gb-body--with-cta {
  padding-bottom: 160rpx;
}

.page-top-hint {
  margin: 0 0 20rpx;
}

.library-delete-hint {
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.6;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: anywhere;
  overflow-x: hidden;
  max-width: 100%;
  box-sizing: border-box;
}
