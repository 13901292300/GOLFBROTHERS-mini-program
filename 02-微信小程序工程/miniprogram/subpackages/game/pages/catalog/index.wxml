<view class="gb-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view class="gb-header__back" bindtap="onBack"><text class="gb-header__chevron">‹</text></view>
        <view>
          <text class="gb-header__eyebrow">ADD RULE</text>
          <text class="gb-header__title">选择玩法</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="gb-body catalog-scroll" scroll-y>
    <view class="page-pad catalog-page">
      <view class="sec-hint catalog-hint">{{emptyHint || "选一种玩法加入个人规则库。记分页只列出当前组容量内的 2–4 人玩法；完整库可从规则管理入口添加多人玩法。"}}</view>
      <view wx:if="{{!catalogGroups.length && emptyHint}}" class="empty">{{emptyHint}}</view>
      <view wx:for="{{catalogGroups}}" wx:key="groupId" class="ds-card catalog-group">
        <view class="catalog-group__head">{{item.group}} 游戏</view>
        <view
          wx:for="{{item.items}}"
          wx:for-item="rule"
          wx:key="id"
          id="catalog-row-{{rule.id}}"
          class="catalog-row"
          hover-class="catalog-row--on"
          catchtap="onCatalogTap"
          data-rule-id="{{rule.id}}"
        >
          <text class="catalog-name">{{rule.name}}</text>
          <text class="catalog-action">{{rule.noSettings ? "加入规则库 ›" : "去配置 ›"}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
