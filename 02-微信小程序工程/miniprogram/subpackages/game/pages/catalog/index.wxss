@import "../../styles/gb-shell.wxss";
@import "../../styles/game-ui.wxss";
@import "../../styles/page-window.wxss";

/* 宿主 app.wxss 未设 page height:100%。
   disableScroll + .gb-page overflow:hidden 时，必须给 page 定高，
   .gb-body 的 flex:1; height:0; min-height:0 才能形成可滚区域。 */
page,
.gb-page {
  height: 100%;
}

.catalog-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.catalog-page {
  padding-bottom: calc(64rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.catalog-hint {
  margin: 0 0 28rpx;
  padding: 0 4rpx;
  line-height: 1.6;
}

.catalog-group {
  margin-bottom: 24rpx;
  padding: 8rpx 0 12rpx;
}

.catalog-group__head {
  padding: 24rpx 32rpx 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--champion-gold);
}

.catalog-group .catalog-row {
  margin: 0 16rpx;
  padding: 28rpx 16rpx;
}

.catalog-group .catalog-row:last-child {
  border-bottom: 0;
}
