@import "../../styles/gb-shell.wxss";
@import "../../styles/game-ui.wxss";

.catalog-page {
  padding-bottom: 64rpx;
}

.catalog-hint {
  margin: 0 0 28rpx;
  padding: 0 4rpx;
  line-height: 1.6;
}

.catalog-group {
  margin-bottom: 24rpx;
  padding: 8rpx 0 12rpx;
}

.catalog-group__head {
  padding: 24rpx 32rpx 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--champion-gold);
}

.catalog-group .catalog-row {
  margin: 0 16rpx;
  padding: 28rpx 16rpx;
}

.catalog-group .catalog-row:last-child {
  border-bottom: 0;
}
