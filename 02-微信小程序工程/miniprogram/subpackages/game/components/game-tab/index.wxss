@import "../../styles/gb-shell.wxss";
@import "../../styles/game-ui.wxss";

.game-tab--fill {
  position: relative;
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  width: 100%;
}

.board-stack {
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
}

.board-pin {
  position: relative;
  flex-shrink: 0;
  background: var(--bg-primary);
  z-index: 20;
  overflow: visible;
}

.board-game-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 18;
  background: transparent;
}

/* ——— ≤4：简单整表 ——— */
.board-simple-head,
.board-simple-foot {
  flex-shrink: 0;
  background: var(--bg-subtle);
}

.board-simple-head {
  border-top: 1px solid var(--border);
}

.board-simple-foot {
  border-top: 2px solid var(--cloud-blue);
}

.board-row--pot {
  border-top: 1px solid var(--border);
}

.board-simple-head .board-row,
.board-simple-foot .board-row {
  border-bottom: 0;
}

.board-simple-body {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.board-simple-head .board-cell--player,
.board-simple-body .board-cell--player,
.board-simple-foot .board-cell--player {
  flex: 1;
  min-width: 0;
  width: auto;
}

.board-simple-head .board-player-cell {
  flex: 1;
  min-width: 0;
  width: auto;
}

.board-simple-body .board-row {
  align-items: stretch;
  border-bottom: 0;
}

/* 球员表头：独立样式，避免被 .board-cell 的 nowrap/overflow 裁切 */
.board-player-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 120rpx;
  min-height: 120rpx;
  padding: 8rpx 4rpx;
  gap: 6rpx;
  overflow: hidden;
  white-space: normal;
  border-right: 1px solid var(--border);
  background: var(--bg-subtle);
}

.board-player-cell:last-child {
  border-right: 0;
}

.board-player-face {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  display: block;
  box-sizing: border-box;
}

.board-player__avatar {
  display: block;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 50%;
  background: #002d62;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  flex-shrink: 0;
  overflow: hidden;
}

.board-player__avatar image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.board-player__name {
  max-width: 100%;
  min-width: 0;
  flex: 1;
  font-size: 22rpx;
  line-height: 26rpx;
  color: var(--text-muted);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* ——— >4：分栏横滑 ——— */
.board-frame {
  flex: 1;
  height: 0;
  min-height: 0;
  display: flex;
  flex-direction: row;
  width: 100%;
  overflow: hidden;
}

.board-left {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: var(--bg-primary);
  z-index: 2;
}

.board-left__head {
  flex-shrink: 0;
  box-sizing: border-box;
  height: 120rpx;
  min-height: 120rpx;
  background: var(--bg-subtle);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  font-weight: 800;
}

.board-left__foot {
  flex-shrink: 0;
  box-sizing: border-box;
  height: 80rpx;
  min-height: 80rpx;
  background: var(--bg-subtle);
  border-top: 2px solid var(--cloud-blue);
  font-weight: 800;
}

.board-left__foot-wrap {
  flex-shrink: 0;
}

.board-left__foot--pot {
  border-top: 1px solid var(--border);
}

.board-left__clip {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow: hidden;
}

.board-left__track {
  will-change: transform;
}

.board-right {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 100%;
}

.board-right__sheet {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.board-h-track {
  display: flex;
  flex-direction: row;
  flex-shrink: 0;
  box-sizing: border-box;
  height: 80rpx;
  background: var(--bg-subtle);
}

.board-h-track--head {
  height: 120rpx;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.board-h-track--foot {
  height: 80rpx;
  border-top: 2px solid var(--cloud-blue);
}

.board-h-track--pot {
  border-top: 1px solid var(--border);
}

.board-h-track .board-cell--axis {
  font-weight: 800;
  border-bottom: 0;
}

.board-right__body {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.board-score-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  height: 80rpx;
  box-sizing: border-box;
}

.board-cell--axis {
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid var(--border);
}

.board-cell--hole-badge {
  position: relative;
  display: block;
}

.board-hole-dot {
  position: absolute;
  left: 100%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  transform: translateY(-50%);
}

.board-hole-dot--pending {
  background: #ef4444;
}

.board-hole-dot--consumed {
  background: #94a3b8;
}

.board-cell--row {
  height: 80rpx;
  min-height: 80rpx;
  max-height: 80rpx;
}

.board-cell--head {
  height: 120rpx;
  min-height: 120rpx;
  max-height: 120rpx;
  border-bottom: 0;
}

.board-simple-head .board-cell--axis,
.board-simple-foot .board-cell--axis {
  border-bottom: 0;
  font-weight: 800;
}

.board-simple-head .board-cell--head {
  height: 120rpx;
  min-height: 120rpx;
  max-height: 120rpx;
}

.board-left .board-cell--hole {
  width: 100%;
  flex: none;
}

.board-left__head.board-cell--head {
  border-bottom: 1px solid var(--border);
}

.board-left__foot {
  border-bottom: 0;
}

/* flow：自然撑高，纵向交给宿主 scroll-view，不抢整页竖滑 */
.game-tab--flow {
  position: relative;
  display: block;
  width: 100%;
  height: auto;
  min-height: 240rpx;
  overflow: visible;
  box-sizing: border-box;
}

.game-tab--flow .board-stack {
  flex: none;
  height: auto;
  min-height: 0;
  overflow: visible;
}

.game-tab--flow .board-simple-body {
  flex: none;
  height: auto;
  min-height: 80rpx;
  overflow: visible;
}

.game-tab--flow .board-frame {
  flex: none;
  height: auto;
  min-height: 0;
}

.game-tab--flow .board-left {
  height: auto;
}

.game-tab--flow .board-left__clip {
  flex: none;
  height: auto;
  min-height: 0;
  overflow: visible;
}

.game-tab--flow .board-right,
.game-tab--flow .board-right__sheet {
  height: auto;
}

.game-tab--flow .board-right__body {
  flex: none;
  height: auto;
  min-height: 0;
}

.register-cta-bar.game-cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary, #ffffff);
  border-top: 2rpx solid var(--border-color, rgba(15, 23, 42, 0.08));
  box-sizing: border-box;
}

.board-dock-h {
  display: flex;
  flex-direction: row;
  width: 100%;
}

.board-dock-h__hole {
  flex-shrink: 0;
  background: var(--bg-subtle);
  z-index: 2;
}

.board-dock-h__right {
  flex: 1;
  min-width: 0;
  width: 0;
}

.game-tab--flow .board-game-mask {
  z-index: 121;
}

.game-tab--flow .board-pin--stuck {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 125;
  background: var(--bg-primary);
}

.game-tab--flow .board-head--stuck {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 124;
  background: var(--bg-subtle);
}

.board-flow-head-slot {
  width: 100%;
}

.board-flow-head {
  display: flex;
  flex-direction: row;
  width: 100%;
  background: var(--bg-subtle);
}

.board-flow-head__right {
  flex: 1;
  min-width: 0;
  width: 0;
}

.board-flow-foot-spacer {
  width: 100%;
  pointer-events: none;
}
