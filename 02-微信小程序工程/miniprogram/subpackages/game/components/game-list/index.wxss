@import "../../styles/gb-shell.wxss";
@import "../../styles/game-ui.wxss";

.kick-mine {
  margin-left: 8rpx;
  letter-spacing: 0;
  font-size: 28rpx;
  font-style: normal;
  font-weight: 400;
}

.kick-row__holes {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8rpx 8rpx;
  justify-items: center;
  margin-top: 8rpx;
}

.kick-hole {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 88rpx;
}

.kick-hole__dot {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1px solid var(--tour-blue);
  background: var(--tour-blue);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kick-hole.off .kick-hole__dot {
  background: transparent;
  border-color: var(--border);
  color: var(--text-muted);
}

.kick-hole.on .kick-hole__dot {
  background: var(--champion-gold);
  border-color: var(--champion-gold);
  color: #111;
}

.kick-hole__n {
  height: 28rpx;
  line-height: 28rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: var(--champion-gold);
}

.kick-mults {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0 12rpx;
}

.kick-mult {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.kick-mult--custom {
  font-size: 20rpx;
}

.kick-mult.on {
  background: var(--champion-gold);
  border-color: var(--champion-gold);
  color: #111;
}

.sheet-mask--over {
  z-index: 50;
}

.kick-custom-sheet-input {
  margin-top: 16rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--tour-blue);
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 12rpx;
}

.kick-custom-ph {
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 800;
}

.kv-avatars {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: nowrap;
  min-width: 0;
  overflow: hidden;
  gap: 16rpx;
}

.kv-party {
  flex-shrink: 0;
  overflow: hidden;
  max-width: 120rpx;
  line-height: 0;
}

.kv-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.kv-avatar-more {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 40rpx;
  white-space: nowrap;
}

.setting-row--privacy {
  align-items: flex-start;
}

.radio-row--privacy {
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx 24rpx;
  max-width: 460rpx;
}

.hole-order-preview {
  flex: 1;
  text-align: right;
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 700;
  padding-top: 4rpx;
}

.hole-cell.start {
  background: var(--champion-gold);
  border-color: var(--champion-gold);
  color: #1a1a1a;
}

.hole-order-cell.lift {
  opacity: 0.72;
  transform: scale(1.08);
}

.hole-order-grid {
  touch-action: none;
}

.donate-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 10rpx;
  min-width: 0;
  flex: 1;
}

.sheet .opt {
  align-items: center;
  padding: 20rpx 16rpx;
  margin-bottom: 12rpx;
}

.sheet .opt .radio-dot,
.sheet .opt .check-box {
  flex-shrink: 0;
  align-self: center;
}

.sheet .opt .opt-title {
  line-height: 56rpx;
}

.donate-line .opt-title {
  line-height: 56rpx;
}

.donate-line .mini-input {
  height: 56rpx;
  line-height: 56rpx;
}

.donate-line .mini-input--wide {
  width: 140rpx;
}

.check-box {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--border);
  border-radius: 6rpx;
  background: #fff;
  box-sizing: border-box;
}

.check-box.on {
  border-color: var(--tour-blue);
  background: var(--tour-blue);
  position: relative;
}

.check-box.on::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 8rpx;
  height: 16rpx;
  border: 4rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.add-game-btn {
  height: 72rpx;
  margin-top: 24rpx;
  margin-left: 32rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--data-blue);
  font-size: 28rpx;
  font-weight: 700;
  background: transparent;
}

.add-game-btn--pressed {
  opacity: 0.72;
}

.add-game-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid var(--data-blue);
  color: var(--data-blue);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.game-list {
  padding-bottom: 220rpx;
}
