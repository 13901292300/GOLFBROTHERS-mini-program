@import "./gb-shell.wxss";

.ds-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 6rpx solid var(--tour-blue);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.game-list {
  padding: 24rpx 32rpx 220rpx;
  box-sizing: border-box;
}

.cap-hint {
  margin-bottom: 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-muted);
}

.setting-head {
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-head--disabled {
  opacity: 0.45;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 800;
  font-style: italic;
}

.setting-chev {
  font-size: 24rpx;
  color: var(--text-muted);
}

.setting-body {
  padding: 0 32rpx 28rpx;
  border-top: 1px solid var(--border);
}

.setting-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 24rpx;
}

.setting-row + .setting-row {
  margin-top: 8rpx;
  padding-top: 24rpx;
  border-top: 1px solid var(--border);
}

.setting-k {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
  flex-shrink: 0;
  padding-top: 4rpx;
}

.radio-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
}

.radio-item.on {
  color: var(--text-primary);
}

.radio-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  box-sizing: border-box;
  background: var(--bg-card);
}

.radio-item.on .radio-dot {
  border-color: var(--tour-blue);
  background: radial-gradient(circle, var(--tour-blue) 45%, transparent 48%);
}

.opt .radio-dot,
.rank-opt .radio-dot {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.opt.on > .radio-dot,
.opt.on > .opt-row > .radio-dot,
.rank-opt.on > .radio-dot {
  border-color: var(--champion-gold);
  background: radial-gradient(circle, var(--champion-gold) 45%, transparent 48%);
}

.game-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.game-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.game-card__name {
  font-size: 34rpx;
  font-weight: 900;
  font-style: italic;
}

.game-card__title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.game-card__heading {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.game-card__summary {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-muted);
}

.game-card__title .game-card__name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-edit-btn {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 800;
  font-style: normal;
  color: var(--text-primary);
  border: 1px solid currentColor;
  background: var(--bg-secondary);
  border-radius: 8rpx;
  line-height: 1.3;
}

.game-card__del {
  color: var(--error);
  font-size: 36rpx;
  line-height: 1;
  padding: 0 8rpx;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 22rpx;
  margin-top: 10rpx;
}

.game-card__top .kv {
  margin-top: 0;
}

.kv-k {
  color: var(--text-muted);
}

.game-card__top .kv-k {
  line-height: 56rpx;
}
.kv-v { font-weight: 700; }

.kv-avatars {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-end;
  align-items: center;
  gap: 8rpx;
}

.kv-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--tour-blue);
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  text-align: center;
  line-height: 40rpx;
  overflow: hidden;
}

.kv-avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.game-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.game-open {
  flex: 1;
  margin-top: 0;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: var(--tour-blue);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  border-radius: 12rpx;
}

.fab-wrap {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.cta-gold {
  background: var(--champion-gold);
  color: #111;
  font-size: 30rpx;
  font-weight: 900;
  font-style: italic;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  text-align: center;
}

.cta-gold--disabled {
  background: #9ca3af;
  color: #111;
  pointer-events: none;
}

.cta-gold--saving {
  pointer-events: none;
}

.cta-ghost {
  background: transparent;
  color: var(--text-primary);
  border: 1px solid var(--border);
  font-size: 28rpx;
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  text-align: center;
}

.empty {
  margin-top: 48rpx;
  text-align: left;
  line-height: 1.7;
  color: var(--text-muted);
  font-size: 24rpx;
}

.page-pad {
  padding: 24rpx 32rpx 180rpx;
}

.sec-label {
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--champion-gold);
  margin: 24rpx 0 16rpx;
}

.rule-lib {
  margin-bottom: 20rpx;
}

.rule-lib__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.rule-lib__title {
  font-size: 28rpx;
  font-weight: 800;
  font-style: italic;
}

.rule-lib__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex-shrink: 1;
}

.rule-lib__count {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 700;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-lib__chev {
  font-size: 24rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.rule-list {
  margin-bottom: 0;
  padding: 0 32rpx 8rpx;
}

.rule-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1px solid var(--border);
}

.rule-row__main {
  flex: 1;
  min-width: 0;
}

.rule-row__title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  max-width: 100%;
}

.rule-row__name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-row__edit {
  flex: 0 0 auto;
  width: auto;
  padding: 4rpx 8rpx;
  font-size: 26rpx;
  line-height: 1;
  color: var(--text-muted);
  font-weight: 400;
}

.rule-row__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rule-row__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.rule-row__add {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 400;
  color: #111;
  background: var(--champion-gold);
  border-radius: 12rpx;
}

.rule-chip {
  position: relative;
  padding: 28rpx 24rpx 40rpx;
  min-height: 88rpx;
}

.rule-chip__name {
  font-size: 26rpx;
  font-weight: 800;
}

.rule-chip__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  font-weight: 700;
}

.rule-chip__actions {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  display: flex;
  gap: 8rpx;
}

.rule-chip__edit {
  position: static;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--tour-blue);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 40rpx;
}

.rule-chip__edit--ghost {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border: 1px solid currentColor;
}

.game-card__tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  font-weight: 700;
  font-style: normal;
  color: var(--text-primary);
  border: 1px solid currentColor;
  border-radius: 8rpx;
  vertical-align: middle;
}

/* 三局：与其他卡片相同「名称后紧跟系数」；名称可缩省略，系数不拉伸、不靠右 */
.game-card__head--seg {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  flex: 1;
  padding-right: 8rpx;
  box-sizing: border-box;
}

.game-card__head--seg .game-card__name {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.game-card__tag--seg {
  flex: 0 0 auto;
  flex-shrink: 0;
  margin-left: 12rpx;
  white-space: nowrap;
  overflow: visible;
  text-overflow: clip;
  max-width: none;
}

.game-card__tag.is-ended {
  color: var(--text-muted);
  border-color: var(--border);
}

.catalog-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1px solid var(--border);
}

.catalog-row--on {
  opacity: 0.7;
}

.catalog-name,
.catalog-action {
  pointer-events: none;
}

.catalog-name {
  font-size: 28rpx;
  font-weight: 700;
}

.catalog-action {
  font-size: 22rpx;
  color: var(--text-muted);
}

.hint-bar {
  padding: 20rpx 32rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-muted);
  background: var(--bg-subtle);
}

.player-grid {
  display: flex;
  gap: 12rpx;
}

.player-slot {
  flex: 1;
  min-width: 0;
  border: 1px solid var(--champion-gold);
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.player-slot.off {
  border-color: var(--border);
  opacity: 0.4;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.player-name {
  font-size: 20rpx;
  color: var(--text-muted);
}

.hole-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hole-preview .game-card__name {
  flex-shrink: 0;
}

.hole-dots {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(9, 12rpx);
  gap: 6rpx;
  justify-content: center;
}

.hole-count {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--text-primary);
}

.hole-preview .setting-chev {
  flex-shrink: 0;
  line-height: 1;
}

.hole-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9ca3af;
}

.hole-dot.on {
  background: var(--champion-gold);
}

.gb-page.dark-mode .hole-dot {
  background: #cbd5e1;
}

.gb-page.dark-mode .hole-dot.on {
  background: var(--champion-gold);
}

.score-grid {
  display: flex;
  gap: 12rpx;
}

.score-chip {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  text-align: center;
  background: var(--bg-subtle);
  border-radius: 10rpx;
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-val {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  min-width: 88rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 32rpx;
  color: var(--text-muted);
  background: transparent;
  border-radius: 8rpx;
  white-space: nowrap;
}

.score-val--low {
  color: #fff;
  background: var(--data-blue);
}

.score-val--high {
  color: #111;
  background: var(--champion-gold);
}

.mode-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.mode-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  background: var(--bg-subtle);
  color: var(--text-primary);
}

.mode-btn.on {
  background: var(--champion-gold);
  color: #111;
  border-color: var(--champion-gold);
}

.player-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 10rpx;
}

.rank-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  background: var(--bg-subtle);
  font-size: 24rpx;
  color: var(--text-primary);
}

.rank-opt.on {
  border-color: var(--champion-gold);
  background: var(--bg-secondary);
  font-weight: 800;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1px solid var(--border);
  display: flex;
  gap: 20rpx;
}

.bottom-bar .cta-gold,
.bottom-bar .cta-ghost {
  flex: 1;
}

.bottom-bar .cta-gold--tight {
  font-size: 24rpx;
  letter-spacing: 0;
  font-style: normal;
  padding: 0 8rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: var(--bg-card);
  border-top: 6rpx solid var(--tour-blue);
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet--tall {
  max-height: 82vh;
  overflow-y: auto;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  margin-bottom: 24rpx;
}

.sheet-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sheet-title-row .sheet-title {
  margin-bottom: 0;
}

.sheet-del {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--error);
}

.sheet-user {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: -8rpx 0 28rpx;
}

.sheet-user__avatar {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin: 0;
  background: var(--tour-blue);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
}

.sheet-user__avatar image {
  width: 100%;
  height: 100%;
  display: block;
}

.sheet-user__name {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preset-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.preset-btn {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-primary);
  background: var(--bg-subtle);
}

.preset-btn.on {
  background: var(--champion-gold);
  color: #111;
  border-color: var(--champion-gold);
}

.preset-btn--custom {
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preset-custom-input {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
  color: inherit;
  background: transparent;
}

.preset-custom-ph {
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 800;
}

.preset-btn--custom.on .preset-custom-input,
.preset-btn--custom.on .preset-custom-ph {
  color: #fff;
}

.field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--bg-subtle);
  color: var(--text-primary);
  font-size: 28rpx;
}

.hole-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
  justify-items: center;
}

.hole-cell {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1px solid var(--tour-blue);
  background: var(--tour-blue);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hole-cell.off {
  background: transparent;
  border-color: var(--border);
  color: var(--text-muted);
}

.board-wrap {
  flex: 1;
}

.board-row,
.board-head {
  display: flex;
  border-bottom: 1px solid var(--border);
}

.board-head {
  background: var(--bg-subtle);
  font-size: 20rpx;
  font-weight: 800;
  color: var(--text-muted);
}

.cell {
  flex: 1;
  text-align: center;
  padding: 18rpx 4rpx;
  font-size: 22rpx;
}

.cell.result-positive { color: var(--error, #DC2626); font-weight: 800; }
.cell.result-negative { color: var(--success, #16A34A); font-weight: 800; }

.total-bar {
  padding: 24rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 4rpx solid var(--tour-blue);
  background: var(--bg-card);
  display: flex;
}

.total-item {
  flex: 1;
  text-align: center;
}

.total-val {
  font-size: 36rpx;
  font-weight: 900;
}

.total-name {
  font-size: 18rpx;
  color: var(--text-muted);
}

.opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
  margin-bottom: 12rpx;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  background: var(--bg-card);
  color: var(--text-primary);
}

.opt.on {
  border-color: var(--champion-gold);
  background: var(--bg-secondary);
}

.opt-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.opt--fold {
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  padding: 0;
}

.opt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
}

.opt-row .opt-title {
  flex-shrink: 0;
}

.opt-row .rule-lib__meta {
  flex: 1;
  min-width: 0;
  justify-content: flex-end;
}

.opt-row .rule-lib__count {
  max-width: none;
  flex: 1;
  min-width: 0;
  text-align: right;
}

.opt-fold-body {
  padding: 0 28rpx 24rpx;
  border-top: 1px solid var(--border);
}

.sec-hint {
  margin: -8rpx 0 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.reward-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.meat-head {
  color: var(--text-muted);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding-bottom: 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 1px solid var(--border);
}

.meat-subhead {
  margin-top: 28rpx;
  margin-bottom: 16rpx;
  padding-top: 20rpx;
  border-bottom: 0;
  border-top: 1px solid var(--border);
}

.meat-value-block {
  padding-left: 48rpx;
}

.opt--nested {
  padding: 20rpx 24rpx;
  background: var(--bg-subtle);
}

.opt--nested:last-child {
  margin-bottom: 0;
}

.reward-input {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.reward-op {
  width: 32rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--champion-gold);
  line-height: 1;
}

.mini-input {
  width: 80rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 8rpx;
  color: var(--champion-gold);
  font-weight: 800;
  background: var(--bg-subtle);
}

.player-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.player-slot {
  width: calc(25% - 12rpx);
  box-sizing: border-box;
  border: 1px solid var(--champion-gold);
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.player-slot.off {
  border-color: var(--border);
  opacity: 0.4;
}

.hole-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-grid {
  display: flex;
  gap: 12rpx;
}

.score-chip {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  text-align: center;
  background: var(--bg-subtle);
  border-radius: 10rpx;
  border: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-chip__val {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  min-width: 88rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 32rpx;
  color: #111;
  background: var(--champion-gold);
  border-radius: 8rpx;
  white-space: nowrap;
}

.mode-row {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0 24rpx;
}

.mode-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 800;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  background: var(--bg-subtle);
  color: var(--text-primary);
}

.mode-btn.on {
  background: var(--champion-gold);
  color: #111;
  border-color: var(--champion-gold);
}

.player-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 10rpx;
}

.rank-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  margin-top: 12rpx;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  background: var(--bg-subtle);
  font-size: 24rpx;
  color: var(--text-primary);
}

.rank-opt.on {
  border-color: var(--champion-gold);
  background: var(--bg-secondary);
  font-weight: 800;
}

.hole-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
  margin: 24rpx 0;
  justify-items: center;
}

.hole-cell {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border-radius: 50%;
  border: 1px solid var(--tour-blue);
  background: var(--tour-blue);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hole-cell.off {
  background: transparent;
  border-color: var(--border);
  color: var(--text-muted);
}

.radio-row {
  display: flex;
  gap: 32rpx;
}

.cap-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-muted);
}

.field {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--bg-subtle);
  color: var(--text-primary);
  font-size: 28rpx;
}

.sec-label {
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--champion-gold);
  margin: 24rpx 0 16rpx;
}

.game-tab {
  min-height: 60vh;
}

.empty-tab {
  padding: 80rpx 48rpx 48rpx;
  text-align: center;
}

.empty-tab__title {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
}

.empty-tab__desc {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-muted);
  text-align: left;
}

.empty-tab__btn {
  margin-top: 48rpx;
}

.empty-tab__switch {
  display: block;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--data-blue);
}

.board-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx 24rpx 8rpx;
  padding: 16rpx 20rpx;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12rpx;
}

.board-toolbar__pick {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.board-toolbar__game {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-toolbar__chev {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1;
}

.board-toolbar__actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.board-toolbar__cfg {
  padding: 8rpx 4rpx 8rpx 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--text-primary);
}

.board-toolbar__go {
  padding: 8rpx 4rpx 8rpx 0;
  color: var(--text-muted);
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1;
}

.board-game-menu {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: calc(100% - 8rpx);
  margin: 0;
  padding: 8rpx 0;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow-x: hidden;
  overflow-y: auto;
  max-height: 60vh;
  z-index: 30;
}

.board-game-menu__item {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.board-game-menu__item--parent {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.board-game-menu__name {
  flex: 1;
  min-width: 0;
}

.board-game-menu__chev {
  flex-shrink: 0;
  padding: 4rpx 8rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 400;
}

.board-game-menu__item--sub2 {
  padding-left: 72rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted);
}

.board-game-menu__item--all {
  border-bottom: 1px solid var(--border);
}

.board-game-menu__item.on {
  color: var(--cloud-blue);
  background: var(--bg-subtle);
}

.board-swiper {
  width: 100%;
}

.board-table {
  display: block;
  width: 100%;
  min-width: 0;
  padding: 0 16rpx 32rpx;
  box-sizing: border-box;
}

.board-row {
  display: flex;
  width: 100%;
  border-bottom: 1px solid var(--border);
}

.board-row--head {
  background: var(--bg-subtle);
  border-top: 1px solid var(--border);
}

.board-row--total {
  background: var(--bg-subtle);
  border-top: 2px solid var(--tour-blue);
}

.board-cell {
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 22rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-right: 1px solid var(--border);
}

.board-cell--hole {
  width: 168rpx;
  flex: 0 0 168rpx;
  font-weight: 800;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.board-cell--hole-badge {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  background: var(--tour-blue);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.board-cell--player {
  flex: 1;
  min-width: 0;
  width: auto;
  font-size: 36rpx;
}

.board-cell--player:last-child {
  border-right: 0;
}

.board-row--head .board-cell,
.board-row--total .board-cell {
  font-weight: 800;
}

.board-cell.result-positive { color: var(--error, #DC2626); font-weight: 800; }
.board-cell.result-negative { color: var(--success, #16A34A); font-weight: 800; }

.board-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 0 16rpx;
  flex-shrink: 0;
}

.board-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border);
}

.board-dot.on {
  background: var(--tour-blue);
}
