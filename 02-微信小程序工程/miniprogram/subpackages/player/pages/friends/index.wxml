<view class="player-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">{{isProxyTeamMode ? 'TEAM' : 'FRIENDS'}}</text>
          <text class="gb-header__title">{{isProxyRegisterMode ? (isProxyTeamMode ? '球队成员代报名' : '替他人报名') : '好友选择'}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="search-bar-wrap">
    <view class="search-bar">
      <text class="search-bar__icon">🔍</text>
      <input
        class="search-bar__input"
        type="text"
        value="{{keyword}}"
        placeholder="{{isProxyTeamMode ? '搜索成员姓名/手机号' : '搜索好友昵称/手机号'}}"
        placeholder-class="search-bar__ph"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" bindtap="clearSearch" class="search-bar__clear"><text>×</text></view>
    </view>
  </view>

  <view wx:if="{{!isProxyRegisterMode}}" class="me-row-wrap">
    <view class="friend-row me-row {{occupiedMap[currentUser.playerId] ? 'is-disabled' : ''}}" bindtap="toggleMe" data-id="{{currentUser.playerId}}">
      <image class="friend-avatar" src="{{currentUser.avatar}}" mode="aspectFill" binderror="onAvatarError" data-type="me"></image>
      <view class="friend-meta">
        <text class="friend-name">我</text>
        <text class="friend-sub">{{currentUser.name}}{{currentUser.phone ? ' · ' + currentUser.phone : ''}}</text>
        <text wx:if="{{occupiedMap[currentUser.playerId]}}" class="friend-tag friend-tag--used">已在本场比赛中使用</text>
        <text wx:elif="{{preselectedMap[currentUser.playerId]}}" class="friend-tag">已在本组</text>
      </view>
      <view class="friend-check {{(selectedMap[currentUser.playerId] || occupiedMap[currentUser.playerId]) ? 'on' : ''}} {{occupiedMap[currentUser.playerId] ? 'is-locked' : ''}}">
        <text wx:if="{{selectedMap[currentUser.playerId] || occupiedMap[currentUser.playerId]}}">✓</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="page-body">
    <view wx:if="{{searchEmpty}}" class="search-empty">
      <text class="search-empty__text">未找到相关好友</text>
    </view>
    <block wx:else>
    <view wx:for="{{sections}}" wx:key="letter" class="letter-section">
      <view class="letter-head">{{item.letter}}</view>
      <view
        wx:for="{{item.items}}"
        wx:for-item="f"
        wx:key="playerId"
        class="friend-row {{disabledMap[f.playerId] ? 'is-disabled' : ''}}"
        bindtap="onTapPlayer"
        data-id="{{f.playerId}}"
        data-selection-key="{{f.playerId}}"
      >
        <image class="friend-avatar" src="{{f.avatar}}" mode="aspectFill" binderror="onAvatarError" data-type="friend" data-id="{{f.playerId}}"></image>
        <view class="friend-meta">
          <text class="friend-name">{{f.name}}</text>
          <block wx:if="{{isProxyRegisterMode}}">
            <text wx:if="{{f.registrationState === 'registered_locked'}}" class="friend-tag friend-tag--used">已报名</text>
            <text wx:elif="{{f.registrationState === 'registered_by_me'}}" class="friend-tag friend-tag--proxy">我代报名</text>
          </block>
          <block wx:else>
            <text wx:if="{{disabledMap[f.playerId]}}" class="friend-tag friend-tag--used">已在本场比赛中使用</text>
            <text wx:elif="{{preselectedMap[f.playerId]}}" class="friend-tag">已在本组</text>
          </block>
        </view>
        <!-- 代报名：锁定态也显示已勾选复选框，明确不可取消 -->
        <view
          wx:if="{{isProxyRegisterMode || !disabledMap[f.playerId] || occupiedMap[f.playerId]}}"
          class="friend-check {{(selectedMap[f.playerId] || occupiedMap[f.playerId]) ? 'on' : ''}} {{(f.registrationState === 'registered_locked' || occupiedMap[f.playerId]) ? 'is-locked' : ''}}"
        >
          <text wx:if="{{selectedMap[f.playerId] || occupiedMap[f.playerId]}}">✓</text>
        </view>
      </view>
    </view>
    </block>
    <view class="body-pad"></view>
  </scroll-view>

  <view class="page-footer">
    <button class="confirm-btn" bindtap="confirm">确认（{{selectedCount}}）</button>
  </view>
</view>
