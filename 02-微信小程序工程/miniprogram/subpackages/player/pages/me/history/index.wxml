<view class="hist-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">HISTORY</text>
          <text class="gb-header__title">历史成绩</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="hist-body" enhanced show-scrollbar="{{false}}">
    <view class="hist-section">
      <view class="hist-card">
        <view class="hist-list-header">
          <text class="hist-overline">我的球局</text>
          <text class="hist-count">{{rounds.length}} 场</text>
        </view>

        <view
          wx:for="{{rounds}}"
          wx:key="id"
          class="hist-row {{index < rounds.length - 1 ? 'hist-row--divider' : ''}}"
        >
          <view class="hist-row__left">
            <view class="hist-score {{item.teeClass}}">
              <text class="hist-score__num">{{item.totalScore}}</text>
            </view>
            <text class="hist-topar">{{item.toPar}}</text>
          </view>

          <view class="hist-row__right">
            <text class="hist-course">{{item.courseName}}</text>
            <text class="hist-datetime">{{item.datetime}}</text>
            <view class="hist-tags">
              <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="hist-tag">{{tag}}</text>
            </view>
          </view>
        </view>

        <view wx:if="{{!rounds.length}}" class="hist-empty">
          <text class="hist-empty__text">暂无球局记录</text>
        </view>
      </view>
    </view>

    <view class="hist-pad"></view>
  </scroll-view>
</view>
