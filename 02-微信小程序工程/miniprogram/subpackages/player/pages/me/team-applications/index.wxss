.team-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}
.team-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-muted: #6b7280;
}
.team-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --border: #222222;
  --text-primary: #f1f5f9;
  --text-muted: #888888;
}
page { height: 100%; background: var(--bg-primary); }
.gb-header { background: var(--tour-blue); border-bottom: 2px solid var(--champion-gold); flex-shrink: 0; }
.gb-header__inner { display: flex; align-items: center; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255,255,255,0.5); }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; }
.team-scroll { flex: 1; min-height: 0; height: 0; }
.team-content { padding: 32rpx; }
.ds-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16rpx; }
.notice-row { padding: 28rpx 32rpx; margin-bottom: 16rpx; }
.notice-row__title { display: block; font-size: 30rpx; font-weight: 800; }
.notice-row__sum { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-muted); }
