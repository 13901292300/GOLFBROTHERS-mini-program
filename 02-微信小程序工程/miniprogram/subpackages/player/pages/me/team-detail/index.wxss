.td-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00aeef;
  --error: #ef4444;
}

.td-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --border: #222222;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --shadow-card: none;
}

.td-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.td-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.2;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.td-tabs {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border);
  padding: 0 8rpx;
}

.td-tab {
  position: relative;
  flex: 1 1 0;
  min-width: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-muted);
  line-height: 1;
  white-space: nowrap;
}

.td-tab__label {
  pointer-events: none;
}

.td-tab.is-active {
  color: var(--text-primary);
  font-weight: 900;
}

.td-tab.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: var(--champion-gold);
  pointer-events: none;
}

/* ===== DIAG-03 最小诊断版样式：不用 100vh / flex 撑满 / 定位 / 层级，诊断结束后整块删除 ===== */
.tdmin {
  /* 页面是 navigationStyle: custom，顶部没有导航栏，手动留出状态栏 + 胶囊高度 */
  padding: 200rpx 24rpx 24rpx;
  background: #ffffff;
}
.tdmin__title {
  font-size: 34rpx;
  font-weight: 900;
  color: #002d62;
  margin-bottom: 24rpx;
}
.tdmin__tabs {
  display: flex;
  border: 1px solid #ce9224;
  border-radius: 8rpx;
  overflow: hidden;
}
.tdmin__tab {
  flex: 1 1 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  background: #ffffff;
}
.tdmin__tab.is-on {
  background: #ce9224;
  color: #ffffff;
  font-weight: 900;
}
.tdmin__state {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #7a4b00;
}
.tdmin__body {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1px dashed #ce9224;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #002d62;
}

/* DIAG-09 单行版本标记条：正常占位、不脱离文档流、不覆盖交互，诊断结束后整块删除 */
.td-diagbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 24rpx;
  background: #fff7e0;
  border-bottom: 1px solid var(--champion-gold);
}
.td-diagbar__text {
  flex: 1;
  min-width: 0;
  font-size: 18rpx;
  line-height: 1.5;
  color: #7a4b00;
}
.td-diagbar__btn {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border: 1px solid #ce9224;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #7a4b00;
}

/* DIAG 最小布局回退用，当前不参与渲染 */
.tdmin__members {
  margin-top: 24rpx;
  height: 720rpx;
  display: flex;
  flex-direction: column;
  border: 1px dashed #ce9224;
  border-radius: 8rpx;
  overflow: hidden;
}
/* ===== /DIAG-03 ===== */

.td-scroll { position: relative; z-index: 1; flex: 1; min-height: 0; height: 0; }
.td-content { padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }
.td-members-pane {
  position: relative;
  z-index: 1;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* 与组件内 :host 配对：组件宿主节点必须占满成员面板，否则列表高度为 0。 */
.td-members-pane > team-members {
  flex: 1 1 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.td-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.td-sheet {
  width: 100%;
  background: var(--bg-card, #fff);
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}

.td-sheet__handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border, #e5e7eb);
  margin: 8rpx auto 20rpx;
}

.td-sheet__title {
  display: block;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--champion-gold, #ce9224);
  margin-bottom: 8rpx;
}

/* DIAG-10 模拟操作提示，诊断结束后删除 */
.td-sheet__note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-muted, #6b7280);
  margin-bottom: 16rpx;
}

.td-sheet__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 40rpx;
  border-top: 1px solid var(--border, #e5e7eb);
}

.td-sheet__label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #002d62);
}

.td-sheet__badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--champion-gold, #ce9224);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
}

.td-sheet__cancel {
  margin: 12rpx 32rpx 0;
  height: 88rpx;
  border-radius: 12rpx;
  background: var(--bg-subtle, #f3f4f6);
  color: var(--text-muted, #6b7280);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.td-page.dark-mode .td-sheet {
  background: #111;
}

