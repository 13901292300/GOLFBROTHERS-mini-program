.matches { padding-bottom: 24rpx; }

.match-create {
  min-height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  border: 1px dashed var(--champion-gold, #ce9224);
  background: rgba(206, 146, 36, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.match-create__plus {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
}
.match-create__label {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--champion-gold, #ce9224);
}

.match-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.match-meta__label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary, #374151);
}
.match-meta__count {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-muted, #6b7280);
}

.match-list { display: flex; flex-direction: column; gap: 16rpx; }

.ds-card {
  background: var(--bg-card, #fff);
  border: 1px solid var(--border, #e5e7eb);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card, 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05));
}

.match-row {
  min-height: 128rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}
.match-row__logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 1px solid var(--border, #e5e7eb);
  background: var(--bg-subtle, #f3f4f6);
  flex-shrink: 0;
}
.match-row__main { flex: 1; min-width: 0; }
.match-row__title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary, #002d62);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.match-row__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-muted, #6b7280);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.match-row__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}
.match-row__chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--text-muted, #6b7280);
}

/* 演示赛与球队的临时关联：诊断数据标识 */
.match-row__diag {
  color: #1d4ed8;
  background: #dbeafe;
  border-color: #60a5fa;
}

/* 测试数据未关联比赛详情：如实标注，避免看起来可进入 */
.match-row__unlinked {
  color: #92400e;
  background: #fef3c7;
  border-color: #f59e0b;
}

.team-tag {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1px solid var(--border, #e5e7eb);
  color: var(--text-secondary, #374151);
  background: var(--bg-subtle, #f3f4f6);
}
.team-tag--organizer {
  color: #fff;
  background: var(--tour-blue, #002d62);
  border-color: var(--tour-blue, #002d62);
}
.team-tag--participant {
  color: var(--data-blue, #00aeef);
  background: rgba(0, 174, 239, 0.1);
  border-color: var(--data-blue, #00aeef);
}
