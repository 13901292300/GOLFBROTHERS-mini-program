/**
 * 个人资料编辑 — 对齐 history / statistics 的 gb-header + Bright/Dark token
 */

.pe-page {
  --primary-blue: #002d62;
  --cloud-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00AEEF;
  --text-on-dark: #ffffff;
  --space-page: 16px;
  --radius-xl: 12px;

  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.pe-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.pe-page.dark-mode {
  --bg-primary: #050816;
  --bg-card: #0b1220;
  --bg-subtle: #121a2b;
  --border: rgba(148, 163, 184, 0.16);
  --text-primary: #e5eefc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --shadow-card: 0 18px 40px rgba(0, 0, 0, 0.35);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

/* ===== gb-header ===== */
.gb-header {
  background: var(--cloud-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: var(--text-on-dark);
  flex-shrink: 0;
}
.gb-header__inner {
  display: flex;
  align-items: center;
}
.gb-header__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.gb-header__back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gb-header__chevron {
  color: var(--text-on-dark);
  font-size: 52rpx;
  line-height: 1;
}
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: var(--text-on-dark);
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.pe-body {
  flex: 1;
  min-height: 0;
}

.pe-main {
  padding: var(--space-page);
  padding-bottom: 40px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-sizing: border-box;
}

.pe-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 3px solid var(--cloud-blue);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  padding: 16px 18px;
  box-sizing: border-box;
}

.pe-card__label {
  display: block;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champion-gold);
  margin-bottom: 12px;
}

.pe-avatar-btn {
  width: 100%;
  margin: 0;
  line-height: inherit;
  font-weight: inherit;
  text-align: center;
}
.pe-avatar-btn::after {
  border: none;
}

.pe-avatar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28px;
  padding-bottom: 24px;
}

.pe-avatar-ring {
  width: 112px;
  height: 112px;
  border-radius: 9999px;
  border: 6px solid var(--champion-gold);
  background: var(--cloud-blue);
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 12px;
}

.pe-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.pe-avatar-hint {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
}

/* 行：label + value */
.pe-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  box-sizing: border-box;
}

.pe-row--last {
  border-bottom: none;
  padding-bottom: 4px;
}

.pe-row__label {
  flex-shrink: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.4;
}

.pe-row__trail {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.pe-row__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
}

.pe-row__trail .pe-row__value {
  flex: 0 1 auto;
}

.pe-row__chevron {
  flex-shrink: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--text-muted);
  line-height: 1;
}

.pe-row__value--multi {
  font-weight: 600;
  font-size: 14px;
  color: var(--text-secondary);
}

.pe-row__value--muted {
  color: var(--text-muted);
  font-weight: 700;
}

.pe-row--top {
  margin-top: 4px;
  border-top: 1px solid var(--border);
  padding-top: 14px;
}

.pe-field {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 4px 0 8px;
}

.pe-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pe-chip {
  min-width: 88px;
  padding: 10px 16px;
  text-align: center;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-muted);
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 8px;
  box-sizing: border-box;
}

.pe-chip.is-active {
  color: var(--data-blue);
  background: rgba(0, 174, 239, 0.1);
  border-color: var(--data-blue);
}

.pe-field-hint {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.4;
}

.pe-link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 6px 0 2px;
}

.pe-link-row__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pe-link-row__title {
  text-align: left;
  font-size: 15px;
}

.pe-link-row__sub {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
}

.pe-link-row__chevron {
  flex-shrink: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-muted);
  line-height: 1;
}

/* 文本编辑弹层 */
.pe-editor {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.pe-editor__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.pe-editor__panel {
  position: relative;
  z-index: 1;
  background: var(--bg-card);
  border-radius: 16px 16px 0 0;
  border-top: 1px solid var(--border);
  padding: 0 16px calc(16px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pe-editor__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 0 12px;
}

.pe-editor__title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 800;
  color: var(--text-primary);
}

.pe-editor__cancel,
.pe-editor__save {
  min-width: 48px;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.4;
}

.pe-editor__cancel {
  color: var(--text-muted);
}

.pe-editor__save {
  color: var(--data-blue);
  text-align: right;
}

.pe-editor__body {
  padding: 4px 0 8px;
}

.pe-editor__input,
.pe-editor__textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text-primary);
  font-size: 15px;
  font-weight: 600;
  padding: 12px 14px;
}

.pe-editor__input {
  height: 48px;
}

.pe-editor__textarea {
  min-height: 96px;
  line-height: 1.5;
}

.pe-editor__count {
  display: block;
  margin-top: 8px;
  text-align: right;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
}

/* 国籍 / 地域选择 */
.pe-picker {
  position: fixed;
  inset: 0;
  z-index: 400;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.pe-picker__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
}

.pe-picker__panel {
  position: relative;
  z-index: 1;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-card);
  border-radius: 24px 24px 0 0;
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pe-picker__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 18px 10px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}

.pe-picker__title {
  flex: 1;
  text-align: center;
  font-size: 16px;
  font-weight: 800;
  color: var(--text-primary);
}

.pe-picker__cancel,
.pe-picker__clear {
  min-width: 48px;
  font-size: 14px;
  font-weight: 700;
}

.pe-picker__cancel {
  color: var(--text-muted);
}

.pe-picker__clear {
  color: var(--data-blue);
  text-align: right;
}

.pe-picker__clear--ghost {
  visibility: hidden;
}

.pe-picker__list {
  flex: 1;
  min-height: 0;
  max-height: 56vh;
}

.pe-picker__item {
  padding: 16px 20px;
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
  border-bottom: 1px solid var(--border);
  box-sizing: border-box;
}

.pe-picker__item:active {
  background: var(--bg-subtle);
}
