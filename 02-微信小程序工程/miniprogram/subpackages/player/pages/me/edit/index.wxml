<view class="pe-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">PROFILE</text>
          <text class="gb-header__title">个人资料</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="pe-body {{teamClubOnboard ? 'pe-body--onboard' : ''}}" enhanced show-scrollbar="{{false}}">
    <view class="pe-main">
      <view wx:if="{{teamClubOnboard}}" class="pe-onboard-hint">
        <text class="pe-onboard-hint__title">完善球队资料</text>
        <text class="pe-onboard-hint__desc">请使用微信授权填写昵称，并通过头像选择器设置头像。完成后即可创建或加入球队。</text>
        <input
          class="pe-wx-nick"
          type="nickname"
          maxlength="20"
          placeholder="点击填写微信昵称"
          bindchange="onWxNickname"
          bindblur="onWxNickname"
        />
      </view>
      <!-- 1. 基础资料 -->
      <button class="pe-card pe-avatar-card pe-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" bindtap="onTapAvatar">
        <view class="pe-avatar-ring">
          <image class="pe-avatar-img" src="{{userProfile.avatar}}" mode="aspectFill" />
        </view>
        <text class="pe-avatar-hint">点击修改头像</text>
      </button>

      <view class="pe-card">
        <text class="pe-card__label">基础资料</text>
        <view class="pe-row" bindtap="onTapNickname">
          <text class="pe-row__label">昵称</text>
          <view class="pe-row__trail">
            <text class="pe-row__value">{{userProfile.nickname}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
        <view class="pe-row" bindtap="onTapGender">
          <text class="pe-row__label">性别</text>
          <view class="pe-row__trail">
            <text class="pe-row__value">{{userProfile.gender}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
        <view class="pe-row" bindtap="onTapSignature">
          <text class="pe-row__label">个人签名</text>
          <view class="pe-row__trail">
            <text class="pe-row__value pe-row__value--multi">{{userProfile.signatureText}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
        <view class="pe-row" bindtap="onTapNationality">
          <text class="pe-row__label">国籍</text>
          <view class="pe-row__trail">
            <text class="pe-row__value {{userProfile.nationalityName ? '' : 'pe-row__value--muted'}}">{{userProfile.nationalityText}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
        <view class="pe-row pe-row--last" bindtap="onTapRegion">
          <text class="pe-row__label">地域</text>
          <view class="pe-row__trail">
            <text class="pe-row__value {{userProfile.regionDisplayName ? '' : 'pe-row__value--muted'}}">{{userProfile.regionText}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
      </view>

      <!-- 2. 高尔夫身份 -->
      <view class="pe-card">
        <text class="pe-card__label">高尔夫身份</text>
        <view class="pe-field">
          <text class="pe-row__label">身份类型</text>
          <view class="pe-chips">
            <view
              class="pe-chip {{userProfile.identityType === identityPlayer ? 'is-active' : ''}}"
              data-type="{{identityPlayer}}"
              bindtap="onSelectIdentity"
            >球员</view>
            <view
              class="pe-chip {{userProfile.identityType === identityCaddie ? 'is-active' : ''}}"
              data-type="{{identityCaddie}}"
              bindtap="onSelectIdentity"
            >球童</view>
          </view>
        </view>
        <view
          wx:if="{{userProfile.isCaddie}}"
          class="pe-row pe-row--last pe-row--top"
          bindtap="onTapCaddieCourse"
        >
          <text class="pe-row__label">所属球场</text>
          <view class="pe-row__trail">
            <text class="pe-row__value pe-row__value--multi">{{userProfile.caddieCourse}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
      </view>

      <!-- 3. 比赛身份 -->
      <view class="pe-card">
        <text class="pe-card__label">比赛身份</text>
        <view class="pe-row pe-row--last" bindtap="onTapDisplayName">
          <text class="pe-row__label">比赛名</text>
          <view class="pe-row__trail">
            <text class="pe-row__value">{{userProfile.displayNameText}}</text>
            <text class="pe-row__chevron">›</text>
          </view>
        </view>
        <text class="pe-field-hint">记分卡 / 领先榜优先显示比赛名，未设置时回退昵称</text>
      </view>

      <!-- 4. 账号信息 -->
      <view class="pe-card">
        <text class="pe-card__label">账号信息</text>
        <view class="pe-row pe-row--last">
          <text class="pe-row__label">手机号</text>
          <text class="pe-row__value {{userProfile.phoneBound ? '' : 'pe-row__value--muted'}}">{{userProfile.phoneMasked}}</text>
        </view>
      </view>

      <!-- 5. 高级功能 -->
      <view class="pe-card">
        <text class="pe-card__label">高级功能</text>
        <view class="pe-link-row" bindtap="onTapAliasManage">
          <view class="pe-link-row__main">
            <text class="pe-row__value pe-link-row__title">马甲管理</text>
            <text class="pe-link-row__sub">会员功能入口</text>
          </view>
          <text class="pe-link-row__chevron">›</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 文本编辑弹层 -->
  <view wx:if="{{editorVisible}}" class="pe-editor {{themeClass}}">
    <view class="pe-editor__mask" bindtap="onEditorCancel"></view>
    <view class="pe-editor__panel">
      <view class="pe-editor__head">
        <text class="pe-editor__cancel" bindtap="onEditorCancel">取消</text>
        <text class="pe-editor__title">{{editorTitle}}</text>
        <text class="pe-editor__save" bindtap="onEditorSave">保存</text>
      </view>
      <view class="pe-editor__body">
        <textarea
          wx:if="{{editorMultiline}}"
          class="pe-editor__textarea"
          value="{{editorDraft}}"
          maxlength="{{editorMaxlength}}"
          placeholder="{{editorPlaceholder}}"
          bindinput="onEditorInput"
          auto-focus
        />
        <input
          wx:else
          class="pe-editor__input"
          type="{{editorField === 'nickname' ? 'nickname' : 'text'}}"
          value="{{editorDraft}}"
          maxlength="{{editorMaxlength}}"
          placeholder="{{editorPlaceholder}}"
          bindinput="onEditorInput"
          bindchange="onEditorWxChange"
          focus
        />
        <text class="pe-editor__count">{{editorCount}}/{{editorMaxlength}}</text>
      </view>
    </view>
  </view>

  <!-- 国籍 / 地域选择 Bottom Sheet -->
  <view wx:if="{{pickerVisible}}" class="pe-picker {{themeClass}}">
    <view class="pe-picker__mask" bindtap="onPickerCancel"></view>
    <view class="pe-picker__panel" catchtap="noop">
      <view class="pe-picker__head">
        <text class="pe-picker__cancel" bindtap="onPickerCancel">取消</text>
        <text class="pe-picker__title">{{pickerTitle}}</text>
        <text
          wx:if="{{pickerAllowClear}}"
          class="pe-picker__clear"
          bindtap="onPickerClear"
        >清除</text>
        <text wx:else class="pe-picker__clear pe-picker__clear--ghost"></text>
      </view>
      <scroll-view scroll-y class="pe-picker__list" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{pickerItems}}"
          wx:key="code"
          class="pe-picker__item"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          bindtap="onPickerSelect"
        >{{item.label}}</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{teamClubOnboard}}" class="pe-onboard-bar">
    <text wx:if="{{teamProfileError}}" class="pe-onboard-bar__err">{{teamProfileError}}</text>
    <button
      class="pe-onboard-bar__btn {{teamProfileBusy ? 'is-disabled' : ''}}"
      disabled="{{teamProfileBusy}}"
      bindtap="onFinishTeamProfile"
    >{{teamProfileBusy ? '提交中…' : '完成并用于球队'}}</button>
  </view>
</view>
