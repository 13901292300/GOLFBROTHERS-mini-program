@import '../../../styles/team-form.wxss';

.create-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.create-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --text-primary: #002d62;
  --text-muted: #6b7280;
}

.create-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --text-primary: #f1f5f9;
  --text-muted: #888888;
}

page { height: 100%; background: var(--bg-primary); }

.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
}

.create-body { flex: 1; min-height: 0; }
