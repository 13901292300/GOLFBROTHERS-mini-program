/**
 * 我的球队列表 — 对齐「创建队内赛 → 选择球队」卡片 / Token
 */
.team-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00aeef;
  --error: #ef4444;
}

.team-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --border: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --shadow-card: none;
}

.team-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.team-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow-x: hidden;
}

.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.team-scroll { flex: 1; min-height: 0; height: 0; }
.team-content { padding: 32rpx 32rpx 24rpx; }

.section { margin-bottom: 24rpx; }
.section-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 24rpx;
}
.section-label__h2 {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
  color: var(--text-secondary);
}
.section-note {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-muted);
  white-space: nowrap;
}

.ds-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.team-list { display: flex; flex-direction: column; gap: 16rpx; }
.team-row {
  min-height: 128rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
}
.team-row--hover { background: var(--bg-subtle); }
.team-row__logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.team-row__main { flex: 1; min-width: 0; }
.team-row__name {
  display: block;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.team-row__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--text-muted);
}
.team-row__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.team-row__chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--text-muted);
  line-height: 1;
}

.team-tag {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1px solid var(--border);
  color: var(--text-secondary);
  background: var(--bg-subtle);
}
.team-tag--super_admin {
  color: #fff;
  background: var(--champion-gold);
  border-color: var(--champion-gold);
}
.team-tag--admin {
  color: #fff;
  background: var(--tour-blue);
  border-color: var(--tour-blue);
}
.team-tag--captain {
  color: var(--champion-gold);
  background: rgba(206, 146, 36, 0.12);
  border-color: var(--champion-gold);
}

.footer {
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border);
}

.create-team-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--champion-gold);
  color: #fff;
  font-size: 32rpx;
  font-weight: 800;
  padding: 0;
}
.create-team-btn::after { border: none; }
