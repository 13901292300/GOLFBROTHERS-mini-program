<view class="create-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">TEAM</text>
          <text class="gb-header__title">创建球队</text>
        </view>
      </view>
    </view>
  </view>

  <team-page-state
    wx:if="{{pageState !== 'ready'}}"
    pageState="{{pageState}}"
    errorTitle="{{errorTitle}}"
    errorDesc="{{errorDesc}}"
    bind:retry="onRetry"
  />

  <scroll-view wx:else class="create-body" scroll-y>
    <view class="form">
      <view class="form-logo" bindtap="onPickLogo">
        <image wx:if="{{form.logo}}" class="form-logo__img" src="{{form.logo}}" mode="aspectFill"></image>
        <text wx:else class="form-logo__ph">上传 LOGO</text>
      </view>
      <view class="field">
        <text class="field__label">球队名称 *</text>
        <input class="field__input" value="{{form.name}}" maxlength="30" bindinput="onName" placeholder="请输入球队全称" />
        <text class="field__count">{{nameCount}}/30</text>
      </view>
      <view class="field">
        <text class="field__label">简称</text>
        <input class="field__input" value="{{form.shortName}}" maxlength="4" bindinput="onShort" placeholder="最多4字" />
        <text class="field__count">{{shortCount}}/4</text>
      </view>
      <view class="field">
        <text class="field__label">地区</text>
        <input class="field__input" value="{{form.city}}" maxlength="20" bindinput="onCity" placeholder="城市或地区" />
      </view>
      <view class="field">
        <text class="field__label">口号</text>
        <input class="field__input" value="{{form.slogan}}" maxlength="40" bindinput="onSlogan" placeholder="可选" />
        <text class="field__count">{{sloganCount}}/40</text>
      </view>
      <view class="field">
        <text class="field__label">简介</text>
        <textarea class="field__area" value="{{form.intro}}" maxlength="200" bindinput="onIntro" placeholder="介绍球队" />
        <text class="field__count">{{introCount}}/200</text>
      </view>
      <view class="field field--row">
        <text class="field__label">接受新成员申请</text>
        <switch checked="{{form.acceptingMembers}}" bindchange="onAccept" color="#002d62" />
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{pageState === 'ready'}}" class="footer">
    <button class="submit-btn {{submitting ? 'is-disabled' : ''}}" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '创建中…' : '创建球队'}}
    </button>
  </view>
</view>
