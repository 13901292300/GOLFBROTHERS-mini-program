.team-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
}

.team-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --border: #222222;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --shadow-card: none;
}

.team-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page { height: 100%; background: var(--bg-primary); }

.team-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1.2;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* DIAG-10 临时取证条，诊断结束后删除 */
.pick-diagbar {
  flex-shrink: 0;
  padding: 8rpx 32rpx;
  background: #fff7e0;
  border-bottom: 1px solid var(--champion-gold);
}
.pick-diagbar__text { font-size: 18rpx; line-height: 1.5; color: #7a4b00; }

.team-scroll { flex: 1; min-height: 0; height: 0; }

.pick-bar {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1px solid var(--border);
}
.pick-bar__hint {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
}
.pick-bar__actions { display: flex; align-items: center; gap: 16rpx; }
.pick-bar__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}
.pick-bar__btn--ghost {
  flex: 0 0 200rpx;
  border: 1px solid var(--border);
  color: var(--text-secondary);
}
.pick-bar__btn--primary { background: var(--tour-blue); color: #fff; }
.pick-bar__btn--off { opacity: 0.45; }
.team-content { padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }

.pick-list { display: flex; flex-direction: column; gap: 16rpx; }

/* DIAG-10 模拟操作提示，诊断结束后删除 */
.pick-note { display: block; font-size: 22rpx; color: var(--text-muted, #6b7280); margin-bottom: 16rpx; }

.ds-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.pick-row {
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}
.pick-row--hover { background: var(--bg-subtle); }
.pick-row--active {
  border-color: var(--champion-gold);
  background: rgba(206, 146, 36, 0.1);
}
.pick-row__radio {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 9999rpx;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pick-row__radio--on {
  border-color: var(--champion-gold);
  background: var(--champion-gold);
}
.pick-row__tick { color: #fff; font-size: 24rpx; font-weight: 900; line-height: 1; }
.pick-row__avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 9999rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.pick-row__main { flex: 1; min-width: 0; }
.pick-row__name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}
.pick-row__name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.pick-row__chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--text-muted);
}

.tm-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1px solid var(--border);
}
.tm-tag--super_admin {
  color: #fff;
  background: var(--champion-gold);
  border-color: var(--champion-gold);
}
.tm-tag--admin {
  color: #fff;
  background: var(--tour-blue);
  border-color: var(--tour-blue);
}
.tm-tag--captain {
  color: var(--champion-gold);
  background: rgba(206, 146, 36, 0.12);
  border-color: var(--champion-gold);
}
