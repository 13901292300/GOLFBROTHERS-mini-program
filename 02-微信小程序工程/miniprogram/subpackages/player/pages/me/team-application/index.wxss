.team-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
}

.team-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --border: #222222;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --shadow-card: none;
}

.team-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page { height: 100%; background: var(--bg-primary); }

.team-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.team-scroll { flex: 1; min-height: 0; height: 0; }
.team-content { padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); }

.ds-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 20rpx;
}

.person-card {
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.person-card__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 9999rpx;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.person-card__main { flex: 1; min-width: 0; }
.person-card__name {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.person-card__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
.person-card__link {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--champion-gold);
}
.person-card__chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  color: var(--text-muted);
}

.facts { padding: 8rpx 32rpx; }
.fact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
}
.fact + .fact { border-top: 1px solid var(--border); }
.fact__label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-muted);
}
.fact__value {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  text-align: right;
  max-width: 62%;
}

.block { padding: 28rpx 32rpx 32rpx; }
.block__label {
  display: block;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--champion-gold);
  margin-bottom: 16rpx;
}
.block__body {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  font-weight: 500;
  color: var(--text-secondary);
  white-space: pre-wrap;
}

.status-box {
  padding: 8rpx 8rpx 24rpx;
  text-align: center;
}
.status-box__title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.status-box__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

.footer {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border);
}
.footer-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}
.footer-btn--ghost {
  background: var(--bg-subtle);
  color: var(--text-muted);
}
.footer-btn--gold {
  background: var(--champion-gold);
  color: #fff;
}
