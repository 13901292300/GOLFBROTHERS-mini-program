/**
 * 球员主页基础壳 — 对齐 profile/edit / footprints 的 token 与 Header
 */

.pp-page {
  --primary-blue: #002d62;
  --golf-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00aeef;
  --text-on-dark: #ffffff;
  --space-page: 16px;
  --radius-xl: 12px;

  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.pp-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
}

.pp-page.dark-mode {
  --bg-primary: #050816;
  --bg-card: #0b1220;
  --bg-subtle: #121a2b;
  --border: rgba(148, 163, 184, 0.16);
  --text-primary: #e5eefc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
  --shadow-card: 0 18px 40px rgba(0, 0, 0, 0.35);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.gb-header {
  background: var(--golf-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: var(--text-on-dark);
  flex-shrink: 0;
}
.gb-header__inner {
  display: flex;
  align-items: center;
}
.gb-header__left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.gb-header__back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gb-header__chevron {
  color: var(--text-on-dark);
  font-size: 52rpx;
  line-height: 1;
}
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: var(--text-on-dark);
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.pp-body {
  flex: 1;
  min-height: 0;
}

.pp-main {
  padding: var(--space-page);
  padding-bottom: calc(40px + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 16px;
  box-sizing: border-box;
}

.pp-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 3px solid var(--golf-blue);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-card);
  padding: 16px 18px;
  box-sizing: border-box;
}

.pp-card__label {
  display: block;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--champion-gold);
  margin-bottom: 12px;
}

.pp-hero {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16px;
}

.pp-avatar-ring {
  width: 88px;
  height: 88px;
  border-radius: 9999px;
  border: 4px solid var(--champion-gold);
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--bg-subtle);
}

.pp-avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.pp-hero__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pp-name-line {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
}

.pp-name-gender {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.pp-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 22px;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-gender {
  flex-shrink: 0;
  margin-left: 6px;
  font-size: 16px;
  font-weight: 700;
  line-height: 1;
}

.pp-gender.gender-male {
  color: #3b82f6;
}

.pp-gender.gender-female {
  color: #ef4444;
}

.pp-self-tag {
  align-self: flex-start;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  color: var(--champion-gold);
  background: rgba(206, 146, 36, 0.12);
  border: 1px solid rgba(206, 146, 36, 0.4);
}

.pp-signature {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.45;
}

.pp-geo {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
}

.pp-geo__dot {
  opacity: 0.6;
}

.pp-metrics {
  display: flex;
  gap: 12px;
}

.pp-metric {
  flex: 1;
  min-width: 0;
  padding: 12px;
  border-radius: 10px;
  background: var(--bg-subtle);
  box-sizing: border-box;
}

.pp-metric__label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
  margin-bottom: 6px;
}

.pp-metric__value {
  display: block;
  font-size: 24px;
  font-weight: 900;
  font-style: italic;
  line-height: 1.1;
}

.pp-metric__value--gold {
  color: var(--champion-gold);
}

.pp-metric__value--blue {
  color: var(--data-blue);
}

.pp-metric__value--pop {
  color: var(--champion-gold);
}

.pp-teams {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 4px;
}

.pp-team-row {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 8px 4px;
  border-radius: 10px;
  box-sizing: border-box;
}

.pp-team-row--hover {
  background: var(--bg-subtle);
}

.pp-team-logo {
  width: 44px;
  height: 44px;
  border-radius: 10px;
  flex-shrink: 0;
  background: var(--bg-subtle);
}

.pp-team-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.pp-team-name {
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-team-sub {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-teams-toggle {
  margin-top: 2px;
  padding: 8px 4px 2px;
  font-size: 13px;
  font-weight: 700;
  color: var(--data-blue);
}

.pp-teams-empty {
  margin-top: 4px;
  padding: 8px 0 2px;
}

.pp-teams-empty__text {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.5;
}

.pp-placeholder__text {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.5;
}

.pp-tabs {
  display: flex;
  flex-shrink: 0;
  gap: 4px;
  padding: 8px 16px 0;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border);
  box-sizing: border-box;
}

.pp-tabs__item {
  flex: 1;
  text-align: center;
  padding: 10px 4px 12px;
  font-size: 14px;
  font-weight: 700;
  color: var(--text-muted);
  border-bottom: 2px solid transparent;
}

.pp-tabs__item.is-active {
  color: var(--text-primary);
  border-bottom-color: var(--champion-gold);
}

.pp-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 4px;
}

.pp-filter__item {
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  background: var(--bg-subtle);
}

.pp-filter__item.is-active {
  color: #fff;
  background: var(--golf-blue);
}

.pp-tab-state {
  padding: 48px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  text-align: center;
}

.pp-hist-stats {
  display: flex;
  gap: 10px;
  margin: 8px 0 12px;
}

.pp-hist-stat {
  flex: 1;
  min-width: 0;
  padding: 10px 8px;
  border-radius: 10px;
  background: var(--bg-subtle);
  text-align: center;
  box-sizing: border-box;
}

.pp-hist-stat__n {
  display: block;
  font-size: 20px;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1.2;
}

.pp-hist-stat__l {
  display: block;
  margin-top: 4px;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
}

.pp-hist-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.pp-hist-card {
  padding: 12px;
  border-radius: 10px;
  background: var(--bg-subtle);
  box-sizing: border-box;
  overflow: hidden;
}

.pp-hist-card--full {
  background: var(--bg-card);
  border: 1px solid var(--border);
}

.pp-hist-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 6px;
}

.pp-hist-card__date {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  flex-shrink: 0;
}

.pp-hist-card__tag {
  font-size: 11px;
  font-weight: 700;
  color: var(--data-blue);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  text-align: right;
}

.pp-hist-card__title {
  display: block;
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-hist-card__course {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-hist-card__result {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.pp-hist-card__primary {
  font-size: 18px;
  font-weight: 900;
  font-style: italic;
  color: var(--champion-gold);
  line-height: 1.25;
  word-break: break-word;
  white-space: normal;
}

.pp-hist-card__secondary {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.35;
  word-break: break-word;
  white-space: normal;
}

.pp-hist-card__team {
  margin-top: 8px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-hist-card__nav {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 700;
  color: var(--data-blue);
}

.pp-hist-more {
  text-align: center;
  padding: 12px;
  font-size: 13px;
  font-weight: 700;
  color: var(--data-blue);
}

.pp-remark-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.pp-moment-related {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(0, 45, 98, 0.06);
  border: 1px solid var(--border);
}
.pp-page.dark-mode .pp-moment-related {
  background: rgba(147, 197, 253, 0.08);
}
.pp-moment-related__name {
  display: block;
  font-size: 13px;
  font-weight: 800;
  color: var(--text-primary);
}
.pp-moment-related__code {
  display: block;
  margin-top: 3px;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
}

.pp-moment-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 4px;
}

.pp-moment-card {
  padding: 12px;
  border-radius: 10px;
  background: var(--bg-subtle);
  box-sizing: border-box;
  overflow: visible;
  position: relative;
  z-index: 1;
}

.pp-moment-card--full {
  background: var(--bg-card);
  border: 1px solid var(--border);
}

.pp-moment-card__report {
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 2px;
  font-size: 12px;
  font-weight: 800;
  color: var(--text-muted);
}
.pp-moment-card__report.is-reported {
  opacity: 0.75;
}
.pp-moment-card__head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.pp-moment-card__avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--bg-subtle);
  flex-shrink: 0;
}

.pp-moment-card__meta {
  flex: 1;
  min-width: 0;
}

.pp-moment-card__name {
  display: block;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-moment-card__time {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
}

.pp-moment-card__text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  color: var(--text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

.pp-moment-card__more {
  display: inline-block;
  margin-top: 6px;
  font-size: 13px;
  font-weight: 800;
  color: var(--data-blue);
}

.pp-moment-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}

.pp-moment-action {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-muted);
}

.pp-moment-action.is-liked {
  color: #b45309;
}
.pp-moment-action.is-reported {
  color: var(--text-muted);
  opacity: 0.75;
}

.pp-moment-action__label {
  font-weight: 800;
}

.pp-moment-action__count {
  min-width: 1em;
}

.pp-moment-cmt-preview {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: var(--bg-subtle);
}

.pp-moment-cmt-preview__row {
  display: block;
  font-size: 12px;
  line-height: 1.55;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pp-moment-cmt-preview__row + .pp-moment-cmt-preview__row {
  margin-top: 4px;
}

.pp-moment-cmt-preview__name {
  font-weight: 800;
  color: var(--golf-blue);
}

.pp-moment-cmt-preview__reply {
  font-weight: 700;
  color: var(--text-muted);
}

.pp-moment-cmt-preview__text {
  font-weight: 600;
  color: var(--text-primary);
}

.pp-page.dark-mode .pp-moment-cmt-preview__name {
  color: #93c5fd;
}

.pp-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 32px;
  box-sizing: border-box;
}

.pp-state__title {
  font-size: 18px;
  font-weight: 900;
  color: var(--text-primary);
}

.pp-state__text {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-muted);
}

.pp-state__btn {
  margin-top: 8px;
  padding: 10px 28px;
  border-radius: 999px;
  background: var(--golf-blue);
  color: #fff;
  font-size: 14px;
  font-weight: 800;
}

.pp-origin-name {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
}

.pp-counts {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-secondary);
}

.pp-counts__sep {
  color: var(--text-muted);
  opacity: 0.7;
}

.pp-hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}

.pp-follow-btn {
  align-self: flex-start;
  padding: 8px 18px;
  border-radius: 999px;
  background: var(--champion-gold);
  color: #fff;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.2;
}

.pp-pk-btn {
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid var(--golf-blue);
  background: transparent;
  color: var(--golf-blue);
  font-size: 13px;
  font-weight: 800;
  line-height: 1.2;
}

.pp-page.dark-mode .pp-pk-btn {
  border-color: var(--champion-gold);
  color: var(--champion-gold);
}

.pp-pk-btn--hover {
  opacity: 0.85;
}

.pp-follow-btn--hover {
  opacity: 0.88;
}

.pp-follow-btn.is-muted {
  background: var(--bg-subtle);
  color: var(--text-secondary);
  border: 1px solid var(--border);
}

.pp-follow-btn.is-loading {
  opacity: 0.55;
  pointer-events: none;
}

.pp-remark-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.pp-card__label--inline {
  margin-bottom: 0;
}

.pp-remark-edit {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 800;
  color: var(--data-blue);
}

.pp-remark-body {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.pp-remark-empty {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.5;
}

.pp-sheet {
  /* 不用 inset：部分基础库对 flex 子项 fixed+inset 覆盖不稳定 */
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  box-sizing: border-box;
}

/* 关系面板常挂载：关闭时必须不可见且不拦截点击 */
.pp-sheet--relation {
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
}

.pp-sheet--relation.is-open {
  visibility: visible;
  pointer-events: auto;
  opacity: 1;
}

.pp-sheet.bright-mode {
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
}

.pp-sheet.dark-mode {
  --bg-card: #0b1220;
  --bg-subtle: #121a2b;
  --border: rgba(148, 163, 184, 0.16);
  --text-primary: #e5eefc;
  --text-secondary: #cbd5e1;
  --text-muted: #94a3b8;
}

.pp-sheet__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.pp-sheet__panel {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 100%;
  background: var(--bg-card);
  border-radius: 24px 24px 0 0;
  padding: 12px 20px calc(16px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pp-sheet__panel--form {
  max-height: 78vh;
  overflow-y: auto;
}

.pp-sheet__handle {
  width: 48px;
  height: 4px;
  border-radius: 999px;
  background: var(--border);
  margin: 4px auto 14px;
}

.pp-sheet__title {
  display: block;
  text-align: center;
  font-size: 16px;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.pp-sheet__desc {
  display: block;
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.45;
  margin-bottom: 18px;
}

.pp-sheet__danger {
  height: 48px;
  border-radius: 12px;
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
  font-size: 15px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 18px;
  margin-bottom: 10px;
}

.pp-sheet__danger.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.pp-sheet__cancel {
  height: 48px;
  border-radius: 12px;
  background: var(--bg-subtle);
  color: var(--text-secondary);
  font-size: 15px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pp-sheet__head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.pp-sheet__head-row .pp-sheet__title {
  flex: 1;
  margin-bottom: 0;
}

.pp-sheet__link {
  min-width: 48px;
  font-size: 14px;
  font-weight: 700;
  color: var(--text-muted);
}

.pp-sheet__link--primary {
  color: var(--data-blue);
  text-align: right;
}

.pp-sheet__field {
  margin-bottom: 14px;
}

.pp-sheet__field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-muted);
  margin-bottom: 8px;
}

.pp-sheet__count {
  font-weight: 600;
}

.pp-sheet__input,
.pp-sheet__textarea {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text-primary);
  font-size: 15px;
  font-weight: 600;
  padding: 12px 14px;
}

.pp-sheet__input {
  height: 48px;
}

.pp-sheet__textarea {
  min-height: 120px;
  line-height: 1.5;
}
