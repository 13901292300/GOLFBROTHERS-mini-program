.mm-page {
  --golf-blue: #002d62;
  --champion-gold: #ce9224;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
  color: var(--text-primary);
  box-sizing: border-box;
}
.mm-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --border: #e5e7eb;
  --text-primary: #002d62;
  --text-muted: #6b7280;
}
.mm-page.dark-mode {
  --bg-primary: #050816;
  --bg-card: #0b1220;
  --bg-subtle: #121a2b;
  --border: rgba(148, 163, 184, 0.16);
  --text-primary: #e5eefc;
  --text-muted: #94a3b8;
}
page { height: 100%; background: var(--bg-primary); }

.gb-header {
  background: var(--golf-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 12px;
  box-sizing: border-box;
}
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
}
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block; font-size: 17rpx; font-weight: 900;
  letter-spacing: 0.24em; color: rgba(255,255,255,0.5); margin-bottom: 6rpx;
}
.gb-header__title {
  display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic;
}
.mm-body { flex: 1; min-height: 0; }
.mm-main {
  padding: 16px;
  padding-bottom: calc(24px + env(safe-area-inset-bottom));
}

.mm-state {
  padding: 48px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}
.mm-state__title { font-size: 16px; font-weight: 800; color: var(--text-primary); }
.mm-state__text { font-size: 13px; font-weight: 600; color: var(--text-muted); }
.mm-state__hint {
  font-size: 12px;
  font-weight: 600;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.5;
}
.mm-related {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(0, 45, 98, 0.06);
  border: 1px solid var(--border);
}
.mm-page.dark-mode .mm-related {
  background: rgba(147, 197, 253, 0.08);
}
.mm-related__name {
  display: block;
  font-size: 13px;
  font-weight: 800;
  color: var(--text-primary);
}
.mm-related__code {
  display: block;
  margin-top: 3px;
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
}
.mm-state__btn {
  padding: 10px 22px;
  border-radius: 999px;
  background: var(--golf-blue);
  color: #fff;
  font-size: 13px;
  font-weight: 800;
}

.mm-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.mm-card {
  padding: 14px;
  border-radius: 12px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  box-sizing: border-box;
  overflow: visible;
  position: relative;
  z-index: 1;
}
.mm-card__head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}
.mm-card__report {
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 2px;
  font-size: 12px;
  font-weight: 800;
  color: var(--text-muted);
}
.mm-card__report.is-reported {
  opacity: 0.75;
}
.mm-card__avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.mm-card__meta { flex: 1; min-width: 0; }
.mm-card__name {
  display: block;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mm-card__time {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
}
.mm-card__text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 5;
  overflow: hidden;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  color: var(--text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}
.mm-card__more {
  display: inline-block;
  margin-top: 6px;
  font-size: 13px;
  font-weight: 800;
  color: #2563eb;
}

/* 轻量「查看详情 ›」：成绩卡后、互动区前；左对齐；热区仅包文字 */
.mm-card__detail {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  min-height: 64rpx;
  margin-top: 2px;
  margin-bottom: 2px;
  padding: 0 12rpx 0 0;
  box-sizing: border-box;
  text-align: left;
  max-width: 100%;
}
.mm-card__detail-text {
  font-size: 12px;
  font-weight: 700;
  line-height: 1.2;
  color: #2563eb;
  text-align: left;
}
.mm-page.dark-mode .mm-card__detail-text {
  color: #93c5fd;
}

.mm-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid var(--border);
}
.mm-action {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 800;
  color: var(--text-muted);
}
.mm-action.is-liked { color: #b45309; }
.mm-action.is-reported { color: var(--text-muted); opacity: 0.75; }

.mm-cmt-preview {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 10px;
  background: var(--bg-subtle);
}
.mm-cmt-preview__row {
  display: block;
  font-size: 12px;
  line-height: 1.55;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mm-cmt-preview__row + .mm-cmt-preview__row { margin-top: 4px; }
.mm-cmt-preview__name { font-weight: 800; color: var(--golf-blue); }
.mm-page.dark-mode .mm-cmt-preview__name { color: #93c5fd; }
.mm-cmt-preview__reply { font-weight: 700; color: var(--text-muted); }
.mm-cmt-preview__text { font-weight: 600; }

.mm-more {
  text-align: center;
  padding: 14px;
  font-size: 13px;
  font-weight: 800;
  color: #2563eb;
}

/* 扩展点样式：feedType TAB（当前 feedTabsVisible=false） */
.mm-feed-tabs {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
  padding: 0 2px;
}
.mm-feed-tabs__item {
  font-size: 13px;
  font-weight: 800;
  color: var(--text-muted, #6b7280);
}
.mm-feed-tabs__item.is-active {
  color: var(--golf-blue, #002d62);
}
.mm-page.dark-mode .mm-feed-tabs__item.is-active {
  color: #93c5fd;
}
