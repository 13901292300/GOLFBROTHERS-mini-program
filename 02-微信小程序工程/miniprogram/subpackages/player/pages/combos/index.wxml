<view class="player-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">COMBO</text>
          <text class="gb-header__title">老牌组合</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view scroll-y class="page-body">
    <view class="body-hint">使用频率最高的组合，点击即可一键按顺序填充空位</view>
    <view wx:for="{{combos}}" wx:key="id" class="combo-card {{item.allUsed ? 'is-disabled' : ''}}" bindtap="selectCombo" data-combo="{{item}}">
      <view class="combo-top">
        <view class="combo-info">
          <text class="combo-name">{{item.name}}</text>
          <text class="combo-desc">{{item.desc}} · 用过 {{item.useCount}} 次</text>
        </view>
        <text class="combo-fill {{item.allUsed ? 'is-off' : ''}}">{{item.allUsed ? '已全部在场' : '填充'}}</text>
      </view>
      <view class="combo-players">
        <view wx:for="{{item.players}}" wx:for-item="p" wx:key="playerId" class="combo-player {{p.disabled ? 'is-disabled' : ''}}">
          <image class="combo-avatar" src="{{p.avatar}}" mode="aspectFill"></image>
          <text class="combo-pname">{{p.name}}</text>
        </view>
      </view>
    </view>
    <view class="body-pad"></view>
  </scroll-view>
</view>
