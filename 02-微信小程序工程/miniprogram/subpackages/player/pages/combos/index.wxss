.player-page { --tour-blue: #002d62; --champion-gold: #ce9224; --data-blue: #00AEEF; }
.player-page.dark-mode {
  --bg-primary: #000000; --bg-card: #111111; --bg-subtle: #0a0a0a; --bg-hover: #1a1a1a;
  --border: #222222; --border-hover: #333333;
  --text-primary: #f1f5f9; --text-secondary: #e5e7f9; --text-muted: #888888; --shadow-card: none;
}
.player-page.bright-mode {
  --bg-primary: #fcfcfc; --bg-card: #ffffff; --bg-subtle: #f3f4f6; --bg-hover: #f9fafb;
  --border: #e5e7eb; --border-hover: #d1d5db;
  --text-primary: #002d62; --text-secondary: #374151; --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page { height: 100%; background: var(--bg-primary); }
.player-page { display: flex; flex-direction: column; height: 100vh; background: var(--bg-primary); color: var(--text-primary); overflow-x: hidden; }

.gb-header { background: var(--tour-blue); border-bottom: 2px solid var(--champion-gold); color: #fff; flex-shrink: 0; }
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

.page-body { flex: 1; min-height: 0; padding: 24rpx 32rpx; box-sizing: border-box; }
.body-hint { font-size: 24rpx; color: var(--text-muted); margin-bottom: 20rpx; }
.body-pad { height: 40rpx; }

.combo-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 18rpx; box-shadow: var(--shadow-card); padding: 24rpx; margin-bottom: 20rpx; }
.combo-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 18rpx; }
.combo-info { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.combo-name { font-size: 30rpx; font-weight: 900; color: var(--text-primary); }
.combo-desc { font-size: 22rpx; color: var(--text-muted); }
.combo-fill { font-size: 24rpx; font-weight: 800; color: #fff; background: var(--tour-blue); padding: 10rpx 26rpx; border-radius: 999rpx; flex-shrink: 0; }
.combo-players { display: flex; flex-wrap: wrap; gap: 22rpx; }
.combo-player { display: flex; flex-direction: column; align-items: center; gap: 8rpx; width: 96rpx; }
.combo-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: var(--bg-subtle); }
.combo-pname { font-size: 22rpx; color: var(--text-secondary); max-width: 96rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.combo-card.is-disabled { opacity: 0.5; }
.combo-fill.is-off { background: var(--bg-subtle); color: var(--text-muted); }
.combo-player.is-disabled { opacity: 0.38; }
