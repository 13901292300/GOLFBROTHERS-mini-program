.mv {
  width: 100%;
  margin-top: 10px;
  box-sizing: border-box;
}
.mv--detail {
  margin-top: 14px;
}
.mv-stage {
  position: relative;
  width: 100%;
  padding-top: 56.25%;
  border-radius: 12px;
  overflow: hidden;
  background: #0b1220;
}
.mv--detail .mv-stage {
  padding-top: 72%;
  border-radius: 14px;
}
.mv-player,
.mv-cover,
.mv-poster,
.mv-loading,
.mv-unavailable {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.mv-player {
  z-index: 1;
  background: #000;
}
.mv-cover {
  z-index: 2;
}
.mv-poster--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #1e293b, #0f172a);
}
.mv-ph {
  color: rgba(255, 255, 255, 0.5);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.08em;
}
.mv-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56px;
  height: 56px;
  margin: -28px 0 0 -28px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  border: 2px solid rgba(255, 255, 255, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.mv-play__icon {
  color: #fff;
  font-size: 20px;
  margin-left: 3px;
  line-height: 1;
}
.mv-duration {
  position: absolute;
  right: 10px;
  bottom: 10px;
  padding: 2px 8px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 12px;
  font-weight: 800;
}
.mv-fail {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: rgba(0, 0, 0, 0.45);
}
.mv-fail__text {
  color: #fff;
  font-size: 13px;
  font-weight: 800;
}
.mv-fail__retry {
  color: rgba(255, 255, 255, 0.85);
  font-size: 12px;
  font-weight: 700;
}
.mv-loading {
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
  pointer-events: none;
}
.mv-loading__text {
  color: #fff;
  font-size: 12px;
  font-weight: 700;
}
.mv-stage--unavailable .mv-unavailable {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2;
}
.mv-unavailable__text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 13px;
  font-weight: 800;
}
