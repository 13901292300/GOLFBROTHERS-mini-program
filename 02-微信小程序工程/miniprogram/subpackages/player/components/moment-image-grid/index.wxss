.mig {
  --mig-gap: 8rpx;
  --mig-broken-bg: #f3f4f6;
  --mig-broken-fg: #9ca3af;
  --mig-img-bg: rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 2;
  margin-top: 10px;
  box-sizing: border-box;
}

.mig.dark-mode {
  --mig-broken-bg: #1f2937;
  --mig-broken-fg: #94a3b8;
  --mig-img-bg: rgba(255, 255, 255, 0.06);
}

/* 单图左对齐，不铺满 */
.mig--single {
  display: block;
  width: auto;
  max-width: 100%;
}

.mig__single {
  display: block;
  max-width: 100%;
  overflow: hidden;
  border-radius: 8rpx;
  background: var(--mig-img-bg);
  box-sizing: border-box;
}

.mig__single .mig__img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 多图：占满卡片内容宽，列数由 layout 类固定，避免窄屏 flex 折成两列 */
.mig--double,
.mig--triple,
.mig--quad,
.mig--grid {
  width: 100%;
  max-width: 100%;
}

.mig__cells {
  display: grid;
  gap: var(--mig-gap);
  width: 100%;
  box-sizing: border-box;
}

/* 2 图 / 4 图：固定两列（4 图保持 2×2，不会变成 3+1） */
.mig--double .mig__cells,
.mig--quad .mig__cells {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

/* 3 图 / 5～9：固定三列（5=3+2，6=3×2，7=3+3+1，8=3+3+2，9=3×3） */
.mig--triple .mig__cells,
.mig--grid .mig__cells {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.mig__cell {
  position: relative;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 6rpx;
  background: var(--mig-img-bg);
  box-sizing: border-box;
  min-width: 0;
}

/* 不支持 aspect-ratio 时：padding 等比例占位，禁止回退固定 210rpx */
@supports not (aspect-ratio: 1 / 1) {
  .mig__cell {
    height: 0;
    padding-bottom: 100%;
  }
}

.mig__cell .mig__img {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.mig__cell .mig__broken {
  position: absolute;
  left: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: var(--mig-broken-bg);
  box-sizing: border-box;
}

.mig__broken-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--mig-broken-fg);
}
