.mig {
  --mig-cell: 210rpx;
  --mig-gap: 8rpx;
  --mig-broken-bg: #f3f4f6;
  --mig-broken-fg: #9ca3af;
  --mig-img-bg: rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 2;
  margin-top: 10px;
  box-sizing: border-box;
}

.mig.dark-mode {
  --mig-broken-bg: #1f2937;
  --mig-broken-fg: #94a3b8;
  --mig-img-bg: rgba(255, 255, 255, 0.06);
}

/* 单图左对齐，不铺满 */
.mig--single {
  display: block;
  width: auto;
  max-width: 100%;
}

.mig__single {
  display: block;
  max-width: 100%;
  overflow: hidden;
  border-radius: 8rpx;
  background: var(--mig-img-bg);
  box-sizing: border-box;
}

.mig__single .mig__img {
  display: block;
  width: 100%;
  height: 100%;
}

/* 2 图：一行两正方形 */
.mig--double .mig__cells {
  width: calc(2 * var(--mig-cell) + var(--mig-gap));
  max-width: 100%;
}

/* 3 图 / 5～9：三列宽 */
.mig--triple .mig__cells,
.mig--grid .mig__cells {
  width: calc(3 * var(--mig-cell) + 2 * var(--mig-gap));
  max-width: 100%;
}

/* 4 图：2×2，不占满三列 */
.mig--quad .mig__cells {
  width: calc(2 * var(--mig-cell) + var(--mig-gap));
  max-width: 100%;
}

.mig__cells {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-content: flex-start;
  gap: var(--mig-gap);
  box-sizing: border-box;
}

.mig__cell {
  width: var(--mig-cell);
  height: var(--mig-cell);
  flex: 0 0 var(--mig-cell);
  overflow: hidden;
  border-radius: 6rpx;
  background: var(--mig-img-bg);
  box-sizing: border-box;
}

.mig__cell .mig__img {
  display: block;
  width: 100%;
  height: 100%;
}

.mig__broken {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mig-broken-bg);
  box-sizing: border-box;
}

.mig__broken-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--mig-broken-fg);
}
