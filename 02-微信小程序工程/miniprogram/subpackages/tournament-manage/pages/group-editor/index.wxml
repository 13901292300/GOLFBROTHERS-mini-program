<view class="group-editor-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">TOURNAMENT</text>
          <text class="gb-header__title">{{headerTitle}}</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="editor-scroll" scroll-y>
    <tournament-group-editor-view
      themeClass="{{themeClass}}"
      mode="{{mode}}"
      layout="page"
      draftCards="{{draftCards}}"
      showCompositionMode="{{showCompositionMode}}"
      strokeCompositionMode="{{strokeCompositionMode}}"
      showPairingSection="{{showPairingSection}}"
      showPairingComposeTools="{{showPairingComposeTools}}"
      bind:compositionmode="onStrokeCompositionModeTap"
      bind:groupcardtap="onGroupCardTap"
      bind:deletegroup="onDeleteGroupTap"
      bind:addgroup="onAddGroup"
      bind:editpairing="onEditPairingTap"
      bind:deletepairing="onDeletePairingTap"
      bind:autopair="onAutoPairTap"
      bind:addpairing="onAddPairingTap"
    />
  </scroll-view>

  <view class="editor-cta-bar">
    <view bindtap="onCancel" class="editor-cta-btn editor-cta-btn--cancel">取消</view>
    <view bindtap="onConfirm" class="editor-cta-btn {{saving ? 'editor-cta-btn--disabled' : ''}}">确定</view>
  </view>

  <view wx:if="{{groupDeleteModalVisible}}" bindtap="closeGroupDeleteModal" class="editor-modal">
    <view catchtap="stopPropagation" class="editor-dialog">
      <text class="editor-dialog__title">确认删除{{groupDeleteTargetName}}？</text>
      <text class="editor-dialog__desc">删除后该组球员配置将被移除。</text>
      <view class="editor-dialog__actions">
        <view bindtap="closeGroupDeleteModal" class="editor-dialog__btn">取消</view>
        <view bindtap="confirmDeleteGroup" class="editor-dialog__btn editor-dialog__btn--danger">确认删除</view>
      </view>
    </view>
  </view>

  <!-- 修改组合：选择球员（临时 editingPairingSelectedIds，确定前不写 pairingDraft） -->
  <view wx:if="{{pairingEditVisible}}" bindtap="closePairingEditSheet" class="editor-modal">
    <view catchtap="stopPropagation" class="pairing-edit-sheet">
      <text class="pairing-edit-sheet__title">{{pairingEditTitle}}</text>
      <scroll-view class="pairing-edit-sheet__list" scroll-y>
        <view
          wx:for="{{pairingEditOptions}}"
          wx:key="userId"
          class="pairing-edit-row {{item.disabled ? 'is-disabled' : ''}} {{item.checked ? 'is-checked' : ''}}"
          catchtap="onTogglePairingEditPlayer"
          data-index="{{item.index}}"
        >
          <view class="pairing-edit-check {{item.checked ? 'is-on' : ''}}">
            <text wx:if="{{item.checked}}">✓</text>
          </view>
          <image wx:if="{{item.avatar}}" class="pairing-edit-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view wx:else class="pairing-edit-avatar pairing-edit-avatar--empty"></view>
          <view class="pairing-edit-meta">
            <text class="pairing-edit-name">{{item.name}}</text>
            <text wx:if="{{item.occupiedTip}}" class="pairing-edit-tip">{{item.occupiedTip}}</text>
          </view>
        </view>
        <view wx:if="{{!pairingEditOptions.length}}" class="pairing-edit-empty">当前组暂无球员</view>
      </scroll-view>
      <view class="pairing-edit-sheet__actions">
        <view catchtap="closePairingEditSheet" class="editor-dialog__btn">取消</view>
        <view catchtap="confirmPairingEdit" class="editor-dialog__btn editor-dialog__btn--primary">确定</view>
      </view>
    </view>
  </view>
</view>
