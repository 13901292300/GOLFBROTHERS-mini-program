@import '../../styles/half-course-panel.wxss';

.sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 150;
}

.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  color: var(--tour-blue, #002d62);
  border-radius: 80rpx 80rpx 0 0;
  z-index: 180;
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35);
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-handle {
  width: 96rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  margin: 24rpx auto 40rpx;
}

.sheet-overlay--half {
  z-index: 210;
}

.bottom-sheet.half-course-sheet {
  z-index: 230;
  pointer-events: auto;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  background: #fff;
}

/* Dark 顶蓝线需被顶圆角裁切（与 Hub/Score bottom-sheet 一致） */
.half-sheet {
  overflow: hidden;
}

.half-course-sheet .half-course-panel {
  pointer-events: auto;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* ===== Phase1 UI 统一：Header / Footer / 左右 48rpx（仅样式） ===== */
.half-course-sheet .half-sheet-head {
  position: relative;
  padding: 0 48rpx 24rpx;
  text-align: left;
}

.half-course-sheet .sheet-head-titles {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  padding-right: 64rpx;
}

.half-course-sheet .fst-main {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--golf-blue, #002d62);
  line-height: 1.3;
}

.half-course-sheet .fst-sub {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--text-secondary, var(--text-muted, #9ca3af));
  line-height: 1.3;
}

.half-course-sheet .half-sheet-close {
  position: absolute;
  right: 32rpx;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-muted, #9ca3af);
  line-height: 1;
}

.half-course-sheet .half-sheet-body {
  max-height: 58vh;
  padding: 0 48rpx 24rpx;
  box-sizing: border-box;
}

.half-course-sheet .half-sheet-footer {
  padding: 12rpx 48rpx calc(12rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.half-course-sheet .half-confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.18em;
  padding: 0;
  text-align: center;
}

/*
 * Dark：不依赖父页 .score-page.dark-mode（styleIsolation isolated）。
 * 记分页 themeClass 为 dark-mode；兼容 dark-theme 别名。
 */
.half-sheet.dark-mode,
.half-sheet.dark-theme {
  --bg-primary: #000000;
  --bg-secondary: #0a0a0a;
  --bg-card: #111111;
  --text-primary: #ffffff;
  --text-secondary: #888888;
  --text-muted: #888888;
  --border-color: #222222;
  --golf-blue: #002d62;
  --data-blue: #00aeef;
  --champion-gold: #ce9224;
  background: var(--bg-card);
  color: var(--text-primary);
}

.half-sheet.dark-mode .sheet-handle,
.half-sheet.dark-theme .sheet-handle {
  background: var(--border-color);
}

.half-sheet .sheet-top-accent {
  display: none;
}

.half-sheet.dark-mode .sheet-top-accent,
.half-sheet.dark-theme .sheet-top-accent {
  display: block;
  width: 100%;
  height: 3px;
  background: var(--golf-blue, #002d62);
  flex-shrink: 0;
}

.half-sheet.dark-mode .fst-main,
.half-sheet.dark-mode .half-course-name,
.half-sheet.dark-theme .fst-main,
.half-sheet.dark-theme .half-course-name {
  color: var(--text-primary);
}

.half-sheet.dark-mode .fst-sub,
.half-sheet.dark-mode .half-hint,
.half-sheet.dark-mode .half-sheet-close,
.half-sheet.dark-mode .par-table__title,
.half-sheet.dark-theme .fst-sub,
.half-sheet.dark-theme .half-hint,
.half-sheet.dark-theme .half-sheet-close,
.half-sheet.dark-theme .par-table__title {
  color: var(--text-muted);
}

.half-sheet.dark-mode .half-col,
.half-sheet.dark-mode .par-row,
.half-sheet.dark-theme .half-col,
.half-sheet.dark-theme .par-row {
  background: var(--bg-card);
  border-color: var(--border-color);
}

.half-sheet.dark-mode .half-col__title,
.half-sheet.dark-mode .par-row__total,
.half-sheet.dark-theme .half-col__title,
.half-sheet.dark-theme .par-row__total {
  color: var(--text-primary);
}

.half-sheet.dark-mode .half-tag,
.half-sheet.dark-mode .par-hole-cell,
.half-sheet.dark-theme .half-tag,
.half-sheet.dark-theme .par-hole-cell {
  background: var(--bg-secondary);
  border-color: var(--border-color);
  color: var(--text-secondary);
}

.half-sheet.dark-mode .half-tag.active,
.half-sheet.dark-theme .half-tag.active {
  background: var(--golf-blue);
  border-color: var(--golf-blue);
  color: #fff;
}

.half-sheet.dark-mode .par-row.active,
.half-sheet.dark-theme .par-row.active {
  background: rgba(0, 174, 239, 0.12);
  border-color: var(--data-blue);
}

.half-sheet.dark-mode .par-row.active .par-row__code,
.half-sheet.dark-theme .par-row.active .par-row__code {
  color: var(--data-blue);
}

.half-sheet.dark-mode .par-side-tag,
.half-sheet.dark-theme .par-side-tag {
  background: var(--data-blue);
  color: #001;
}

.half-sheet.dark-mode .par-row__code,
.half-sheet.dark-mode .par-row__name,
.half-sheet.dark-theme .par-row__code,
.half-sheet.dark-theme .par-row__name {
  color: var(--text-secondary);
}
