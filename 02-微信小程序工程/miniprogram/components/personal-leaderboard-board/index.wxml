<view class="leaderboard-head leaderboard-head--personal {{showLeaderboardTeamColumn ? '' : 'leaderboard-head--personal-no-team'}}">
  <text class="lh-pos">POS</text>
  <text class="lh-player">PLAYER</text>
  <view class="leaderboard-metrics {{showLeaderboardTeamColumn ? 'leaderboard-metrics--with-team' : 'leaderboard-metrics--no-team'}}">
    <text wx:if="{{showLeaderboardTeamColumn}}" class="lh-team">TEAM</text>
    <text class="lh-thru">THRU</text>
    <text class="lh-total">{{leaderboardScoreType === 'net' ? 'NET SCORE' : 'TO PAR'}}</text>
  </view>
</view>

<view wx:if="{{emptyText && (!leaderboard || !leaderboard.length)}}" class="hub-empty">{{emptyText}}</view>

<block wx:for="{{leaderboard}}" wx:key="rowId">
  <view bindtap="onRowTap" data-index="{{index}}" class="leaderboard-row leaderboard-row--personal {{showLeaderboardTeamColumn ? '' : 'leaderboard-row--personal-no-team'}}">
    <text class="lr-pos pos-cell">{{item.pos}}</text>
    <view class="lr-player">
      <text class="player-name">{{item.name}}</text>
      <text wx:if="{{!item.isTeam && item.genderIcon}}" class="gender-icon {{item.genderClass}}">{{item.genderIcon}}</text>
    </view>
    <view class="leaderboard-metrics {{showLeaderboardTeamColumn ? 'leaderboard-metrics--with-team' : 'leaderboard-metrics--no-team'}}">
      <text wx:if="{{showLeaderboardTeamColumn}}" class="lr-team">{{item.teamName || '-'}}</text>
      <text class="lr-thru">{{item.thru}}</text>
      <text class="lr-total leaderboard-total {{leaderboardScoreType === 'net' ? 'score-even' : item.scoreClass}}">{{leaderboardScoreType === 'net' ? (item.netScoreDisplay || item.scoreStr) : item.scoreStr}}</text>
    </view>
  </view>

  <!-- 展开成绩卡 -->
  <view wx:if="{{item.expanded}}" class="scorecard-row {{scorePanel === 'quick' ? 'score-panel-quick' : ''}}">
    <!-- Entity 组合：与普通创建 fourball 一致 -->
    <view wx:if="{{item.isEntity && item.members && item.members.length}}" class="sc-team-stack-wrap">
      <leaderboard-player-profile-panel
        wx:for="{{item.members}}"
        wx:for-item="mem"
        wx:key="playerId"
        player="{{mem}}"
        team-group-logo-by-id="{{teamGroupLogoById}}"
        avatar-badge="{{leaderboardAvatarBadge}}"
        meta-mode="{{leaderboardMetaMode}}"
        show-name-gender="{{leaderboardShowExpandGender}}"
        gender="{{mem.gender}}"
        gender-symbol="{{mem.genderSymbol || mem.genderIcon}}"
        gender-class="{{mem.genderClass}}"
        followed="{{leaderboardFollowEnabled ? followMap[mem.playerId] : false}}"
        relation-status="{{leaderboardFollowEnabled ? (relationMap[mem.playerId] || (followMap[mem.playerId] ? 'following' : 'none')) : 'none'}}"
        relationship-label="{{leaderboardFollowEnabled ? (relationLabelMap[mem.playerId] || '') : ''}}"
        can-follow="{{leaderboardFollowEnabled ? !!leaderboardFollowableMap[mem.playerId] : true}}"
        follow-loading="{{leaderboardFollowEnabled ? !!followLoadingMap[mem.playerId] : false}}"
        is-self="{{leaderboardFollowEnabled ? !leaderboardFollowableMap[mem.playerId] : false}}"
        bind:follow="onFollowTap"
        bind:profiletap="onProfileTap"
      />
    </view>
    <leaderboard-player-profile-panel
      wx:else
      player="{{item}}"
      team-group-logo-by-id="{{teamGroupLogoById}}"
      avatar-badge="{{leaderboardAvatarBadge}}"
      meta-mode="{{leaderboardMetaMode}}"
      show-name-gender="{{leaderboardShowExpandGender}}"
      gender="{{item.gender}}"
      gender-symbol="{{item.genderSymbol || item.genderIcon}}"
      gender-class="{{item.genderClass}}"
      followed="{{leaderboardFollowEnabled ? followMap[item.playerId] : false}}"
      relation-status="{{leaderboardFollowEnabled ? (relationMap[item.playerId] || (followMap[item.playerId] ? 'following' : 'none')) : 'none'}}"
      relationship-label="{{leaderboardFollowEnabled ? (relationLabelMap[item.playerId] || '') : ''}}"
      can-follow="{{leaderboardFollowEnabled ? !!leaderboardFollowableMap[item.playerId] : true}}"
      follow-loading="{{leaderboardFollowEnabled ? !!followLoadingMap[item.playerId] : false}}"
      is-self="{{leaderboardFollowEnabled ? !leaderboardFollowableMap[item.playerId] : false}}"
      bind:follow="onFollowTap"
      bind:profiletap="onProfileTap"
    />

    <block wx:if="{{prestartExpandMode === 'teeing_off_soon'}}">
      <view class="scorecard-dark-panel ld-scorecard is-empty-status">
        <view class="mp-sb-coming-soon">
          <text class="mp-sb-coming-soon__text">TEEING OFF SOON</text>
        </view>
        <image class="sc-ad" src="{{scorecardAdImage}}" mode="widthFix" binderror="onAdError"></image>
      </view>
    </block>
    <view wx:elif="{{openScorecard}}" class="scorecard-dark-panel ld-scorecard {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">
      <text class="sc-course course-name-title">{{scorecardCourseTitle}}</text>

      <view class="tour-scorecard">
        <view class="tsc-row tsc-head">
          <text wx:for="{{openScorecard.frontHead}}" wx:for-item="h" wx:key="*this" class="tsc-cell">{{h}}</text>
        </view>
        <view class="tsc-row">
          <text wx:for="{{openScorecard.frontPar}}" wx:for-item="c" wx:key="index" class="tsc-cell">{{c.t}}</text>
        </view>
        <view class="tsc-row">
          <view wx:for="{{openScorecard.frontScore}}" wx:for-item="c" wx:key="index" class="tsc-cell ld-score-cell">
            <view wx:if="{{c.m}}" class="ld-score-marker {{c.m}} {{c.c}}">
              <text class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
            </view>
            <text wx:else class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
          </view>
        </view>
      </view>

      <view class="tour-scorecard">
        <view class="tsc-row tsc-head">
          <text wx:for="{{openScorecard.backHead}}" wx:for-item="h" wx:key="*this" class="tsc-cell">{{h}}</text>
        </view>
        <view class="tsc-row">
          <text wx:for="{{openScorecard.backPar}}" wx:for-item="c" wx:key="index" class="tsc-cell">{{c.t}}</text>
        </view>
        <view class="tsc-row">
          <view wx:for="{{openScorecard.backScore}}" wx:for-item="c" wx:key="index" class="tsc-cell ld-score-cell">
            <view wx:if="{{c.m}}" class="ld-score-marker {{c.m}} {{c.c}}">
              <text class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
            </view>
            <text wx:else class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
          </view>
        </view>
      </view>

      <view class="score-legend-area">
        <view class="legend-item"><view class="score-legend-dot dot-eagle"></view>EAGLE OR BETTER</view>
        <view class="legend-item"><view class="score-legend-dot dot-birdie"></view>BIRDIE</view>
        <view class="legend-item"><view class="score-legend-dot dot-bogey"></view>BOGEY</view>
        <view class="legend-item"><view class="score-legend-dot dot-double"></view>DOUBLE BOGEY+</view>
      </view>
      <image class="sc-ad" src="{{scorecardAdImage}}" mode="widthFix" binderror="onAdError"></image>
    </view>
  </view>
</block>
