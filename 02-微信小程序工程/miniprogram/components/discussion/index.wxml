<!-- 统一讨论区聊天系统：自包含 flex 面板，填满宿主高度 -->
<view class="ds-root {{theme === 'dark' ? 'ds-dark' : 'ds-bright'}} {{fontScale === 'large' ? 'font-large' : 'font-normal'}} {{fixedInput ? 'ds-root--fixed-input' : ''}}">

  <!-- L1：围观行。不横向滚动，超出进「更多」完整列表 -->
  <view wx:if="{{showWatchersStrip}}" class="tab-watchers-strip">
    <view class="ws-track">
      <text class="discussion-watchers-label">围观</text>
      <view
        wx:for="{{visibleWatchers}}"
        wx:key="userId"
        class="ws-person"
      >
        <view
          class="discussion-avatar-btn"
          id="ds-watcher-avatar-{{index}}"
          hover-class="none"
          hover-stop-propagation="true"
          data-role="watcher"
          data-sel="ds-watcher-avatar-{{index}}"
          data-userid="{{item.userId}}"
          data-name="{{item.name}}"
          data-avatar="{{item.avatar}}"
          data-demo="{{item.demo}}"
          catchtap="onAvatarTap"
          catchlongpress="onAvatarLongPress"
        >
          <image class="discussion-avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
        </view>
      </view>
      <view wx:if="{{showWatchersMore}}" class="discussion-more-btn" catchtap="openWatchersSheet">更多</view>
    </view>
    <view class="ws-measure" aria-hidden="true">
      <text class="discussion-watchers-label">围观</text>
      <view class="ws-person">
        <view class="discussion-avatar-btn"></view>
      </view>
      <view class="discussion-more-btn">更多</view>
    </view>
  </view>

  <!-- L2：聊天内容（内部滚动） -->
  <scroll-view class="ds-chat-scroll" scroll-y scroll-into-view="{{toView}}" scroll-with-animation>
    <view class="discussion-chat">
      <!-- 历史路径：固定「今天」（含空列表）；enableTimeNodes 开启时不渲染 -->
      <view wx:if="{{!enableTimeNodes}}" class="discussion-time">今天</view>

      <!-- 时间节点投影路径：空列表无孤立时间；time 行非消息记录 -->
      <block wx:if="{{enableTimeNodes}}">
        <block wx:for="{{chatView}}" wx:key="key">
          <view wx:if="{{item.rowType === 'time'}}" class="discussion-time">{{item.label}}</view>
          <view wx:elif="{{item.rowType === 'message' && item.type === 'system'}}" id="ds-msg-{{item.msgIndex}}" class="chat-system">
            <text class="chat-system__text">{{item.text}}</text>
          </view>
          <view wx:elif="{{item.rowType === 'message'}}" id="ds-msg-{{item.msgIndex}}" class="chat-row {{item.self ? 'self' : ''}}">
            <image
              wx:if="{{!item.self}}"
              id="ds-msg-avatar-{{item.msgIndex}}"
              class="chat-avatar ds-player-avatar {{reactionDetachedMessageIndex >= 0 && reactionDetachedMessageIndex == item.msgIndex ? 'is-reaction-detached' : ''}}"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-role="chat"
              data-sel="ds-msg-avatar-{{item.msgIndex}}"
              data-userid="{{item.userId}}"
              data-name="{{item.name}}"
              data-avatar="{{item.avatar}}"
              data-index="{{item.msgIndex}}"
              data-self="{{false}}"
              data-demo="{{item.demo}}"
              hover-class="none"
              hover-stop-propagation="true"
              catchtap="onAvatarTap"
              catchlongpress="onAvatarLongPress"
            ></image>
            <view class="chat-col">
              <text class="chat-meta">{{item.name}}</text>
              <view class="chat-bubble"><text wx:if="{{item.mention}}" class="mention-text">{{item.mention}} </text>{{item.text}}</view>
            </view>
            <image
              wx:if="{{item.self}}"
              id="ds-msg-avatar-{{item.msgIndex}}"
              class="chat-avatar ds-player-avatar {{reactionDetachedMessageIndex >= 0 && reactionDetachedMessageIndex == item.msgIndex ? 'is-reaction-detached' : ''}}"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-role="chat"
              data-sel="ds-msg-avatar-{{item.msgIndex}}"
              data-userid="{{item.userId || 'me'}}"
              data-name="{{item.name}}"
              data-avatar="{{item.avatar}}"
              data-index="{{item.msgIndex}}"
              data-self="{{true}}"
              data-demo="{{item.demo}}"
              hover-class="none"
              hover-stop-propagation="true"
              catchtap="onAvatarTap"
              catchlongpress="onAvatarLongPress"
            ></image>
          </view>
        </block>
      </block>

      <!-- 历史消息列表（未开启时间节点） -->
      <block wx:else>
        <block wx:for="{{chat}}" wx:key="index">
          <!-- 系统提示：居中灰字，无气泡（type=system；与普通评论分离） -->
          <view wx:if="{{item.type === 'system'}}" id="ds-msg-{{index}}" class="chat-system">
            <text class="chat-system__text">{{item.text}}</text>
          </view>
          <view wx:else id="ds-msg-{{index}}" class="chat-row {{item.self ? 'self' : ''}}">
            <image
              wx:if="{{!item.self}}"
              id="ds-msg-avatar-{{index}}"
              class="chat-avatar ds-player-avatar {{reactionDetachedMessageIndex >= 0 && reactionDetachedMessageIndex == index ? 'is-reaction-detached' : ''}}"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-role="chat"
              data-sel="ds-msg-avatar-{{index}}"
              data-userid="{{item.userId}}"
              data-name="{{item.name}}"
              data-avatar="{{item.avatar}}"
              data-index="{{index}}"
              data-self="{{false}}"
              data-demo="{{item.demo}}"
              hover-class="none"
              hover-stop-propagation="true"
              catchtap="onAvatarTap"
              catchlongpress="onAvatarLongPress"
            ></image>
            <view class="chat-col">
              <text class="chat-meta">{{item.name}}</text>
              <view class="chat-bubble"><text wx:if="{{item.mention}}" class="mention-text">{{item.mention}} </text>{{item.text}}</view>
            </view>
            <image
              wx:if="{{item.self}}"
              id="ds-msg-avatar-{{index}}"
              class="chat-avatar ds-player-avatar {{reactionDetachedMessageIndex >= 0 && reactionDetachedMessageIndex == index ? 'is-reaction-detached' : ''}}"
              src="{{item.avatar}}"
              mode="aspectFill"
              data-role="chat"
              data-sel="ds-msg-avatar-{{index}}"
              data-userid="{{item.userId || 'me'}}"
              data-name="{{item.name}}"
              data-avatar="{{item.avatar}}"
              data-index="{{index}}"
              data-self="{{true}}"
              data-demo="{{item.demo}}"
              hover-class="none"
              hover-stop-propagation="true"
              catchtap="onAvatarTap"
              catchlongpress="onAvatarLongPress"
            ></image>
          </view>
        </block>
      </block>

      <view
        wx:if="{{bottomSpacerHeight > 0}}"
        class="discussion-content-spacer"
        style="height:{{bottomSpacerHeight}}px;"
      ></view>
    </view>
  </scroll-view>

  <!-- L3：输入栏（面板底部，含 safe area；微信式 textarea + 发送态） -->
  <view wx:if="{{showInputBar}}" class="discussion-input-bar {{fixedInput ? 'discussion-input-bar--fixed' : ''}} {{inputDisabled ? 'is-input-disabled' : ''}}">
    <view class="discussion-plus-btn" bindtap="noop">＋</view>
    <view class="discussion-input-box">
      <textarea
        class="discussion-input"
        value="{{draft}}"
        cursor="{{cursor}}"
        focus="{{inputFocus}}"
        disabled="{{inputDisabled}}"
        bindinput="onDraftInput"
        bindblur="onDraftBlur"
        bindconfirm="onSend"
        auto-height
        placeholder="{{inputPlaceholder || '说点什么…'}}"
        placeholder-class="discussion-input__ph"
        confirm-type="send"
        confirm-hold="{{false}}"
        show-confirm-bar="{{false}}"
        adjust-position="{{!emojiPanelOpen && !inputDisabled}}"
        cursor-spacing="24"
      ></textarea>
    </view>
    <view class="discussion-emoji-btn {{emojiPanelOpen ? 'is-on' : ''}} {{inputDisabled ? 'is-disabled' : ''}}" bindtap="toggleEmojiPanel">☺</view>
    <view class="discussion-send {{!inputDisabled && canSend ? 'is-active' : 'is-disabled'}}" bindtap="onSend">发送</view>
  </view>

  <view wx:if="{{showWatchersSheet}}" class="watchers-modal" catchtap="closeWatchersSheet">
    <view class="watchers-sheet" catchtap="noop">
      <view class="watchers-sheet-header">
        <view>
          <text class="watchers-sheet-title">全部围观用户</text>
          <text class="watchers-sheet-subtitle">{{watchersHint || '长按头像可提及用户'}}</text>
        </view>
        <view class="watchers-close-btn" catchtap="closeWatchersSheet">✕</view>
      </view>
      <scroll-view scroll-y class="watchers-list">
        <view wx:if="{{!watchers.length}}" class="watcher-empty">暂无围观用户</view>
        <view
          wx:for="{{watchers}}"
          wx:key="userId"
          class="watcher-item"
        >
          <image
            id="ds-wlist-avatar-{{index}}"
            src="{{item.avatar}}"
            mode="aspectFill"
            hover-class="none"
            hover-stop-propagation="true"
            data-role="watcher-list"
            data-sel="ds-wlist-avatar-{{index}}"
            data-userid="{{item.userId}}"
            data-name="{{item.name}}"
            data-avatar="{{item.avatar}}"
            data-index="{{index}}"
            data-demo="{{item.demo}}"
            catchtap="onAvatarTap"
            catchlongpress="onAvatarLongPress"
          ></image>
          <view class="watcher-col">
            <text class="watcher-name">{{item.name}}</text>
            <text class="watcher-hint">围观用户</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 表情面板 overlay（wx:if 挂载/卸载，与输入栏 DOM 互不复用） -->
  <!-- 遮罩仅覆盖输入栏「以上」区域（bottom=输入栏高度），绝不盖住输入栏，避免拦截输入交互 -->
  <view wx:if="{{emojiPanelOpen && showInputBar}}" class="emoji-mask" style="bottom:{{emojiPanelBottom}}px;" bindtap="closeEmojiPanel"></view>
  <view wx:if="{{emojiPanelOpen && showInputBar}}" class="emoji-panel" style="bottom:{{emojiPanelBottom}}px;">
    <scroll-view scroll-y class="emoji-scroll">
      <view class="emoji-grid">
        <view
          wx:for="{{emojiList}}"
          wx:key="*this"
          class="emoji-cell"
          data-emoji="{{item}}"
          bindtap="insertEmoji"
        >{{item}}</view>
      </view>
    </scroll-view>
  </view>

</view>
