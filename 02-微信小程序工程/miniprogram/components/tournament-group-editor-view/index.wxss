/* 分组编辑视图内核样式（自 group-editor 抽出，供页/sheet 共用） */
.tournament-group-editor-view.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --bg-hover: #1a1a1a;
  --border: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
  --error: #ef4444;
  --shadow-card: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.tournament-group-editor-view.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --bg-hover: #f9fafb;
  --border: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --cloud-blue: #002d62;
  --error: #ef4444;
  --shadow-card: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.tournament-group-editor-view {
  color: var(--text-primary, #002d62);
  box-sizing: border-box;
}

.tournament-group-editor-view--page .editor-body {
  padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tournament-group-editor-view--sheet .editor-body {
  padding: 8rpx 8rpx 24rpx;
  box-sizing: border-box;
}

.composition-mode-section {
  margin-bottom: 28rpx;
}
.composition-mode-section__label {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}
.composition-mode-options {
  display: flex;
  gap: 16rpx;
}
.composition-mode-option {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 14rpx;
  border: 2rpx solid var(--border);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 800;
}
.composition-mode-option.is-active {
  border-color: var(--champion-gold, #c8a24a);
  background: rgba(200, 162, 74, 0.12);
  color: var(--text-primary);
}

.composition-preview {
  margin: -8rpx 0 28rpx;
  padding: 16rpx 24rpx 18rpx;
  background: var(--bg-subtle, #f3f4f6);
  border: 1px solid var(--border);
  border-radius: 0 0 20rpx 20rpx;
  border-top: none;
}
.composition-preview__row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-top: 0;
  overflow: hidden;
}
.composition-preview__row + .composition-preview__row {
  margin-top: 8rpx;
}
.composition-preview__label {
  flex-shrink: 0;
  max-width: 46%;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cloud-blue, #002d62);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.tournament-group-editor-view.dark-mode .composition-preview__label,
.tournament-group-editor-view.dark-mode .pairing-card__label {
  color: var(--text-primary);
}
.composition-preview__names {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.editor-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180rpx;
}
.editor-empty__text {
  color: var(--text-muted);
  font-size: 26rpx;
}

.groups-tab-toolbar {
  margin-top: 24rpx;
}
.add-group-btn {
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 700;
  background: transparent;
}
.add-group-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid var(--border-hover);
  color: var(--text-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.tee-group-card {
  position: relative;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-top: 6rpx solid var(--cloud-blue);
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
  padding: 96rpx 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.delete-group-btn {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2px solid var(--bg-card);
  background: var(--error, #ef4444);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  z-index: 4;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.16);
}
.tee-group-meta {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(90deg, rgba(0, 45, 98, 0.1), transparent 72%);
}
.tournament-group-editor-view.dark-mode .tee-group-meta {
  background: linear-gradient(90deg, rgba(0, 45, 98, 0.28), transparent 72%);
}
.tee-group-badge {
  height: 72rpx;
  line-height: 72rpx;
  display: inline-flex;
  align-items: center;
  background: var(--cloud-blue);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 28rpx;
  border-bottom-right-radius: 20rpx;
}

.group-block {
  margin-bottom: 8rpx;
}

.gb-group-player-conflict {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--error, #ef4444);
}

.pairing-section {
  margin: -8rpx 0 28rpx;
  padding: 20rpx 24rpx 8rpx;
  background: var(--bg-subtle, #f3f4f6);
  border: 1px solid var(--border);
  border-radius: 0 0 20rpx 20rpx;
  border-top: none;
}
.pairing-section__head {
  margin-bottom: 12rpx;
}
.pairing-section__title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.pairing-card {
  background: var(--bg-card, #fff);
  border: 1px solid var(--border);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}
.pairing-card__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.pairing-card__label {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--cloud-blue, #002d62);
}
.pairing-card__actions {
  display: flex;
  gap: 20rpx;
}
.pairing-card__action {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--champion-gold, #c8a24a);
}
.pairing-card__action--danger {
  color: var(--error, #ef4444);
}
.pairing-card__names {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  line-height: 1.4;
}
.pairing-incomplete {
  padding: 8rpx 4rpx 16rpx;
}
.pairing-incomplete__label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 700;
}
.pairing-incomplete__names {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}
.pairing-toolbar {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}
.pairing-tool-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: var(--champion-gold, #c8a24a);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
}
.pairing-tool-btn--ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}
