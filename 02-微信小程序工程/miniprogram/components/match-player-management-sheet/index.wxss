/* 复用赛事详情 sheet 视觉（register-sheet / player-manage） */
@import "/styles/tournament-common.wxss";

.match-player-management-host {
  position: relative;
  z-index: 220;
}

.match-player-management-host__round {
  display: block;
  margin-top: 4rpx;
  margin-bottom: 0;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.match-player-management-host .register-sheet__confirm.is-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.match-player-management-host .player-manage-row__remove.is-disabled {
  opacity: 0.45;
  color: var(--text-muted);
}

.match-player-management-host .player-team-pick-item__main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.match-player-management-host .player-team-pick-item__logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-subtle);
}

.match-player-management-host .player-manage-row__remark {
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
