<view wx:if="{{visible}}" class="phone-bind-root">
  <view class="phone-bind-overlay" bindtap="onCancel" catchtouchmove="stopPropagation"></view>
  <view class="phone-bind-sheet" catchtap="stopPropagation" catchtouchmove="stopPropagation">
    <view class="phone-bind-sheet__handle"></view>
    <view class="phone-bind-sheet__head">
      <text class="phone-bind-sheet__overline">PHONE</text>
      <text class="phone-bind-sheet__title">{{title || '绑定手机号'}}</text>
      <text class="phone-bind-sheet__hint">{{hint || '手机号用于识别用户身份，绑定后可继续当前操作。'}}</text>
    </view>
    <view class="phone-bind-sheet__body">
      <text class="phone-bind-sheet__label">手机号</text>
      <input
        class="phone-bind-sheet__input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phoneDraft}}"
        bindinput="onPhoneInput"
      />
      <button
        class="phone-bind-sheet__wx-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
      >使用微信手机号</button>
    </view>
    <view class="phone-bind-sheet__actions">
      <view class="phone-bind-sheet__cancel" bindtap="onCancel">取消</view>
      <view class="phone-bind-sheet__confirm {{submitting ? 'is-disabled' : ''}}" bindtap="onConfirm">确认绑定</view>
    </view>
  </view>
</view>
