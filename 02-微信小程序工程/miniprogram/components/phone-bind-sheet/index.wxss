.phone-bind-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 12000;
}
.phone-bind-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.phone-bind-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-card, #fff);
  border-radius: 24rpx 24rpx 0 0;
  padding: 12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.phone-bind-sheet__handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border, #e5e5e5);
  margin: 8rpx auto 20rpx;
}
.phone-bind-sheet__overline {
  display: block;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-muted, #999);
}
.phone-bind-sheet__title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary, #111);
}
.phone-bind-sheet__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-muted, #999);
}
.phone-bind-sheet__body {
  margin-top: 28rpx;
}
.phone-bind-sheet__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-muted, #999);
  margin-bottom: 12rpx;
}
.phone-bind-sheet__input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--bg-subtle, #f5f5f5);
  color: var(--text-primary, #111);
  font-size: 30rpx;
  font-weight: 700;
}
.phone-bind-sheet__wx-btn {
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  border-radius: 16rpx;
  background: transparent;
  border: 1px dashed var(--border, #ddd);
  color: var(--text-muted, #666);
  font-size: 26rpx;
  font-weight: 700;
}
.phone-bind-sheet__wx-btn::after {
  border: none;
}
.phone-bind-sheet__actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}
.phone-bind-sheet__cancel,
.phone-bind-sheet__confirm {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}
.phone-bind-sheet__cancel {
  background: var(--bg-subtle, #f5f5f5);
  color: var(--text-primary, #333);
}
.phone-bind-sheet__confirm {
  background: var(--data-blue, #00AEEF);
  color: #fff;
}
.phone-bind-sheet__confirm.is-disabled {
  opacity: 0.5;
}
