.css-root {
  --css-blue: #002d62;
  --css-accent: #00aeef;
  --css-error: #dc2626;
  --css-text: #111827;
  --css-muted: #9ca3af;
  --css-border: #e5e7eb;
  --css-bg: #f3f4f6;
  --css-card: #ffffff;
  --css-handle: #e5e7eb;
  --css-avatar-ph: #e5e7eb;
  --css-qr-surface: #ffffff;
  --css-on-brand: #ffffff;
}

/* 记分页 themeClass 为 dark-mode；兼容 dark-theme 别名 */
.css-root.dark-mode,
.css-root.dark-theme {
  --css-text: #ffffff;
  --css-muted: #888888;
  --css-border: #222222;
  --css-bg: #0a0a0a;
  --css-card: #111111;
  --css-handle: #222222;
  --css-avatar-ph: #222222;
  --css-qr-surface: #ffffff;
  --css-on-brand: #ffffff;
}

.css-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 200;
}

.css-overlay--top {
  z-index: 230;
}

.css-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 40rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--css-card);
  color: var(--css-blue);
  border-radius: 80rpx 80rpx 0 0;
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35);
}

.css-sheet.dark-mode,
.css-sheet.dark-theme {
  background: var(--css-card);
  color: var(--css-text);
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.55);
}

.css-manage {
  z-index: 240;
  max-height: 70vh;
}

.css-handle {
  width: 96rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--css-handle);
  margin: 24rpx auto 16rpx;
  flex-shrink: 0;
}

.css-head {
  flex-shrink: 0;
  padding: 8rpx 0 24rpx;
}

.css-overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--css-accent);
  margin-bottom: 8rpx;
}

.css-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--css-text);
  line-height: 1.3;
}

.css-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--css-muted);
}

.css-body {
  flex: 1;
  min-height: 0;
  max-height: 52vh;
}

.css-card {
  box-sizing: border-box;
  background: var(--css-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.css-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.css-card__head-main {
  flex: 1;
  min-width: 0;
}

.css-card__title {
  display: block;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--css-text);
}

.css-card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--css-muted);
}

.css-card__toggle {
  flex-shrink: 0;
  margin-top: 4rpx;
  padding: 4rpx 0 4rpx 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--css-muted);
}

.css-card__body {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1px solid var(--css-border);
}

.css-hint {
  color: var(--css-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.css-scorer-list {
  margin-top: 20rpx;
  width: 100%;
}

.css-scorer-list__title {
  display: block;
  margin-bottom: 12rpx;
}

.css-scorer-list__empty {
  color: var(--css-muted);
  font-size: 22rpx;
  line-height: 1.5;
  padding: 4rpx 0;
}

.css-scorer-list__row {
  width: 100%;
  white-space: nowrap;
}

.css-scorer-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 112rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.css-scorer-item__avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--css-avatar-ph);
}

.css-scorer-item__name {
  margin-top: 8rpx;
  width: 100%;
  color: var(--css-text);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.css-scorer-item__tag {
  margin-top: 2rpx;
  color: var(--css-accent);
  font-size: 20rpx;
  font-weight: 600;
}

.css-generate-wrap {
  padding: 4rpx 0 8rpx;
}

.css-generate {
  width: 100%;
  box-sizing: border-box;
}

.css-qr-card {
  background: var(--css-card);
  border: 1px solid var(--css-border);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.css-qr-card__img {
  width: 280rpx;
  height: 280rpx;
  background: var(--css-qr-surface);
  border-radius: 12rpx;
}

.css-qr-card__hint {
  margin-top: 14rpx;
  text-align: center;
}

.css-qr-card__actions {
  margin-top: 20rpx;
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.css-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.css-btn--primary {
  flex: 1;
  background: var(--css-blue);
  color: var(--css-on-brand);
}

.css-btn--ghost {
  flex: 1;
  background: var(--css-bg);
  color: var(--css-text);
}

.css-btn.is-disabled {
  opacity: 0.5;
}

.css-footer {
  flex-shrink: 0;
  padding-top: 16rpx;
}

.css-footer__close {
  width: 100%;
}

.css-manage__body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 24rpx;
}

.css-manage__avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--css-avatar-ph);
}
.css-manage__name {
  margin-top: 16rpx;
  color: var(--css-text);
  font-size: 30rpx;
  font-weight: 700;
}

.css-manage__desc {
  margin-top: 10rpx;
  text-align: center;
  padding: 0 12rpx;
}

.css-manage__remove {
  margin-top: 28rpx;
  color: var(--css-error);
  font-size: 28rpx;
  font-weight: 800;
  opacity: 0.85;
  padding: 16rpx 0;
}
