/* 资料栏权威样式：本文件属于拥有真实 DOM 的组件，不依赖父 panel / 页面祖先。 */
.scorecard-profile {
  background: var(--bg-card, #ffffff);
  color: var(--text-primary, #002d62);
  border-bottom: 1px solid var(--border, #e5e7eb);
  padding: 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}
.sc-profile-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex: 1 1 auto;
  min-width: 0;
}
.sc-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.sc-avatar {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  border: 1px solid var(--border, #e5e7eb);
  display: block;
  overflow: hidden;
}
.sc-flag {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  z-index: 1;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--bg-card, #ffffff);
  overflow: hidden;
  background: #fff;
}
.sc-flag image {
  width: 100%;
  height: 100%;
}
.sc-flag--team {
  overflow: hidden;
}
.sc-flag--text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--cloud-blue, #002d62);
}
.sc-flag__text {
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  color: #FFFFFF;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.sc-profile-meta {
  flex: 1 1 auto;
  min-width: 0;
  overflow: visible;
}
.sc-name-line {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}
.name-gender-group {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}
.sc-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  color: var(--text-primary, #002d62);
  line-height: 1.35;
  padding: 4rpx 4rpx 2rpx 0;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sc-name-line .sc-name-gender,
.sc-name-gender {
  flex-shrink: 0;
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}
.gender-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}
.sc-chevron {
  flex-shrink: 0;
  margin-left: 4rpx;
  min-width: 64rpx;
  min-height: 64rpx;
  padding: 0 4rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted, #6b7280);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
  box-sizing: border-box;
}
.sc-chevron__glyph {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}
.sc-chevron--disabled {
  opacity: 0.32;
  color: var(--text-muted, #9ca3af);
}
.dark-mode .sc-chevron--disabled,
.theme-dark .sc-chevron--disabled {
  opacity: 0.4;
}
.sc-sub {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-muted, #6b7280);
  margin-top: 8rpx;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.sc-sub-strong {
  color: var(--text-primary, #002d62);
  font-weight: 900;
}
.sc-rel-tag {
  flex-shrink: 0;
  max-width: 42%;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  border: 1px solid var(--border, #e5e7eb);
  background: var(--bg-subtle, #f3f4f6);
  color: var(--text-muted, #6b7280);
  box-sizing: border-box;
}
.sc-rel-tag--friend {
  border-color: rgba(206, 146, 36, 0.55);
  background: rgba(206, 146, 36, 0.12);
  color: var(--champion-gold, #ce9224);
}
.sc-rel-tag--following {
  border-color: var(--border, #e5e7eb);
  background: var(--bg-subtle, #f3f4f6);
  color: var(--text-muted, #6b7280);
}
.sc-follow-btn {
  flex-shrink: 0;
}
