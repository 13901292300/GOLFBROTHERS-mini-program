/* 组件内补强：与 tournament-common 展开身份卡省略链一致（apply-shared 下双保险） */
.scorecard-profile {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
.sc-profile-left {
  flex: 1 1 auto;
  min-width: 0;
}
.sc-profile-meta {
  flex: 1 1 auto;
  min-width: 0;
  /* 勿 hidden：斜体昵称右上角外伸由 .sc-name 内 padding 消化 */
  overflow: visible;
}
.sc-name-line {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}
/* 昵称+性别：内容收缩；受行内剩余宽度约束；勿 space-between */
.name-gender-group {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}
.sc-name {
  flex: 0 1 auto;
  min-width: 0;
  line-height: 1.35;
  padding: 4rpx 4rpx 2rpx 0;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  /* 继承页级主题 token；缺省回落 Bright 主色，避免组件内落成黑色 */
  color: var(--text-primary, #002d62);
}
.sc-name-gender {
  flex-shrink: 0;
  margin-left: 4rpx;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
}
.sc-chevron {
  flex-shrink: 0;
  margin-left: 4rpx;
  min-width: 64rpx;
  min-height: 64rpx;
  padding: 0 4rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted, #6b7280);
  box-sizing: border-box;
}
.sc-chevron__glyph {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}
.sc-chevron--disabled {
  opacity: 0.32;
  color: var(--text-muted, #9ca3af);
}
.dark-mode .sc-chevron--disabled,
.theme-dark .sc-chevron--disabled {
  opacity: 0.4;
}
.sc-sub {
  color: var(--text-muted, #6b7280);
}
.sc-sub-strong {
  color: var(--text-primary, #002d62);
}
.sc-rel-tag {
  flex-shrink: 0;
  max-width: 42%;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  border: 1px solid var(--border, #e5e7eb);
  background: var(--bg-subtle, #f3f4f6);
  color: var(--text-muted, #6b7280);
  box-sizing: border-box;
}

.sc-rel-tag--friend {
  border-color: rgba(206, 146, 36, 0.55);
  background: rgba(206, 146, 36, 0.12);
  color: var(--champion-gold, #ce9224);
}

.sc-rel-tag--following {
  border-color: var(--border, #e5e7eb);
  background: var(--bg-subtle, #f3f4f6);
  color: var(--text-muted, #6b7280);
}
