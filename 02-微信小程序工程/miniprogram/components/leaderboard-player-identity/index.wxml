<view class="scorecard-profile">
  <view class="sc-profile-left">
    <view class="sc-avatar-wrap">
      <image class="sc-avatar" src="{{player.avatar}}" mode="aspectFill"></image>
      <!-- 角标节点保留；显隐由 showAvatarBadge（avatarBadge 能力）控制 -->
      <view
        wx:if="{{showAvatarBadge}}"
        class="sc-flag {{avatarBadgeIsTeam ? 'sc-flag--team' : ''}}"
      >
        <image src="{{avatarBadgeSrc}}" mode="aspectFill"></image>
      </view>
    </view>
    <view class="sc-profile-meta">
      <view class="sc-name-line">
        <!-- 昵称+性别紧凑组合：宽度随内容收缩，长昵称在组内省略 -->
        <view class="name-gender-group">
          <text class="sc-name">{{player.name}}</text>
          <text
            wx:if="{{showNameGender && displayGenderSymbol}}"
            class="gender-icon sc-name-gender {{displayGenderClass}}"
          >{{displayGenderSymbol}}</text>
        </view>
        <!-- 进入球员资料：独立点击区（catchtap 不冒泡）；无主页弱化 -->
        <view
          wx:if="{{showProfileEntry}}"
          class="sc-chevron {{profileEntryEnabled ? '' : 'sc-chevron--disabled'}}"
          catchtap="onProfileTap"
          aria-label="进入球员主页"
        >
          <text class="sc-chevron__glyph">›</text>
        </view>
      </view>
      <!-- metaMode：页级显式开启；默认仍为 COUNTRY/AGE -->
      <view wx:if="{{metaMode === 'handicapFloatHub'}}" class="sc-sub">
        江湖差点 <text class="sc-sub-strong">{{player.handicapText || '--'}}</text> · 浮动系数 <text class="sc-sub-strong">{{player.floatCoefText || '--'}}</text>
      </view>
      <view wx:elif="{{metaMode === 'handicapFloat'}}" class="sc-sub">
        江湖差点 <text class="sc-sub-strong">{{player.handicapText || '--'}}</text>　浮动系数 <text class="sc-sub-strong">{{player.floatCoefText || '--'}}</text>
      </view>
      <view wx:else class="sc-sub">
        COUNTRY: <text class="sc-sub-strong">{{player.country || '—'}}</text>　AGE: <text class="sc-sub-strong">{{player.age || '—'}}</text>
      </view>
    </view>
  </view>
  <!-- 加关注=操作按钮；好友/已关注=状态标签（不可点）；页面注入关系，组件不读 store -->
  <follow-action-btn
    wx:if="{{showFollowBtn}}"
    user-id="{{player.playerId}}"
    loading="{{followLoading}}"
    disabled="{{followLoading}}"
    bind:follow="onFollowTap"
  />
  <text
    wx:elif="{{showRelationTag}}"
    class="sc-rel-tag {{displayStatus === 'friend' ? 'sc-rel-tag--friend' : 'sc-rel-tag--following'}}"
  >{{displayRelationLabel}}</text>
</view>
