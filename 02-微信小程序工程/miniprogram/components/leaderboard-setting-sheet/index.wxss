/**
 * 领先榜查看方式 — 标准 bottom sheet（L1）
 * 组件 styleIsolation 默认 isolated：必须自带 overlay/sheet，禁止依赖页面 tournament-common。
 * 视觉对齐 temp-admin / payment / half-course：暗色遮罩 + 圆角 sheet + 头部呼吸空间。
 */

/* ===== 全屏遮罩（仅背景色带透明度；禁止宿主 opacity） ===== */
.sheet-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 210;
  pointer-events: auto;
  opacity: 1;
  transition: opacity 0.18s ease;
}

/* ===== 标准 bottom sheet：亮度完整，叠在 overlay 上 ===== */
.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  color: var(--cloud-blue, #002d62);
  border-radius: 80rpx 80rpx 0 0;
  z-index: 230;
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  pointer-events: auto;
  box-sizing: border-box;
}

.sheet-handle {
  width: 96rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
  /* 权威 bottom-sheet：顶 24 + 底 40 = 标题区前呼吸空间 */
  margin: 24rpx auto 40rpx;
}

.sheet-top-accent {
  display: none;
}

.leaderboard-setting-sheet.dark-mode .sheet-top-accent {
  display: block;
  width: 100%;
  height: 3px;
  background: #002d62;
  flex-shrink: 0;
}

.leaderboard-setting-sheet {
  /* 左右 40rpx 对齐 register-sheet；底部 safe-area；顶部由 handle+head padding 承担 */
  padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 82vh;
  background: #ffffff;
}

.leaderboard-setting-sheet.dark-mode {
  background: var(--bg-card, #1a1a1a);
  color: var(--text-primary, #f8fafc);
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.55);
}

.leaderboard-setting-sheet.dark-mode .sheet-handle {
  background: var(--border, rgba(255, 255, 255, 0.16));
}

/* ===== 头部：对齐 register-sheet__head（整体 padding，禁止只给标题 margin-top） ===== */
.leaderboard-setting__head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  /* 与 register-sheet__head 一致：底 32rpx 分隔首组选项；顶由 handle 底 margin 承担 */
  padding: 8rpx 0 32rpx;
  box-sizing: border-box;
}

.leaderboard-setting__head-main {
  min-width: 0;
  flex: 1;
  padding-right: 72rpx;
  box-sizing: border-box;
}

.leaderboard-setting__overline {
  display: block;
  color: var(--data-blue, #00aeef);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.12em;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.leaderboard-setting__title {
  display: block;
  margin-top: 0;
  color: var(--text-primary, #0f172a);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.leaderboard-setting-sheet.dark-mode .leaderboard-setting__title {
  color: var(--text-primary, #f8fafc);
}

.leaderboard-setting__subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--text-muted, #94a3b8);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.leaderboard-setting__close {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--bg-subtle, #f1f5f9);
  color: var(--text-muted, #94a3b8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
  font-weight: 700;
}

.leaderboard-setting-sheet.dark-mode .leaderboard-setting__close {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-muted, #94a3b8);
}

/* 首节间距由 head 底 padding 承担 */
.leaderboard-setting__section {
  margin-top: 0;
}

.leaderboard-setting__section + .leaderboard-setting__section {
  margin-top: 28rpx;
}

.leaderboard-setting__label {
  display: block;
  margin-bottom: 16rpx;
  color: var(--text-secondary, #475569);
  font-size: 24rpx;
  font-weight: 800;
}

.leaderboard-setting-sheet.dark-mode .leaderboard-setting__label {
  color: var(--text-secondary, #cbd5e1);
}

.leaderboard-setting__options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.leaderboard-setting-option {
  min-height: 88rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid var(--border-color, rgba(15, 23, 42, 0.12));
  background: var(--bg-subtle, #f1f5f9);
  color: var(--text-primary, #0f172a);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.leaderboard-setting-sheet.dark-mode .leaderboard-setting-option {
  border-color: rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-primary, #f8fafc);
}

.leaderboard-setting-option.is-active {
  border-color: var(--champion-gold, #ce9224);
  background: rgba(201, 164, 92, 0.16);
  color: var(--champion-gold, #ce9224);
}

.leaderboard-setting-option.is-disabled {
  opacity: 0.46;
  color: var(--text-muted, #94a3b8);
}

.leaderboard-setting-option__text {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.leaderboard-setting-option__name {
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
  line-height: 1.3;
}

.leaderboard-setting-option__sub {
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.2;
  color: var(--text-muted, #94a3b8);
}

.leaderboard-setting__footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.leaderboard-setting__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.leaderboard-setting__btn--cancel {
  color: var(--text-secondary, #475569);
  background: var(--bg-subtle, #f1f5f9);
  border: 1px solid var(--border-color, rgba(15, 23, 42, 0.12));
}

.leaderboard-setting-sheet.dark-mode .leaderboard-setting__btn--cancel {
  color: var(--text-secondary, #cbd5e1);
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}

.leaderboard-setting__btn--confirm {
  color: #ffffff;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}
