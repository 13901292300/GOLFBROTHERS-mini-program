/* 与记分页既有 player-action-modal 视觉一致；Dark 用修饰类 + CSS 变量 */
.player-action-modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 220;
  background: rgba(15, 23, 42, 0.45);
}
.player-action-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  z-index: 230;
  width: 640rpx;
  max-width: 86vw;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}
.player-action-modal__card {
  background: var(--bg-card, #ffffff);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 40rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.18);
  box-sizing: border-box;
}
.player-action-modal__profile {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}
.player-action-modal__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #e5e7eb;
  border: 3rpx solid rgba(0, 45, 98, 0.12);
  box-sizing: border-box;
}
.player-action-modal__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.player-action-modal__name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.player-action-modal__name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--golf-blue, #002d62);
  line-height: 1.25;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.player-action-modal__gender {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--data-blue, #1c94de);
  line-height: 1;
}
.player-action-modal__stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  min-width: 0;
}
.player-action-modal__stat {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary, #9ca3af);
  line-height: 1.3;
}
.player-action-modal__stat-sep {
  font-size: 22rpx;
  color: var(--text-secondary, #9ca3af);
  opacity: 0.6;
}
.player-action-modal__home {
  flex-shrink: 0;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 45, 98, 0.08);
  color: var(--golf-blue, #002d62);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}
.player-action-modal__home:active {
  opacity: 0.72;
}
.player-action-modal__actions {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 20rpx 16rpx;
}
.player-action-modal__item {
  width: 132rpx;
  min-height: 128rpx;
  padding: 14rpx 0 10rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f3f4f6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  line-height: 1;
}
.player-action-modal__item-icon {
  font-size: 48rpx;
  line-height: 1;
}
.player-action-modal__item-cost {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  opacity: 0.72;
  line-height: 1;
}
.player-action-modal__item-coin {
  font-size: 24rpx;
  line-height: 1;
}
.player-action-modal__item-cost-num {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
  color: #6b7280;
  letter-spacing: -0.5rpx;
}
.player-action-modal__item:active {
  opacity: 0.72;
  transform: scale(0.96);
}
.player-action-modal__item--placeholder {
  opacity: 0.55;
}

.player-action-modal--dark .player-action-modal__item-cost-num {
  color: rgba(255, 255, 255, 0.55);
}
.player-action-modal--dark .player-action-modal__card {
  background: var(--bg-card, #1f2937);
}
.player-action-modal--dark .player-action-modal__name {
  color: var(--text-primary);
}
.player-action-modal--dark .player-action-modal__gender {
  color: #60a5fa;
}
.player-action-modal--dark .player-action-modal__stat,
.player-action-modal--dark .player-action-modal__stat-sep {
  color: var(--text-secondary);
}
.player-action-modal--dark .player-action-modal__avatar {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.08);
}
.player-action-modal--dark .player-action-modal__home {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-primary);
}
.player-action-modal--dark .player-action-modal__item {
  background: rgba(255, 255, 255, 0.08);
}
