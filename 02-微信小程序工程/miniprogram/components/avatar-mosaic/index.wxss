/* 容器驱动：固定 size×size，overflow 裁剪，永不被内容撑开/撑高 */
.am-root {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
}
.am-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 1px;
}
/* 方形拼图块：固定边长（由 JS 依据固定容器尺寸推导），不可收缩、裁剪溢出 */
.am-cell {
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 0;
}
/* 拼图头像：方形、等比裁切（cover），禁止圆角/拉伸 */
.am-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 0;
  object-fit: cover;
}
/* +N 单元：方形灰底、白字、居中、不可点击 */
.am-plus {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  box-sizing: border-box;
  font-weight: 700;
  background: #8a9099;
  color: #ffffff;
  pointer-events: none;
}
