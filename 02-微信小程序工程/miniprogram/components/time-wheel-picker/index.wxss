.time-wheel-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
}

.time-wheel-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 1;
}

.time-wheel-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}

.time-wheel-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover);
  margin: 0 auto 28rpx;
}

.time-wheel-title {
  display: block;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.time-wheel-year-row {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.year-arrow {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.year-text {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 900;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.time-wheel-label-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  height: 56rpx;
  align-items: center;
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.time-wheel-picker-wrap {
  position: relative;
  height: 340rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  background: var(--bg-subtle);
  margin-bottom: 32rpx;
  overflow: hidden;
}

.time-wheel-picker {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 340rpx;
}

.time-wheel-highlight {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 50%;
  height: 80rpx;
  transform: translateY(-50%);
  border-top: 1rpx solid var(--border-hover);
  border-bottom: 1rpx solid var(--border-hover);
  background: rgba(206, 146, 36, 0.08);
  z-index: 1;
  pointer-events: none;
}

.time-wheel-item {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.time-wheel-item.active {
  color: var(--champion-gold);
  font-size: 38rpx;
  font-weight: 900;
}

.time-wheel-confirm {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}

.time-wheel-confirm::after {
  border: none;
}
