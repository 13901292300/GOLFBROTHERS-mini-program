.series-standings-round-dock-body {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  padding-bottom: 4rpx;
  background: var(--bg-primary, #fcfcfc);
  --round-selected-ring: #0f172a;
}
.series-standings-round-dock-body.dark-mode {
  --round-selected-ring: #f8fafc;
}

.series-standings-round-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-primary, #fcfcfc);
}

.srd-scroll-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
}

.series-standings-round-scroll {
  flex: 1;
  min-width: 0;
  width: 100%;
  white-space: nowrap;
  background: var(--bg-primary, #fcfcfc);
}

.series-standings-round-row {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 0 0;
  box-sizing: border-box;
}

.series-standings-tot {
  flex-shrink: 0;
}

.series-standings-round-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  position: relative;
}
.series-standings-round-chip__label {
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}
.series-standings-round-chip__live {
  font-size: 18rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 0.04em;
}

.round-selector-state--unassigned {
  background: #f1f5f9;
  color: #0f172a;
  border-color: rgba(15, 23, 42, 0.08);
}
.round-selector-state--grouped {
  background: var(--champion-gold);
  color: #ffffff;
  border-color: var(--champion-gold);
}
.round-selector-state--live {
  background: var(--data-blue, #00aeef);
  color: #ffffff;
  border-color: var(--data-blue, #00aeef);
}
.round-selector-state--completed {
  background: #6b7280;
  color: #ffffff;
  border-color: #6b7280;
}
.round-selector-state--cancelled {
  background: #9ca3af;
  color: #ffffff;
  border-color: #9ca3af;
  opacity: 0.88;
}
.round-selector-state--tot {
  background: #f1f5f9;
  color: #0f172a;
  border-color: rgba(15, 23, 42, 0.08);
}
.round-selector-state--unassigned .series-standings-round-chip__label,
.round-selector-state--tot .series-standings-round-chip__label {
  color: #0f172a;
}
.round-selector-state--grouped .series-standings-round-chip__label,
.round-selector-state--live .series-standings-round-chip__label,
.round-selector-state--completed .series-standings-round-chip__label,
.round-selector-state--cancelled .series-standings-round-chip__label {
  color: #ffffff;
}
.round-selector-state--live .series-standings-round-chip__live {
  color: rgba(255, 255, 255, 0.92);
}
.round-selector-state--cancelled .series-standings-round-chip__label {
  text-decoration: line-through;
}

.series-standings-round-chip.round-selector-item--selected {
  position: relative;
  z-index: 1;
  transform: none;
  box-shadow:
    inset 0 0 0 2rpx var(--round-selected-ring, #0f172a),
    0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.series-standings-round-chip .round-selector-item__selected-icon {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  right: auto;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--data-blue, #00aeef);
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
  z-index: 2;
  pointer-events: none;
  box-sizing: border-box;
}
.series-standings-round-chip.round-selector-item--selected {
  padding-left: 40rpx;
  padding-right: 4rpx;
}

.series-standings-round-dock-body.dark-mode .round-selector-state--unassigned,
.series-standings-round-dock-body.dark-mode .round-selector-state--tot {
  background: rgba(255, 255, 255, 0.08);
  color: #f8fafc;
  border-color: rgba(255, 255, 255, 0.12);
}
.series-standings-round-dock-body.dark-mode .round-selector-state--unassigned .series-standings-round-chip__label,
.series-standings-round-dock-body.dark-mode .round-selector-state--tot .series-standings-round-chip__label {
  color: #f8fafc;
}
.series-standings-round-dock-body.dark-mode .series-standings-round-chip .round-selector-item__selected-icon {
  background: #fff;
  color: var(--data-blue, #00aeef);
}

.series-standings-round-meta {
  box-sizing: border-box;
  height: 52rpx;
  min-height: 52rpx;
  max-height: 52rpx;
  margin-top: 0;
  padding: 12rpx 0;
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
  pointer-events: none;
}
.series-standings-round-meta--empty {
  visibility: hidden;
}
.series-standings-round-meta__text {
  display: block;
  width: 100%;
  min-width: 0;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 500;
  color: var(--text-secondary, #64748b);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.srd-overflow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 36rpx;
  z-index: 2;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted, #94a3b8);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  background: none;
}
.srd-overflow--left {
  left: 0;
}
.srd-overflow--right {
  right: 0;
}
