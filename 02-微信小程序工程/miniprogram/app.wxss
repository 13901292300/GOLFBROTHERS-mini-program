/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;

  /* ===== 品牌色 单一来源（视觉规范 V3.0，全局唯一标准，与主题无关） ===== */
  --champion-gold: #CE9224;
  --tour-blue: #002D62;
  --pga-blue: #002D62;
  --data-blue: #00AEEF;

  /* ===== 全局统一 TAB 颜色 token（与主题无关，dark/bright 一致） ===== */
  --tab-active-color: #ffffff;
  --tab-inactive-color: rgba(255, 255, 255, 0.5);

  /* ===== 全局统一 TAB 高度 / 字号 token（设计系统唯一标准，所有页面 TAB 一致） ===== */
  --tab-height: 50px;
  --tab-font-size: 26rpx;

  /* ===== 全局统一 TAB 金色指示器 token（粗细 + 色值唯一标准，所有页面一致，禁止局部覆盖） ===== */
  --tab-indicator-height: 3px;
  --tab-indicator-color: var(--champion-gold);
}

/* 所有 TAB（首页顶部 / 记分页 / 其他 tab 组件）统一使用以下两类 */
.tab-active {
  color: var(--tab-active-color);
}

.tab-inactive {
  color: var(--tab-inactive-color);
}

/* ===== gb-group-player：多组 GAME 分组卡片球员统一标准 ===== */
/* 基准：修改分组页（group-editor）正确视觉 —— 头像左，昵称/T台右 */
.gb-group-player-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 8rpx;
  align-items: start;
  overflow: visible;
}
.gb-group-player {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}
.gb-group-player-avatar-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}
.gb-group-player-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  border: 1px solid var(--border, #e5e7eb);
  background: var(--bg-subtle, #f3f4f6);
  display: block;
  flex-shrink: 0;
}
.gb-group-player-avatar--empty {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted, #6b7280);
  font-size: 36rpx;
  font-weight: 300;
}
.gb-group-player-meta {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 4rpx;
}
.gb-group-player-name {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary, #002d62);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gb-group-player-tee {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-start;
  gap: 6rpx;
  max-width: 100%;
  min-height: 24rpx;
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gb-group-player-tee-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.gb-group-player-tee-dot--male,
.gb-group-player-tee-dot.tee-marker-dot--male {
  background: #3b82f6;
}
.gb-group-player-tee-dot--female,
.gb-group-player-tee-dot.tee-marker-dot--female {
  background: #ef4444;
}
.gb-group-player-tee-text {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-muted, #6b7280);
  line-height: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
