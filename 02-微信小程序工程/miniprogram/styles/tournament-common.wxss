  align-self: start;
  color: var(--text-primary);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 横向：两头像水平中点；纵向：与头像下半部分对齐 */
.tee-marker-line {
  position: absolute;
  left: calc(50% + 44rpx);
  top: 60rpx;
  transform: translateX(-50%);
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  line-height: 1;
  pointer-events: none;
}
.tee-marker-dot { width: 10rpx; height: 10rpx; border-radius: 9999rpx; flex-shrink: 0; }
.tee-marker-dot--female { background: #dc2626; }
.tee-marker-dot--male { background: #0284c7; }
.tee-marker-letter { font-size: 20rpx; font-weight: 700; color: var(--text-secondary); line-height: 1; }
.tee-team-red { display: none; }
.tee-team-blue { display: none; }
.tee-status {
  position: absolute;
  right: 28rpx;
  top: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  z-index: 2;
}
/* 出发表底部悬浮快捷按钮：保留标准按钮视觉（填充/圆角/内边距/点击态），
   仅移除外层背景容器（panel/card/bar）。按钮自身直接 fixed 悬浮，不形成区域块。 */
.tee-quick-entry-float {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 110;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  text-align: center;
  border-radius: 12rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(0, 45, 98, 0.28);
}
.tee-quick-entry-float:active { background: #001d42; }
/* 出发表列表内容容器：
   1) padding-bottom 预留安全间距，最后一组不被底部悬浮按钮遮挡（仅作用于内容区，不动 scroll root）
   2) min-height: 0 — 不强制撑高；组数少时避免无意义滚动（与 Hub 出发表一致） */
.tee-sheet-list {
  box-sizing: border-box;
  min-height: 0;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ----- 讨论区壳 ds-fullscreen（hub/detail 共用） (detail L1550-L1568) ----- */
/* ===== 讨论区 ===== */
/* 讨论区全屏层：固定覆盖 header 以下区域（top 由 JS headerTotalHeight 给定），
   内部 = TAB（flex 不收缩）+ 统一讨论区组件（flex:1，自管围观/聊天滚动/输入/表情）。
   不进入 scroll-view，不影响其它 TAB 的滚动与吸顶逻辑。 */
.ds-fullscreen {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
}
.ds-fullscreen .tab-scroll-wrap { flex: 0 0 auto; }
.ds-fill { flex: 1 1 auto; min-height: 0; display: block; }
.ds-discussion-tabs--ghost {
  visibility: hidden;
  pointer-events: none;
}

/* ----- MORE FAB (detail L1570-L1603) ----- */
/* ===== MORE FAB ===== */
.leaderboard-fab {
  position: fixed;
  right: 16rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #002D62;
  color: #ffffff;
