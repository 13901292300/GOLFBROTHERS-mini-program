/* ----- Bottom sheet 基础 + feature grid (detail L1605-L1628) ----- */
/* ===== Bottom sheet ===== */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 150; }
.bottom-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; color: var(--tour-blue); border-radius: 80rpx 80rpx 0 0; z-index: 180; box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35); padding-bottom: env(safe-area-inset-bottom); overflow: hidden; }
.sheet-handle { width: 96rpx; height: 8rpx; border-radius: 999rpx; background: #e5e7eb; margin: 24rpx auto 40rpx; }
.sheet-top-accent { display: none; }
.feature-section { padding: 0 48rpx 24rpx; }
.feature-section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 24rpx; padding: 0 4rpx; color: var(--tour-blue); }
.fst-main { font-size: 24rpx; font-weight: 800; letter-spacing: 0.12em; }
.fst-sub { font-style: normal; font-size: 20rpx; color: #9ca3af; letter-spacing: 0.08em; }
.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 24rpx; row-gap: 32rpx; }
.feature-item { display: flex; flex-direction: column; align-items: center; min-height: 156rpx; }
.feature-item--empty { visibility: hidden; pointer-events: none; }
.feature-item.is-disabled {
