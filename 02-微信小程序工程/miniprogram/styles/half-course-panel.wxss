/* 多半场选择面板 — 与 pages/course/select 半场弹窗内容区一致（可嵌入 Bottom Sheet） */

.half-course-panel {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00aeef;
  color: var(--text-primary);
}

.half-sheet-head {
  position: relative;
  padding: 8rpx 48rpx 24rpx;
  text-align: center;
}
.half-sheet-eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: var(--text-muted);
  line-height: 1;
  margin-bottom: 8rpx;
}
.half-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1.2;
}
.half-sheet-close {
  position: absolute;
  right: 32rpx;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-muted);
  line-height: 1;
}

.half-sheet-body {
  max-height: 58vh;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.half-course-name {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary);
  line-height: 1.3;
}
.half-hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.half-split {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 56rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}
.half-col {
  flex: 1 1 0;
  min-width: 0;
  max-width: 50%;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-top: 6rpx solid var(--tour-blue);
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
}
.half-col__title {
  display: block;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.half-tags { display: flex; flex-direction: column; gap: 16rpx; width: 100%; }
.half-tag {
  width: 100%;
  max-width: 100%;
  min-height: 80rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 12rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-secondary);
  color: var(--text-secondary);
}
.half-tag__code { font-size: 28rpx; font-weight: 800; line-height: 1.2; }
.half-tag__name {
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 600;
  opacity: 0.75;
  line-height: 1.2;
  max-width: 100%;
  word-break: break-word;
}
.half-tag.active {
  background: var(--tour-blue);
  color: #fff;
  border-color: var(--tour-blue);
  box-shadow: inset 0 -6rpx 0 var(--champion-gold);
}

.par-table { width: 100%; box-sizing: border-box; margin-top: 48rpx; }
.par-table__title {
  display: block;
  font-size: 22rpx;
  font-weight: 900;
  font-style: italic;
  letter-spacing: 0.18em;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}
.par-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-card);
}
.par-row__head { display: flex; align-items: center; gap: 16rpx; width: 100%; }
.par-row__code { flex: 0 0 auto; width: 72rpx; font-size: 26rpx; font-weight: 800; color: var(--text-secondary); }
.par-row__name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.par-row__tags { flex: 0 0 auto; display: flex; gap: 8rpx; }
.par-side-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: var(--tour-blue);
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  line-height: 1.6;
}
.par-row__total { flex: 0 0 auto; font-size: 22rpx; font-weight: 900; color: var(--text-primary); }
.par-hole-row { display: flex; flex-wrap: wrap; gap: 10rpx; width: 100%; }
.par-hole-cell {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 8rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.bright-mode .par-row.active {
  background: rgba(0, 45, 98, 0.08);
  border-color: var(--tour-blue);
}
.bright-mode .par-row.active .par-row__code { color: var(--tour-blue); }
.dark-mode .par-row.active {
  background: rgba(0, 174, 239, 0.12);
  border-color: var(--data-blue);
}
.dark-mode .par-row.active .par-row__code { color: var(--data-blue); }
.dark-mode .par-side-tag { background: var(--data-blue); color: #001; }

.half-sheet-footer {
  padding: 12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.half-confirm-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}
.half-confirm-btn::after { border: none; }
.half-confirm-btn:active { transform: scale(0.98); }
.half-confirm-btn.is-disabled {
  opacity: 0.45;
  pointer-events: none;
}
