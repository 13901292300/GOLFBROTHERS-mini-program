<view class="ct-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">CONTACTS</text>
          <text class="gb-header__title">通讯录</text>
        </view>
      </view>
    </view>
  </view>

  <view class="ct-search-wrap">
    <view class="ct-search">
      <text class="ct-search__icon">🔍</text>
      <input
        class="ct-search__input"
        type="text"
        value="{{keyword}}"
        placeholder="搜索备注名或昵称"
        placeholder-class="ct-search__ph"
        confirm-type="search"
        bindinput="onSearchInput"
      />
      <view wx:if="{{keyword}}" bindtap="clearSearch" class="ct-search__clear"><text>×</text></view>
    </view>
  </view>

  <view class="ct-tabs">
    <view
      wx:for="{{relationTabs}}"
      wx:key="key"
      class="ct-tab {{activeTab === item.key ? 'is-active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchRelationTab"
    >
      <text>{{item.label}}</text>
      <view wx:if="{{item.key === 'followers' && followersTabBadge}}" class="ct-tab-dot"></view>
    </view>
  </view>

  <view class="ct-main">
    <scroll-view
      scroll-y
      class="ct-body {{(!useLetterIndex || searchMode) ? 'ct-body--search' : ''}}"
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollIntoView}}"
      scroll-with-animation
    >
      <view class="ct-meta">
        <text class="ct-meta__label">{{metaLabel}}</text>
        <text class="ct-meta__count">{{listCount}}</text>
      </view>

      <!-- 字母分组：好友 / 我关注的 / 我的粉丝 -->
      <block wx:if="{{!searchMode && useLetterIndex}}">
        <!-- 新粉丝（仅我的粉丝 Tab） -->
        <view wx:if="{{activeTab === 'followers' && newFollowerRows.length}}" class="ct-section">
          <view class="ct-letter-head ct-letter-head--new">新粉丝</view>
          <view wx:for="{{newFollowerRows}}" wx:key="id" class="ct-row">
            <image class="ct-avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view class="ct-info">
              <view class="ct-line1">
                <text class="ct-name">{{item.displayName}}</text>
                <text class="ct-gender {{item.genderClass}}">{{item.genderSymbol}}</text>
                <text class="ct-metric">差点 {{item.handicapText}}</text>
                <text class="ct-metric">浮动 {{item.floatText}}</text>
              </view>
              <text class="ct-signature">{{item.signature || '这个球友很懒，还没有签名'}}</text>
            </view>
            <follow-action-btn user-id="{{item.id}}" bind:follow="onFollowAction" />
          </view>
        </view>

        <block wx:for="{{sections}}" wx:key="letter">
          <view class="ct-section" id="{{item.anchorId}}">
            <view class="ct-letter-head">{{item.letter}}</view>
            <view
              wx:for="{{item.items}}"
              wx:for-item="friend"
              wx:key="id"
              class="ct-row"
            >
              <image class="ct-avatar" src="{{friend.avatar}}" mode="aspectFill" />
              <view class="ct-info">
                <view class="ct-line1">
                  <text class="ct-name">{{friend.displayName}}</text>
                  <text class="ct-gender {{friend.genderClass}}">{{friend.genderSymbol}}</text>
                  <text class="ct-metric">差点 {{friend.handicapText}}</text>
                  <text class="ct-metric">浮动 {{friend.floatText}}</text>
                </view>
                <text class="ct-signature">{{friend.signature || '这个球友很懒，还没有签名'}}</text>
              </view>
              <follow-action-btn
                wx:if="{{friend.showFollowFromFanBtn}}"
                user-id="{{friend.id}}"
                bind:follow="onFollowAction"
              />
              <text
                wx:elif="{{friend.relationStatusLabel}}"
                class="ct-rel-tag {{friend.relationStatus === 'friend' ? 'ct-rel-tag--friend' : 'ct-rel-tag--following'}}"
              >{{friend.relationStatusLabel}}</text>
            </view>
          </view>
        </block>
        <view wx:if="{{!listCount}}" class="ct-empty">
          <text class="ct-empty__text">{{emptyText}}</text>
        </view>
      </block>

      <!-- 推荐默认扁平 / 搜索结果扁平 -->
      <block wx:else>
        <view wx:for="{{searchMode ? searchResults : flatRows}}" wx:key="id" class="ct-row">
          <image class="ct-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view class="ct-info">
            <view class="ct-line1">
              <text class="ct-name">{{item.displayName}}</text>
              <text class="ct-gender {{item.genderClass}}">{{item.genderSymbol}}</text>
              <text class="ct-metric">差点 {{item.handicapText}}</text>
              <text class="ct-metric">浮动 {{item.floatText}}</text>
            </view>
            <text class="ct-signature">{{item.signature || '这个球友很懒，还没有签名'}}</text>
            <text wx:if="{{item.sourceHint}}" class="ct-source">{{item.sourceHint}}</text>
          </view>
          <follow-action-btn
            wx:if="{{activeTab === 'recommend' && item.showFollowBtn}}"
            user-id="{{item.id}}"
            bind:follow="onFollowAction"
          />
          <follow-action-btn
            wx:elif="{{item.showFollowFromFanBtn}}"
            user-id="{{item.id}}"
            bind:follow="onFollowAction"
          />
          <text
            wx:elif="{{item.relationStatusLabel}}"
            class="ct-rel-tag {{item.relationStatus === 'friend' ? 'ct-rel-tag--friend' : 'ct-rel-tag--following'}}"
          >{{item.relationStatusLabel}}</text>
        </view>
        <view wx:if="{{!listCount}}" class="ct-empty">
          <text class="ct-empty__text">{{emptyText}}</text>
        </view>
      </block>

      <view class="ct-pad"></view>
    </scroll-view>

    <view wx:if="{{!searchMode && useLetterIndex}}" class="ct-index">
      <view
        wx:for="{{indexLetters}}"
        wx:key="letter"
        class="ct-index__item {{item.active ? 'is-active' : ''}}"
        data-letter="{{item.letter}}"
        bindtap="onTapIndex"
      >{{item.letter}}</view>
    </view>
  </view>
</view>
