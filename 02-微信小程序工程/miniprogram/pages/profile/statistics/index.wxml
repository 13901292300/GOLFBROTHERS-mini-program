<view class="st-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">STATISTICS</text>
          <text class="gb-header__title">数据统计</text>
        </view>
      </view>
    </view>
  </view>

  <view class="st-hero-glow"></view>

  <scroll-view scroll-y class="st-body" enhanced show-scrollbar="{{false}}">
    <view class="st-main">
      <!-- 1. 总杆趋势 -->
      <view class="st-card">
        <view class="st-card__head">
          <view class="st-card__titles">
            <text class="st-card__eyebrow">{{statistics.totalStrokes.eyebrow}}</text>
            <text class="st-card__title">{{statistics.totalStrokes.title}}</text>
          </view>
          <view class="st-card__avg">
            <text class="st-card__avg-label">{{statistics.totalStrokes.averageLabel}}</text>
            <text class="st-card__avg-value">{{statistics.totalStrokes.average}}</text>
          </view>
        </view>
        <view class="st-chart">
          <view
            wx:for="{{totalStrokesChart.gridBands}}"
            wx:key="id"
            class="st-grid-band"
            style="bottom:{{item.yPct}}%;height:{{item.heightPct}}%;"
          ></view>
          <view
            wx:for="{{totalStrokesChart.gridLines}}"
            wx:key="id"
            class="st-grid-line"
            style="bottom:{{item.yPct}}%;"
          >
            <text class="st-grid-label">{{item.label}}</text>
          </view>
          <view class="st-avg-line" style="bottom:{{totalStrokesChart.avgYPct}}%;"></view>
          <view
            wx:for="{{totalStrokesChart.points}}"
            wx:key="id"
            class="st-point"
            style="left:{{item.xPct}}%;bottom:{{item.yPct}}%;"
          >
            <text class="st-dot-label">{{item.valueText}}</text>
            <view class="st-dot" style="background-color:{{item.color}};box-shadow:0 0 8px {{item.color}};"></view>
          </view>
        </view>
        <text class="st-card__footer">{{statistics.totalStrokes.footer}}</text>
      </view>

      <!-- 2. 推杆趋势 -->
      <view class="st-card">
        <view class="st-card__head">
          <view class="st-card__titles">
            <text class="st-card__eyebrow">{{statistics.putting.eyebrow}}</text>
            <text class="st-card__title">{{statistics.putting.title}}</text>
          </view>
          <view class="st-card__avg">
            <text class="st-card__avg-label">{{statistics.putting.averageLabel}}</text>
            <text class="st-card__avg-value">{{statistics.putting.average}}</text>
          </view>
        </view>
        <view class="st-chart">
          <view
            wx:for="{{puttingChart.gridBands}}"
            wx:key="id"
            class="st-grid-band"
            style="bottom:{{item.yPct}}%;height:{{item.heightPct}}%;"
          ></view>
          <view
            wx:for="{{puttingChart.gridLines}}"
            wx:key="id"
            class="st-grid-line"
            style="bottom:{{item.yPct}}%;"
          >
            <text class="st-grid-label">{{item.label}}</text>
          </view>
          <view class="st-avg-line" style="bottom:{{puttingChart.avgYPct}}%;"></view>
          <view
            wx:for="{{puttingChart.points}}"
            wx:key="id"
            class="st-point"
            style="left:{{item.xPct}}%;bottom:{{item.yPct}}%;"
          >
            <text class="st-dot-label">{{item.valueText}}</text>
            <view class="st-dot" style="background-color:{{item.color}};box-shadow:0 0 8px {{item.color}};"></view>
          </view>
        </view>
        <text class="st-card__footer">{{statistics.putting.footer}}</text>
      </view>

      <!-- 3. GIR Performance -->
      <view class="st-card">
        <view class="st-card__head">
          <view class="st-card__titles">
            <text class="st-card__eyebrow">{{statistics.girPerformance.eyebrow}}</text>
            <text class="st-card__title">{{statistics.girPerformance.title}}</text>
          </view>
          <view class="st-card__avg">
            <text class="st-card__avg-label">{{statistics.girPerformance.averageLabel}}</text>
            <text class="st-card__avg-value">{{statistics.girPerformance.rate}}</text>
          </view>
        </view>
        <view class="st-chart">
          <view
            wx:for="{{girChart.gridBands}}"
            wx:key="id"
            class="st-grid-band"
            style="bottom:{{item.yPct}}%;height:{{item.heightPct}}%;"
          ></view>
          <view
            wx:for="{{girChart.gridLines}}"
            wx:key="id"
            class="st-grid-line"
            style="bottom:{{item.yPct}}%;"
          >
            <text class="st-grid-label">{{item.label}}</text>
          </view>
          <view class="st-avg-line" style="bottom:{{girChart.avgYPct}}%;"></view>
          <view
            wx:for="{{girChart.points}}"
            wx:key="id"
            class="st-point"
            style="left:{{item.xPct}}%;bottom:{{item.yPct}}%;"
          >
            <text class="st-dot-label">{{item.valueText}}</text>
            <view class="st-dot" style="background-color:{{item.color}};box-shadow:0 0 8px {{item.color}};"></view>
          </view>
        </view>
        <text class="st-card__footer">{{statistics.girPerformance.footer}}</text>
      </view>

      <!-- 4. PAR Performance -->
      <view class="st-card st-card--par">
        <view class="st-par-head">
          <view class="st-card__titles">
            <text class="st-card__eyebrow">{{statistics.parPerformance.eyebrow}}</text>
            <text class="st-card__title">{{statistics.parPerformance.title}}</text>
          </view>
          <text class="st-par-head__avg">{{parAvgText}}</text>
        </view>
        <view class="st-par-body">
          <view class="st-par-tabs">
            <view
              wx:for="{{statistics.parPerformance.tabs}}"
              wx:key="par"
              class="st-par-tab {{activePar === item.par ? 'is-active' : 'is-inactive'}}"
              data-par="{{item.par}}"
              bindtap="onParTabTap"
            >
              <text class="st-par-tab__text">{{item.label}}</text>
            </view>
          </view>
          <view class="st-par-chart-wrap">
            <view class="st-chart st-chart--par">
              <view
                wx:for="{{parChart.gridBands}}"
                wx:key="id"
                class="st-grid-band"
                style="bottom:{{item.yPct}}%;height:{{item.heightPct}}%;"
              ></view>
              <view
                wx:for="{{parChart.gridLines}}"
                wx:key="id"
                class="st-grid-line"
                style="bottom:{{item.yPct}}%;"
              >
                <text class="st-grid-label">{{item.label}}</text>
              </view>
              <view class="st-avg-line" style="bottom:{{parChart.avgYPct}}%;"></view>
              <view
                wx:for="{{parChart.points}}"
                wx:key="id"
                class="st-point"
                style="left:{{item.xPct}}%;bottom:{{item.yPct}}%;"
              >
                <text class="st-dot-label">{{item.valueText}}</text>
                <view class="st-dot" style="background-color:{{item.color}};box-shadow:0 0 8px {{item.color}};"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
