}
.profile-list-header-alt {
  padding: var(--input-padding-y) var(--input-padding-x);
  background: var(--bg-subtle);
  border-bottom: 1px solid var(--border);
  box-sizing: border-box;
}
.profile-menu-icon--muted {
  color: var(--text-muted);
}

/* 中间“+”创建面板：操作面板顶部（非页面级蓝色 HEADER，无假胶囊/返回） */
.create-sheet-head {
  background: transparent;
  padding: 12px 16px 8px;
  padding-top: calc(12px + env(safe-area-inset-top, 0px));
  box-sizing: border-box;
}
.create-sheet-handle {
  width: 40px;
  height: 4px;
  border-radius: 9999px;
  background: rgba(148, 163, 184, 0.5);
  margin: 0 auto 12px;
}

/*
 * “+”创建弹屏 / 更多创建：位于 .ds-app 外层，须自行承载 dark-theme token，
 * 与 .ds-app.dark-theme 同源，不新增第二套主题变量。
 */
.create-overlay.dark-theme,
.more-create-overlay.dark-theme {
  --bg-primary: #050816;
  --bg-card: #0B1220;
  --bg-subtle: #121A2B;
  --bg-hover: #1A2332;
  --border: var(--border-dark);
  --border-hover: var(--border-dark-hover);
  --text-primary: #E5EEFC;
  --text-secondary: #CBD5E1;
  --text-muted: #94A3B8;
  --text-disabled: #64748B;
  --shadow-card: 0 18px 40px var(--black-alpha-35);
  color: var(--text-primary);
}

/* 弹屏整体背景：深色半透明 / 实色 */
.create-overlay.dark-theme.bg-white-95 {
  background-color: rgba(5, 8, 22, 0.96);
}
.more-create-overlay.dark-theme {
  background: var(--bg-primary);
}

.create-overlay.dark-theme .create-sheet-handle {
  background: rgba(148, 163, 184, 0.35);
}

/* 图标 tile / 关闭按钮 / 功能卡图标底 */
.create-overlay.dark-theme .bg-slate-50,
.create-overlay.dark-theme .bg-slate-100,
.more-create-overlay.dark-theme .bg-slate-50,
.more-create-overlay.dark-theme .bg-slate-100 {
  background-color: var(--bg-subtle);
}
.create-overlay.dark-theme .bg-white,
.more-create-overlay.dark-theme .bg-white {
  background-color: var(--bg-card);
}
.create-overlay.dark-theme .border-slate-100,
.more-create-overlay.dark-theme .border-slate-100 {
  border-color: var(--border);
}

/* 功能入口卡片：用深色 surface，标题反色保证可读 */
.create-overlay.dark-theme .ds-card-action,
.more-create-overlay.dark-theme .ds-card-selectable {
  background-color: var(--bg-hover);
}
.create-overlay.dark-theme .ds-card-action .text-sm.text-tour-blue,
.more-create-overlay.dark-theme .text-sm.text-tour-blue,
.more-create-overlay.dark-theme .text-xl.text-tour-blue {
  color: var(--text-on-dark);
}

/* 文案色：覆盖硬编码浅色 utility */
.create-overlay.dark-theme .text-tour-blue,
.more-create-overlay.dark-theme .text-tour-blue {
  color: var(--text-primary);
}
.create-overlay.dark-theme .text-slate-300,
.create-overlay.dark-theme .text-slate-400,
.more-create-overlay.dark-theme .text-slate-300,
.more-create-overlay.dark-theme .text-slate-400 {
  color: var(--text-muted);
}
.create-overlay.dark-theme .shortcut-label {
  color: var(--text-secondary);
}
.create-overlay.dark-theme .shortcut-tile {
  background: var(--bg-card);
  border-color: var(--border);
  box-shadow: none;
}

/* 底部关闭按钮 */
.create-overlay.dark-theme .w-14.h-14.bg-white {
  background-color: var(--bg-card);
  border-color: var(--border);
  color: var(--text-muted);
  box-shadow: 0 8px 24px var(--black-alpha-35);
}

.more-create-header {
  padding: 24px 16px 16px;
  padding-top: calc(24px + env(safe-area-inset-top, 0px));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
}

/* 统一 GB Header（与创建页 / 记分页 / Hub 一致；右侧仅真实胶囊避让，不绘制假胶囊） */
.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
  box-sizing: border-box;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; min-width: 0; }
.gb-header__back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow {
  display: block;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 6rpx;
}
.gb-header__title {
  display: block;
  color: #fff;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  line-height: 1;
}

.shortcut-scroll {
  display: flex;
  overflow-x: auto;
  gap: 16px;
  padding: 8px 0;
  -webkit-overflow-scrolling: touch;
}
.shortcut-tile {
  width: 56px;
  height: 56px;
  background: var(--bg-card);
  border: 1px solid var(--slate-100);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 2px var(--shadow-black-05);
  box-sizing: border-box;
}
.shortcut-label {
  font-size: 9px;
  font-weight: 700;
  color: var(--slate-600);
  text-transform: uppercase;
  margin-top: 8px;
  text-align: center;
}

.banner-picker-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.banner-picker-item {
  height: 96px;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid var(--border);
  position: relative;
  padding: 0;
  width: 100%;
}
.banner-picker-label {
  position: absolute;
  left: 12px;
  bottom: 12px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-on-dark);
  z-index: 1;
}
.edit-field-input {
  background: transparent;
  width: 100%;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
}
.edit-field-textarea {
  background: transparent;
  width: 100%;
  font-size: 14px;
  font-weight: 700;
  height: 80px;
  color: var(--text-primary);
}

/* 创建浮层关闭按钮 */
.w-14.h-14.bg-white {
  width: 56px;
  height: 56px;
  background: var(--bg-card);
  border: 2px solid var(--slate-100);
  border-radius: 9999px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20px 25px -5px var(--shadow-black-10);
}

@keyframes flash-live {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* ===== 大字体（fontScale=large）—— 仅覆盖卡片阅读字号，不改布局几何 ===== */
.ds-app.font-large .ds-card-game-title {
  font-size: 16px;
}
.ds-app.font-large .ds-card-game-meta {
  font-size: 12px;
}
.ds-app.font-large .text-sm {
  font-size: 16px;
}
.ds-app.font-large .text-base {
  font-size: 18px;
}
.ds-app.font-large .text-9px {
  font-size: 12px;
}

/* ===== 日程 TAB：年度日历年份切换 ===== */
.calendar-year-switch {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 8px 12px 4px;
  margin-bottom: 4px;
}

.calendar-year-switch__btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 700;
  color: var(--text-muted, #94a3b8);
  line-height: 1;
}

.calendar-year-switch__year {
  min-width: 72px;
  text-align: center;
  font-size: 20px;
  font-weight: 900;
  font-style: italic;
  color: var(--text-primary, #002d62);
  letter-spacing: 0.04em;
}
.calendar-year-switch__btn:active,
.calendar-year-switch__btn:hover,
.calendar-year-switch__btn:focus {
  color: var(--text-muted, #94a3b8);
  background: transparent;
  opacity: 0.75;
}

/* DARK：日程年份切换 — 年份/箭头浅色，避免固定蓝色 */
.ds-app.dark-theme .calendar-year-switch__year {
  color: #f5f5f5;
}

.ds-app.dark-theme .calendar-year-switch__btn,
.ds-app.dark-theme .calendar-year-switch__btn:active,
.ds-app.dark-theme .calendar-year-switch__btn:hover,
.ds-app.dark-theme .calendar-year-switch__btn:focus {
  color: #f5f5f5;
  background: transparent;
}



.registration-segment {
  display: flex;
  padding: 4px;
  border-radius: 12px;
  background: var(--ds-bg-muted, #eef1f4);
}

.registration-segment__item {
  flex: 1;
  padding: 10px 12px;
  border-radius: 9px;
  color: var(--ds-text-muted, #64748b);
  font-size: 13px;
  font-weight: 700;
  text-align: center;
}

.registration-segment__item.is-active {
  color: #002d62;
  background: #fff;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
}

.ds-app.dark-theme .registration-segment {
  background: rgba(255, 255, 255, 0.08);
}

.ds-app.dark-theme .registration-segment__item {
  color: #94a3b8;
}

.ds-app.dark-theme .registration-segment__item.is-active {
  color: #e5eefc;
  background: #1e293b;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.28);
}

.offline-scoring-home-bar {
  flex-shrink: 0;
  z-index: 40;
  padding: 12rpx 28rpx;
  background: #002d62;
  color: #fff8e7;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}
.ds-app.dark-theme .offline-scoring-home-bar {
  background: #0b1c38;
  color: #f3d48a;
}
.offline-scoring-home-bar--ok {
  background: #0f5132;
  color: #d1f5e1;
}
.offline-scoring-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 80;
}
.offline-scoring-sheet {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 120rpx;
  z-index: 81;
  background: var(--bg-card, #fff);
  color: var(--text-primary, #111);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}
.ds-app.dark-theme .offline-scoring-sheet {
  background: #1e293b;
  color: #e5eefc;
}
.offline-scoring-sheet__title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}
.offline-scoring-sheet__row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.offline-scoring-sheet__k {
  opacity: 0.7;
}
.offline-scoring-sheet__v {
  font-weight: 700;
  text-align: right;
  flex: 1;
}
.offline-scoring-sheet__retry,
.offline-scoring-sheet__close {
  margin-top: 20rpx;
  text-align: center;
  padding: 18rpx 0;
  font-weight: 700;
}
.offline-scoring-sheet__retry {
  color: #ce9224;
}
