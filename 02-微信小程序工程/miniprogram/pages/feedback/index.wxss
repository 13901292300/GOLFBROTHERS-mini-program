.feedback-page { --tour-blue: #002d62; --champion-gold: #ce9224; }
.feedback-page.dark-mode {
  --bg-primary: #000000; --bg-card: #111111; --bg-subtle: #0a0a0a;
  --border: #222222; --text-primary: #f1f5f9; --text-muted: #888888;
}
.feedback-page.bright-mode {
  --bg-primary: #fcfcfc; --bg-card: #ffffff; --bg-subtle: #f3f4f6;
  --border: #e5e7eb; --text-primary: #002d62; --text-muted: #6b7280;
}

page { height: 100%; background: var(--bg-primary); }
.feedback-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.gb-header { background: var(--tour-blue); border-bottom: 2px solid var(--champion-gold); color: #fff; flex-shrink: 0; }
.gb-header__inner { display: flex; align-items: center; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

.page-body { flex: 1; min-height: 0; box-sizing: border-box; }
.form-section { padding: 28rpx 32rpx 8rpx; }
.field-label { font-size: 26rpx; font-weight: 800; color: var(--text-primary); margin-bottom: 16rpx; }
.required { color: #dc2626; }
.field-textarea {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}
.field-input {
  width: 100%;
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  font-size: 28rpx;
  color: var(--text-primary);
}
.field-ph { color: var(--text-muted); }
.field-hint { display: block; margin-top: 10rpx; font-size: 22rpx; color: var(--text-muted); text-align: right; }

.image-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.image-item, .image-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
}
.image-thumb { width: 100%; height: 100%; }
.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; }
.image-add__plus { font-size: 44rpx; color: var(--text-muted); line-height: 1; }
.image-add__text { font-size: 22rpx; color: var(--text-muted); }

.location-row { display: flex; align-items: center; gap: 16rpx; }
.location-info { flex: 1; min-width: 0; }
.location-coords { font-size: 24rpx; color: var(--text-primary); word-break: break-all; }
.location-empty { font-size: 26rpx; color: var(--text-muted); }
.location-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: var(--pga-blue);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}
.location-clear {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-decoration: underline;
}

.submit-wrap { padding: 48rpx 32rpx 24rpx; }
.submit-btn {
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--champion-gold);
  color: #111111;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn.is-disabled { opacity: 0.55; }
.body-pad { height: 48rpx; }
