/* 队内赛创建 —— 复刻 创建队内赛.html；Header / Bottom Sheet 与普通创建页统一 */

.create-page {
  --tour-blue: #002d62;
  --champion-gold: #ce9224;
  --data-blue: #00aeef;
  --error: #ef4444;
}
.create-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --bg-hover: #1a1a1a;
  --border: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-tertiary: #888888;
  --text-muted: #888888;
  --text-disabled: #555555;
  --shadow-card: none;
}
.create-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --bg-hover: #f9fafb;
  --border: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-tertiary: #6b7280;
  --text-muted: #6b7280;
  --text-disabled: #9ca3af;
  --error: #dc2626;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.create-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
  overflow-x: hidden;
}

/* ===== Header（与普通创建统一） ===== */
.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

/* ===== 主体 ===== */
.content-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  width: 100%;
  box-sizing: border-box;
}
.content { padding: 32rpx; box-sizing: border-box; }
.content-spacer { height: 32rpx; }

.section { margin-bottom: 48rpx; }
.section-label { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20rpx; gap: 24rpx; }
.section-label__h2 { font-size: 28rpx; line-height: 1.5; font-weight: 700; color: var(--text-secondary); }
.ds-desc-text,
.section-note,
.field-subvalue,
.team-group-entry-desc,
.team-group-desc,
.permission-option-desc,
.custom-info-label,
.event-detail-title,
.mode-text__em {
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-secondary);
  font-weight: 400;
}
.ds-hint-text,
.recommend-option-type,
.event-detail-image-hint {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--text-tertiary);
  font-weight: 400;
}
.section-note { white-space: nowrap; }

.ds-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}
.ds-card.top-line::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: var(--tour-blue);
  border-radius: 16rpx 16rpx 0 0;
  pointer-events: none;
}

.ds-field { min-height: 128rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.game-mode-field { cursor: pointer; }
.field-main { min-width: 0; flex: 1; }
.field-value { font-size: 32rpx; line-height: 1.4; font-weight: 800; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.field-value.strong { font-size: 36rpx; font-weight: 900; letter-spacing: -0.03em; }
.field-value.italic { font-style: italic; }
.field-placeholder { font-size: 32rpx; line-height: 1.4; font-weight: 700; font-style: italic; color: var(--text-disabled); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.field-subvalue { display: block; margin-top: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.field-icon { color: var(--champion-gold); font-size: 36rpx; flex-shrink: 0; }
.field-right { display: inline-flex; align-items: center; justify-content: flex-end; gap: 20rpx; flex-shrink: 0; margin-left: auto; }

.round-name-input { width: 100%; height: 88rpx; padding: 0; border: 0; background: transparent; color: var(--text-primary); font-size: 36rpx; line-height: 1.4; font-weight: 900; letter-spacing: -0.03em; }
.round-name-input::placeholder { color: var(--text-disabled); font-weight: 700; }

/* ===== 球队卡片 ===== */
.team-card { min-height: 172rpx; padding: 28rpx 32rpx; display: flex; align-items: center; justify-content: space-between; gap: 28rpx; }
.team-left { display: flex; align-items: center; gap: 28rpx; min-width: 0; flex: 1; }
.team-logo { width: 112rpx; height: 112rpx; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-subtle); flex-shrink: 0; }
.team-title { display: block; font-size: 32rpx; line-height: 1.3; font-weight: 800; color: var(--text-primary); margin-bottom: 12rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.ds-badge {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}
.badge-gold { background: var(--champion-gold); color: #ffffff; }
.badge-info { background: var(--data-blue); color: #ffffff; }

/* ===== 时间设置 ===== */
.time-card { padding: 0 32rpx; }
.inner-row { min-height: 136rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; border-bottom: 1px solid var(--border); }
.inner-row:last-child { border-bottom: 0; }
.meta-label { display: block; font-size: 20rpx; line-height: 1.2; font-weight: 900; letter-spacing: 0.15em; color: var(--text-muted); text-transform: uppercase; margin-bottom: 12rpx; }
.data-value { display: block; font-size: 32rpx; line-height: 1.4; font-weight: 800; font-style: italic; color: var(--text-primary); font-variant-numeric: tabular-nums; }

/* ===== 横向 Radio ===== */
.inline-choice-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36rpx; padding: 4rpx 0; }
.inline-choice { min-height: 72rpx; display: inline-flex; align-items: center; gap: 16rpx; color: var(--text-secondary); font-size: 28rpx; line-height: 1.4; font-weight: 700; }
.inline-choice.first-choice-shifted { margin-left: 4em; }
.choice-dot { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2px solid var(--border-hover); background: transparent; position: relative; flex-shrink: 0; box-sizing: border-box; }
.inline-choice.active { color: var(--text-primary); }
.inline-choice.active .choice-dot { border-color: var(--tour-blue); background: var(--tour-blue); }
.inline-choice.active .choice-dot::after {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* ===== 费用设置 ===== */
.fee-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  min-height: 128rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}
.fee-left {
  flex: 1;
  min-width: 0;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.fee-action {
  align-self: center;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}
.fee-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
  align-content: center;
  justify-content: flex-start;
}
.fee-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  width: auto;
  max-width: 100%;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  border: 1px solid rgba(206, 146, 36, 0.16);
  background: rgba(206, 146, 36, 0.08);
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1;
  font-weight: 500;
  text-align: center;
  box-sizing: border-box;
}
.fee-tag-text {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.2;
  text-align: center;
}
.fee-sheet-header {
  align-items: center;
}
.fee-diamond-toggle {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.fee-diamond-label {
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--text-secondary);
}
.fee-diamond-icon {
  font-size: 24rpx;
  line-height: 1;
}
.fee-diamond-switch {
  transform: scale(0.74);
  transform-origin: center right;
}
.fee-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.fee-row {
  min-height: 104rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.fee-name-input {
  flex: 3;
  min-width: 0;
  height: 88rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
  background: transparent;
}
.fee-amount-input {
  width: 100%;
  height: 88rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 900;
  text-align: right;
  background: transparent;
  font-variant-numeric: tabular-nums;
}
.fee-amount-wrap {
  flex: 2;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.fee-amount-diamond {
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1;
}
.fee-name-input::placeholder,
.fee-amount-input::placeholder {
  color: var(--text-disabled);
  font-weight: 700;
}
.fee-delete {
  flex-shrink: 0;
  color: var(--error);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
  opacity: 0.78;
  padding: 20rpx 0 20rpx 12rpx;
}
.add-fee-btn {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0 28rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 700;
}
.add-fee-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid var(--border-hover);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ===== 分队设置 ===== */
.team-group-entry-desc {
  display: block;
}
.team-group-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  align-items: center;
}
.team-group-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  border: 1px solid rgba(0, 45, 98, 0.14);
  background: rgba(0, 45, 98, 0.06);
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.2;
  font-weight: 500;
  box-sizing: border-box;
}
.team-group-entry-action {
  align-self: center;
}
.team-group-desc {
  display: block;
  margin-bottom: 24rpx;
}
.team-group-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.team-group-row {
  min-height: 104rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.team-group-label {
  width: 104rpx;
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
}
.team-group-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 800;
  background: transparent;
}
.team-group-input::placeholder {
  color: var(--text-disabled);
  font-weight: 700;
}
.team-group-delete {
  flex-shrink: 0;
  color: var(--error);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
  opacity: 0.78;
  padding: 20rpx 0 20rpx 20rpx;
}
.add-team-group-btn {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0 28rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 700;
}
.add-team-group-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid var(--border-hover);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ===== 分组权限 ===== */
.group-permission-card {
  padding: 28rpx 32rpx;
}
.permission-option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.permission-option {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  box-sizing: border-box;
}
.permission-option.active {
  border-color: var(--tour-blue);
  background: rgba(0, 45, 98, 0.06);
}
.permission-option .choice-dot {
  margin-top: 6rpx;
  flex-shrink: 0;
}
.permission-option.active .choice-dot {
  border-color: var(--tour-blue);
  background: var(--tour-blue);
}
.permission-option.active .choice-dot::after {
  content: "";
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ffffff;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.permission-option-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.permission-option-title {
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--text-secondary);
}
.permission-option.active .permission-option-title {
  color: var(--text-primary);
}
.permission-option.active .permission-option-desc {
  color: var(--text-secondary);
}

/* ===== 赛事信息 ===== */
.event-info-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 0; }
.event-info-sort-area {
  display: block;
  width: 100%;
  overflow: hidden;
}
.event-info-movable {
  width: 70%;
  height: 128rpx;
  z-index: 1;
}
.event-info-movable.dragging {
  z-index: 8;
}
.event-info-create-row { margin-bottom: 0; }
.event-info-movable .event-info-create-row {
  width: 100%;
  height: 128rpx;
  box-sizing: border-box;
}
.event-info-row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}
.event-info-drag-handle {
  color: var(--text-muted);
  font-size: 28rpx;
  line-height: 1;
  flex-shrink: 0;
  opacity: 0.55;
}
.event-info-create-row .field-value { font-style: normal; }
/* 图片项无标题时：类型文案复用主标题 field-value 样式 */
.event-info-create-row .field-value:empty {
  display: none;
}
.event-info-create-row .field-value:empty + .field-subvalue.ds-desc-text {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 800;
  color: var(--text-primary);
  margin-top: 0;
}
.add-event-info-btn { display: inline-flex; align-items: center; gap: 16rpx; margin-top: 24rpx; color: var(--text-muted); font-size: 28rpx; font-weight: 700; }
.add-event-info-icon { width: 56rpx; height: 56rpx; border-radius: 50%; border: 1px solid var(--border-hover); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0; }

.add-info-recommend-list { display: flex; flex-direction: column; gap: 16rpx; margin-bottom: 24rpx; }
.recommend-option {
  min-height: 96rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}
.recommend-option.active { border-color: var(--champion-gold); background: rgba(206, 146, 36, 0.1); }
.recommend-option.disabled { opacity: 0.42; }
.recommend-option-title { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.3; font-weight: 700; color: var(--text-primary); }
.recommend-option-type { margin-right: 8rpx; }
.recommend-check { color: var(--champion-gold); font-size: 28rpx; opacity: 0; flex-shrink: 0; }
.recommend-option.active .recommend-check { opacity: 1; }

.custom-info-block { border-top: 1px solid var(--border); padding-top: 24rpx; margin-top: 8rpx; margin-bottom: 28rpx; }
.custom-info-label { display: block; margin-bottom: 16rpx; }
.custom-info-type-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; margin-bottom: 20rpx; }
.custom-info-type {
  height: 84rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
  box-sizing: border-box;
}
.custom-info-type .choice-dot { width: 36rpx; height: 36rpx; }
.custom-info-type.active { border-color: var(--champion-gold); background: rgba(206, 146, 36, 0.1); color: var(--text-primary); }
.custom-info-type.active .choice-dot { border-color: var(--tour-blue); background: var(--tour-blue); }
.custom-info-type.active .choice-dot::after {
  content: "";
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.custom-info-input {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-primary);
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.sheet-actions-two { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.sheet-cancel-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border-hover);
  background: transparent;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
}
.sheet-cancel-btn::after { border: none; }
.sheet-confirm-btn--inline { margin-bottom: 0; }
.event-info-sheet .sheet-actions-two,
.fee-sheet .sheet-actions-two,
.team-group-sheet .sheet-actions-two {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  box-sizing: border-box;
}
.event-info-sheet .sheet-cancel-btn,
.event-info-sheet .sheet-confirm-btn,
.fee-sheet .sheet-cancel-btn,
.fee-sheet .sheet-confirm-btn,
.team-group-sheet .sheet-cancel-btn,
.team-group-sheet .sheet-confirm-btn {
  flex: 1;
  min-width: 0;
  width: auto;
  margin: 0;
  box-sizing: border-box;
}

.event-detail-title { margin-bottom: 20rpx; }
.event-detail-title-strong { color: var(--text-primary); font-size: 32rpx; font-weight: 800; }

.event-detail-textarea {
  width: 100%;
  min-height: 380rpx;
  border: 1px solid var(--border);
  border-radius: 16rpx;
  background: var(--bg-subtle);
  color: var(--text-primary);
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  font-weight: 500;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.event-detail-image-box {
  min-height: 360rpx;
  border: 1px dashed var(--border-hover);
  border-radius: 16rpx;
  background: var(--bg-subtle);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
}
.event-detail-image-title {
  align-self: flex-start;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}
.event-detail-image-box.has-image {
  padding: 16rpx;
  min-height: 0;
  display: flex;
  align-items: stretch;
  justify-content: flex-start;
  flex-direction: column;
  gap: 12rpx;
  overflow: visible;
}
.event-detail-image-icon { font-size: 56rpx; color: var(--text-disabled); line-height: 1; }
.event-detail-image-strong { font-size: 28rpx; line-height: 1.2; font-weight: 800; color: var(--text-secondary); }
.event-detail-image-hint { max-width: 520rpx; }
.event-detail-image-preview {
  display: block;
  width: 100%;
  border-radius: 12rpx;
}

.event-detail-delete-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  border: 1px solid var(--error);
  background: transparent;
  color: var(--error);
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  margin-bottom: 28rpx;
}
.event-detail-delete-btn::after { border: none; }
.event-detail-delete-btn.confirming { background: var(--error); color: #fff; }

/* ===== 隐私设置（与普通创建页一致） ===== */
.privacy-card { padding: 28rpx 32rpx; }
.privacy-row { display: flex; align-items: center; gap: 20rpx; flex-wrap: nowrap; }
.privacy-left { flex: 0 0 auto; }
.privacy-center { flex: 1; min-width: 0; }
.privacy-right { flex: 0 0 auto; display: flex; align-items: center; gap: 12rpx; min-width: 0; }

.privacy-state { font-size: 28rpx; font-weight: 800; color: var(--text-primary); transition: color 0.2s; }
.privacy-state.is-private { color: var(--champion-gold); }

.privacy-switch {
  position: relative;
  width: 104rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--tour-blue);
  box-sizing: border-box;
  transition: background-color 0.25s ease;
  flex-shrink: 0;
}
.privacy-switch.is-private { background: var(--champion-gold); }
.privacy-switch__thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.25s ease;
}
.privacy-switch.is-private .privacy-switch__thumb { transform: translateX(48rpx); }

.access-code-label { flex-shrink: 0; font-size: 22rpx; font-weight: 700; color: var(--text-muted); white-space: nowrap; }
.access-code-value {
  flex-shrink: 0;
  font-family: 'SF Mono', 'Roboto Mono', Consolas, Menlo, monospace;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0.16em;
  color: var(--text-primary);
  white-space: nowrap;
}
.access-code-copy {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 1px solid var(--tour-blue);
  color: var(--tour-blue);
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}
.access-code-copy:active { transform: scale(0.96); }

/* ===== LOGO配置 ===== */
.logo-config-card {
  cursor: pointer;
}
.logo-config-desc {
  display: block;
  white-space: normal;
}
.logo-sheet {
  text-align: center;
}
.logo-preview-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}
.logo-preview-box {
  width: 220rpx;
  height: 220rpx;
  border-radius: 32rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx;
  box-sizing: border-box;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.logo-preview-box.has-custom {
  border-color: var(--champion-gold);
  box-shadow: 0 12rpx 28rpx rgba(206, 146, 36, 0.16);
}
.logo-preview-box.is-default {
  opacity: 0.86;
}
.logo-preview-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  background: var(--bg-card);
}
.logo-preview-title {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.logo-preview-desc {
  display: block;
  max-width: 560rpx;
}
.logo-action-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 18rpx;
}
.logo-upload-btn,
.logo-delete-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  box-sizing: border-box;
}
.logo-upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1px solid var(--tour-blue);
  background: var(--tour-blue);
  color: #ffffff;
}
.logo-delete-btn {
  border: 1px solid var(--error);
  background: transparent;
  color: var(--error);
}
.logo-upload-btn::after,
.logo-delete-btn::after {
  border: none;
}
.logo-upload-icon {
  font-size: 30rpx;
  line-height: 1;
  font-weight: 800;
}
.logo-sheet-hint {
  display: block;
}

/* ===== PARTNER 配置 ===== */
.partner-config-card {
  padding: 28rpx 32rpx 32rpx;
}
.partner-config-desc {
  display: block;
  margin-bottom: 24rpx;
  white-space: normal;
}
.partner-config-row {
  margin-bottom: 28rpx;
}
.partner-config-label {
  display: block;
  font-size: 24rpx;
  line-height: 36rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.partner-title-input {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  color: var(--text-primary);
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}
.partner-logo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.partner-logo-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  min-height: 232rpx;
  border-radius: 12rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  box-sizing: border-box;
  padding: 10rpx 10rpx 12rpx;
}
.partner-logo-dual {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.partner-logo-slot {
  border: 1px dashed var(--border-hover);
  border-radius: 10rpx;
  background: var(--bg-card);
  min-height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 8rpx;
  box-sizing: border-box;
}
.partner-logo-slot__label {
  font-size: 18rpx;
  line-height: 1.2;
  color: var(--text-muted);
  margin-bottom: 4rpx;
}
.partner-logo-slot__empty {
  width: 100%;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.partner-logo-slot__plus {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--text-disabled);
}
.partner-logo-img {
  width: 100%;
  height: 52rpx;
  padding: 4rpx;
  box-sizing: border-box;
}
.partner-logo-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
}
.partner-logo-add {
  width: calc((100% - 32rpx) / 3);
  min-height: 232rpx;
  border-radius: 12rpx;
  border: 1px dashed var(--border-hover);
  background: var(--bg-subtle);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--text-tertiary);
  box-sizing: border-box;
}
.partner-logo-add__icon {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
}
.partner-logo-add__text {
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 600;
}

/* ===== 底部固定按钮 ===== */
.footer {
  flex-shrink: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border);
  z-index: 30;
}
.submit-btn {
  width: 100%;
  height: 104rpx;
  line-height: 104rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--tour-blue);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  padding: 0;
}
.submit-btn::after { border: none; }
.submit-btn:active { transform: scale(0.98); background: #001d42; }

/* ===== Bottom Sheet（与普通创建统一） ===== */
.sheet-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.46); opacity: 0; pointer-events: none; transition: opacity 0.22s ease; z-index: 80; }
.sheet-mask.show { opacity: 1; pointer-events: auto; }
.bottom-sheet { position: fixed; left: 0; right: 0; bottom: 0; transform: translateY(105%); background: var(--bg-card); border: 1px solid var(--border); border-bottom: 0; border-radius: 32rpx 32rpx 0 0; box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24); padding: 20rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); z-index: 90; transition: transform 0.24s ease; max-height: 85vh; overflow-y: auto; }
.bottom-sheet.show { transform: translateY(0); }
.sheet-handle { width: 80rpx; height: 8rpx; border-radius: 999rpx; background: var(--border-hover); margin: 0 auto 28rpx; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; }
.sheet-overline { display: block; font-size: 20rpx; line-height: 1.2; font-weight: 900; letter-spacing: 0.15em; color: var(--data-blue); }
.sheet-header__h3 { display: block; margin-top: 4rpx; font-size: 36rpx; line-height: 1.2; font-weight: 700; color: var(--text-primary); }
.sheet-close { width: 72rpx; height: 72rpx; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0; }

.game-mode-list { display: flex; flex-direction: column; gap: 20rpx; }
.game-mode-option { width: 100%; min-height: 128rpx; border-radius: 16rpx; border: 1px solid var(--border); background: var(--bg-subtle); color: var(--text-primary); display: flex; align-items: center; gap: 24rpx; padding: 24rpx; box-sizing: border-box; }
.game-mode-option.active { border-color: var(--champion-gold); background: rgba(206, 146, 36, 0.1); }
.mode-icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--tour-blue); color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 30rpx; }
.mode-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.mode-text__strong { font-size: 28rpx; line-height: 1.2; font-weight: 700; color: var(--text-primary); }
.mode-check { color: var(--champion-gold); font-size: 28rpx; opacity: 0; flex-shrink: 0; }
.game-mode-option.active .mode-check { opacity: 1; }

/* ===== 时间滚轮（与普通创建页一致） ===== */
.wheel-sheet-title { display: block; font-size: 36rpx; line-height: 1.2; font-weight: 700; color: var(--text-primary); margin-bottom: 16rpx; }
.wheel-year-bar { height: 96rpx; display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.year-arrow { width: 76rpx; height: 76rpx; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-subtle); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.wheel-year-text { font-size: 40rpx; line-height: 1; font-weight: 900; color: var(--text-primary); letter-spacing: -0.02em; }
.wheel-title-row { display: grid; grid-template-columns: repeat(4, 1fr); height: 56rpx; align-items: center; color: var(--text-muted); font-size: 24rpx; font-weight: 700; text-align: center; }
.wheel-picker { width: 100%; height: 340rpx; border-radius: 16rpx; border: 1px solid var(--border); background: var(--bg-subtle); margin-bottom: 32rpx; }
.wheel-item { height: 80rpx; line-height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.wheel-indicator { height: 80rpx; background: rgba(206, 146, 36, 0.08); border-top: 1px solid var(--border-hover); border-bottom: 1px solid var(--border-hover); }
.sheet-confirm-btn { width: 100%; height: 96rpx; line-height: 96rpx; border: 0; border-radius: 12rpx; background: var(--tour-blue); color: #fff; font-size: 28rpx; font-weight: 700; padding: 0; }
.sheet-confirm-btn::after { border: none; }
