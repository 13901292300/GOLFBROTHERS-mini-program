<view class="score-page {{themeClass}} {{fontScaleClass}}">
  <!-- Header -->
  <view id="main-header" class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">SCORECARD</text>
          <text class="gb-header__title">记分卡</text>
        </view>
      </view>
      <view class="gb-header__right">
        <view class="mini-program-pill">
          <view class="mini-program-pill__dots">
            <view class="mini-program-pill__dot"></view>
            <view class="mini-program-pill__dot"></view>
            <view class="mini-program-pill__dot"></view>
          </view>
          <view class="mini-program-pill__line"></view>
          <view class="mini-program-pill__circle">
            <view class="mini-program-pill__circle-inner"></view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Navigation Tabs -->
  <view class="tab-nav">
    <view
      bindtap="switchScorecardTab"
      data-tab="score"
      class="tab-nav__item {{activeTab === 'score' ? 'tab-nav__item--active' : ''}}"
    >
      <text class="tab-nav__label {{activeTab === 'score' ? 'tab-active' : 'tab-inactive'}}">记分</text>
      <view wx:if="{{activeTab === 'score'}}" class="tab-nav__indicator"></view>
    </view>
    <view bindtap="switchScorecardTab" data-tab="discussion" class="tab-nav__item {{activeTab === 'discussion' ? 'tab-nav__item--active' : ''}}">
      <text class="tab-nav__label {{activeTab === 'discussion' ? 'tab-active' : 'tab-inactive'}}">讨论区</text>
      <view wx:if="{{activeTab === 'discussion'}}" class="tab-nav__indicator"></view>
    </view>
    <view bindtap="switchScorecardTab" data-tab="game" class="tab-nav__item {{activeTab === 'game' ? 'tab-nav__item--active' : ''}}">
      <text class="tab-nav__label {{activeTab === 'game' ? 'tab-active' : 'tab-inactive'}}">游戏</text>
      <view wx:if="{{activeTab === 'game'}}" class="tab-nav__indicator"></view>
    </view>
  </view>

  <!-- Main Content -->
  <view class="score-main">
    <!-- Score Tab Panel -->
    <view wx:if="{{activeTab !== 'discussion'}}" class="score-tab-panel">
      <!-- Course & Game Info：TAB 与 HOLE 之间的可下拉信息栏（轻量 Context Panel 入口） -->
      <view id="course-game-info" class="course-game-info">
        <view class="course-game-info__head score-info-row">
          <view class="score-info-left">
            <view class="course-game-info__accent"></view>
            <text class="course-game-info__course course-name">{{match.course}}</text>
            <view bindtap="toggleGameInfo" class="course-game-info__toggle course-dropdown-btn" aria-label="展开本场信息">
              <text class="course-game-info__chevron {{gameInfoOpen ? 'course-game-info__chevron--open' : ''}}">⌄</text>
            </view>
          </view>
          <view class="score-display-switch">
            <view
              bindtap="setScoreDisplayMode"
              data-value="gross"
              class="score-display-switch__btn {{scoreDisplayMode === 'gross' ? 'score-display-switch__btn--active' : ''}}"
            >总杆</view>
            <view
              bindtap="setScoreDisplayMode"
              data-value="diff"
              class="score-display-switch__btn {{scoreDisplayMode === 'diff' ? 'score-display-switch__btn--active' : ''}}"
            >杆差</view>
          </view>
        </view>
        <!-- Context Panel 已移至 .score-page 根级浮层（position:fixed），不再参与本容器布局流 -->
      </view>

      <!-- Best Ball Roster Strip：fourball_best 演示 + stroke_entity 4+0（team，1–4 人均可）；2+2 pair 名册为空 -->
      <view wx:if="{{(mode === 'fourball_best' || mode === 'stroke_entity') && bestRoster.length}}" class="bestball-roster-strip">
        <view class="bestball-roster-inner">
          <view
            wx:for="{{bestRoster}}"
            wx:key="playerId"
            class="bestball-player-card {{item.groupClass}}"
            style="--tee-color:{{item.teeColor}};"
          >
            <!-- 左：球员区（头像在上、昵称在下，纵向居中） -->
            <view class="bestball-player-id">
              <image class="bestball-player-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
              <text class="bestball-player-name">{{item.name}}</text>
            </view>
            <!-- 右：T台区（独立固定右侧，不参与球员头像/昵称布局） -->
            <view class="bestball-tee-line">
              <view class="bestball-tee-dot"></view>
              <text>{{item.tee}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Scoreboard Table Container -->
      <scroll-view class="scoreboard-scroll" scroll-x scroll-y bindscroll="onScoreboardScroll" style="{{scoreboardStyle}}">
        <view class="scoreboard-inner">
          <!-- thead row 1: Hole labels -->
          <view class="scoreboard-row scoreboard-row--head">
            <view class="scoreboard-cell sticky-col player-col-header">
              <text class="col-head-label">Hole</text>
            </view>
            <view
              wx:for="{{columns}}"
              wx:key="colIdx"
              wx:for-index="ci"
              class="scoreboard-cell scoreboard-cell--head {{item.isSpecial ? 'scoreboard-cell--special-head' : ''}}"
            >
              <view class="hole-label-wrap">
                <view class="hole-label-circle {{item.isSpecial ? 'hole-label-circle--special' : (item.isStartHole ? 'hole-label-circle--start' : 'hole-number')}}">{{item.label}}</view>
              </view>
            </view>
          </view>

          <!-- thead row 2: Par -->
          <view class="scoreboard-row scoreboard-row--par">
            <view class="scoreboard-cell sticky-col">
              <text class="col-par-label">Par</text>
            </view>
            <view
              wx:for="{{columns}}"
              wx:key="colIdx"
              wx:for-index="ci"
              class="scoreboard-cell {{item.isSpecial ? 'scoreboard-cell--special-par' : ''}}"
            >
              <text class="par-val">{{item.par}}</text>
            </view>
          </view>

          <!-- tbody: fourball_best 按组渲染记分行（每组一行）；标准/赛事模式走 wx:else 球员行 -->
          <block wx:if="{{mode === 'fourball_best'}}">
          <view
            wx:for="{{bestTeams}}"
            wx:key="id"
            wx:for-index="gIdx"
            class="scoreboard-row scoreboard-row--player"
          >
            <!-- pair(2人)：四人四球原型并排双头像；single(1人)：个人比杆样式；team(>=3人)：球队样式 -->
            <view class="scoreboard-cell sticky-col player-cell {{item.kind === 'single' ? 'bestball-single-cell' : (item.kind === 'pair' ? 'bestball-pair-cell' : 'bestball-mode-cell')}}">
              <block wx:if="{{item.kind === 'single'}}">
                <view class="player-card">
                  <view class="player-top-line">
                    <image class="player-avatar-img {{item.colorClass}}" src="{{item.avatar}}" mode="aspectFill"></image>
                    <view class="player-diff-wrap">
                      <text class="player-diff-score {{item.teamDiffClass}}">{{item.teamDiffStr}}</text>
                    </view>
                  </view>
                  <text class="player-name-line">{{item.name}}</text>
                </view>
                <view class="player-tee-marker {{item.colorClass}}"></view>
              </block>
              <block wx:elif="{{item.kind === 'pair'}}">
                <view class="player-cell-content">
                  <view class="paired-avatars">
                    <view class="pair-avatar-group">
                      <view wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="avatar-with-diff" style="left:{{pm.left}};transform:{{pm.tf}};">
                        <image class="player-avatar-img" src="{{pm.avatar}}" mode="aspectFill" style="border-color:{{pm.teeColor}};"></image>
                      </view>
                    </view>
                    <view class="player-diff-wrap">
                      <text class="player-diff-score {{item.teamDiffClass}}">{{item.teamDiffStr}}</text>
                    </view>
                  </view>
                  <view class="paired-names">
                    <text wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="player-name-line" style="left:{{pm.left}};transform:{{pm.tf}};">{{pm.name}}</text>
                  </view>
                </view>
                <view class="tee-marker-strip-right">
                  <view wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="tee-half" style="background:{{pm.teeColor}};"></view>
                </view>
              </block>
              <block wx:else>
                <view class="bestball-mode-layout">
                  <view class="bestball-mode-wrap">
                    <text class="bestball-mode-kicker">TEAM SCORE</text>
                    <text class="bestball-mode-main">{{item.label}}</text>
                  </view>
                  <view class="player-diff-wrap bestball-mode-diff">
                    <text class="player-diff-score {{item.teamDiffClass}}">{{item.teamDiffStr}}</text>
                  </view>
                </view>
              </block>
            </view>

            <view
              wx:for="{{item.columns}}"
              wx:for-item="col"
              wx:key="colIdx"
              wx:for-index="cIdx"
              bindtap="onScoreCellTap"
              data-player-idx="{{gIdx}}"
              data-col-idx="{{cIdx}}"
              class="scoreboard-cell score-cell {{col.isSpecial ? 'scoreboard-cell--special-cell' : ''}}"
            >
              <block wx:if="{{col.isSpecial}}">
                <view class="special-cell-inner">
                  <text class="special-cell-val {{col.isTot ? 'special-cell-val--tot tot-value' : ''}}">{{col.score}}</text>
                  <view class="special-cell-meta">
                    <text class="special-cell-putt">{{col.putts}}</text>
                    <text class="special-cell-diff {{col.diffClass}}">{{col.diffStr}}</text>
                  </view>
                </view>
              </block>

              <block wx:else>
                <view class="hole-cell-inner">
                  <view class="{{col.scoreClass}}">
                    <text class="hole-cell-score {{scoreDisplayMode === 'diff' ? 'hole-cell-score--diff' : ''}}">{{col.mainStr}}</text>
                  </view>
                  <view class="hole-cell-meta">
                    <text class="hole-cell-putt">{{col.putts}}</text>
                    <text class="hole-cell-diff {{col.diffClass}}">{{col.diffStr}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
          </block>

          <!-- tbody: stroke_entity；第一列复用 fourball single/pair/team；洞格仍走 onEntityScoreCellTap -->
          <block wx:elif="{{mode === 'stroke_entity'}}">
          <view
            wx:for="{{entitiesView}}"
            wx:key="entityId"
            wx:for-index="eIdx"
            class="scoreboard-row scoreboard-row--player entity-row"
          >
            <view class="scoreboard-cell sticky-col player-cell {{item.kind === 'single' ? 'bestball-single-cell' : (item.kind === 'pair' ? 'bestball-pair-cell' : 'bestball-mode-cell')}}">
              <block wx:if="{{item.kind === 'single'}}">
                <view class="player-card">
                  <view class="player-top-line">
                    <image class="player-avatar-img {{item.colorClass}}" src="{{item.avatar}}" mode="aspectFill"></image>
                    <view class="player-diff-wrap">
                      <text class="player-diff-score {{item.teamDiffClass}}">{{item.teamDiffStr}}</text>
                    </view>
                  </view>
                  <text class="player-name-line">{{item.name}}</text>
                </view>
                <view class="player-tee-marker {{item.colorClass}}"></view>
              </block>
              <block wx:elif="{{item.kind === 'pair'}}">
                <view class="player-cell-content">
                  <view class="paired-avatars">
                    <view class="pair-avatar-group">
                      <view wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="avatar-with-diff" style="left:{{pm.left}};transform:{{pm.tf}};">
                        <image class="player-avatar-img" src="{{pm.avatar}}" mode="aspectFill" style="border-color:{{pm.teeColor}};"></image>
                      </view>
                    </view>
                    <view class="player-diff-wrap">
                      <text class="player-diff-score {{item.teamDiffClass}}">{{item.teamDiffStr}}</text>
                    </view>
                  </view>
                  <view class="paired-names">
                    <text wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="player-name-line" style="left:{{pm.left}};transform:{{pm.tf}};">{{pm.name}}</text>
                  </view>
                </view>
                <view class="tee-marker-strip-right">
                  <view wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="tee-half" style="background:{{pm.teeColor}};"></view>
                </view>
              </block>
              <block wx:else>
                <!-- team（G2/G3 4+0）：与 fourball_best「四人最佳球位挑战-18」同构 — sticky 仅 TEAM SCORE；头像在 bestRoster 名册条 -->
                <view class="bestball-mode-layout">
                  <view class="bestball-mode-wrap">
                    <text class="bestball-mode-kicker">TEAM SCORE</text>
                    <text class="bestball-mode-main">{{item.label}}</text>
                  </view>
                  <view class="player-diff-wrap bestball-mode-diff">
                    <text class="player-diff-score {{item.teamDiffClass}}">{{item.teamDiffStr}}</text>
                  </view>
                </view>
              </block>
            </view>

            <view
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="colIdx"
              wx:for-index="cIdx"
              bindtap="onEntityScoreCellTap"
              data-entity-index="{{eIdx}}"
              data-hole-index="{{cell.holeIndex}}"
              class="scoreboard-cell score-cell entity-score-cell {{cell.type === 'special' ? 'scoreboard-cell--special-cell' : ''}}"
            >
              <block wx:if="{{cell.type === 'special'}}">
                <view class="special-cell-inner">
                  <text class="special-cell-val {{cell.isTot ? 'special-cell-val--tot tot-value' : ''}}">{{cell.val}}</text>
                  <view class="special-cell-meta">
                    <text class="special-cell-putt">{{cell.puttTotal}}</text>
                    <text class="special-cell-diff {{cell.diffClass}}">{{cell.diffStr}}</text>
                  </view>
                </view>
              </block>

              <block wx:else>
                <view class="hole-cell-inner">
                  <view class="{{cell.scoreClass}}">
                    <text class="hole-cell-score {{scoreDisplayMode === 'diff' ? 'hole-cell-score--diff' : ''}} {{!cell.mainStr && cell.displayHint ? 'hole-cell-score--hint' : ''}}">{{cell.mainStr || cell.displayHint}}</text>
                  </view>
                  <view class="hole-cell-meta">
                    <text class="hole-cell-putt">{{cell.putts}}</text>
                    <text class="hole-cell-diff {{cell.diffClass}}">{{cell.diffStr}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
          </block>

          <!-- 比洞：成绩主体 = matchSidesView（Side A / status / Side B）；不读 entity -->
          <block wx:elif="{{isG5MatchPlay && matchSidesView.length}}">
          <block
            wx:for="{{matchSidesView}}"
            wx:key="sideId"
            wx:for-index="sIdx"
          >
          <view class="scoreboard-row scoreboard-row--player match-side-row">
            <view class="scoreboard-cell sticky-col player-cell {{item.kind === 'pair' ? 'bestball-pair-cell' : ''}}">
              <block wx:if="{{item.kind === 'single'}}">
                <view class="player-card">
                  <view class="player-top-line">
                    <image class="player-avatar-img {{item.colorClass}}" src="{{item.avatar}}" mode="aspectFill"></image>
                    <view class="player-diff-wrap">
                      <text class="player-diff-score {{item.relClass}}">{{item.relScoreStr}}</text>
                    </view>
                  </view>
                  <text class="player-name-line">{{item.name}}</text>
                </view>
                <view class="player-tee-marker {{item.colorClass}}"></view>
              </block>
              <block wx:else>
                <view class="player-cell-content">
                  <view class="paired-avatars">
                    <view class="pair-avatar-group">
                      <view wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="avatar-with-diff" style="left:{{pm.left}};transform:{{pm.tf}};">
                        <image class="player-avatar-img" src="{{pm.avatar}}" mode="aspectFill" style="border-color:{{pm.teeColor}};"></image>
                      </view>
                    </view>
                    <view class="player-diff-wrap">
                      <text class="player-diff-score {{item.relClass}}">{{item.relScoreStr}}</text>
                    </view>
                  </view>
                  <view class="paired-names">
                    <text wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="player-name-line" style="left:{{pm.left}};transform:{{pm.tf}};">{{pm.name}}</text>
                  </view>
                </view>
                <view class="tee-marker-strip-right">
                  <view wx:for="{{item.pairMembers}}" wx:for-item="pm" wx:key="name" class="tee-half" style="background:{{pm.teeColor}};"></view>
                </view>
              </block>
            </view>

            <view
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="colIdx"
              wx:for-index="cIdx"
              bindtap="onMatchSideScoreCellTap"
              data-side-idx="{{sIdx}}"
              data-col-idx="{{cIdx}}"
              class="scoreboard-cell score-cell {{cell.type === 'special' ? 'scoreboard-cell--special-cell' : ''}}"
            >
              <block wx:if="{{cell.type === 'special'}}">
                <view class="special-cell-inner">
                  <text class="special-cell-val {{cell.isTot ? 'special-cell-val--tot tot-value' : ''}}">{{cell.val}}</text>
                  <view class="special-cell-meta">
                    <text class="special-cell-putt">{{cell.puttTotal}}</text>
                    <text class="special-cell-diff {{cell.diffClass}}">{{cell.diffStr}}</text>
                  </view>
                </view>
              </block>

              <block wx:else>
                <view class="hole-cell-inner">
                  <view class="{{cell.scoreClass}}">
                    <text class="hole-cell-score {{scoreDisplayMode === 'diff' ? 'hole-cell-score--diff' : ''}} {{!cell.mainStr && cell.displayHint ? 'hole-cell-score--hint' : ''}}">{{cell.mainStr || cell.displayHint}}</text>
                  </view>
                  <view class="hole-cell-meta">
                    <text class="hole-cell-putt">{{cell.putts}}</text>
                    <text class="hole-cell-diff {{cell.diffClass}}">{{cell.diffStr}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>

          <!-- Side A / B 胜洞走势：文案 TIED·nUP·nDN；色同详情得分榜红蓝 -->
          <view
            wx:if="{{sIdx === 0}}"
            class="scoreboard-row match-status-row"
          >
            <view class="scoreboard-cell sticky-col match-status-sticky">
              <view class="match-label-wrap">
                <text class="match-label-kicker">MATCH</text>
                <text class="match-label-main">胜洞走势</text>
              </view>
            </view>
            <view
              wx:for="{{matchStatusView.rowCells}}"
              wx:for-item="msCell"
              wx:key="colIdx"
              class="scoreboard-cell match-status-cell {{msCell.isSpecial || msCell.isTot ? 'scoreboard-cell--special-cell' : ''}} {{msCell.isTot || msCell.showFinal ? 'match-status-cell--tot match-status-summary' : ''}}"
            >
              <view wx:if="{{msCell.showWinA}}" class="match-win-line match-win-line--a"></view>
              <view wx:if="{{msCell.showWinB}}" class="match-win-line match-win-line--b"></view>
              <view class="match-cell-inner">
                <text wx:if="{{msCell.isTot || msCell.showFinal}}" class="match-summary-label">FINAL</text>
                <text wx:if="{{msCell.isTot || msCell.showFinal}}" class="match-cumulative {{msCell.leadClass || matchStatusView.currentLeadClass}}">{{msCell.text || matchStatusView.currentLabel}}</text>
                <text wx:elif="{{msCell.showStanding}}" class="match-cumulative {{msCell.leadClass}}">{{msCell.standingText}}</text>
              </view>
            </view>
          </view>
          </block>
          </block>

          <block wx:else>
          <block
            wx:for="{{playersView}}"
            wx:key="id"
            wx:for-index="pIdx"
          >
          <view class="scoreboard-row scoreboard-row--player">
            <view class="scoreboard-cell sticky-col player-cell">
              <view class="player-card">
                <view class="player-top-line">
                  <image class="player-avatar-img {{item.colorClass}}" src="{{item.avatar}}" mode="aspectFill"></image>
                  <view class="player-diff-wrap">
                    <text class="player-diff-score {{item.relClass}}">{{item.relScoreStr}}</text>
                  </view>
                </view>
                <text class="player-name-line">{{item.name}}</text>
              </view>
              <view class="player-tee-marker {{item.colorClass}}"></view>
            </view>

            <view
              wx:for="{{item.cells}}"
              wx:for-item="cell"
              wx:key="colIdx"
              wx:for-index="cIdx"
              bindtap="onScoreCellTap"
              data-player-idx="{{pIdx}}"
              data-col-idx="{{cIdx}}"
              class="scoreboard-cell score-cell {{cell.type === 'special' ? 'scoreboard-cell--special-cell' : ''}}"
            >
              <!-- 红/蓝三角：赌球视觉测试，普通记分（含 G1）暂不展示；JS 字段保留供未来游戏功能 -->

              <block wx:if="{{cell.type === 'special'}}">
                <view class="special-cell-inner">
                  <text class="special-cell-val {{cell.isTot ? 'special-cell-val--tot tot-value' : ''}}">{{cell.val}}</text>
                  <view class="special-cell-meta">
                    <text class="special-cell-putt">{{cell.puttTotal}}</text>
                    <text class="special-cell-diff {{cell.diffClass}}">{{cell.diffStr}}</text>
                  </view>
                </view>
              </block>

              <block wx:else>
                <view class="hole-cell-inner">
                  <view class="{{cell.scoreClass}}">
                    <text class="hole-cell-score {{scoreDisplayMode === 'diff' ? 'hole-cell-score--diff' : ''}} {{!cell.mainStr && cell.displayHint ? 'hole-cell-score--hint' : ''}}">{{cell.mainStr || cell.displayHint}}</text>
                  </view>
                  <view class="hole-cell-meta">
                    <text class="hole-cell-putt">{{cell.putts}}</text>
                    <text class="hole-cell-diff {{cell.diffClass}}">{{cell.diffStr}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>
          </block>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- Discussion Tab Panel -->
    <!-- 讨论区：复用全局唯一 Discussion Chat System 组件（围观行 + 聊天流 + emoji + 输入栏，禁止本页单独实现） -->
    <view wx:if="{{activeTab === 'discussion'}}" id="discussion-tab-panel" class="score-discussion-panel">
      <discussion
        watchers="{{watchers}}"
        messages="{{chatMessages}}"
        theme="{{themeClass === 'dark-mode' ? 'dark' : 'bright'}}"
        fontScale="{{fontScale}}"
      ></discussion>
    </view>
  </view>

  <!-- Floating Actions -->
  <view wx:if="{{activeTab !== 'discussion'}}" id="score-actions" class="score-actions">
    <view
      bindtap="openGroupManagePage"
      data-disabled="{{addDeleteDisabled}}"
      id="quick-score-btn"
      class="score-actions__primary {{addDeleteDisabled ? 'is-disabled' : ''}}"
    >添加/删除</view>
    <view bindtap="toggleSheet" class="score-actions__secondary">更多功能</view>
  </view>

  <!-- More Menu Bottom Sheet（视觉与中间页 M 按钮功能面板一致） -->
  <view wx:if="{{showMoreSheet}}" bindtap="toggleSheet" class="sheet-overlay"></view>
  <view wx:if="{{showMoreSheet}}" class="bottom-sheet bottom-sheet--more-menu" catchtap="noop">
    <view class="sheet-top-accent"></view>
    <view class="sheet-handle"></view>
    <view class="feature-section feature-section--menu">
      <view class="feature-section-title">
        <text class="fst-main">更多功能</text>
        <text class="fst-sub">本组记分</text>
      </view>
      <view class="feature-grid">
        <block wx:for="{{moreMenuItems}}" wx:key="label">
          <view wx:if="{{item.empty}}" class="feature-item feature-item--empty"></view>
          <view
            wx:else
            bindtap="onMoreMenuTap"
            data-label="{{item.label}}"
            data-action="{{item.action}}"
            data-disabled="{{item.disabled}}"
            class="feature-item {{item.disabled ? 'is-disabled' : ''}}"
          >
            <view class="feature-icon {{item.bg === 'bg-red' ? 'danger' : (item.bg === 'bg-gold' ? 'warning' : '')}}"><text>{{item.icon}}</text></view>
            <text class="feature-label">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
    <view class="sheet-cancel-wrap">
      <view bindtap="toggleSheet" class="sheet-cancel-btn">取 消</view>
    </view>
  </view>

  <!-- Score Input Sheet -->
  <view wx:if="{{showScoreSheet}}" id="score-input-sheet" class="score-input-sheet {{scorePanelMode === 'quick' ? 'quick-mode' : ''}} {{isReadOnlyScore ? 'is-readonly' : ''}}">
    <view class="score-input-sheet__mask" bindtap="closeScoreInput"></view>
    <view class="score-input-sheet__panel {{scoreSheetOpen ? 'score-input-sheet__panel--open' : ''}}">
      <view class="score-input-sheet__handle"></view>

      <view class="panel-mode-switch">
        <view
          bindtap="switchScorePanelMode"
          data-mode="tech"
          class="panel-mode-btn {{scorePanelMode === 'tech' ? 'panel-mode-btn--active' : ''}}"
        >技术面板</view>
        <view
          bindtap="switchScorePanelMode"
          data-mode="quick"
          class="panel-mode-btn {{scorePanelMode === 'quick' ? 'panel-mode-btn--active' : ''}}"
        >快捷面板</view>
      </view>

      <view class="sheet-hole-nav">
        <view bindtap="sheetPrevHole" class="sheet-hole-nav__btn">‹</view>
        <view class="sheet-hole-nav__center">
          <view class="sheet-hole-label">{{sheetHoleLabel}}</view>
          <view class="sheet-hole-meta">
            <view class="sheet-hole-meta__item"><text>PAR</text><text class="sheet-hole-meta__val">{{sheetPar}}</text></view>
            <view class="sheet-hole-meta__item"><text>YARDS</text><text class="sheet-hole-meta__val sheet-hole-meta__val--light">{{sheetYards}}</text></view>
          </view>
        </view>
        <view bindtap="sheetNextHole" class="sheet-hole-nav__btn">›</view>
      </view>

      <view class="score-sheet-layout">
        <view class="sheet-player-list">
          <view
            wx:for="{{sheetPlayers}}"
            wx:key="id"
            wx:for-index="sIdx"
            bindtap="onSheetPlayerTap"
            data-idx="{{sIdx}}"
            class="sheet-player-item {{scorePanelMode === 'tech' && item.active ? 'sheet-player-item--active' : 'sheet-player-item--inactive'}}"
          >
            <view class="sheet-player-avatar-wrap">
              <image class="sheet-player-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
              <text class="sheet-player-name">{{item.name}}</text>
            </view>
            <view class="sheet-hole-score {{item.isDraftScore ? 'sheet-hole-score--draft' : ''}} {{(!item.holeScore && item.holeScore !== 0) ? 'sheet-hole-score--empty' : ''}}">{{item.holeScore}}</view>
          </view>
        </view>

        <view wx:if="{{scorePanelMode === 'tech'}}" class="sheet-main-panel tech-score-panel {{techPanelFocusPulse ? 'tech-score-panel--focus-pulse' : ''}} {{isReadOnlyScore ? 'is-disabled' : ''}}">
          <view class="sheet-control-row">
            <text class="sheet-control-label">成绩</text>
            <view class="stepper-btn">
              <view bindtap="adjustSheetVal" data-type="score" data-delta="-1" class="control-icon control-icon--minus {{isReadOnlyScore ? 'is-disabled' : ''}}">−</view>
              <text class="stepper-val">{{panelMainDisplay}}</text>
              <view bindtap="adjustSheetVal" data-type="score" data-delta="1" class="control-icon control-icon--plus {{isReadOnlyScore ? 'is-disabled' : ''}}">+</view>
            </view>
          </view>
          <view class="sheet-control-row">
            <text class="sheet-control-label">推杆</text>
            <view class="stepper-btn">
              <view bindtap="adjustSheetVal" data-type="putt" data-delta="-1" class="control-icon control-icon--minus {{isReadOnlyScore ? 'is-disabled' : ''}}">−</view>
              <text class="stepper-val">{{panelPutt}}</text>
              <view bindtap="adjustSheetVal" data-type="putt" data-delta="1" class="control-icon control-icon--plus {{isReadOnlyScore ? 'is-disabled' : ''}}">+</view>
            </view>
          </view>
          <view class="sheet-control-row">
            <text class="sheet-control-label">罚杆</text>
            <view class="stepper-btn">
              <view bindtap="adjustSheetVal" data-type="penalty" data-delta="-1" class="control-icon control-icon--minus {{isReadOnlyScore ? 'is-disabled' : ''}}">−</view>
              <text class="stepper-val">{{panelPenalty}}</text>
              <view bindtap="adjustSheetVal" data-type="penalty" data-delta="1" class="control-icon control-icon--plus {{isReadOnlyScore ? 'is-disabled' : ''}}">+</view>
            </view>
          </view>
          <view class="sheet-control-row">
            <text class="sheet-control-label">沙坑</text>
            <view class="stepper-btn">
              <view bindtap="adjustSheetVal" data-type="bunker" data-delta="-1" class="control-icon control-icon--minus {{isReadOnlyScore ? 'is-disabled' : ''}}">−</view>
              <text class="stepper-val">{{panelBunker}}</text>
              <view bindtap="adjustSheetVal" data-type="bunker" data-delta="1" class="control-icon control-icon--plus {{isReadOnlyScore ? 'is-disabled' : ''}}">+</view>
            </view>
          </view>
          <view class="direction-row {{isReadOnlyScore ? 'is-disabled' : ''}}">
            <view class="direction-btn" bindtap="selectPanelFairway" data-value="fairway">
              <view class="direction-circle {{panelFairway === 'fairway' ? 'direction-circle--active' : ''}}">◎</view>
              <text class="direction-label {{panelFairway === 'fairway' ? 'direction-label--gold' : ''}}">Fairway</text>
            </view>
            <view class="direction-btn" bindtap="selectPanelFairway" data-value="left">
              <view class="direction-circle {{panelFairway === 'left' ? 'direction-circle--active' : ''}}">←</view>
              <text class="direction-label {{panelFairway === 'left' ? 'direction-label--gold' : ''}}">Left</text>
            </view>
            <view class="direction-btn" bindtap="selectPanelFairway" data-value="right">
              <view class="direction-circle {{panelFairway === 'right' ? 'direction-circle--active' : ''}}">→</view>
              <text class="direction-label {{panelFairway === 'right' ? 'direction-label--gold' : ''}}">Right</text>
            </view>
          </view>
        </view>

        <view wx:if="{{scorePanelMode === 'quick'}}" class="sheet-main-panel quick-score-panel {{isReadOnlyScore ? 'is-disabled' : ''}}">
          <view class="quick-score-control-list">
            <view wx:for="{{quickPanelDisplay}}" wx:key="*this" wx:for-index="qIdx" class="quick-score-control-row">
              <view class="quick-score-control">
                <view bindtap="adjustQuickPanelScore" data-idx="{{qIdx}}" data-delta="-1" class="quick-score-control-btn {{isReadOnlyScore ? 'is-disabled' : ''}}">−</view>
                <text class="quick-score-control-value">{{item}}</text>
                <view bindtap="adjustQuickPanelScore" data-idx="{{qIdx}}" data-delta="1" class="quick-score-control-btn {{isReadOnlyScore ? 'is-disabled' : ''}}">+</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="sheet-footer-btns">
        <view bindtap="clearScoreInput" class="sheet-footer-btn sheet-footer-btn--clear {{isReadOnlyScore ? 'is-disabled' : ''}}">清除</view>
        <view bindtap="confirmScoreInput" class="sheet-footer-btn sheet-footer-btn--confirm {{isReadOnlyScore ? 'is-disabled' : ''}}">确认</view>
      </view>
    </view>
  </view>

  <!-- Group Manage Page -->
  <view wx:if="{{showGroupManage}}" id="group-manage-page" class="group-manage-page">
    <view class="gb-header" style="{{headerRootStyle}}">
      <view class="gb-header__inner" style="{{headerBarStyle}}">
        <view class="gb-header__left">
          <view bindtap="closeGroupManagePage" class="gb-header__back" aria-label="返回">
            <text class="gb-header__chevron">‹</text>
          </view>
          <view>
            <text class="gb-header__eyebrow">SCORECARD</text>
            <text class="gb-header__title">添加/删除</text>
          </view>
        </view>
        <view class="gb-header__right">
          <view class="mini-program-pill">
            <view class="mini-program-pill__dots">
              <view class="mini-program-pill__dot"></view>
              <view class="mini-program-pill__dot"></view>
              <view class="mini-program-pill__dot"></view>
            </view>
            <view class="mini-program-pill__line"></view>
            <view class="mini-program-pill__circle">
              <view class="mini-program-pill__circle-inner"></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <scroll-view class="group-manage-content" scroll-y>
      <view class="section-card">
        <view class="section-head">
          <view>
            <text class="section-title">本组球员</text>
            <text class="section-desc">点击头像右上角可移出本组</text>
          </view>
          <text class="section-count">{{playerCount}}/4</text>
        </view>
        <view class="players-strip fixed-slots">
          <view wx:for="{{groupSlots}}" wx:key="slotId" wx:for-index="slotIdx" class="player-item fixed-slot {{item.status !== 'occupied' ? 'empty-slot' : ''}}">
            <text class="slot-index">{{item.slotId}}</text>
            <view class="avatar-wrap">
              <block wx:if="{{item.status === 'occupied'}}">
                <image src="{{item.player.avatar}}" mode="aspectFill"></image>
                <view catchtap="removeGroupSlot" data-index="{{slotIdx}}" class="delete-dot">×</view>
              </block>
              <block wx:elif="{{item.status === 'pending'}}">
                <view bindtap="onEmptySlotTap" data-index="{{slotIdx}}" class="empty-avatar empty-avatar--pending">…</view>
              </block>
              <block wx:else>
                <view bindtap="onEmptySlotTap" data-index="{{slotIdx}}" class="empty-avatar {{item.hasCache ? 'empty-avatar--cache' : ''}}">＋</view>
                <view wx:if="{{item.hasCache}}" class="slot-cache-badge">↻</view>
              </block>
            </view>
            <text class="player-name">{{item.status === 'occupied' ? item.player.name : (item.status === 'pending' ? '待加入' : (item.hasCache ? '有历史成绩' : '空位'))}}</text>
            <text wx:if="{{item.status === 'occupied' && item.player.teamLabel}}" class="group-manage-team-label">[{{item.player.teamLabel}}]</text>
          </view>
        </view>
      </view>

      <view class="section-card qr-card">
        <text class="qr-title">扫码加入本组</text>
        <text class="qr-subtitle">现场球友扫描二维码后，可申请加入当前记分组。</text>
        <view class="qr-box">
          <image class="qr-image" src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=GolfBrothersGroupJoin&color=000&bgcolor=fff" mode="aspectFit"></image>
        </view>
        <text class="share-note">长按二维码可保存或转发</text>
      </view>
    </scroll-view>

    <!-- 固定底部操作栏：取消 / 确认（空位点击为唯一添加入口） -->
    <view class="group-manage-footer">
      <view class="group-actions">
        <view bindtap="onCancelGroupManage" class="group-action-btn group-action-btn--cancel">取消</view>
        <view bindtap="_onConfirmGroupManage" class="group-action-btn group-action-btn--confirm">确认</view>
      </view>
    </view>

    <!-- 点击空位：人员来源选择（仅添加/删除流程内弹层；包装层抬高至底栏之上） -->
    <view class="group-manage-source-sheet">
      <player-source-sheet
        visible="{{addSheetVisible}}"
        theme-class="{{themeClass}}"
        overline="ADD PLAYER"
        title="选择添加方式"
        options="{{playerSourceOptions}}"
        bind:close="closeAddSheet"
        bind:select="onPlayerSourceSelect"
      />
    </view>

    <!-- 报名列表 / 球队列表：本页二级人员选择，不改 Slot 绑定流程 -->
    <view wx:if="{{playerSourceListVisible}}" class="manual-sheet-mask" bindtap="closePlayerSourceListSheet"></view>
    <view wx:if="{{playerSourceListVisible}}" class="player-source-list-sheet {{themeClass}}" catchtap="noop">
      <view class="manual-sheet__handle"></view>
      <view class="manual-sheet__header">
        <view>
          <text class="manual-sheet__overline">{{playerSourceListOverline}}</text>
          <text class="manual-sheet__title">{{playerSourceListTitle}}</text>
        </view>
        <view class="manual-sheet__close" bindtap="closePlayerSourceListSheet"><text>×</text></view>
      </view>

      <scroll-view scroll-y class="player-source-list">
        <view wx:if="{{!playerSourceListItems.length}}" class="player-source-list__empty">{{playerSourceListEmptyText}}</view>
        <view
          wx:for="{{playerSourceListItems}}"
          wx:key="id"
          wx:for-index="sourceIdx"
          class="player-source-list__item"
          data-index="{{sourceIdx}}"
          bindtap="onPlayerSourceListItemTap"
        >
          <image class="player-source-list__avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="player-source-list__main">
            <text class="player-source-list__title">{{item.title}}</text>
            <text class="player-source-list__subtitle">{{item.subtitle}}</text>
          </view>
          <text class="player-source-list__action">添加</text>
        </view>
      </scroll-view>

      <view class="manual-sheet__footer">
        <view class="manual-sheet__btn manual-sheet__btn--cancel" bindtap="closePlayerSourceListSheet">取消</view>
      </view>
    </view>

    <!-- 手工添加：底部弹窗（姓名/手机/性别），不跳转独立页 -->
    <view wx:if="{{manualSheetVisible}}" class="manual-sheet-mask" bindtap="closeManualSheet"></view>
    <view wx:if="{{manualSheetVisible}}" class="manual-sheet {{themeClass}}" catchtap="noop">
      <view class="manual-sheet__handle"></view>
      <view class="manual-sheet__header">
        <view>
          <text class="manual-sheet__overline">Add Player</text>
          <text class="manual-sheet__title">添加人员</text>
        </view>
        <view class="manual-sheet__close" bindtap="closeManualSheet"><text>×</text></view>
      </view>

      <view class="manual-sheet__body">
        <view class="manual-field">
          <text class="manual-field__label">选手姓名（必填）</text>
          <input
            class="manual-field__input"
            type="text"
            maxlength="20"
            placeholder="请输入选手姓名"
            placeholder-class="manual-field__placeholder"
            value="{{manualName}}"
            bindinput="onManualNameInput"
          />
        </view>
        <view class="manual-field">
          <text class="manual-field__label">手机号码（选填）</text>
          <input
            class="manual-field__input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号码"
            placeholder-class="manual-field__placeholder"
            value="{{manualPhone}}"
            bindinput="onManualPhoneInput"
          />
        </view>
        <view class="manual-field">
          <text class="manual-field__label">性别</text>
          <view class="manual-gender">
            <view
              class="manual-gender__tag {{manualGender === 'male' ? 'is-active' : ''}}"
              data-gender="male"
              bindtap="onManualGenderSelect"
            >男</view>
            <view
              class="manual-gender__tag {{manualGender === 'female' ? 'is-active' : ''}}"
              data-gender="female"
              bindtap="onManualGenderSelect"
            >女</view>
          </view>
        </view>
      </view>

      <view class="manual-sheet__footer">
        <view class="manual-sheet__btn manual-sheet__btn--cancel" bindtap="closeManualSheet">取消</view>
        <view class="manual-sheet__btn manual-sheet__btn--confirm" bindtap="confirmManualSheet">确定</view>
      </view>
    </view>

    <!-- 加入比赛：未加入本场的好友需先选择所属分队，再加入空位 -->
    <view wx:if="{{joinMatchTeamSheetVisible}}" class="manual-sheet-mask" bindtap="closeJoinMatchTeamSheet"></view>
    <view wx:if="{{joinMatchTeamSheetVisible}}" class="join-match-sheet {{themeClass}}" catchtap="noop">
      <view class="manual-sheet__handle"></view>
      <view class="manual-sheet__header">
        <view>
          <text class="manual-sheet__overline">JOIN MATCH</text>
          <text class="manual-sheet__title">选择所属分队</text>
        </view>
        <view class="manual-sheet__close" bindtap="closeJoinMatchTeamSheet"><text>×</text></view>
      </view>
      <view class="join-match-sheet__body">
        <text class="join-match-sheet__desc">{{joinMatchPlayerName}}尚未加入本场比赛，请先选择所属分队。</text>
        <view class="join-match-team-list">
          <view
            wx:for="{{joinMatchTeamOptions}}"
            wx:key="id"
            class="join-match-team-item"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            bindtap="onJoinMatchTeamSelect"
          >
            <text class="join-match-team-name">{{item.name}}</text>
            <text class="join-match-team-action">选择</text>
          </view>
        </view>
      </view>
      <view class="manual-sheet__footer">
        <view class="manual-sheet__btn manual-sheet__btn--cancel" bindtap="closeJoinMatchTeamSheet">取消</view>
      </view>
    </view>
  </view>

  <!-- 信息继承型展开面板（Context Panel）：根级 fixed 浮层，与记分表完全解耦，不挤压 TAB / HOLE / score grid -->
  <view wx:if="{{gameInfoOpen}}" class="game-info-mask" bindtap="closeGameInfo"></view>
  <scroll-view
    wx:if="{{gameInfoOpen}}"
    scroll-y
    class="game-info-panel game-context-panel"
    style="top:{{gameInfoTop}}px;max-height:{{gameInfoMaxH}}px;"
    catchtap="noop"
  >

    <!-- 轻量 Context Panel：单列纯文本 label+value，仅 5 项基础赛事信息（球场含半场 / 比赛名称 / 赛制 / 开球时间 / 天气），
         数据全部继承自 createGame（+ 第三方天气）。严禁球场分段 / 头像 / 球员 / group / score / leaderboard / 运行时状态。
         私密比赛额外追加只读「围观密码」（复用创建密码）。 -->
    <view class="gc-list">
      <view class="gc-item"><text class="gc-item-label">球场</text><text class="gc-item-value">{{gameContext.courseFull || match.course || '—'}}</text></view>
      <view class="gc-item"><text class="gc-item-label">比赛名称</text><text class="gc-item-value">{{gameContext.title || match.name || '—'}}</text></view>
      <view class="gc-item"><text class="gc-item-label">赛制</text><text class="gc-item-value">{{gameContext.format || match.format || '—'}}</text></view>
      <view class="gc-item"><text class="gc-item-label">开球时间</text><text class="gc-item-value">{{gameContext.teeTime || match.teeTime || '未设置'}}</text></view>
      <!-- 第5项：天气（第三方实时，单行纯文本，无卡片/无图标网格） -->
      <view class="gc-item {{gameContext.isPrivate ? '' : 'gc-item--last'}}"><text class="gc-item-label">天气</text><text class="gc-item-value">{{gameContext.weather.line || '—'}}</text></view>
      <!-- 私密追加项：围观密码（仅私密比赛显示，密码复用 createGame.accessCode，不重新生成） -->
      <view wx:if="{{gameContext.isPrivate}}" class="gc-item gc-item--last">
        <text class="gc-item-label">围观密码</text>
        <view class="gc-code-wrap">
          <text class="gc-item-value gc-code-value">{{gameContext.accessCode || '—'}}</text>
          <view wx:if="{{gameContext.accessCode}}" class="gc-copy-btn" catchtap="copyAccessCode">复制</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <half-course-sheet
    visible="{{halfSheetVisible}}"
    game-id="{{gameId}}"
    mode="{{mode}}"
    theme-class="{{themeClass}}"
    bind:close="closeHalfSheet"
    bind:confirm="onHalfCourseConfirmed"
  />

  <!-- 修改T台（第一阶段：仅 UI / 本地选中，不写盘） -->
  <view wx:if="{{editTeeSheetVisible}}" class="sheet-overlay" bindtap="closeEditTeeSheet"></view>
  <view wx:if="{{editTeeSheetVisible}}" class="bottom-sheet edit-tee-sheet" catchtap="noop">
    <view class="sheet-top-accent"></view>
    <view class="sheet-handle"></view>
    <view class="feature-section-title edit-tee-sheet__title">
      <text class="fst-main">修改T台</text>
      <text class="fst-sub">黑 · 金 · 蓝 · 白 · 红</text>
    </view>
    <scroll-view scroll-y class="edit-tee-sheet__list" enable-flex="{{true}}">
      <view
        wx:for="{{editTeePlayers}}"
        wx:key="playerId"
        class="edit-tee-row"
      >
        <view class="edit-tee-row__player">
          <image class="edit-tee-row__avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <text class="edit-tee-row__name">{{item.name}}</text>
        </view>
        <view class="edit-tee-row__dots">
          <view
            wx:for="{{item.teeDots}}"
            wx:for-item="dot"
            wx:for-index="dotIdx"
            wx:key="key"
            class="edit-tee-dot-hit"
            data-player-id="{{item.playerId}}"
            data-tee-key="{{dot.key}}"
            bindtap="onEditTeeDotTap"
          >
            <view
              class="edit-tee-dot {{dot.selected ? 'edit-tee-dot--selected' : ''}} {{dot.key === 'WHITE_T' ? 'edit-tee-dot--white' : ''}} {{dot.key === 'BLACK_T' ? 'edit-tee-dot--black' : ''}}"
              style="background: {{dot.color}};"
            ></view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="edit-tee-sheet__footer">
      <view class="sheet-cancel-btn edit-tee-sheet__btn-cancel" bindtap="closeEditTeeSheet">取消</view>
      <view class="sheet-cancel-btn edit-tee-sheet__btn-confirm" bindtap="confirmEditTeeSheet">确认</view>
    </view>
  </view>

  <!-- G5–G8：修改起始洞（1–18），写入 matchPlayMeta.source=manual -->
  <view wx:if="{{startHoleSheetVisible}}" class="sheet-overlay" bindtap="closeStartHoleSheet"></view>
  <view wx:if="{{startHoleSheetVisible}}" class="bottom-sheet start-hole-sheet" catchtap="noop">
    <view class="sheet-top-accent"></view>
    <view class="sheet-handle"></view>
    <view class="feature-section-title start-hole-sheet__title">
      <text class="fst-main">修改起始洞</text>
      <text class="fst-sub">胜洞从所选洞起累计</text>
    </view>
    <view class="start-hole-grid">
      <view
        wx:for="{{startHoleOptions}}"
        wx:key="hole"
        class="start-hole-cell {{startHoleDraft === item.hole ? 'start-hole-cell--active' : ''}}"
        data-hole="{{item.hole}}"
        bindtap="onStartHoleDraftSelect"
      >{{item.label}}</view>
    </view>
    <view class="start-hole-sheet__footer">
      <view class="sheet-cancel-btn start-hole-sheet__btn-cancel" bindtap="closeStartHoleSheet">取消</view>
      <view class="sheet-cancel-btn start-hole-sheet__btn-confirm" bindtap="confirmStartHoleSheet">确认</view>
    </view>
  </view>

  <caddie-scoring-sheet
    visible="{{caddieSheetVisible}}"
    hasQr="{{caddieSheetHasQr}}"
    qrUrl="{{caddieSheetQrUrl}}"
    generating="{{caddieSheetGenerating}}"
    scorers="{{caddieSheetScorers}}"
    theme-class="{{themeClass}}"
    bind:close="closeCaddieSheet"
    bind:generateQr="onGenerateCaddieQr"
    bind:removeCaddie="onRemoveCaddie"
  />

  <!-- 显示设置 sheet（结构对齐 Hub M 按钮；fontScale_global 逻辑不变） -->
  <view wx:if="{{showStyleSheet}}" bindtap="closeStyleSheet" class="sheet-overlay"></view>
  <view class="style-sheet {{showStyleSheet ? 'active' : ''}}" catchtap="noop">
    <view class="style-sheet__head">
      <view>
        <text class="style-sheet__title">显示设置</text>
        <text class="style-sheet__sub">这些设置会影响所有记分相关页面。</text>
      </view>
      <view bindtap="closeStyleSheet" class="style-sheet__close">✕</view>
    </view>
    <view class="style-section">
      <text class="style-section-title">字体大小</text>
      <view class="style-option-row">
        <view
          bindtap="onFontScaleChange"
          data-value="normal"
          class="style-option {{fontScale === 'normal' ? 'active' : ''}}"
        >标准字体</view>
        <view
          bindtap="onFontScaleChange"
          data-value="large"
          class="style-option {{fontScale === 'large' ? 'active' : ''}}"
        >大字体</view>
      </view>
    </view>
    <view class="style-done-wrap">
      <view bindtap="closeStyleSheet" class="style-done-btn">完成</view>
    </view>
  </view>

</view>
