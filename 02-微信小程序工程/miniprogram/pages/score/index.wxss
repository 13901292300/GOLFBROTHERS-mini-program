/* 复刻原型 .actions / .action-btn：横向并列、卡片底 + 描边 */
.group-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.group-action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
}

/* 取消：次要描边按钮 */
.group-action-btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
}

/* 确认：金色主按钮 */
.group-action-btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

/* 主题切换完全由 .dark-mode / .bright-mode 上的 Theme Token 驱动，
   无需任何局部 bright/dark 覆盖规则。 */

/* ===================================================================
   四人最佳球位模式（fourball_best）专用样式 —— 复刻 HTML 原型
   仅在 mode === 'fourball_best' 时渲染，不影响其他模式
   =================================================================== */

/* 球员花名册条（位于赛况信息与记分表之间） */
.bestball-roster-strip {
  background: linear-gradient(90deg, rgba(0, 45, 98, 0.18), rgba(17, 17, 17, 0.98), rgba(206, 146, 36, 0.1));
  border-bottom: 1rpx solid var(--border-color);
  padding: 18rpx 20rpx 20rpx;
  flex-shrink: 0;
}

.bestball-roster-inner {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}

.bestball-player-card {
  min-width: 0;
  height: 124rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.035);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx;
  position: relative;
  overflow: hidden;
}

.bestball-player-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: var(--tee-color, #ce9224);
}

/* 分组高亮（仅视觉：背景 + 边框）：同一 group 内球员共享同一高亮，区分不同组。
   不改变头像排列方式 / 昵称位置 / 布局结构。颜色循环复用 4 组调色板。 */
.bestball-player-card.bestball-group-0 {
  background: rgba(206, 146, 36, 0.12);
  border-color: rgba(206, 146, 36, 0.5);
}
.bestball-player-card.bestball-group-1 {
  background: rgba(0, 174, 239, 0.12);
  border-color: rgba(0, 174, 239, 0.5);
}
.bestball-player-card.bestball-group-2 {
  background: rgba(34, 197, 94, 0.12);
  border-color: rgba(34, 197, 94, 0.5);
}
.bestball-player-card.bestball-group-3 {
  background: rgba(220, 38, 38, 0.12);
  border-color: rgba(220, 38, 38, 0.5);
}

.bestball-player-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 9999rpx;
  border: 1rpx solid var(--tee-color, #ce9224);
  flex-shrink: 0;
  background: #000;
}

/* 左侧球员区：头像在上、昵称在下，纵向居中排列 */
.bestball-player-id {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.bestball-player-name {
  max-width: 100%;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  color: #ffffff;
  font-style: italic;
  text-transform: uppercase;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧 T 台区：独立固定右侧，不参与头像/昵称布局 */
.bestball-tee-line {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 16rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--text-secondary);
  white-space: nowrap;
}

.bestball-tee-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 9999rpx;
  background: var(--tee-color, #ce9224);
  flex-shrink: 0;
}

/* 球队最佳球位行 —— sticky 列 */
.bestball-mode-cell {
  background: #08111d !important;
}

/* 第一列横向 3 区布局：左右弹性 spacer 居中 + 中部「标题块 + 杆差」。
   缩进时杆差宽度收缩，spacer 自动回收空间，保持左右平衡、无死白。 */
/* 与个人比杆赛 player-top-line 一致：左侧标题块（自然宽度，类比头像），
   右侧 diff 包裹层 flex 撑满剩余区域并把杆差居中 → 杆差落在「中偏右」视觉位置。 */
.bestball-mode-layout {
  flex: 1 1 auto;
  width: 100%;
  min-width: 0;
  min-height: 152rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  /* 文案在「杆差列」左侧区域内水平居中（预留右侧固定杆差列宽度） */
  justify-content: center;
  padding-right: var(--bb-diff-col-w, 96rpx);
  box-sizing: border-box;
  gap: 0;
}

.bestball-mode-wrap {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  min-width: 0;
}

/* 球队杆差：复用 .player-diff-wrap（flex:1 + 居中 + --player-diff-opacity 淡出）。
   仅把 flex-grow 改为状态变量：未缩进=1（撑满剩余区、杆差居中→中偏右）；
   缩进时 --bestball-diff-grow→0，flex-basis:0 使其宽度塌缩为 0，标题块自动回正居中。 */
/* 杆差列：固定宽度 + 绝对定位贯穿整行高度，作为全行对齐基准。
   横向：居中于「文案列右边界~单元格右边界」之间；纵向：middle align to row height。
   所有记分行（主组 / 单人）共用同一规则 → 同一 x、同一垂直中线。 */
.bestball-mode-diff {
  position: absolute;
  right: var(--player-col-padding-x, 24rpx);
  top: 0;
  bottom: 0;
  width: var(--bb-diff-col-w, 96rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.25s ease;
}

.bestball-mode-kicker {
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 0.18em;
  color: var(--champion-gold);
  font-weight: 900;
  text-transform: uppercase;
}

.bestball-mode-main {
  font-size: var(--bestball-label-size, 30rpx);
  line-height: 1.1;
  color: #ffffff;
  font-weight: 900;
  letter-spacing: 0.08em;
  /* 左滑压缩时字体随 --bestball-label-size 缩小，但始终单行完整显示 */
  white-space: nowrap;
  text-align: center;
}

/* 2+2 / pair 组记分行 sticky 列：复刻「四人四球」原型 absolute 坐标 */
.bestball-pair-cell {
  justify-content: flex-start;
  padding-top: 0;
  padding-bottom: 0;
}

.bestball-pair-cell .player-cell-content {
  width: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.paired-avatars {
  position: relative;
  height: 104rpx;
  width: 100%;
}

/* swipe indent：头像+昵称组随 --pair-container-shift 居中（杆差列不参与平移） */
.pair-avatar-group {
  position: relative;
  height: 104rpx;
  width: 100%;
  transform: translateX(var(--pair-container-shift, 0rpx));
  transition: transform 0.1s linear;
}

.paired-avatars .avatar-with-diff {
  position: absolute;
  top: 0;
  width: 80rpx;
  transition: transform 0.1s linear;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.paired-avatars .avatar-with-diff:nth-child(1) {
  left: 24rpx;
  z-index: 10;
}

.paired-avatars .avatar-with-diff:nth-child(2) {
  left: 128rpx;
  z-index: 5;
}

.paired-avatars .player-avatar-img {
  width: 72rpx;
  height: 72rpx;
}

.paired-avatars .player-diff-wrap {
  position: absolute;
  right: 0;
  top: 20rpx;
  left: auto;
  width: var(--bb-diff-col-w, 96rpx);
  flex: none;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  overflow: visible;
  opacity: var(--player-diff-opacity, 1);
  transition: opacity 0.1s, width 0.25s ease;
}

.paired-avatars .player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.paired-names {
  position: relative;
  height: 28rpx;
  width: 100%;
  transform: translateX(var(--pair-container-shift, 0rpx));
  transition: transform 0.1s linear;
}

.paired-names .player-name-line {
  position: absolute;
  top: 0;
  width: 80rpx;
  max-width: 80rpx;
  transition: transform 0.1s linear;
  margin: 0;
  text-align: center;
  font-size: 18rpx;
}

.paired-names .player-name-line:nth-child(1) {
  left: 24rpx;
}

.paired-names .player-name-line:nth-child(2) {
  left: 128rpx;
}

.tee-marker-strip-right {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  display: flex;
  flex-direction: column;
}

.tee-marker-strip-right .tee-half {
  flex: 1;
  width: 100%;
}

/* 3+1 单人记分行 sticky 列：复用个人比杆赛 .player-card 结构，
   但在记分行内整体垂直 + 水平居中，使头像/昵称/杆差与「主组记分行」及 HOLE 格共享同一视觉中线。
   仅作用于 fourball_best 的单人行，标准个人比杆赛球员行不受影响。 */
.bestball-single-cell {
  justify-content: center;
  padding-top: 0;
  padding-bottom: 0;
}

.bestball-single-cell .player-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 预留右侧固定杆差列宽度，头像/昵称在左侧区域居中（与主组文案同一中线） */
  padding-right: var(--bb-diff-col-w, 96rpx);
  box-sizing: border-box;
}

.bestball-single-cell .player-top-line {
  justify-content: center;
}

/* 单人行杆差：与主组共用同一「固定宽度 + 绝对定位贯穿整行」的杆差列 → 双轴严格对齐 */
.bestball-single-cell .player-diff-wrap {
  position: absolute;
  right: var(--player-col-padding-x, 24rpx);
  top: 0;
  bottom: 0;
  width: var(--bb-diff-col-w, 96rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* BRIGHT 模式覆盖（与原型 body.bright-mode 一致） */
.score-page.bright-mode .bestball-roster-strip {
  background: linear-gradient(90deg, rgba(0, 45, 98, 0.05), #f8fafc, rgba(206, 146, 36, 0.08));
  border-bottom-color: var(--border-color);
}

.score-page.bright-mode .bestball-player-card {
  /* 轻微压灰/压蓝（仅 BRIGHT）：让白色 T 台线/分隔更清晰，球员行不再融入白底 */
  background: #f2f5f9;
  border-color: var(--border-color);
}

.score-page.bright-mode .bestball-player-name,
.score-page.bright-mode .bestball-mode-main {
  color: var(--pga-blue);
}

.score-page.bright-mode .bestball-mode-cell {
  background: var(--bg-card) !important;
}
