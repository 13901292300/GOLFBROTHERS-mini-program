  align-items: flex-end;
}
.friend-sheet__panel {
  width: 100%;
  max-height: 70vh;
  background: var(--bg-card);
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  display: flex;
  flex-direction: column;
