  flex-shrink: 0;
}

.discussion-avatar-btn image { width: 100%; height: 100%; display: block; }

.discussion-more-btn {
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1px solid var(--discussion-border);
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--discussion-bubble);
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.discussion-chat {
  flex: 1;
  min-height: 0;
  padding: 28rpx 24rpx 36rpx;
}

.discussion-time {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 8rpx 0 28rpx;
}

.chat-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.chat-row--self { flex-direction: row-reverse; }

.chat-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.chat-body { max-width: 72%; }

.chat-meta {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
