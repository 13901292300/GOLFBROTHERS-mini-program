/**
 * 记分页面样式 — 对齐 记分及添加删除页面汇总.html
 */
@import '../../styles/half-course-panel.wxss';

/* =========================================================
   THEME TOKEN SYSTEM (single source of truth)
   所有结构性背景 / 文字 / 边框颜色都来自这些变量。
   品牌色（蓝色 Header、金色、记分语义色）不参与主题切换。
   ========================================================= */
.score-page.dark-mode {
  --bg-primary: #000000;
  --bg-secondary: #0a0a0a;
  --bg-card: #111111;
  --bg-panel: #000000;
  --text-primary: #ffffff;
  --text-secondary: #888888;
  --border-color: #222222;
  /* HEADER 三色 DARK：hole 最浅 → identity 中 → intersection 最深（相对纯黑成绩区拉开） */
  --score-header-hole: #202b3a;
  --score-header-identity: #172231;
  --score-header-intersection: #0d1724;
  /* fourball 成绩行横线：比 --border-color 更可读，仍弱于成绩主体 */
  --fourball-score-row-border: #3f3f46;
  /* style-sheet 兼容别名（对齐 detail/hub） */
  --bg-subtle: #0a0a0a;
  --text-muted: #888888;
  --border: var(--border-color);
  --border-hover: #333333;

  /* TOT 列主题联动：DARK = 冠军金（用字面量，避免嵌套 var 在部分基础库解析失败） */
  --tot-color: #CE9224;

  /* 记分面板视觉层级：DARK 维持金色高亮体系，成绩金色 */
  --highlight-color: #CE9224;
  --highlight-surface: #fff9c4;
  --highlight-text: #002d62;
  --score-color: #CE9224;
  --score-surface: rgba(206, 146, 36, 0.16);
  --score-border: rgba(206, 146, 36, 0.48);
  --aux-text: #00aeef;
  --highlight-strong: #facc15;
  --highlight-on: #002d55;
  --par-color: #CE9224;

  /* 技术面板焦点 pulse：冠军金 → 浅金 → 冠军金 */
  --tech-panel-pulse: #CE9224;
  --tech-panel-pulse-mid: #E4C078;

  --discussion-bg: #0b0f14;
  --discussion-strip: #101820;
  --discussion-bubble: #182330;
  --discussion-bar: #111827;
  --discussion-input-bg: #0b1220;
  --discussion-border: #263241;
}

.score-page.bright-mode {
  --bg-primary: #ffffff;
  --bg-secondary: #f1f5f9;
  --bg-card: #f8fafc;
  --bg-panel: #ffffff;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --border-color: #e2e8f0;
  /* HEADER 三色 V2.2：hole 最浅 → identity 中 → intersection 最深 */
  --score-header-hole: #f4f7fb;
  --score-header-identity: #e2eaf3;
  --score-header-intersection: #c2d2e4;
  /* fourball 成绩行横线：Light 保持现有浅灰 */
  --fourball-score-row-border: var(--border-color);
  /* style-sheet 兼容别名（对齐 detail/hub） */
  --bg-subtle: #f3f4f6;
  --text-muted: #6b7280;
  --border: var(--border-color);
  --border-hover: #d1d5db;

  /* TOT 列主题联动：BRIGHT = PGA蓝 #002D62 */
  --tot-color: #002D62;

  /* 记分面板：BRIGHT 单一 PGA 藏蓝高对比体系（成绩与高亮同色 #002D62，靠底色/边框/加粗区分；辅助文字灰） */
  --highlight-color: #002D62;
  --highlight-surface: rgba(0, 45, 98, 0.12);
  --highlight-text: #002D62;
  --score-color: #002D62;
  --score-surface: rgba(0, 45, 98, 0.10);
  --score-border: rgba(0, 45, 98, 0.42);
  --aux-text: #6B7280;
  --highlight-strong: #002D62;
  --highlight-on: #ffffff;
  --par-color: #002D62;

  /* 技术面板焦点 pulse：PGA蓝 → 浅蓝 → PGA蓝 */
  --tech-panel-pulse: #002D62;
  --tech-panel-pulse-mid: #5BA3D9;

  --discussion-bg: #f3f4f6;
  --discussion-strip: #ffffff;
  --discussion-bubble: #ffffff;
  --discussion-bar: #f8fafc;
  --discussion-input-bg: #ffffff;
  --discussion-border: #e2e8f0;
}

page {
  height: 100%;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.score-page {
  /* Bottom Sheet 主按钮品牌色（页面内定义，避免 var(--golf-blue) 未声明失效） */
  --golf-blue: #002d62;
  --champion-gold: #ce9224;

  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-primary);
  color: var(--text-primary);
  box-sizing: border-box;
}

/* ===== Header ===== */
/* height / padding-top / padding-right are computed in JS (initHeaderNav) and
   applied via inline headerRootStyle / headerBarStyle, matching the home page. */
.gb-header {
  flex-shrink: 0;
  background: #002d62;
  border-bottom: 2px solid var(--champion-gold);
  color: #ffffff;
  box-sizing: border-box;
}

.gb-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
}

.gb-header__left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.gb-header__right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.gb-header__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gb-header__chevron {
  font-size: 40rpx;
  color: #ffffff;
  line-height: 1;
}

.gb-header__eyebrow {
  display: block;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 8rpx;
}

.gb-header__title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  color: #ffffff;
  line-height: 1;
}

/* D/B 开关已收口到首页（唯一入口），记分页不再提供任何主题控件。 */

/* The real WeChat system capsule occupies the top-right; reserve space via
   headerPaddingRight (JS) and hide this mock pill, exactly like the home page. */
.mini-program-pill {
  display: none;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  align-items: center;
  gap: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.mini-program-pill__dots { display: flex; gap: 8rpx; }
.mini-program-pill__dot { width: 12rpx; height: 12rpx; background: #fff; border-radius: 999rpx; }
.mini-program-pill__line { width: 2rpx; height: 32rpx; background: rgba(255, 255, 255, 0.2); }
.mini-program-pill__circle {
  width: 40rpx; height: 40rpx;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
}
.mini-program-pill__circle-inner { width: 20rpx; height: 20rpx; background: #fff; border-radius: 999rpx; }

/* ===== Tab Nav ===== */
/* 容器不居中项（用 stretch 让 item 铺满高度），文字由 .tab-nav__item 自身 flex 居中，指示器贴容器底边 */
.tab-nav {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  height: var(--tab-height);
  background: #002d62;
  border-bottom: 1px solid var(--border-color);
}

.tab-nav__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}

.tab-nav__label {
  font-size: var(--tab-font-size);
  line-height: 1;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.tab-nav__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 112rpx;
  height: var(--tab-indicator-height);
  background: var(--tab-indicator-color);
  opacity: 1;
  border-radius: 999rpx;
}

/* ===== Main ===== */
.score-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.score-tab-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Course & Game Info */
.course-game-info {
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
}

.course-game-info__head {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
}

/* 信息栏三段式：左(球场名+下拉) / 中(占位) / 右(总杆·杆差开关) */
.score-info-row {
  justify-content: space-between;
  gap: 24rpx;
}

.score-info-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

/* 下拉按钮紧挨球场名右侧：名字按内容收缩并省略号，按钮不收缩 */
.score-info-left .course-name {
  flex: 0 1 auto;
}

.course-dropdown-btn {
  flex-shrink: 0;
}

/* 右侧切换开关 */
.score-display-switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 999rpx;
  padding: 4rpx;
}

.score-display-switch__btn {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  border-radius: 999rpx;
  line-height: 1.2;
}

.score-display-switch__btn--active {
  background: #002D62;
  color: #ffffff;
}

.course-game-info__accent {
  width: 6rpx;
  height: 32rpx;
  background: var(--champion-gold);
  border-radius: 999rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.course-game-info__course {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-game-info__toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.course-game-info__chevron {
  font-size: 24rpx;
  color: var(--champion-gold);
  transition: transform 0.2s;
}

.course-game-info__chevron--open { transform: rotate(180deg); }

.game-info-panel {
  padding: 8rpx 32rpx 24rpx;
  border-top: 1px solid var(--border-color);
}

/* 外部遮罩：点击空白处收起（全屏 fixed、透明、不参与记分布局流） */
.game-info-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: transparent;
}

/* Context 面板：根级 fixed 浮层，与 TAB / HOLE / score grid 完全解耦，
   不占布局高度、不 push 任何元素、不触发 reflow。top / max-height 由 JS 实测注入。 */
.game-context-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  max-height: 60vh;
  box-sizing: border-box;
  padding: 16rpx 24rpx 28rpx;
  background: var(--bg-card);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.18);
}

/* 最小必要信息：纯文本 label + value 列表（无卡片嵌套、无头像、无分组展开） */
.gc-list {
  margin-top: 4rpx;
  font-size: 26rpx;
}
.gc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1px solid var(--border-color);
}
.gc-item--last { border-bottom: none; }
.gc-item-label {
  color: var(--text-secondary);
  flex-shrink: 0;
}
.gc-item-value {
  color: var(--text-primary);
  font-weight: 700;
  margin-left: 24rpx;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 围观密码：数值 + 复制按钮（单行追加，不新增模块） */
.gc-code-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 24rpx;
  flex: 1;
}
.gc-code-value {
  margin-left: 0;
  flex: 0 1 auto;
  letter-spacing: 4rpx;
  color: var(--champion-gold);
}
.gc-copy-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--champion-gold);
  border: 1px solid var(--champion-gold);
  border-radius: 999rpx;
  line-height: 1.6;
}
.gc-copy-btn:active { opacity: 0.7; }

.game-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid var(--border-color);
}

.game-info-row--last { border-bottom: none; }

.game-info-label { color: var(--text-secondary); }
.game-info-value { color: var(--text-primary); font-weight: 700; margin-left: 24rpx; flex: 1; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Scoreboard */
.scoreboard-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  background: var(--bg-primary);
}

/*
 * 普通创建 fourball_best 2+2 / 4+0：HOLE/PAR/TOT 对齐 score-shell-ui-v2.4（game-single）视觉。
 * 门控：.is-fourball-pair22（2+2/2+1）| .is-fourball-team-layout（4+0）；selector 合并，不复制两套。
 * TOTAL 无 tot-head class：列序末格 :last-child（buildColumns idx===20）
 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row.scoreboard-row--head,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row.scoreboard-row--head {
  height: 112rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  /* visible：避免 overflow:hidden 打断 sticky-col 横滑吸边 */
  overflow: visible;
  background: transparent;
  border-bottom: none;
  box-shadow: 0 1px 0 var(--border-color);
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row.scoreboard-row--par,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row.scoreboard-row--par {
  height: 72rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  overflow: visible;
  background: transparent;
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head > .scoreboard-cell,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head > .scoreboard-cell {
  height: 112rpx;
  min-height: 112rpx;
  box-sizing: border-box;
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell {
  height: 72rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

/* PAR 成绩区 cell：普通表格底边（cell 自画，避免铺底盖住 row border） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell:not(.sticky-col),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell:not(.sticky-col) {
  border-bottom: 1px solid var(--border-color);
}

/* HOLE 左侧 = 交叉蓝（对齐 game-single head spacer / lead--head） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .sticky-col,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .sticky-col {
  background: var(--score-header-intersection);
  /* 压缩原 32+32，保证 112 行内居中；不改 --player-col-width */
  padding-top: 0;
  padding-bottom: 0;
}

/* HOLE 1–18 + OUT/IN 头 = hole 蓝 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .scoreboard-cell--special-head,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}

/* HOLE TOTAL 头 = 交叉蓝（压过 special-head） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--head .scoreboard-cell--special-head:last-child,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--head .scoreboard-cell--special-head:last-child {
  background: var(--score-header-intersection);
}

/* PAR 左侧 = 身份蓝；底边交叉蓝（对齐 game-single 身份区） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .sticky-col,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .sticky-col {
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

/* PAR 1–18 洞格 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell:not(.sticky-col):not(.scoreboard-cell--special-par),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell:not(.sticky-col):not(.scoreboard-cell--special-par) {
  background: var(--bg-primary);
}

/* PAR OUT/IN = hole 蓝（对齐 hole-special-col） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell--special-par,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell--special-par {
  background: var(--score-header-hole);
}

/* PAR TOTAL = 身份蓝（对齐 tot-col）；底边交叉蓝（PAR 无 score-cell--total class） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par > .scoreboard-cell--special-par:last-child,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par > .scoreboard-cell--special-par:last-child {
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

/* 兼容命名：若日后 PAR 挂上 score-cell--total，同交叉蓝底边 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par .score-cell--total,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par .score-cell--total {
  border-bottom: 1px solid var(--score-header-intersection);
}

/* HOLE / PAR 文案：对齐 hole-par-normal-container 字阶与光学上移 */
.scoreboard-scroll.is-fourball-pair22 .col-head-label,
.scoreboard-scroll.is-fourball-team-layout .col-head-label,
.scoreboard-scroll.is-fourball-pair22 .col-par-label,
.scoreboard-scroll.is-fourball-team-layout .col-par-label {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  line-height: 1;
  text-transform: uppercase;
}

.scoreboard-scroll.is-fourball-pair22 .col-head-label,
.scoreboard-scroll.is-fourball-team-layout .col-head-label {
  transform: translateY(-3rpx);
}

.scoreboard-scroll.is-fourball-pair22 .col-par-label,
.scoreboard-scroll.is-fourball-team-layout .col-par-label {
  transform: translateY(-2rpx);
}

/* 洞号圆：与基准共用全局数值，提高优先级避免被其它 Legacy 规则干扰 */
.scoreboard-scroll.is-fourball-pair22 .hole-number,
.scoreboard-scroll.is-fourball-team-layout .hole-number,
.scoreboard-scroll.is-fourball-pair22 .hole-label-circle,
.scoreboard-scroll.is-fourball-team-layout .hole-label-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 900;
}

.scoreboard-scroll.is-fourball-pair22 .hole-number,
.scoreboard-scroll.is-fourball-team-layout .hole-number {
  background: #002d62 !important;
  color: #ffffff !important;
  border: 1px solid #002d62;
}

/* OUT/IN/TOTAL 圆标：对齐基准 special（bright / dark token） */
.scoreboard-scroll.is-fourball-pair22 .hole-label-circle--special,
.scoreboard-scroll.is-fourball-team-layout .hole-label-circle--special {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

.score-page.dark-mode .scoreboard-scroll.is-fourball-pair22 .hole-label-circle--special,
.score-page.dark-mode .scoreboard-scroll.is-fourball-team-layout .hole-label-circle--special {
  background: var(--score-header-identity);
  border: 1px solid var(--score-header-intersection);
  color: var(--text-secondary);
}

/* PAR 数字：与基准 par-val 一致 */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--par .par-val,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--par .par-val {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

/* 成绩格 special：OUT/IN=hole蓝，TOTAL=身份蓝（对齐 game-single；不改 columns） */
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--player > .score-cell:nth-child(11),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--player > .score-cell:nth-child(11),
.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--player > .score-cell:nth-child(21),
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--player > .score-cell:nth-child(21) {
  background: var(--score-header-hole);
}

.scoreboard-scroll.is-fourball-pair22 .scoreboard-row--player > .score-cell.score-cell--total,
.scoreboard-scroll.is-fourball-team-layout .scoreboard-row--player > .score-cell.score-cell--total {
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

/* ===== Shell：G1 basic / 普通创建单组 game-single（左 player-column + 右 score-track）===== */
.scoreboard-shell,
.scoreboard-shell--basic,
.scoreboard-shell--game-single,
.scoreboard-shell--match-play,
.scoreboard-shell--fourball {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  background: var(--bg-primary);
  overflow: hidden;
}

/* ===== fourball shell v2（Phase4：identity 固定 + track lead + 独立横滑；不改 Legacy）===== */
.scoreboard-shell--fourball {
  position: relative;
  /* Phase5.5：壳级折叠进度，驱动列宽 / tee sticky left / 头像叠合 */
  --fourball-identity-collapse: 0;
  --fourball-identity-width-start: 220rpx;
  --fourball-identity-width-delta: 72rpx;
  --fourball-identity-width: calc(
    var(--fourball-identity-width-start) - var(--fourball-identity-width-delta) *
      var(--fourball-identity-collapse)
  );
  /* Phase7.2：HOLE/PAR 锚点 = identity + diff(96) + tee(6) */
  --fourball-diff-lead-width: 96rpx;
  --fourball-tee-lead-width: 6rpx;
  --fourball-hole-par-anchor-width: calc(
    var(--fourball-identity-width) + var(--fourball-diff-lead-width) +
      var(--fourball-tee-lead-width)
  );
}

/* Phase5.5：列宽 220→148 随 progress；禁止 width transition（跟手） */
/* Phase5.4：最高层遮挡。列底用页面底，避免末行以下被 identity 蓝铺满 */
.scoreboard-shell--fourball .fourball-player-column {
  flex-shrink: 0;
  width: var(--fourball-identity-width);
  min-width: var(--fourball-identity-width);
  max-width: var(--fourball-identity-width);
  height: 100%;
  position: relative;
  z-index: 3;
  background: var(--bg-primary);
  background-color: var(--bg-primary);
  box-sizing: border-box;
  transition: none;
}

/* identity|diff 竖线：挂在内容 inner（表头+球员行高度），不随全高 column 伸入空白区 */
.scoreboard-shell--fourball .fourball-player-column__inner {
  width: 100%;
  box-sizing: border-box;
  box-shadow: inset -1px 0 0 var(--score-header-intersection);
}

.scoreboard-shell--fourball .fourball-player-column__spacer {
  width: 100%;
  box-sizing: border-box;
  border-bottom: 1px solid var(--score-header-intersection);
}

.scoreboard-shell--fourball .fourball-player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-bottom: none;
}

.scoreboard-shell--fourball .fourball-player-column__spacer.shell-row--par {
  height: 72rpx;
  min-height: 72rpx;
  background: var(--score-header-identity);
}

.scoreboard-shell--fourball .fourball-player-column__row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--score-header-intersection);
}

/* 末行以下空白区不留横线；行间分隔仍由非 last-child 的 border-bottom 承担 */
.scoreboard-shell--fourball .fourball-player-column__inner > .fourball-player-column__row:last-child {
  border-bottom: none;
}

/* Phase5.2-b / 5.5 / 5.6：内容折叠；collapse 继承壳级；头像组随列宽居中 */
.scoreboard-shell--fourball .fourball-pair-identity {
  --fourball-avatar-collapse-shift: -48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/*
 * Phase5.6：avatar-group 相对当前 identity 宽居中（无固定 left）。
 * gap / 第二头像 margin-left 随 collapse 收紧布局盒，避免 148rpx 下挤出左边界。
 * 折叠距离仍为 --fourball-avatar-collapse-shift（-48rpx）。
 */
.scoreboard-shell--fourball .fourball-pair-identity .avatar-group {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 80rpx;
  margin: 0 auto;
  box-sizing: border-box;
  gap: calc(16rpx * (1 - var(--fourball-identity-collapse)));
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__item {
  position: relative;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__item--first {
  z-index: 2;
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__item--second {
  z-index: 1;
  /* margin 参与 flex 布局宽度，居中才能跟列宽收缩；位移量仍为 -48rpx×progress */
  margin-left: calc(
    var(--fourball-avatar-collapse-shift) * var(--fourball-identity-collapse)
  );
  transform: translateX(0);
}

.scoreboard-shell--fourball .fourball-pair-identity .avatar-group__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: block;
  background: var(--bg-secondary);
}

.scoreboard-shell--fourball .fourball-pair-identity .name-stack {
  position: relative;
  width: 100%;
  min-height: 28rpx;
}

.scoreboard-shell--fourball .fourball-pair-identity .name-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  min-height: 28rpx;
  opacity: calc(1 - var(--fourball-identity-collapse));
}

.scoreboard-shell--fourball .fourball-pair-identity .name-group__name {
  flex: 1 1 0;
  min-width: 0;
  max-width: 50%;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/*
 * fourball 双球员壳：type=single（members 仅 1 人）时 identity 内头像/昵称居中。
 * 列宽与 collapse 不变；type=pair 双头像不受影响。
 */
.scoreboard-shell--fourball .fourball-pair-identity--single .avatar-group {
  justify-content: center;
}

.scoreboard-shell--fourball .fourball-pair-identity--single .avatar-group__item,
.scoreboard-shell--fourball .fourball-pair-identity--single .avatar-group__item--first {
  margin-left: 0;
  margin-right: 0;
}

.scoreboard-shell--fourball .fourball-pair-identity--single .name-group {
  justify-content: center;
  /* single 无 pair-name-compact；collapse 后仍显示单昵称，禁止随 --fourball-identity-collapse 淡出 */
  opacity: 1;
}

.scoreboard-shell--fourball .fourball-pair-identity--single .name-group__name {
  flex: 0 1 auto;
  max-width: 100%;
  width: auto;
  text-align: center;
}

/* Phase5.2-d：折叠昵称 combined（整串）/ dual（短侧优先宽，长侧省略） */
.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 28rpx;
  box-sizing: border-box;
  opacity: var(--fourball-identity-collapse);
  pointer-events: none;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact--combined .pair-name-compact__text {
  max-width: 100%;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact--dual {
  justify-content: center;
  gap: 0;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact__part {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoreboard-shell--fourball .fourball-pair-identity .pair-name-compact__sep {
  flex: 0 0 auto;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

/* Phase7.4：宽= identity+diff+tee；translateX 仅阶段2（fourballHoleParOffsetX） */
.scoreboard-shell--fourball .fourball-hole-par-overlay {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: var(--fourball-hole-par-anchor-width);
  height: 184rpx;
  display: flex;
  flex-direction: column;
  pointer-events: none;
  box-sizing: border-box;
  transition: none;
  will-change: transform;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__hole,
.scoreboard-shell--fourball .fourball-hole-par-overlay__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  box-sizing: border-box;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__hole {
  height: 112rpx;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__par {
  height: 72rpx;
}

.scoreboard-shell--fourball .fourball-hole-par-overlay__hole text,
.scoreboard-shell--fourball .fourball-hole-par-overlay__par text {
  color: var(--text-secondary);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  line-height: 1;
}

/* Phase6 / 5.5 / 6.2：T sticky — left=压缩后 identity 右缘；显隐无过渡，防交接回跳 */
.scoreboard-shell--fourball .fourball-tee-sticky-overlay {
  position: absolute;
  left: var(--fourball-identity-width);
  top: 0;
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
  transition: none;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
  transition: none;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__spacer {
  width: 100%;
  box-sizing: border-box;
  background: var(--score-header-identity);
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__inner > .fourball-tee-sticky-overlay__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-bottom: none;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__spacer.shell-row--par {
  height: 72rpx;
  min-height: 72rpx;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__row {
  display: flex;
  align-items: stretch;
  justify-content: center;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-bottom: 1px solid var(--score-header-intersection);
  background: var(--score-header-identity);
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  height: 100%;
  /* 双色左右半条；亦可用 tee-left / tee-right 实体色块 */
  background: transparent;
}

.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip .tee-left,
.scoreboard-shell--fourball .fourball-tee-sticky-overlay__strip .tee-right {
  flex: 1 1 50%;
  width: 50%;
  min-width: 0;
  height: 100%;
}

/* sticky 显示瞬间隐藏 track 内 T（同帧交接，无淡出，避免回跳观感） */
.scoreboard-shell--fourball.is-fourball-tee-sticky .fourball-track-lead--tee .fourball-track-lead__tee-half {
  opacity: 0;
  visibility: hidden;
  transition: none;
}

/* score-track：最低层（z-index:1）；勿抬高，保证 identity 可遮挡滚入成绩 */
.scoreboard-shell--fourball .fourball-score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 1;
  background: transparent;
}

/* Phase6.1：阶段1 用 translateX(scrollLeft) 抵消原生横滑，lead/score 视觉冻结 */
.scoreboard-shell--fourball .fourball-score-track__inner {
  display: inline-block;
  min-width: 100%;
  position: relative;
  z-index: 1;
  will-change: transform;
  transition: none;
}

.scoreboard-shell--fourball .scoreboard-row {
  display: flex;
  min-width: max-content;
  position: relative;
  z-index: 1;
}

/* 横线统一由 cell/lead 自绘；提高优先级，压过通用 .scoreboard-shell .shell-row border */
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.shell-row--head,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.shell-row--par,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.shell-row--player,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--head,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--par,
.scoreboard-shell.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--player {
  border-bottom: none;
  box-shadow: none;
}

.scoreboard-shell--fourball .scoreboard-row.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
}

.scoreboard-shell--fourball .scoreboard-row.shell-row--par {
  min-height: 72rpx;
}

.scoreboard-shell--fourball .scoreboard-row.shell-row--player {
  height: 156rpx;
  min-height: 156rpx;
}

.scoreboard-shell--fourball .scoreboard-cell {
  flex-shrink: 0;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/*
 * Phase7.5 / OUT·IN 修正：洞头与 OUT/IN 汇总列用 18洞浅底 --score-header-hole；
 * TOTAL 保持 intersection（头）/ identity（身）。spacer/lead/overlay 不改。
 */
.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
}

/* OUT/IN：HOLE/PAR 行 = 18洞浅底 */
.scoreboard-shell--fourball .scoreboard-cell--hole-special-col,
.scoreboard-shell--fourball .scoreboard-row--par > .scoreboard-cell--special-par:not(.scoreboard-cell--tot-col) {
  background: var(--score-header-hole);
  background-color: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-cell--tot-col {
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
}

.scoreboard-shell--fourball .scoreboard-row--par > .scoreboard-cell:not(.scoreboard-cell--special-par):not(.scoreboard-cell--tot-col):not(.scoreboard-cell--hole-special-col) {
  background: var(--bg-primary);
}

/* 成绩格不透明底，滚入视口时形成对 lead 的覆盖观感（同 G1；无 opacity/宽塌缩） */
.scoreboard-shell--fourball .scoreboard-row--player .score-cell {
  position: relative;
  z-index: 1;
  background: var(--bg-primary);
  background-color: var(--bg-primary);
}

/*
 * 横向业务分隔线唯一来源：HOLE/PAR/成绩 cell + 同行 lead
 * Light = --border-color；Dark = 增强灰（--fourball-score-row-border）
 */
.scoreboard-shell--fourball .scoreboard-row--head .scoreboard-cell--head,
.scoreboard-shell--fourball .scoreboard-row--par > .scoreboard-cell,
.scoreboard-shell--fourball .scoreboard-row.scoreboard-row--player .score-cell,
.scoreboard-shell--fourball .fourball-track-lead--head,
.scoreboard-shell--fourball .fourball-track-lead--par,
.scoreboard-shell--fourball .scoreboard-row--player .fourball-track-lead {
  border-bottom: 1px solid var(--fourball-score-row-border);
  box-sizing: border-box;
}

/* OUT/IN 成绩区：覆盖默认 bg-primary → 18洞浅底；TOTAL 保持身份蓝（横线跟上方统一 token） */
.scoreboard-shell--fourball .scoreboard-row--player .score-cell.scoreboard-cell--hole-special-col {
  background: var(--score-header-hole);
  background-color: var(--score-header-hole);
}

.scoreboard-shell--fourball .scoreboard-row--player .score-cell.score-cell--total,
.scoreboard-shell--fourball .scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
}

/* track lead：中间层；固定宽，禁止 opacity/width collapse */
.scoreboard-shell--fourball .fourball-track-lead {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--score-header-identity);
  background-color: var(--score-header-identity);
  transition: none;
  opacity: 1;
}

.scoreboard-shell--fourball .fourball-track-lead--diff {
  width: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
}

.scoreboard-shell--fourball .fourball-track-lead--tee {
  width: 6rpx;
  min-width: 6rpx;
  max-width: 6rpx;
  padding: 0;
  flex-direction: column;
  align-items: stretch;
}

.scoreboard-shell--fourball .fourball-track-lead--head {
  background: var(--score-header-intersection);
}

.scoreboard-shell--fourball .fourball-track-lead__diff {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
  color: var(--text-primary);
}

.scoreboard-shell--fourball .fourball-track-lead__tee-half {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
}

.player-column {
  flex-shrink: 0;
  width: 128rpx;
  min-width: 128rpx;
  height: 100%;
  background: var(--bg-secondary);
  border-right: none;
  box-sizing: border-box;
}

.player-column__inner {
  width: 100%;
}

.player-column__spacer {
  width: 100%;
  border-bottom: 1px solid var(--border-color);
  box-sizing: border-box;
}

.player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  background: var(--bg-card);
  box-sizing: border-box;
}

.player-column__spacer.shell-row--par {
  background: var(--bg-primary);
}

.player-column__row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border-bottom: 1px solid var(--border-color);
  background: var(--bg-secondary);
  box-sizing: border-box;
}

.player-column__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}

.player-column__card .player-avatar-img {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

/* 昵称：字阶/字重/斜体/大写由 .player-name-line 提供；此处仅列内居中与宽度 */
.player-column__name {
  max-width: 100%;
  text-align: center;
}

.score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: var(--bg-primary);
}

.score-track__inner {
  display: inline-block;
  min-width: 100%;
}

.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  box-sizing: border-box;
}

.shell-row--par {
  min-height: 72rpx;
  box-sizing: border-box;
}

.shell-row--player {
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
}

.scoreboard-shell .scoreboard-row.shell-row--head,
.scoreboard-shell .scoreboard-row.shell-row--par,
.scoreboard-shell .scoreboard-row.shell-row--player {
  border-bottom: 1px solid var(--border-color);
}

/* score-track 前缀：diff + T 固定列宽（禁止 flex 收缩） */
.scoreboard-shell--basic .track-lead-diff,
.scoreboard-shell--game-single .track-lead-diff,
.track-lead-diff {
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  flex: 0 0 96rpx !important;
  flex-shrink: 0 !important;
  justify-content: center;
  padding: 8rpx 4rpx;
  background: var(--bg-secondary);
  border-right: none;
  overflow: visible;
  box-sizing: border-box;
}

.scoreboard-shell--basic .track-lead-tee,
.track-lead-tee {
  width: 32rpx !important;
  min-width: 32rpx !important;
  max-width: 32rpx !important;
  flex: 0 0 32rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  display: flex;
  /* 成绩行 T 线：与行同高（顶/底对齐），子色块用 height:100% / flex 均分 */
  align-items: stretch;
  justify-content: stretch;
  background: var(--bg-secondary);
  border-right: 1px solid var(--border-color);
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.track-lead-diff--head,
.track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--bg-card);
  box-sizing: border-box;
}

.track-lead-diff--par,
.track-lead-tee--par {
  background: var(--bg-primary);
}

.track-lead-diff__wrap {
  flex: none;
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  max-width: none;
  overflow: visible;
  opacity: 1 !important;
}

.scoreboard-shell--basic .track-lead-diff .player-diff-score {
  font-size: 32rpx;
  line-height: 1.1;
  white-space: nowrap;
}
/* game-single：diff 字阶对齐 G5（40rpx）；颜色/under·even·over 仍走全局 */
.scoreboard-shell--game-single .track-lead-diff .player-diff-score {
  font-size: 40rpx;
  line-height: 1.2;
  white-space: nowrap;
}

/* 普通创建单组：双栏 player-column + score-track（diff/T 在 track 内随横滑） */
.scoreboard-shell--game-single {
  position: relative;
}

/*
 * 纯 4+0：HOLE 以下完全复用 game-single；
 * 仅身份列改为 TEAM SCORE + 赛制名（宽仍 128rpx）。
 * HOLE 以上球员卡片走页面级 .bestball-roster-strip，不进本壳。
 */
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score {
  padding: 12rpx 6rpx;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-wrap {
  width: 100%;
  padding-right: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-kicker {
  font-size: 14rpx;
  letter-spacing: 0.12em;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .player-column__card--team-score .bestball-mode-main {
  font-size: 24rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 4+0：成绩行合成 T 线 — 满行高、四色上下均分；不改列宽 / 行高 */
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .scoreboard-row--player .track-lead-tee {
  align-items: stretch;
  justify-content: stretch;
  overflow: hidden;
  padding: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .track-lead-tee__composite,
.scoreboard-shell--game-single.scoreboard-shell--fourball40 .tee-sticky-overlay__row .track-lead-tee__composite {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-height: 0;
  align-self: stretch;
  box-sizing: border-box;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .track-lead-tee__seg {
  flex: 1 1 0;
  width: 100%;
  min-height: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40 .tee-sticky-overlay__row {
  align-items: stretch;
  padding: 0;
}

.scoreboard-shell--game-single.scoreboard-shell--fourball40.is-tee-sticky
  .score-track
  .track-lead-tee__composite {
  opacity: 0;
}

/* HOLE/PAR 方案A：初始标签 — 宽=身份区(128+96+6)，水平中心对齐；HOLE/PAR 分占 head/par 行 */
.scoreboard-shell--game-single .hole-par-normal-container {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 230rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole,
.scoreboard-shell--game-single .hole-par-normal-container__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole {
  height: 112rpx;
}
.scoreboard-shell--game-single .hole-par-normal-container__par {
  height: 72rpx;
}
/* HOLE/PAR 字阶对齐 G5 col-head/par-label；保留光学上移 */
.scoreboard-shell--game-single .hole-par-normal-container__hole text,
.scoreboard-shell--game-single .hole-par-normal-container__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.scoreboard-shell--game-single .hole-par-normal-container__hole text {
  transform: translateY(-3rpx);
}
.scoreboard-shell--game-single .hole-par-normal-container__par text {
  transform: translateY(-2rpx);
}

/* HOLE/PAR 方案A：吸边紧凑标签 — 宽=player-column 128rpx，水平中心对齐头像区；HOLE/PAR 分占 head/par 行 */
.scoreboard-shell--game-single .hole-par-compact-container {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 128rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
}
/* Phase1：compact 保留节点但不参与显示 */
.scoreboard-shell--game-single .hole-par-compact-container--phase1-hidden {
  opacity: 0;
  visibility: hidden;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole,
.scoreboard-shell--game-single .hole-par-compact-container__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole {
  height: 112rpx;
}
.scoreboard-shell--game-single .hole-par-compact-container__par {
  height: 72rpx;
}
/* compact 与 normal 统一字阶；保留光学上移 */
.scoreboard-shell--game-single .hole-par-compact-container__hole text,
.scoreboard-shell--game-single .hole-par-compact-container__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}
.scoreboard-shell--game-single .hole-par-compact-container__hole text {
  transform: translateY(-3rpx);
}
.scoreboard-shell--game-single .hole-par-compact-container__par text {
  transform: translateY(-2rpx);
}
.scoreboard-shell--game-single .player-column {
  position: relative;
  z-index: 3;
  background: transparent;
  border-right: none;
}
/* game-single：头像对齐 G5 80rpx；T 色仅走 T 线，头像无色环 */
.scoreboard-shell--game-single .player-column__card .player-avatar-img {
  width: 80rpx;
  height: 80rpx;
}
.scoreboard-shell--game-single .score-track {
  position: relative;
  z-index: 1;
  background: transparent;
  margin: 0;
  padding: 0;
}
/* HEADER：身份蓝（头像列 / lead 身）；TOTAL 头=交叉；TOTAL 身=身份 */
.scoreboard-shell--game-single .player-column__spacer.shell-row--par,
.scoreboard-shell--game-single .player-column__row {
  background: var(--score-header-identity);
  border-right: none;
  /* identity 区行分隔：交叉蓝，避免与 identity 底色过近 */
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}
/* HOLE × 身份交叉蓝（仅 head；无右边框/底边，底边由 track header row 统一绘制） */
.scoreboard-shell--game-single .player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-right: none;
  border-bottom: none;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--par,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player {
  background: transparent;
}
/* 记分行横向分隔：score-cell 铺底会盖住 row 的 border-bottom，改由 cell 自身绘制 */
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player .score-cell {
  border-bottom: 1px solid var(--border-color);
}
/* lead 身份蓝；HOLE 行 lead 用交叉蓝覆盖 */
.scoreboard-shell--game-single .track-lead-diff,
.scoreboard-shell--game-single .track-lead-diff--par,
.scoreboard-shell--game-single .track-lead-tee,
.scoreboard-shell--game-single .track-lead-tee--par {
  background: var(--score-header-identity) !important;
}
/* diff/T 身份区行分隔（par + 球员行；head 仍由 header row 统一绘制） */
.scoreboard-shell--game-single .track-lead-diff--par,
.scoreboard-shell--game-single .track-lead-tee--par,
.scoreboard-shell--game-single .scoreboard-row--player .track-lead-diff,
.scoreboard-shell--game-single .scoreboard-row--player .track-lead-tee {
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}
.scoreboard-shell--game-single .track-lead-diff--head,
.scoreboard-shell--game-single .track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection) !important;
  box-sizing: border-box;
}
/* head 底边由 row 绘制且不占高度，保证与左侧 spacer 交叉蓝同高 112rpx */
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--head.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  box-shadow: 0 1px 0 var(--border-color);
  overflow: hidden;
  box-sizing: border-box;
}
/* HOLE 行：1–18 + OUT/IN = HOLE蓝；TOTAL 头 = 交叉蓝（HOLE×身份） */
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
}
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}
.scoreboard-shell--game-single .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
}
/* OUT/IN 整列身 = HOLE蓝（与 1–18 一致；覆盖 special-par / special-cell） */
.scoreboard-shell--game-single .scoreboard-cell--hole-special-col {
  background: var(--score-header-hole);
}
/* TOTAL 身（PAR + 成绩格）= 身份蓝；行分隔用交叉蓝（不影响 1–18/OUT/IN） */
.scoreboard-shell--game-single .scoreboard-cell--tot-col {
  background: var(--score-header-identity);
}
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--par .scoreboard-cell--tot-col,
.scoreboard-shell--game-single .scoreboard-row.scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  border-bottom: 1px solid var(--score-header-intersection);
}
/* PAR 行 / 成绩格：保持原规则 */
.scoreboard-shell--game-single .scoreboard-row--par > .scoreboard-cell:nth-child(n + 3):not(.scoreboard-cell--special-par),
.scoreboard-shell--game-single .scoreboard-row--player .score-cell:not(.scoreboard-cell--special-cell) {
  background: var(--bg-primary);
}
/* track 内 T 列：宽=T线；底色同身份区；高度随成绩行 stretch */
.scoreboard-shell--game-single .track-lead-tee {
  width: 6rpx !important;
  min-width: 6rpx !important;
  max-width: 6rpx !important;
  flex: 0 0 6rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  border-right: none;
  overflow: hidden;
  box-sizing: border-box;
}
/* track 与 sticky overlay 共用：单色 T = 满行高 */
.scoreboard-shell--game-single .track-lead-tee .player-tee-marker,
.scoreboard-shell--game-single .track-lead-tee .track-lead-tee__mark,
.scoreboard-shell--game-single .tee-sticky-overlay__row .player-tee-marker,
.scoreboard-shell--game-single .tee-sticky-overlay__row .track-lead-tee__mark {
  position: static;
  right: auto;
  top: auto;
  bottom: auto;
  transform: none;
  width: 100%;
  height: 100%;
  align-self: stretch;
  margin: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}
/* T sticky overlay：宽=T线；左缘=player-column 右缘；高度=表内容（head+par+players） */
.scoreboard-shell--game-single .tee-sticky-overlay {
  position: absolute;
  left: 128rpx;
  top: 0;
  /* 禁止 bottom/height:100% 撑满 shell，避免底部灰色延长线 */
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
}
.scoreboard-shell--game-single .tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}
.scoreboard-shell--game-single .tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}
/* head spacer = 交叉蓝；par spacer = 身份蓝（与 lead 对齐） */
.scoreboard-shell--game-single .tee-sticky-overlay__spacer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  background: var(--score-header-identity) !important;
  border-bottom: 1px solid var(--border-color);
}
.scoreboard-shell--game-single .tee-sticky-overlay__inner > .tee-sticky-overlay__spacer.shell-row--head {
  background: var(--score-header-intersection) !important;
}
/* player row：与 .shell-row--player 同高；stretch 使 T 线顶底对齐成绩行 */
.scoreboard-shell--game-single .tee-sticky-overlay__row {
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  background: var(--score-header-identity) !important;
  box-sizing: border-box;
}
/* sticky 显示时隐藏 track 内原始 T，避免双线（不改 DOM） */
.scoreboard-shell--game-single.is-tee-sticky .score-track .track-lead-tee .player-tee-marker,
.scoreboard-shell--game-single.is-tee-sticky .score-track .track-lead-tee .track-lead-tee__mark {
  opacity: 0;
}

/* ===== Match Play Shell：对齐 stroke shell（player-column + HOLE/PAR overlay + track lead + T sticky）===== */
.scoreboard-shell--match-play {
  position: relative;
}

.scoreboard-shell--match-play .player-column {
  width: 128rpx;
  min-width: 128rpx;
  height: 100%;
  position: relative;
  z-index: 3;
  background: transparent;
  border-right: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .score-track {
  flex: 1;
  min-width: 0;
  height: 100%;
  position: relative;
  z-index: 1;
  background: transparent;
}

/* HOLE/PAR normal：宽 230rpx，仅文字+横移（无铺底，同 game-single，避免 translate 时蓝底伸入洞列） */
.scoreboard-shell--match-play .match-play-hole-par-normal {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 230rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
  background: transparent;
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole,
.scoreboard-shell--match-play .match-play-hole-par-normal__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole {
  height: 112rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__par {
  height: 72rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole text,
.scoreboard-shell--match-play .match-play-hole-par-normal__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.scoreboard-shell--match-play .match-play-hole-par-normal__hole text {
  transform: translateY(-3rpx);
}

.scoreboard-shell--match-play .match-play-hole-par-normal__par text {
  transform: translateY(-2rpx);
}

/* compact：宽=头像列 128rpx + 浅蓝底；仅 T sticky 吸边后显示 */
.scoreboard-shell--match-play .match-play-hole-par-compact {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  width: 128rpx;
  height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  /* 吸边时：上 HOLE 交叉蓝 + 下 PAR 身份蓝（实色分段，非 rgba） */
  background: linear-gradient(
    to bottom,
    var(--score-header-intersection) 0,
    var(--score-header-intersection) 112rpx,
    var(--score-header-identity) 112rpx,
    var(--score-header-identity) 100%
  );
  opacity: 0;
  visibility: hidden;
}

.scoreboard-shell--match-play .match-play-hole-par-compact--hidden {
  opacity: 0;
  visibility: hidden;
}

/* 未吸边：只允许 normal；compact 强制隐藏（互斥） */
.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-normal {
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-compact,
.scoreboard-shell--match-play:not(.is-match-play-tee-sticky) .match-play-hole-par-compact.match-play-hole-par-compact--hidden {
  opacity: 0 !important;
  visibility: hidden !important;
}

/* 已吸边：只允许 compact；normal 强制隐藏（互斥） */
.scoreboard-shell--match-play.is-match-play-tee-sticky .match-play-hole-par-normal {
  opacity: 0 !important;
  visibility: hidden !important;
}

.scoreboard-shell--match-play.is-match-play-tee-sticky .match-play-hole-par-compact,
.scoreboard-shell--match-play.is-match-play-tee-sticky .match-play-hole-par-compact.match-play-hole-par-compact--hidden {
  opacity: 1 !important;
  visibility: visible !important;
}

.scoreboard-shell--match-play .match-play-hole-par-compact__hole,
.scoreboard-shell--match-play .match-play-hole-par-compact__par {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-hole-par-compact__hole {
  height: 112rpx;
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-hole-par-compact__par {
  height: 72rpx;
}

.scoreboard-shell--match-play .match-play-hole-par-compact__hole text,
.scoreboard-shell--match-play .match-play-hole-par-compact__par text {
  display: block;
  width: 100%;
  text-align: center;
  color: var(--text-secondary);
  line-height: 1;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
}

.scoreboard-shell--match-play .player-column__card .player-avatar-img {
  width: 80rpx;
  height: 80rpx;
}

/* HEADER V2：身份蓝 / HOLE×lead 交叉蓝 */
.scoreboard-shell--match-play .player-column__spacer.shell-row--par,
.scoreboard-shell--match-play .player-column__row {
  background: var(--score-header-identity);
  border-right: none;
  /* identity 区行分隔：交叉蓝，避免与 identity 底色过近 */
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

.scoreboard-shell--match-play .player-column__spacer.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection);
  border-right: none;
  border-bottom: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-side-row {
  height: 156rpx;
  min-height: 156rpx;
}

.scoreboard-shell--match-play .match-play-status-row {
  height: 100rpx;
  min-height: 100rpx;
  justify-content: center;
  /* 对齐 FINAL 胜洞格 .match-status-cell--tot（DARK） */
  background: rgba(0, 45, 98, 0.22);
}

/* 胜洞走势标题 overlay：初始覆盖头像+diff+T（230rpx），与 HOLE/PAR 共用横移 style */
.scoreboard-shell--match-play .match-play-status-title-normal {
  position: absolute;
  /* head 112 + par 72 + Side A 156 */
  left: 0;
  top: 340rpx;
  z-index: 4;
  width: 230rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  will-change: transform;
  /* 透出下层 FINAL 固定区底色，避免横移时涂到洞列 */
  background: transparent;
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-status-title-normal.is-faded {
  opacity: 0;
  visibility: hidden;
}

.scoreboard-shell--match-play .match-play-status-title-normal .match-label-wrap {
  width: 100%;
  padding: 0 8rpx;
}

/* 吸边 compact：宽=头像列 128 + T线 6，阈值后显示 */
.scoreboard-shell--match-play .match-play-status-title-compact {
  position: absolute;
  left: 0;
  top: 340rpx;
  z-index: 4;
  width: 134rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  pointer-events: none;
  box-sizing: border-box;
  opacity: 0;
  visibility: hidden;
  background: rgba(0, 45, 98, 0.22);
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-status-title-compact.is-visible {
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-status-title-compact .match-label-wrap {
  width: 100%;
  padding: 0 4rpx;
}

.scoreboard-shell--match-play .match-play-status-title-compact .match-label-main {
  font-size: 20rpx;
}

/* track-lead：与 game-single 同宽（diff 96 / T 6）；底色见下方 HEADER V2 */
.scoreboard-shell--match-play .track-lead-diff,
.scoreboard-shell--match-play .track-lead-diff--head,
.scoreboard-shell--match-play .track-lead-diff--par,
.scoreboard-shell--match-play .track-lead-diff--status {
  width: 96rpx !important;
  min-width: 96rpx !important;
  max-width: 96rpx !important;
  flex: 0 0 96rpx !important;
  flex-shrink: 0 !important;
  justify-content: center;
  padding: 8rpx 4rpx;
  border-right: none;
  overflow: visible;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-diff .player-diff-score {
  font-size: 40rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.scoreboard-shell--match-play .track-lead-tee,
.scoreboard-shell--match-play .track-lead-tee--head,
.scoreboard-shell--match-play .track-lead-tee--par,
.scoreboard-shell--match-play .track-lead-tee--status {
  width: 6rpx !important;
  min-width: 6rpx !important;
  max-width: 6rpx !important;
  flex: 0 0 6rpx !important;
  flex-shrink: 0 !important;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  border-right: none;
  overflow: hidden;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-tee .player-tee-marker,
.scoreboard-shell--match-play .track-lead-tee .track-lead-tee__mark,
.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row .player-tee-marker,
.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row .track-lead-tee__mark {
  position: static;
  right: auto;
  top: auto;
  bottom: auto;
  transform: none;
  width: 100%;
  height: 100%;
  align-self: stretch;
  margin: 0;
  flex-shrink: 0;
  box-sizing: border-box;
}

/* HEADER V2：lead 身份蓝；HOLE 行 lead 交叉蓝 */
.scoreboard-shell--match-play .track-lead-diff,
.scoreboard-shell--match-play .track-lead-diff--par,
.scoreboard-shell--match-play .track-lead-tee,
.scoreboard-shell--match-play .track-lead-tee--par {
  background: var(--score-header-identity) !important;
}

/* diff/T 身份区行分隔（par + 球员行；head 仍由 header row 统一绘制） */
.scoreboard-shell--match-play .track-lead-diff--par,
.scoreboard-shell--match-play .track-lead-tee--par,
.scoreboard-shell--match-play .scoreboard-row--player .track-lead-diff,
.scoreboard-shell--match-play .scoreboard-row--player .track-lead-tee {
  border-bottom: 1px solid var(--score-header-intersection);
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-diff--head,
.scoreboard-shell--match-play .track-lead-tee--head {
  height: 112rpx;
  min-height: 112rpx;
  background: var(--score-header-intersection) !important;
  box-sizing: border-box;
}
/* head 底边由 row 绘制且不占高度，保证与左侧 spacer 交叉蓝同高 112rpx */
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--head.shell-row--head {
  height: 112rpx;
  min-height: 112rpx;
  border-bottom: none;
  box-shadow: 0 1px 0 var(--border-color);
  overflow: hidden;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .track-lead-diff--status,
.scoreboard-shell--match-play .track-lead-tee--status {
  height: 100rpx;
  min-height: 100rpx;
  /* 对齐 FINAL 胜洞格 .match-status-cell--tot（DARK） */
  background: rgba(0, 45, 98, 0.22) !important;
}

.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--par,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player {
  background: transparent;
}

/* 与 game-single 一致：HOLE/PAR 行保留分隔线；球员行仍由 cell 绘底边 */
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--head,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--par {
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player {
  border-bottom: none;
}

/* HOLE 1–18 = HOLE蓝；FINAL 头 = 交叉蓝；FINAL 身 = 身份蓝 */
.scoreboard-shell--match-play .scoreboard-row--head .scoreboard-cell--head:not(.scoreboard-cell--special-head) {
  background: var(--score-header-hole);
}

.scoreboard-shell--match-play .scoreboard-row--head .scoreboard-cell--special-head {
  background: var(--score-header-hole);
}

.scoreboard-shell--match-play .scoreboard-row--head .scoreboard-cell--tot-head {
  background: var(--score-header-intersection);
}

/* OUT/IN 整列身 = HOLE蓝（与 1–18 一致） */
.scoreboard-shell--match-play .scoreboard-cell--hole-special-col {
  background: var(--score-header-hole);
}

.scoreboard-shell--match-play .scoreboard-cell--tot-col {
  background: var(--score-header-identity);
}
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--par .scoreboard-cell--tot-col,
.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player .score-cell.scoreboard-cell--tot-col {
  border-bottom: 1px solid var(--score-header-intersection);
}

/* PAR 行洞格：保持原规则 */
.scoreboard-shell--match-play .scoreboard-row--par > .scoreboard-cell:nth-child(n + 3):not(.scoreboard-cell--special-par) {
  background: var(--bg-primary);
}

.scoreboard-shell--match-play .scoreboard-row.scoreboard-row--player .score-cell {
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .scoreboard-row.match-status-row .match-status-cell,
.scoreboard-shell--match-play .scoreboard-row.match-status-row .track-lead-diff--status,
.scoreboard-shell--match-play .scoreboard-row.match-status-row .track-lead-tee--status {
  border-bottom: 1px solid var(--border-color);
}

/* match-play T sticky overlay（独立类名，不改 G1 tee-sticky-overlay） */
.scoreboard-shell--match-play .match-play-tee-sticky-overlay {
  position: absolute;
  left: 128rpx;
  top: 0;
  width: 6rpx;
  height: auto;
  max-height: 100%;
  z-index: 2;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  background: transparent;
  margin: 0;
  padding: 0;
  border: none;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__inner {
  width: 100%;
  height: auto;
  min-height: 0;
  background: transparent;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__spacer {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 0;
  background: var(--score-header-identity) !important;
  border-bottom: 1px solid var(--border-color);
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__inner > .match-play-tee-sticky-overlay__spacer.shell-row--head {
  background: var(--score-header-intersection) !important;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__row {
  display: flex;
  align-items: stretch;
  justify-content: stretch;
  width: 100%;
  height: 156rpx;
  min-height: 156rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  background: var(--score-header-identity) !important;
  box-sizing: border-box;
}

.scoreboard-shell--match-play .match-play-tee-sticky-overlay__status {
  width: 100%;
  height: 100rpx;
  min-height: 100rpx;
  margin: 0;
  padding: 0;
  border-bottom: 1px solid var(--border-color);
  /* 对齐 FINAL 胜洞格 .match-status-cell--tot（DARK） */
  background: rgba(0, 45, 98, 0.22) !important;
  box-sizing: border-box;
}

.scoreboard-shell--match-play.is-match-play-tee-sticky .score-track .track-lead-tee .player-tee-marker,
.scoreboard-shell--match-play.is-match-play-tee-sticky .score-track .track-lead-tee .track-lead-tee__mark {
  opacity: 0;
}

/* 胜洞趋势固定区 + compact + sticky T 状态段：对齐 FINAL bright */
.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-row,
.score-page.bright-mode .scoreboard-shell--match-play .track-lead-diff--status,
.score-page.bright-mode .scoreboard-shell--match-play .track-lead-tee--status,
.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-title-compact,
.score-page.bright-mode .scoreboard-shell--match-play .match-play-tee-sticky-overlay__status {
  background: rgba(0, 45, 98, 0.04) !important;
}

.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-title-normal .match-label-main,
.score-page.bright-mode .scoreboard-shell--match-play .match-play-status-title-compact .match-label-main {
  color: #002d62;
}

/* 公共单色 T：高度 = 成绩行（父级 track-lead-tee / sticky row）100% */
.track-lead-tee__mark,
.track-lead-tee .player-tee-marker {
  position: static;
  flex-shrink: 0;
  width: 6rpx;
  height: 100%;
  align-self: stretch;
  top: auto;
  right: auto;
  bottom: auto;
  box-sizing: border-box;
}

.scoreboard-inner { display: inline-block; min-width: 100%; }

.scoreboard-row {
  display: flex;
  border-bottom: 1px solid var(--border-color);
  min-width: max-content;
}

.scoreboard-row--head { background: var(--bg-card); }
.scoreboard-row--par { background: var(--bg-primary); }
.scoreboard-row--player { height: 156rpx; }

.scoreboard-cell {
  width: 144rpx;
  min-width: 144rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  border-right: 1px solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.sticky-col {
  position: sticky;
  left: 0;
  z-index: 20;
  /* 原型机制：球员列宽度由 CSS 变量驱动（所有行共用，故缩放时不会错位） */
  width: var(--player-col-width, 240rpx);
  min-width: var(--player-col-width, 240rpx);
  background: var(--bg-secondary);
  transition: width 0.25s ease, min-width 0.25s ease;
}

.scoreboard-row--head .sticky-col { background: var(--bg-card); }

.player-col-header {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
  padding-left: var(--player-col-padding-x, 24rpx);
  padding-right: var(--player-col-padding-x, 24rpx);
  transition: padding 0.25s ease;
}

.col-head-label,
.col-par-label {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.par-val { font-size: 24rpx; font-weight: 700; color: var(--text-secondary); }

.scoreboard-cell--special-head { background: rgba(0, 45, 98, 0.2); }
.scoreboard-cell--special-par { background: var(--bg-card); }
.scoreboard-cell--special-cell { background: rgba(0, 45, 98, 0.05); }

.hole-label-wrap { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }

.hole-number,
.hole-label-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.hole-number {
  background: #002d62 !important;
  color: #ffffff !important;
  border: 1px solid #002d62;
}

/* G5–G8 比洞：自动起始洞 HOLE 金底白字 */
.hole-label-circle--start {
  background: var(--champion-gold, #ce9224) !important;
  color: #ffffff !important;
  border: 1px solid var(--champion-gold, #ce9224);
}

.hole-label-circle--special {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

/* DARK：OUT/IN/TOTAL special label 独立于 HOLE 数字圆标（不套用蓝底白字） */
.score-page.dark-mode .hole-label-circle--special {
  background: var(--score-header-identity);
  border: 1px solid var(--score-header-intersection);
  color: var(--text-secondary);
}

/* Player cell */
.player-cell {
  justify-content: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  padding-left: var(--player-col-padding-x, 24rpx);
  padding-right: var(--player-col-padding-x, 24rpx);
  transition: padding 0.25s ease;
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
}

.player-card { width: 100%; min-width: 0; }

.player-top-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.player-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  /* T 色统一由 T 线展示；取消头像 colorClass / 内联 teeColor 色环 */
  border: none !important;
}

.player-avatar-img.border-red,
.player-avatar-img.border-gold,
.player-avatar-img.border-white,
.player-avatar-img.border-light,
.player-avatar-img.border-black {
  border: none !important;
}

.player-diff-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
  overflow: hidden;
  opacity: var(--player-diff-opacity, 1);
  transition: opacity 0.25s ease;
}

.player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1.2;
}

.player-name-line {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-secondary);
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: var(--player-name-width, 192rpx);
  transition: max-width 0.25s ease;
}

/* Legacy 身份列绝对定位 T：顶底贴齐成绩行（不再只盖头像区中段） */
.player-tee-marker {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.player-tee-marker.border-red { background: #dc2626; }
.player-tee-marker.border-gold { background: var(--champion-gold); }
.player-tee-marker.border-white { background: var(--text-primary); }
.player-tee-marker.border-light { background: #00aeef; }
.player-tee-marker.border-black { background: #111827; }

.diff-under { color: #ef4444 !important; }
.diff-even { color: var(--par-color) !important; }
.diff-over { color: var(--text-secondary) !important; }

.player-diff-score.diff-under { color: #ef4444; }
.player-diff-score.diff-even { color: var(--par-color); }

/* Score cells */
.score-cell { padding: 8rpx; min-height: 156rpx; }

.hole-cell-inner,
.special-cell-inner {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 注意：不要 position:relative，否则底部推杆/杆差会被锚到本内框（居中漂浮），
     而不是记分格真正的底边。让其锚定到 .scoreboard-cell。 */
}

.hole-cell-score,
.special-cell-val {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
}

.special-cell-val { color: var(--text-secondary); font-style: italic; }

/* 杆差模式：仅缩小主成绩文字（含正负号），圆圈/方框容器尺寸保持不变 */
.hole-cell-score--diff { font-size: 40rpx; }

/* 无成绩：T 台码数提示（浅灰小字） */
.hole-cell-score--hint {
  font-size: 24rpx;
  font-weight: 500;
  color: #9ca3af;
}

/* TOT 列：主题联动颜色，!important 防止任何局部/语义色覆盖 */
.special-cell-val--tot,
.tot-value { color: var(--tot-color) !important; }

/* ===== 成绩标记统一外框系统：四类共用同一 marker-size + border-box，仅视觉不同（圆/圈/框/底） =====
   关键：固定 width/height + box-sizing:border-box，border 不撑大外框、内容不撑形状，四态外轮廓完全一致 */
.score-birdie,
.score-eagle,
.score-bogey,
.score-double {
  --score-marker-size: 72rpx;
  width: var(--score-marker-size);
  height: var(--score-marker-size);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小鸟：红圈（描边、内部透明） */
.score-birdie { border: 4rpx solid #ef4444; border-radius: 9999rpx; }
.score-birdie .hole-cell-score { color: #ef4444; }

/* 老鹰及更好（-2 及更好）：圆底白字（实心圆，固定外框，非内容撑圆） */
.score-eagle { background: #ef4444; border-radius: 9999rpx; }
.score-eagle .hole-cell-score { color: #ffffff; }

/* 加一：方框（描边、内部透明） */
.score-bogey { border: 2rpx solid var(--text-secondary); }

/* 加二及更差（+2 及以上）：灰底白字（实心灰底） */
.score-double { background: #6b7280; border-radius: 8rpx; }
.score-double .hole-cell-score { color: #ffffff; }

.hole-cell-meta,
.special-cell-meta {
  position: absolute;
  bottom: 4rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.hole-cell-putt,
.special-cell-putt {
  font-size: 16rpx;
  font-weight: 700;
  color: #00aeef;
  opacity: 0.8;
  line-height: 1;
}

.hole-cell-diff,
.special-cell-diff {
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
}

.triangle-red,
.triangle-blue {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 28rpx 28rpx 0;
  z-index: 5;
  pointer-events: none;
}

.triangle-red { border-color: transparent #ef4444 transparent transparent; }
.triangle-blue { border-color: transparent #3b82f6 transparent transparent; }

/* 名次腰线（第三/第四名）：在右上三角内部画一条白色斜线（左上→右下），裁剪于三角形内不外溢。
   三角尺寸/位置不变（仍为 28rpx 角标），本元素只叠加白线，颜色由下层 triangle 提供。 */
.corner-waist {
  position: absolute;
  top: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  z-index: 6;
  pointer-events: none;
  /* 与红/蓝三角同形：右上角三角（斜边由左上 → 右下），用于裁剪白线，确保不超出三角边界 */
  clip-path: polygon(0 0, 100% 0, 100% 100%);
}
.corner-waist::after {
  content: "";
  position: absolute;
  /* 统一中腰位置：直角顶点(右上,100%,0)到斜边(左上→右下)垂足(50%,50%)的中点 = (75%,25%) */
  top: 25%;
  left: 75%;
  width: 24rpx;
  height: 3rpx;
  background: #ffffff;
  /* 左上 → 右下方向的斜线（屏幕坐标顺时针 45°），并裁剪在三角内部 */
  transform: translate(-50%, -50%) rotate(45deg);
  transform-origin: center;
}

/* Floating Actions */
.score-actions {
  flex-shrink: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
  display: flex;
  gap: 24rpx;
}

.score-actions__primary {
  flex: 1;
  background: #002d62;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
}

.score-actions__primary.is-disabled {
  background: #9ca3af;
  color: #f3f4f6;
  opacity: 0.72;
}

.score-actions__secondary {
  flex: 1;
  background: transparent;
  border: 1px solid var(--border-color);
  color: #00aeef;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
}

/* Discussion Panel */
.score-discussion-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: var(--discussion-bg);
  color: var(--text-primary);
}
/* 讨论区组件填满面板剩余空间（组件内部自管 围观/聊天滚动/输入 三层布局） */
.score-discussion-panel discussion {
  flex: 1;
  min-height: 0;
  display: block;
}

.discussion-watchers-strip {
  height: 96rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 24rpx;
  border-bottom: 1px solid var(--discussion-border);
  background: var(--discussion-strip);
  white-space: nowrap;
  flex-shrink: 0;
}

.discussion-watchers-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-right: 4rpx;
  flex-shrink: 0;
}

.discussion-avatar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  border: 4rpx solid var(--discussion-border);
  overflow: hidden;
  flex-shrink: 0;
}

.discussion-avatar-btn image { width: 100%; height: 100%; display: block; }

.discussion-more-btn {
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1px solid var(--discussion-border);
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--discussion-bubble);
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.discussion-chat {
  flex: 1;
  min-height: 0;
  padding: 28rpx 24rpx 36rpx;
}

.discussion-time {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin: 8rpx 0 28rpx;
}

.chat-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.chat-row--self { flex-direction: row-reverse; }

.chat-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.chat-body { max-width: 72%; }

.chat-meta {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  margin: 0 0 8rpx 4rpx;
}

.chat-row--self .chat-meta { text-align: right; margin-right: 4rpx; }

.chat-bubble {
  background: var(--discussion-bubble);
  color: var(--text-primary);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.chat-row--self .chat-bubble { background: #0f4b32; color: #ffffff; }
.score-page.bright-mode .chat-row--self .chat-bubble { background: #d9fdd3; color: #0f172a; }

.discussion-attach-panel {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 24rpx;
  background: var(--discussion-bar);
  border-top: 1px solid var(--discussion-border);
  flex-shrink: 0;
}

.attach-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.attach-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: var(--discussion-bubble);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--champion-gold);
  font-size: 32rpx;
}

.discussion-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--discussion-border);
  background: var(--discussion-bar);
}

.discussion-input {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  border: 1px solid var(--discussion-border);
  background: var(--discussion-input-bg);
  color: var(--text-primary);
  padding: 0 24rpx;
  font-size: 26rpx;
}

.discussion-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  flex-shrink: 0;
  font-size: 36rpx;
}

.discussion-send {
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: #002d62;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* ===== 更多功能面板（与中间页 M 按钮 bottom-sheet 规范一致） ===== */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 150; }
.bottom-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; color: var(--tour-blue); border-radius: 80rpx 80rpx 0 0; overflow: hidden; z-index: 180; box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35); padding-bottom: env(safe-area-inset-bottom); }
.sheet-handle { width: 96rpx; height: 8rpx; border-radius: 999rpx; background: #e5e7eb; margin: 24rpx auto 40rpx; }
.feature-section { padding: 0 48rpx 24rpx; }
.feature-section--menu { max-height: 62vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
/* Sheet Header 统一：左对齐主标题 + 副标题 */
.feature-section-title {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin: 0 0 24rpx;
  padding: 0;
  color: var(--golf-blue);
}
.fst-main {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--golf-blue);
  line-height: 1.3;
}
.fst-sub {
  font-style: normal;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-secondary, #9ca3af);
  letter-spacing: 0.08em;
  line-height: 1.3;
}
.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 24rpx; row-gap: 32rpx; }
.feature-item { display: flex; flex-direction: column; align-items: center; min-height: 156rpx; }
.feature-item.is-disabled {
  opacity: 0.46;
}
.feature-icon { width: 112rpx; height: 112rpx; border-radius: 24rpx; background: var(--tour-blue); color: var(--champion-gold); display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; font-size: 44rpx; box-shadow: 0 12rpx 24rpx rgba(0, 45, 98, 0.18); }
.feature-icon.danger { background: #ff5722; color: #fff; }
.feature-icon.warning { background: #ffc107; color: var(--tour-blue); }
.feature-label { color: var(--tour-blue); font-size: 20rpx; line-height: 1.2; font-weight: 800; text-align: center; }
.feature-item--empty { visibility: hidden; pointer-events: none; }
.sheet-cancel-wrap { padding: 4rpx 48rpx 48rpx; }
/* Score Sheet 主按钮规范：88 / 12 / 蓝底白字 */
.sheet-cancel-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
  border-radius: 12rpx;
  font-weight: 900;
  font-size: 24rpx;
  letter-spacing: 0.18em;
  box-sizing: border-box;
}


/* ===== 显示设置 sheet（对齐 Hub/M · detail .style-sheet） ===== */
.style-sheet { position: fixed; left: 0; right: 0; bottom: 0; transform: translateY(100%); background: var(--bg-card); color: var(--text-primary); border-radius: 48rpx 48rpx 0 0; border: 1px solid var(--border); z-index: 260; transition: transform 0.25s ease; box-shadow: 0 -36rpx 80rpx rgba(0, 0, 0, 0.35); padding-bottom: max(40rpx, env(safe-area-inset-bottom)); }
.style-sheet.active { transform: translateY(0); }
.style-sheet__head { display: flex; align-items: flex-start; justify-content: space-between; padding: 36rpx 40rpx 8rpx; }
.style-sheet__title { display: block; font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.style-sheet__sub { display: block; font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; }
.style-sheet__close { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; }
.style-section { padding: 36rpx 40rpx 0; }
.style-section-title { display: block; font-size: 24rpx; font-weight: 700; color: var(--text-secondary); margin-bottom: 20rpx; }
.style-option-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.style-option { height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 12rpx; border: 1px solid var(--border-hover); background: var(--bg-subtle); color: var(--text-secondary); font-size: 26rpx; font-weight: 700; }
.style-option.active { border-color: var(--champion-gold); background: var(--golf-blue); color: #fff; box-shadow: inset 0 -6rpx 0 var(--champion-gold); }
.style-done-wrap { padding: 48rpx 40rpx 0; }
.style-done-btn { height: 88rpx; line-height: 88rpx; text-align: center; background: var(--golf-blue); color: #fff; border-radius: 12rpx; font-weight: 700; font-size: 28rpx; }

/* Bottom Sheet 通用 Dark：背景/标题/辅助字/边框走页面 token，避免白底 */
.score-page.dark-mode .bottom-sheet {
  background: var(--bg-card);
  color: var(--text-primary);
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.55);
}
.score-page.dark-mode .sheet-handle {
  background: var(--border-color);
}
.score-page.dark-mode .feature-section-title,
.score-page.dark-mode .fst-main {
  color: var(--text-primary);
}
.score-page.dark-mode .fst-sub {
  color: var(--text-secondary);
}
.score-page.dark-mode .feature-label {
  color: var(--text-primary);
}
/* Dark 主按钮保持蓝底白字，不受文字 token 影响 */
.score-page.dark-mode .sheet-cancel-btn {
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
}

.score-page.dark-mode .edit-tee-row {
  border-bottom-color: var(--border-color);
}
.score-page.dark-mode .edit-tee-row__name {
  color: var(--text-primary);
}

/* ===== 编辑类 Sheet 统一：修改T台 / 修改起始洞（Header=fst，Footer/按钮同规） ===== */
.edit-tee-sheet,
.start-hole-sheet {
  z-index: 190;
  padding: 0 48rpx 32rpx;
}
.edit-tee-sheet {
  max-height: 78vh;
}
.edit-tee-sheet__title,
.start-hole-sheet__title {
  margin-bottom: 24rpx;
}
.edit-tee-sheet__list {
  max-height: 52vh;
  margin-bottom: 24rpx;
}
.edit-tee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.28);
}
.edit-tee-row:last-child { border-bottom: none; }
.edit-tee-row__player {
  width: 120rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.edit-tee-row__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.25);
}
.edit-tee-row__name {
  max-width: 120rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.edit-tee-row__dots {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 34rpx;
  padding-right: 4rpx;
}
/* 扩大可点区域，视觉圆点仍居中 */
.edit-tee-dot-hit {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.edit-tee-dot {
  width: 23rpx;
  height: 23rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  opacity: 1;
  transition: width 0.15s ease, height 0.15s ease;
}
/* BRIGHT：白T需边框才可辨认 */
.edit-tee-dot--white {
  border-color: rgba(100, 116, 139, 0.65);
}
/* DARK：黑T需边框才可辨认（亮色模式黑T本身对比足够，边框保持淡） */
.edit-tee-dot--black {
  border-color: transparent;
}
.edit-tee-dot--selected {
  width: 54rpx;
  height: 54rpx;
  opacity: 1;
  transform: none;
  box-shadow: none;
}
.edit-tee-dot--selected.edit-tee-dot--white {
  border-color: rgba(100, 116, 139, 0.65);
}
.edit-tee-dot--selected.edit-tee-dot--black {
  border-color: transparent;
}
.score-page.dark-mode .edit-tee-dot--white {
  border-color: rgba(226, 232, 240, 0.7);
}
.score-page.dark-mode .edit-tee-dot--black {
  border-color: rgba(226, 232, 240, 0.55);
}
.score-page.dark-mode .edit-tee-dot--selected.edit-tee-dot--white {
  border-color: rgba(226, 232, 240, 0.7);
}
.score-page.dark-mode .edit-tee-dot--selected.edit-tee-dot--black {
  border-color: rgba(226, 232, 240, 0.55);
}

.start-hole-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
  margin-bottom: 32rpx;
  justify-items: center;
}
/* 未选中：蓝底白字圆钮；选中：金底白字（真实洞号 A1–B9） */
.start-hole-cell {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  border: none;
  background: #002d62;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.start-hole-cell--active {
  background: #ce9224;
  border: none;
  color: #fff;
}
.score-page.dark-mode .start-hole-cell {
  background: #002d62;
  border: none;
  color: #fff;
}
.score-page.dark-mode .start-hole-cell--active {
  background: #ce9224;
  border: none;
  color: #fff;
}

/* 编辑类 Footer + 取消/确认（确认继承主按钮；取消描边次级） */
.edit-tee-sheet__footer,
.start-hole-sheet__footer {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0 16rpx;
  flex-shrink: 0;
}
.edit-tee-sheet__btn-cancel,
.edit-tee-sheet__btn-confirm,
.start-hole-sheet__btn-cancel,
.start-hole-sheet__btn-confirm {
  flex: 1;
}
.edit-tee-sheet__btn-cancel,
.start-hole-sheet__btn-cancel {
  background: transparent;
  color: var(--text-primary, #111827);
  border: 2rpx solid rgba(148, 163, 184, 0.45);
  font-weight: 900;
  font-size: 24rpx;
}
.edit-tee-sheet__btn-confirm,
.start-hole-sheet__btn-confirm {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
}
.score-page.dark-mode .edit-tee-sheet__btn-cancel,
.score-page.dark-mode .start-hole-sheet__btn-cancel {
  background: transparent;
  color: var(--text-primary);
  border-color: var(--border-color);
}
.score-page.dark-mode .edit-tee-sheet__btn-confirm,
.score-page.dark-mode .start-hole-sheet__btn-confirm {
  background: var(--golf-blue, #002d62);
  color: #ffffff;
  border: none;
}

/* More / 编辑 Sheet — DARK：顶蓝线 + handle（通用 bottom-sheet） */
.bottom-sheet--more-menu { overflow: hidden; }
.sheet-top-accent { display: none; }
.score-page.dark-mode .bottom-sheet .sheet-top-accent {
  display: block;
  width: 100%;
  height: 3px;
  background: #002d62;
  flex-shrink: 0;
}
.score-page.dark-mode .bottom-sheet--more-menu .feature-section-title,
.score-page.dark-mode .bottom-sheet--more-menu .feature-label { color: var(--text-primary); }
.score-page.dark-mode .bottom-sheet--more-menu .fst-sub { color: var(--text-secondary); }
.score-page.dark-mode .bottom-sheet--more-menu .feature-item:active { opacity: 0.72; }

.sheet-overlay--half { z-index: 210; }
/* 修改半场：panel 必须高于 mask，否则遮罩拦截全部点击 */
.bottom-sheet.half-course-sheet {
  z-index: 230;
  pointer-events: auto;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 0;
  background: #fff;
}
.half-course-sheet .half-course-panel {
  pointer-events: auto;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* Score Input Sheet */
.score-input-sheet {
  position: fixed;
  inset: 0;
  z-index: 500;
}

.score-input-sheet__mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
}

.score-input-sheet__panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-card);
  border-radius: 96rpx 96rpx 0 0;
  border-top: 6rpx solid #002d62;
  transform: translateY(100%);
  transition: transform 0.3s;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.score-input-sheet__panel--open { transform: translateY(0); }

.score-input-sheet__handle {
  width: 128rpx;
  height: 8rpx;
  background: var(--border-color);
  border-radius: 999rpx;
  margin: 24rpx auto 32rpx;
}

.panel-mode-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  margin: 0 auto 24rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
}

.panel-mode-btn {
  height: 56rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
}

.panel-mode-btn--active {
  background: #002d62;
  color: #ffffff;
}

.sheet-hole-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.sheet-hole-nav__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.sheet-hole-label {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #002d62;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  border: 4rpx solid #ffffff;
}

.sheet-hole-meta {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.sheet-hole-meta__item { display: flex; gap: 8rpx; align-items: center; }
.sheet-hole-meta__val { color: var(--text-primary); font-size: 24rpx; }
.sheet-hole-meta__val--light { color: var(--aux-text); }

.score-sheet-layout {
  display: flex;
  padding: 0 32rpx;
  gap: 16rpx;
  height: 600rpx;
}

.sheet-player-list {
  width: 264rpx;
  min-width: 264rpx;
  background: var(--bg-primary);
  border-radius: 48rpx;
  padding: 16rpx 12rpx;
  overflow: hidden;
}

.sheet-player-item {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  border-radius: 24rpx;
}

.sheet-player-item--active {
  background: var(--highlight-surface);
  border-right: 4rpx solid var(--highlight-color);
}

/* 非 active 不通过 opacity 灰化，保持正常可读 */
.sheet-player-item--inactive { opacity: 1; }

.sheet-player-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.sheet-player-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--border-color);
}

.sheet-player-name {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-primary);
  max-width: 96rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* 选中行球员名使用高亮色文字，进一步强化当前选中态 */
.sheet-player-item--active .sheet-player-name { color: var(--highlight-text); }

.sheet-hole-score {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: var(--score-surface);
  border: 1px solid var(--score-border);
  color: var(--score-color);
  font-size: 30rpx;
  font-weight: 900;
  font-style: italic;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 当前编辑未确认草稿（通用兜底；Bright active 另有覆盖） */
.sheet-hole-score--draft {
  color: var(--text-muted, #9ca3af);
  border-color: var(--border-color, #d1d5db);
  background: transparent;
  font-weight: 700;
}

/* ===== Dark 模式：普通单组技术面板当前球员冠军金高亮 ===== */
.score-page.dark-mode .sheet-player-item--active {
  background: #CE9224;
  border-right: 4rpx solid #CE9224;
}

.score-page.dark-mode .sheet-player-item--active .sheet-player-name {
  color: #111111;
}

/* Dark：正式成绩格冠军金边 + 深底 + 白字（非 draft / 非 empty） */
.score-page.dark-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  border: 2rpx solid #CE9224;
  background: #111111;
  color: #ffffff;
}

/* Dark：草稿成绩 PGA 蓝字；背景/边框保持原草稿样式 */
.score-page.dark-mode .sheet-hole-score--draft {
  color: #002D62;
}

/* ===== Bright 模式：普通单组技术面板 PGA 蓝高亮 ===== */
.score-page.bright-mode .sheet-player-item--active {
  background: #002D62;
  border-right: 4rpx solid #002D62;
}

.score-page.bright-mode .sheet-player-item--active .sheet-player-name {
  color: #ffffff;
}

/* active + 已确认成绩：白底 PGA 蓝字，压在深蓝行上仍清晰 */
.score-page.bright-mode .sheet-player-item--active .sheet-hole-score:not(.sheet-hole-score--draft) {
  color: #002D62;
  background: #ffffff;
  border-color: rgba(255, 255, 255, 0.95);
}

/* active + draft：浅蓝/半透明白，表示未确认输入 */
.score-page.bright-mode .sheet-player-item--active .sheet-hole-score--draft {
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.5);
  font-weight: 700;
}

/* 非 active + 无正式成绩：PGA 蓝边 + 浅蓝底，可记未完 */
.score-page.bright-mode .sheet-player-item--inactive .sheet-hole-score--empty {
  color: transparent;
  background: rgba(0, 45, 98, 0.12);
  border: 2rpx solid #002D62;
}

/* 非 active + 正式成绩：PGA 蓝边 + 白底 + PGA 蓝字 */
.score-page.bright-mode .sheet-player-item--inactive .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  color: #002D62;
  background: #ffffff;
  border: 2rpx solid #002D62;
}

/* Bright 快捷：头像旁成绩格与技术面板同规范（复用 PGA 蓝体系；draft 不覆盖） */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score--empty {
  color: transparent;
  background: rgba(0, 45, 98, 0.12);
  border: 2rpx solid #002D62;
}

.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  color: #002D62;
  background: #ffffff;
  border: 2rpx solid #002D62;
}

/* Bright 快捷：默认 PAR 等为草稿 — 弱化浅灰，不用正式 PGA 蓝 */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-hole-score--draft {
  color: #9ca3af;
  background: rgba(148, 163, 184, 0.16);
  border: 2rpx solid #d1d5db;
  font-weight: 700;
}

/* ===== Dark 快捷：成绩格与技术面板 Dark 视觉语言统一（仅 quick-mode） ===== */
/* 正式成绩：冠军金边 + 深底 + 白字 */
.score-page.dark-mode .score-input-sheet.quick-mode .sheet-hole-score:not(.sheet-hole-score--draft):not(.sheet-hole-score--empty) {
  border: 2rpx solid #CE9224;
  background: #111111;
  color: #ffffff;
}

/* 草稿成绩：PGA 蓝字 + Dark 背景，不用冠军金 */
.score-page.dark-mode .score-input-sheet.quick-mode .sheet-hole-score--draft {
  color: #4A90E2;
  background: #111111;
  border: 2rpx solid #222222;
  font-weight: 700;
}

/* 空成绩：不覆盖，沿用现有 Dark .sheet-hole-score / --empty 表现 */

/* Bright 快捷：中间记分控件视觉对齐正式成绩格 */
.score-page.bright-mode .quick-score-control {
  background: #ffffff;
  border: 2rpx solid #002D62;
  box-shadow: none;
}

.score-page.bright-mode .quick-score-control-value {
  color: #002D62;
}

.sheet-main-panel {
  flex: 1;
  min-width: 0;
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  border-radius: 48rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Bright：技术面板控件区 PGA 蓝边框，呼应左侧球员高亮；背景/内控件不变 */
.score-page.bright-mode .tech-score-panel {
  border: 3px solid #002D62;
  background: #ffffff;
}

/* Dark：技术面板控件区冠军金边框，呼应左侧球员高亮；背景/内控件不变 */
.score-page.dark-mode .tech-score-panel {
  border: 3px solid #CE9224;
}

/* 焦点切换 pulse：颜色跟随主题变量（Bright PGA蓝 / Dark 冠军金） */
.tech-score-panel--focus-pulse {
  animation: tech-panel-focus-pulse 500ms ease;
}

@keyframes tech-panel-focus-pulse {
  0% { border-color: var(--tech-panel-pulse); }
  50% { border-color: var(--tech-panel-pulse-mid); }
  100% { border-color: var(--tech-panel-pulse); }
}

.sheet-control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-control-label {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.stepper-btn {
  background: var(--bg-card);
  border-radius: 9999rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  gap: 16rpx;
}

.control-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: #facc15;
  color: #002d55;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.stepper-val {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text-primary);
  min-width: 64rpx;
  text-align: center;
}

.direction-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.direction-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.direction-circle {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #94a3b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 8rpx 12rpx rgba(0, 0, 0, 0.1);
}

.direction-circle--active {
  background: var(--highlight-strong);
  color: var(--highlight-on);
}

.direction-label {
  font-size: 16rpx;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
}

.direction-label--gold { color: var(--highlight-color); font-weight: 900; }

/* Dark：技术面板 FAIRWAY 选中态冠军金；未选保持原样 */
.score-page.dark-mode .tech-score-panel .direction-circle--active {
  background: #CE9224;
  color: #111111;
}

.score-page.dark-mode .tech-score-panel .direction-label--gold {
  color: #CE9224;
}

.quick-score-control-list {
  display: flex;
  flex-direction: column;
  transform: translateY(-26rpx);
}

.quick-score-control-row {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center; /* 控件在行内水平居中；高度不变，与左侧头像行垂直对齐 */
}

.quick-score-control {
  min-width: 224rpx;
  height: 72rpx;
  border-radius: 9999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 16rpx;
}

.quick-score-control-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #facc15;
  color: #002d62;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

/* Bright：快捷面板 +/- PGA 蓝；不改技术面板 / Dark */
.score-page.bright-mode .quick-score-control-btn {
  background: #002D62;
  color: #ffffff;
}

/* Dark：快捷面板 +/- 冠军金 */
.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control-btn {
  background: #CE9224;
  color: #111111;
}

/* Dark：快捷记分控件容器（包裹 +/- 与数值） */
.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control {
  background: var(--bg-card);
  border: 2rpx solid #CE9224;
  box-shadow: none;
}

.quick-score-control-value {
  min-width: 56rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  color: #0f172a;
}

.score-page.dark-mode .score-input-sheet.quick-mode .quick-score-control-value {
  color: white;
}

.sheet-footer-btns {
  display: flex;
  padding: 48rpx 80rpx 0;
  gap: 32rpx;
}

.sheet-footer-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: center;
}

.sheet-footer-btn--clear {
  background: var(--bg-primary);
  color: var(--text-secondary);
  border: 1px solid var(--border-color);
}

.sheet-footer-btn--confirm {
  background: var(--champion-gold);
  color: #000000;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.2);
}

/* finished 只读：编辑控件置灰，成绩展示布局不变 */
.score-input-sheet.is-readonly .control-icon.is-disabled,
.score-input-sheet.is-readonly .quick-score-control-btn.is-disabled,
.score-input-sheet.is-readonly .sheet-footer-btn.is-disabled {
  opacity: 0.42;
  filter: grayscale(0.35);
}
.score-input-sheet.is-readonly .tech-score-panel.is-disabled .direction-row,
.score-input-sheet.is-readonly .direction-row.is-disabled,
.score-input-sheet.is-readonly .quick-score-panel.is-disabled {
  opacity: 0.55;
}

/* Bright：技术面板操作色统一（+/- / 确认）；不改快捷面板、不改 Dark */
.score-page.bright-mode .tech-score-panel .control-icon {
  background: #002D62;
  color: #ffffff;
}

.score-page.bright-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Bright：快捷面板确认 PGA 蓝；不改技术面板选择器、不改 Dark */
.score-page.bright-mode .score-input-sheet.quick-mode .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Dark：技术面板 +/- 冠军金；不改 Bright / 快捷 */
.score-page.dark-mode .tech-score-panel .control-icon {
  background: #CE9224;
  color: #111111;
}

/* Dark：技术面板确认按钮冠军金；不改快捷面板 */
.score-page.dark-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #CE9224;
  color: #111111;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.28);
}

/* Group Manage Page */
.group-manage-page {
  position: fixed;
  inset: 0;
  z-index: 650;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
}

.group-manage-content {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  /* 与固定底栏为 flex 同级、互不重叠；额外补偿确保滚动到底内容不被遮挡 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 固定底部操作栏：作为 group-manage-page(flex column) 的最后一个 flex 同级，
   恒贴底、不随 scroll-view 滚动、不被内容挤压；不使用 margin 伪造。 */
.group-manage-footer {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
  z-index: 100;
}

/* 人员来源弹层挂在添加/删除内：抬高层级，避免被底栏(z-index:100)遮挡 */
.group-manage-source-sheet {
  position: relative;
  z-index: 200;
}

/* 手工添加底部弹窗：高于来源选择与底栏 */
.manual-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 700;
}

.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--text-primary);
}

.manual-sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover, var(--border-color));
  margin: 0 auto 28rpx;
}

.manual-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.manual-sheet__overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--data-blue, #00aeef);
}

.manual-sheet__title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.manual-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-muted, var(--text-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.manual-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.manual-field__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.manual-field__input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-primary));
  color: var(--text-primary);
  font-size: 28rpx;
}

.manual-field__placeholder {
  color: var(--text-muted, #9ca3af);
}

.manual-gender {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.manual-gender__tag {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-gender__tag.is-active {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

.manual-sheet__footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.manual-sheet__btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.manual-sheet__btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
  border: 1px solid var(--border-color);
}

.manual-sheet__btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}

.player-source-list-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--bg-card);
  color: var(--text-primary);
  box-sizing: border-box;
}

.player-source-list {
  max-height: 56vh;
}

.player-source-list__empty {
  padding: 48rpx 24rpx;
  border-radius: 22rpx;
  border: 1px dashed var(--border-color);
  background: var(--bg-primary);
  color: var(--text-secondary);
  text-align: center;
  font-size: 26rpx;
}

.player-source-list__item {
  min-height: 108rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.player-source-list__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.player-source-list__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.player-source-list__title {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.player-source-list__subtitle {
  font-size: 22rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.player-source-list__action {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
  flex-shrink: 0;
}

.join-match-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--bg-card);
  color: var(--text-primary);
}

.join-match-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.join-match-sheet__desc {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.join-match-team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.join-match-team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
}

.join-match-team-name {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.join-match-team-action {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
}

.section-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.section-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section-count {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--champion-gold);
}

.players-strip {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  /* 恒定 4 列：增删只切换填充/空位，列数与对齐不随 children 数量变化（中心轴绝对稳定） */
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.player-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.slot-index {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
}

.avatar-wrap {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.avatar-wrap image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
}

.delete-dot {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg-card);
}

.player-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

/* 添加/删除：昵称下方分队小胶囊（仅展示，不改座位布局） */
.group-manage-team-label {
  max-width: 96rpx;
  margin-top: -6rpx;
  padding: 0 6rpx;
  height: 24rpx;
  line-height: 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 45, 98, 0.08);
  color: var(--text-muted, #6b7280);
  font-size: 16rpx;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}
.score-page.dark-mode .group-manage-team-label {
  background: rgba(255, 255, 255, 0.1);
  color: var(--text-secondary);
}

/* 空槽位占位（复刻原型 .empty-slot）：虚线圆 + ＋，名称弱化；保持 4 列布局恒定 */
.empty-slot .avatar-wrap {
  border: 1px dashed var(--border-color);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
}

.empty-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 36rpx;
}

.empty-slot .player-name {
  color: var(--text-secondary);
  opacity: 0.65;
}

/* 可继承空位：该槽位保留了上一位球员成绩，高亮提示可继承 */
.empty-slot .empty-avatar--cache {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .avatar-wrap {
  position: relative;
}
.slot-cache-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--accent-gold, #d4af37);
  color: #1a1a1a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

/* 待扫码加入（pending）：高亮虚线 + 省略号脉冲，提示该槽位正在等待扫码 */
.empty-avatar--pending {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .empty-avatar--pending {
  animation: slotPendingPulse 1.2s ease-in-out infinite;
}
@keyframes slotPendingPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.friend-sheet {
  position: fixed;
  inset: 0;
  z-index: 720;
  background: rgba(0, 0, 0, 0.45);
