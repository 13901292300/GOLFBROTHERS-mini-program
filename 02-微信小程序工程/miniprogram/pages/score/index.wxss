/**
 * 记分页面样式 — 对齐 记分及添加删除页面汇总.html
 */
@import '../../styles/half-course-panel.wxss';

/* =========================================================
   THEME TOKEN SYSTEM (single source of truth)
   所有结构性背景 / 文字 / 边框颜色都来自这些变量。
   品牌色（蓝色 Header、金色、记分语义色）不参与主题切换。
   ========================================================= */
.score-page.dark-mode {
  --bg-primary: #000000;
  --bg-secondary: #0a0a0a;
  --bg-card: #111111;
  --bg-panel: #000000;
  --text-primary: #ffffff;
  --text-secondary: #888888;
  --border-color: #222222;

  /* TOT 列主题联动：DARK = 冠军金（用字面量，避免嵌套 var 在部分基础库解析失败） */
  --tot-color: #CE9224;

  /* 记分面板视觉层级：DARK 维持金色高亮体系，成绩金色 */
  --highlight-color: #CE9224;
  --highlight-surface: #fff9c4;
  --highlight-text: #002d62;
  --score-color: #CE9224;
  --score-surface: rgba(206, 146, 36, 0.16);
  --score-border: rgba(206, 146, 36, 0.48);
  --aux-text: #00aeef;
  --highlight-strong: #facc15;
  --highlight-on: #002d55;
  --par-color: #CE9224;

  /* 技术面板焦点 pulse：冠军金 → 浅金 → 冠军金 */
  --tech-panel-pulse: #CE9224;
  --tech-panel-pulse-mid: #E4C078;

  --discussion-bg: #0b0f14;
  --discussion-strip: #101820;
  --discussion-bubble: #182330;
  --discussion-bar: #111827;
  --discussion-input-bg: #0b1220;
  --discussion-border: #263241;
}

.score-page.bright-mode {
  --bg-primary: #ffffff;
  --bg-secondary: #f1f5f9;
  --bg-card: #f8fafc;
  --bg-panel: #ffffff;
  --text-primary: #0f172a;
  --text-secondary: #64748b;
  --border-color: #e2e8f0;

  /* TOT 列主题联动：BRIGHT = PGA蓝 #002D62 */
  --tot-color: #002D62;

  /* 记分面板：BRIGHT 单一 PGA 藏蓝高对比体系（成绩与高亮同色 #002D62，靠底色/边框/加粗区分；辅助文字灰） */
  --highlight-color: #002D62;
  --highlight-surface: rgba(0, 45, 98, 0.12);
  --highlight-text: #002D62;
  --score-color: #002D62;
  --score-surface: rgba(0, 45, 98, 0.10);
  --score-border: rgba(0, 45, 98, 0.42);
  --aux-text: #6B7280;
  --highlight-strong: #002D62;
  --highlight-on: #ffffff;
  --par-color: #002D62;

  /* 技术面板焦点 pulse：PGA蓝 → 浅蓝 → PGA蓝 */
  --tech-panel-pulse: #002D62;
  --tech-panel-pulse-mid: #5BA3D9;

  --discussion-bg: #f3f4f6;
  --discussion-strip: #ffffff;
  --discussion-bubble: #ffffff;
  --discussion-bar: #f8fafc;
  --discussion-input-bg: #ffffff;
  --discussion-border: #e2e8f0;
}

page {
  height: 100%;
  background: var(--bg-primary);
  color: var(--text-primary);
}

.score-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--bg-primary);
  color: var(--text-primary);
  box-sizing: border-box;
}

/* ===== Header ===== */
/* height / padding-top / padding-right are computed in JS (initHeaderNav) and
   applied via inline headerRootStyle / headerBarStyle, matching the home page. */
.gb-header {
  flex-shrink: 0;
  background: #002d62;
  border-bottom: 2px solid var(--champion-gold);
  color: #ffffff;
  box-sizing: border-box;
}

.gb-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
}

.gb-header__left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.gb-header__right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.gb-header__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gb-header__chevron {
  font-size: 40rpx;
  color: #ffffff;
  line-height: 1;
}

.gb-header__eyebrow {
  display: block;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 0.24em;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1;
  margin-bottom: 8rpx;
}

.gb-header__title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  font-style: italic;
  color: #ffffff;
  line-height: 1;
}

/* D/B 开关已收口到首页（唯一入口），记分页不再提供任何主题控件。 */

/* The real WeChat system capsule occupies the top-right; reserve space via
   headerPaddingRight (JS) and hide this mock pill, exactly like the home page. */
.mini-program-pill {
  display: none;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  align-items: center;
  gap: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.mini-program-pill__dots { display: flex; gap: 8rpx; }
.mini-program-pill__dot { width: 12rpx; height: 12rpx; background: #fff; border-radius: 999rpx; }
.mini-program-pill__line { width: 2rpx; height: 32rpx; background: rgba(255, 255, 255, 0.2); }
.mini-program-pill__circle {
  width: 40rpx; height: 40rpx;
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  display: flex; align-items: center; justify-content: center;
}
.mini-program-pill__circle-inner { width: 20rpx; height: 20rpx; background: #fff; border-radius: 999rpx; }

/* ===== Tab Nav ===== */
/* 容器不居中项（用 stretch 让 item 铺满高度），文字由 .tab-nav__item 自身 flex 居中，指示器贴容器底边 */
.tab-nav {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  height: var(--tab-height);
  background: #002d62;
  border-bottom: 1px solid var(--border-color);
}

.tab-nav__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  min-width: 0;
}

.tab-nav__label {
  font-size: var(--tab-font-size);
  line-height: 1;
  font-weight: 400;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.tab-nav__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 112rpx;
  height: var(--tab-indicator-height);
  background: var(--tab-indicator-color);
  opacity: 1;
  border-radius: 999rpx;
}

/* ===== Main ===== */
.score-main {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.score-tab-panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Course & Game Info */
.course-game-info {
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border-color);
}

.course-game-info__head {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
}

/* 信息栏三段式：左(球场名+下拉) / 中(占位) / 右(总杆·杆差开关) */
.score-info-row {
  justify-content: space-between;
  gap: 24rpx;
}

.score-info-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

/* 下拉按钮紧挨球场名右侧：名字按内容收缩并省略号，按钮不收缩 */
.score-info-left .course-name {
  flex: 0 1 auto;
}

.course-dropdown-btn {
  flex-shrink: 0;
}

/* 右侧切换开关 */
.score-display-switch {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 999rpx;
  padding: 4rpx;
}

.score-display-switch__btn {
  padding: 8rpx 22rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  border-radius: 999rpx;
  line-height: 1.2;
}

.score-display-switch__btn--active {
  background: #002D62;
  color: #ffffff;
}

.course-game-info__accent {
  width: 6rpx;
  height: 32rpx;
  background: var(--champion-gold);
  border-radius: 999rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.course-game-info__course {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-game-info__toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  border: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.course-game-info__chevron {
  font-size: 24rpx;
  color: var(--champion-gold);
  transition: transform 0.2s;
}

.course-game-info__chevron--open { transform: rotate(180deg); }

.game-info-panel {
  padding: 8rpx 32rpx 24rpx;
  border-top: 1px solid var(--border-color);
}

/* 外部遮罩：点击空白处收起（全屏 fixed、透明、不参与记分布局流） */
.game-info-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: transparent;
}

/* Context 面板：根级 fixed 浮层，与 TAB / HOLE / score grid 完全解耦，
   不占布局高度、不 push 任何元素、不触发 reflow。top / max-height 由 JS 实测注入。 */
.game-context-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  max-height: 60vh;
  box-sizing: border-box;
  padding: 16rpx 24rpx 28rpx;
  background: var(--bg-card);
  border-top: 1px solid var(--border-color);
  border-bottom: 1px solid var(--border-color);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.18);
}

/* 最小必要信息：纯文本 label + value 列表（无卡片嵌套、无头像、无分组展开） */
.gc-list {
  margin-top: 4rpx;
  font-size: 26rpx;
}
.gc-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 1px solid var(--border-color);
}
.gc-item--last { border-bottom: none; }
.gc-item-label {
  color: var(--text-secondary);
  flex-shrink: 0;
}
.gc-item-value {
  color: var(--text-primary);
  font-weight: 700;
  margin-left: 24rpx;
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 围观密码：数值 + 复制按钮（单行追加，不新增模块） */
.gc-code-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 24rpx;
  flex: 1;
}
.gc-code-value {
  margin-left: 0;
  flex: 0 1 auto;
  letter-spacing: 4rpx;
  color: var(--champion-gold);
}
.gc-copy-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--champion-gold);
  border: 1px solid var(--champion-gold);
  border-radius: 999rpx;
  line-height: 1.6;
}
.gc-copy-btn:active { opacity: 0.7; }

.game-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1px solid var(--border-color);
}

.game-info-row--last { border-bottom: none; }

.game-info-label { color: var(--text-secondary); }
.game-info-value { color: var(--text-primary); font-weight: 700; margin-left: 24rpx; flex: 1; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Scoreboard */
.scoreboard-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  background: var(--bg-primary);
}

.scoreboard-inner { display: inline-block; min-width: 100%; }

.scoreboard-row {
  display: flex;
  border-bottom: 1px solid var(--border-color);
  min-width: max-content;
}

.scoreboard-row--head { background: var(--bg-card); }
.scoreboard-row--par { background: var(--bg-primary); }
.scoreboard-row--player { height: 156rpx; }

.scoreboard-cell {
  width: 144rpx;
  min-width: 144rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  border-right: 1px solid var(--border-color);
  position: relative;
  overflow: hidden;
}

.sticky-col {
  position: sticky;
  left: 0;
  z-index: 20;
  /* 原型机制：球员列宽度由 CSS 变量驱动（所有行共用，故缩放时不会错位） */
  width: var(--player-col-width, 240rpx);
  min-width: var(--player-col-width, 240rpx);
  background: var(--bg-secondary);
  transition: width 0.25s ease, min-width 0.25s ease;
}

.scoreboard-row--head .sticky-col { background: var(--bg-card); }

.player-col-header {
  padding-top: 32rpx;
  padding-bottom: 32rpx;
  padding-left: var(--player-col-padding-x, 24rpx);
  padding-right: var(--player-col-padding-x, 24rpx);
  transition: padding 0.25s ease;
}

.col-head-label,
.col-par-label {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.par-val { font-size: 24rpx; font-weight: 700; color: var(--text-secondary); }

.scoreboard-cell--special-head { background: rgba(0, 45, 98, 0.2); }
.scoreboard-cell--special-par { background: var(--bg-card); }
.scoreboard-cell--special-cell { background: rgba(0, 45, 98, 0.05); }

.hole-label-wrap { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }

.hole-number,
.hole-label-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.hole-number {
  background: #002d62 !important;
  color: #ffffff !important;
  border: 1px solid #002d62;
}

.hole-label-circle--special {
  background: var(--bg-primary);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
}

/* Player cell */
.player-cell {
  justify-content: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  padding-left: var(--player-col-padding-x, 24rpx);
  padding-right: var(--player-col-padding-x, 24rpx);
  transition: padding 0.25s ease;
  height: 156rpx;
  min-height: 156rpx;
  box-sizing: border-box;
}

.player-card { width: 100%; min-width: 0; }

.player-top-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.player-avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  border-width: 4rpx;
  border-style: solid;
}

.player-avatar-img.border-red { border-color: #dc2626; }
.player-avatar-img.border-gold { border-color: var(--champion-gold); }
.player-avatar-img.border-white { border-color: var(--text-primary); }
.player-avatar-img.border-light { border-color: #00aeef; }

.player-diff-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
  overflow: hidden;
  opacity: var(--player-diff-opacity, 1);
  transition: opacity 0.25s ease;
}

.player-diff-score {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1.2;
}

.player-name-line {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  font-style: italic;
  color: var(--text-secondary);
  text-transform: uppercase;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: var(--player-name-width, 192rpx);
  transition: max-width 0.25s ease;
}

.player-tee-marker {
  position: absolute;
  right: 0;
  top: 25%;
  bottom: 25%;
  width: 6rpx;
}

.player-tee-marker.border-red { background: #dc2626; }
.player-tee-marker.border-gold { background: var(--champion-gold); }
.player-tee-marker.border-white { background: var(--text-primary); }
.player-tee-marker.border-light { background: #00aeef; }

.diff-under { color: #ef4444 !important; }
.diff-even { color: var(--par-color) !important; }
.diff-over { color: var(--text-secondary) !important; }

.player-diff-score.diff-under { color: #ef4444; }
.player-diff-score.diff-even { color: var(--par-color); }

/* Score cells */
.score-cell { padding: 8rpx; min-height: 156rpx; }

.hole-cell-inner,
.special-cell-inner {
  width: 100%;
  min-height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  /* 注意：不要 position:relative，否则底部推杆/杆差会被锚到本内框（居中漂浮），
     而不是记分格真正的底边。让其锚定到 .scoreboard-cell。 */
}

.hole-cell-score,
.special-cell-val {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
}

.special-cell-val { color: var(--text-secondary); font-style: italic; }

/* 杆差模式：仅缩小主成绩文字（含正负号），圆圈/方框容器尺寸保持不变 */
.hole-cell-score--diff { font-size: 40rpx; }

/* TOT 列：主题联动颜色，!important 防止任何局部/语义色覆盖 */
.special-cell-val--tot,
.tot-value { color: var(--tot-color) !important; }

/* ===== 成绩标记统一外框系统：四类共用同一 marker-size + border-box，仅视觉不同（圆/圈/框/底） =====
   关键：固定 width/height + box-sizing:border-box，border 不撑大外框、内容不撑形状，四态外轮廓完全一致 */
.score-birdie,
.score-eagle,
.score-bogey,
.score-double {
  --score-marker-size: 72rpx;
  width: var(--score-marker-size);
  height: var(--score-marker-size);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小鸟：红圈（描边、内部透明） */
.score-birdie { border: 4rpx solid #ef4444; border-radius: 9999rpx; }
.score-birdie .hole-cell-score { color: #ef4444; }

/* 老鹰及更好（-2 及更好）：圆底白字（实心圆，固定外框，非内容撑圆） */
.score-eagle { background: #ef4444; border-radius: 9999rpx; }
.score-eagle .hole-cell-score { color: #ffffff; }

/* 加一：方框（描边、内部透明） */
.score-bogey { border: 2rpx solid var(--text-secondary); }

/* 加二及更差（+2 及以上）：灰底白字（实心灰底） */
.score-double { background: #6b7280; border-radius: 8rpx; }
.score-double .hole-cell-score { color: #ffffff; }

.hole-cell-meta,
.special-cell-meta {
  position: absolute;
  bottom: 4rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.hole-cell-putt,
.special-cell-putt {
  font-size: 16rpx;
  font-weight: 700;
  color: #00aeef;
  opacity: 0.8;
  line-height: 1;
}

.hole-cell-diff,
.special-cell-diff {
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
}

.triangle-red,
.triangle-blue {
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 28rpx 28rpx 0;
  z-index: 5;
  pointer-events: none;
}

.triangle-red { border-color: transparent #ef4444 transparent transparent; }
.triangle-blue { border-color: transparent #3b82f6 transparent transparent; }

/* 名次腰线（第三/第四名）：在右上三角内部画一条白色斜线（左上→右下），裁剪于三角形内不外溢。
   三角尺寸/位置不变（仍为 28rpx 角标），本元素只叠加白线，颜色由下层 triangle 提供。 */
.corner-waist {
  position: absolute;
  top: 0;
  right: 0;
  width: 28rpx;
  height: 28rpx;
  z-index: 6;
  pointer-events: none;
  /* 与红/蓝三角同形：右上角三角（斜边由左上 → 右下），用于裁剪白线，确保不超出三角边界 */
  clip-path: polygon(0 0, 100% 0, 100% 100%);
}
.corner-waist::after {
  content: "";
  position: absolute;
  /* 统一中腰位置：直角顶点(右上,100%,0)到斜边(左上→右下)垂足(50%,50%)的中点 = (75%,25%) */
  top: 25%;
  left: 75%;
  width: 24rpx;
  height: 3rpx;
  background: #ffffff;
  /* 左上 → 右下方向的斜线（屏幕坐标顺时针 45°），并裁剪在三角内部 */
  transform: translate(-50%, -50%) rotate(45deg);
  transform-origin: center;
}

/* Floating Actions */
.score-actions {
  flex-shrink: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
