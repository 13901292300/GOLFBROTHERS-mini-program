}

.join-match-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.join-match-sheet__desc {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.join-match-team-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.join-match-team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-primary);
}

.join-match-team-name {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.join-match-team-action {
  font-size: 24rpx;
  font-weight: 900;
  color: var(--champion-gold, #ce9224);
}

.section-card {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text-primary);
}

.section-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section-count {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--champion-gold);
}

.players-strip {
  width: 100%;
  box-sizing: border-box;
  display: grid;
  /* 恒定 4 列：增删只切换填充/空位，列数与对齐不随 children 数量变化（中心轴绝对稳定） */
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.player-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.slot-index {
  font-size: 20rpx;
  font-weight: 900;
  color: var(--text-secondary);
}

.avatar-wrap {
  position: relative;
  width: 92rpx;
  height: 92rpx;
}

.avatar-wrap image {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
}

.delete-dot {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid var(--bg-card);
}

.player-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}

/* 空槽位占位（复刻原型 .empty-slot）：虚线圆 + ＋，名称弱化；保持 4 列布局恒定 */
.empty-slot .avatar-wrap {
  border: 1px dashed var(--border-color);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
}

.empty-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 36rpx;
}

.empty-slot .player-name {
  color: var(--text-secondary);
  opacity: 0.65;
}

/* 可继承空位：该槽位保留了上一位球员成绩，高亮提示可继承 */
.empty-slot .empty-avatar--cache {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .avatar-wrap {
  position: relative;
}
.slot-cache-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--accent-gold, #d4af37);
  color: #1a1a1a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
}

/* 待扫码加入（pending）：高亮虚线 + 省略号脉冲，提示该槽位正在等待扫码 */
.empty-avatar--pending {
  color: var(--accent-gold, #d4af37);
  font-weight: 900;
}
.empty-slot .empty-avatar--pending {
  animation: slotPendingPulse 1.2s ease-in-out infinite;
}
@keyframes slotPendingPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.friend-sheet {
  position: fixed;
  inset: 0;
  z-index: 720;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}
.friend-sheet__panel {
  width: 100%;
  max-height: 70vh;
  background: var(--bg-card);
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
}
.friend-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
