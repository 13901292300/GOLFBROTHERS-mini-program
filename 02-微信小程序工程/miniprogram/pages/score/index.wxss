}
.slot-qr-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}
.slot-qr-btn--ghost {
  background: var(--bg-page, rgba(255, 255, 255, 0.06));
