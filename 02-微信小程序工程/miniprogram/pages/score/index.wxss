  flex-direction: row;
  gap: 16rpx;
}

.manual-gender__tag {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-gender__tag.is-active {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

.manual-sheet__footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.manual-sheet__btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.manual-sheet__btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
  border: 1px solid var(--border-color);
}

.manual-sheet__btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}

.player-source-list-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
