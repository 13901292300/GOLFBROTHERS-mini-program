  border: 1px solid var(--border-color);
}
.slot-qr-btn--primary {
  background: var(--accent-gold, #d4af37);
  color: #1a1a1a;
}

.qr-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
  text-align: center;
}

.qr-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  margin: 16rpx 0 32rpx;
}

.qr-box {
  display: flex;
