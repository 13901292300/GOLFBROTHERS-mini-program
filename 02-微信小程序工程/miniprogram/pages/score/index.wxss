/* —— 扫码加入：槽位专属二维码 —— */
.slot-qr-mask {
  position: fixed;
  inset: 0;
  z-index: 721;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.slot-qr-panel {
  width: 560rpx;
  background: var(--bg-card);
  border-radius: 28rpx;
