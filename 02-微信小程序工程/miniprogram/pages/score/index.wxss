  display: flex;
  flex-direction: column;
  align-items: center;
}
.slot-qr-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
}
.slot-qr-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.slot-qr-box {
  margin: 28rpx 0;
