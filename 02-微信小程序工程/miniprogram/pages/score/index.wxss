  display: flex;
  gap: 24rpx;
}

.score-actions__primary {
  flex: 1;
  background: #002d62;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 16rpx;
  padding: 28rpx 0;
