  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.2);
}

/* Bright：技术面板操作色统一（+/- / 确认）；不改快捷面板、不改 Dark */
.score-page.bright-mode .tech-score-panel .control-icon {
  background: #002D62;
  color: #ffffff;
}

.score-page.bright-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #002D62;
  color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(0, 45, 98, 0.22);
}

/* Dark：技术面板 +/- 冠军金；不改 Bright / 快捷 */
.score-page.dark-mode .tech-score-panel .control-icon {
  background: #CE9224;
  color: #111111;
}

/* Dark：技术面板确认按钮冠军金；不改快捷面板 */
.score-page.dark-mode .score-input-sheet:not(.quick-mode) .sheet-footer-btn--confirm {
  background: #CE9224;
  color: #111111;
  box-shadow: 0 16rpx 40rpx rgba(206, 146, 36, 0.28);
}

/* Group Manage Page */
.group-manage-page {
  position: fixed;
  inset: 0;
  z-index: 650;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
}

.group-manage-content {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  /* 与固定底栏为 flex 同级、互不重叠；额外补偿确保滚动到底内容不被遮挡 */
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 固定底部操作栏：作为 group-manage-page(flex column) 的最后一个 flex 同级，
   恒贴底、不随 scroll-view 滚动、不被内容挤压；不使用 margin 伪造。 */
.group-manage-footer {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary);
  border-top: 1px solid var(--border-color);
  z-index: 100;
}

/* 人员来源弹层挂在添加/删除内：抬高层级，避免被底栏(z-index:100)遮挡 */
.group-manage-source-sheet {
  position: relative;
  z-index: 200;
}

/* 手工添加底部弹窗：高于来源选择与底栏 */
.manual-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 700;
}

.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--text-primary);
}

.manual-sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover, var(--border-color));
  margin: 0 auto 28rpx;
}

.manual-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.manual-sheet__overline {
