}

.score-actions__secondary {
  flex: 1;
  background: transparent;
  border: 1px solid var(--border-color);
  color: #00aeef;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: 16rpx;
  padding: 28rpx 0;
  text-align: center;
