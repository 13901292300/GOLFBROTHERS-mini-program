  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.sheet-hole-nav__btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--bg-primary);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.sheet-hole-label {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #002d62;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  border: 4rpx solid #ffffff;
}

.sheet-hole-meta {
  display: flex;
  gap: 32rpx;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.sheet-hole-meta__item { display: flex; gap: 8rpx; align-items: center; }
.sheet-hole-meta__val { color: var(--text-primary); font-size: 24rpx; }
.sheet-hole-meta__val--light { color: var(--aux-text); }

.score-sheet-layout {
  display: flex;
  padding: 0 32rpx;
  gap: 16rpx;
  height: 600rpx;
}

.sheet-player-list {
