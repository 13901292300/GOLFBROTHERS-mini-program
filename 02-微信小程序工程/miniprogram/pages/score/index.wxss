}

.manual-sheet__title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.manual-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-muted, var(--text-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.manual-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.manual-field__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.manual-field__input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color);
  background: var(--bg-subtle, var(--bg-primary));
  color: var(--text-primary);
  font-size: 28rpx;
}

.manual-field__placeholder {
  color: var(--text-muted, #9ca3af);
}

.manual-gender {
