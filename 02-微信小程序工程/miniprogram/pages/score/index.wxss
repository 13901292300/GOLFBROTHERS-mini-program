/* —— 扫码加入：槽位专属二维码 —— */
.slot-qr-mask {
  position: fixed;
  inset: 0;
  z-index: 721;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.slot-qr-panel {
  width: 560rpx;
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.slot-qr-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary);
}
.slot-qr-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.slot-qr-box {
  margin: 28rpx 0;
