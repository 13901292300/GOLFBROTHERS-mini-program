<view class="group-editor-page {{themeClass}}">
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">TOURNAMENT</text>
          <text class="gb-header__title">{{headerTitle}}</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="editor-scroll" scroll-y>
    <view class="editor-body">
      <!-- 仅 G2/G3 比杆显示；G6/G7 比洞隐藏（复用编辑器，不复用 2+2/4+0 选择规则） -->
      <view wx:if="{{showCompositionMode}}" class="composition-mode-section">
        <text class="composition-mode-section__label">组合模式</text>
        <view class="composition-mode-options">
          <view
            class="composition-mode-option {{strokeCompositionMode === '2+2' ? 'is-active' : ''}}"
            bindtap="onStrokeCompositionModeTap"
            data-mode="2+2"
          >2+2</view>
          <view
            class="composition-mode-option {{strokeCompositionMode === '4+0' ? 'is-active' : ''}}"
            bindtap="onStrokeCompositionModeTap"
            data-mode="4+0"
          >4+0</view>
        </view>
      </view>

      <block wx:if="{{draftCards.length > 0}}">
        <view wx:for="{{draftCards}}" wx:key="groupId" class="group-block">
          <view
            class="tee-group-card"
            bindtap="onGroupCardTap"
            data-group-id="{{item.groupId}}"
            data-group-name="{{item.badge}}"
          >
            <view
              catchtap="onDeleteGroupTap"
              data-group-id="{{item.groupId}}"
              data-group-name="{{item.badge}}"
              class="delete-group-btn"
            >
              <text>×</text>
            </view>
            <view class="tee-group-meta">
              <text class="tee-group-badge">{{item.badge}}</text>
            </view>
            <view class="gb-group-player-grid">
              <view wx:for="{{item.players}}" wx:for-item="pl" wx:key="position" class="gb-group-player">
                <view class="gb-group-player-avatar-wrap">
                  <image wx:if="{{pl.avatar}}" class="gb-group-player-avatar" src="{{pl.avatar}}" mode="aspectFill"></image>
                  <view wx:else class="gb-group-player-avatar gb-group-player-avatar--empty">+</view>
                </view>
                <view class="gb-group-player-meta">
                  <text class="gb-group-player-name">{{pl.displayName || pl.nickname || pl.name || ''}}</text>
                  <view wx:if="{{pl.teeText || pl.teeLabel}}" class="gb-group-player-tee">
                    <view wx:if="{{pl.teeMarkerClass}}" class="gb-group-player-tee-dot {{pl.teeMarkerClass}}"></view>
                    <text class="gb-group-player-tee-text">{{pl.teeText || pl.teeLabel}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- G2/G3 报名 / G4 报名编辑：只读组合预览（与 composition-preview 同款） -->
          <view wx:if="{{item.compositionPreview}}" class="composition-preview" catchtap="stopPropagation">
            <view wx:if="{{item.compositionPreview.showCombo1}}" class="composition-preview__row">
              <text class="composition-preview__label">{{item.compositionPreview.combo1Label}}：</text>
              <text class="composition-preview__names">{{item.compositionPreview.combo1Text}}</text>
            </view>
            <view wx:if="{{item.compositionPreview.showCombo2}}" class="composition-preview__row">
              <text class="composition-preview__label">{{item.compositionPreview.combo2Label}}：</text>
              <text class="composition-preview__names">{{item.compositionPreview.combo2Text}}</text>
            </view>
          </view>

          <!-- 旧 pairing 编辑区：仅 showPairingSection 时展示；G4 全模式改用上方 composition-preview -->
          <view wx:if="{{showPairingSection && item.pairingBlock}}" class="pairing-section" catchtap="stopPropagation">
            <view wx:if="{{item.pairingBlock.title}}" class="pairing-section__head">
              <text class="pairing-section__title">{{item.pairingBlock.title}}</text>
            </view>

            <block wx:if="{{item.pairingBlock.pairings.length}}">
              <view
                wx:for="{{item.pairingBlock.pairings}}"
                wx:for-item="pr"
                wx:key="id"
                class="pairing-card"
              >
                <view class="pairing-card__row">
                  <text class="pairing-card__label">{{pr.label}}</text>
                  <view class="pairing-card__actions">
                    <text
                      class="pairing-card__action"
                      catchtap="onEditPairingTap"
                      data-group-id="{{item.groupId}}"
                      data-pairing-id="{{pr.id}}"
                    >修改</text>
                    <text
                      class="pairing-card__action pairing-card__action--danger"
                      catchtap="onDeletePairingTap"
                      data-group-id="{{item.groupId}}"
                      data-pairing-id="{{pr.id}}"
                    >删除</text>
                  </view>
                </view>
                <text class="pairing-card__names">{{pr.namesText}}</text>
              </view>
            </block>

            <view wx:if="{{item.pairingBlock.hasIncomplete}}" class="pairing-incomplete">
              <text class="pairing-incomplete__label">未完成组合：</text>
              <text class="pairing-incomplete__names">{{item.pairingBlock.incompleteNamesText}}</text>
            </view>

            <view wx:if="{{showPairingComposeTools}}" class="pairing-toolbar">
              <view
                class="pairing-tool-btn"
                catchtap="onAutoPairTap"
                data-group-id="{{item.groupId}}"
              >自动组合</view>
              <view
                class="pairing-tool-btn pairing-tool-btn--ghost"
                catchtap="onAddPairingTap"
                data-group-id="{{item.groupId}}"
              >添加组合</view>
            </view>
          </view>
        </view>
      </block>
      <view wx:else class="editor-empty">
        <text class="editor-empty__text">暂无分组</text>
      </view>

      <view class="groups-tab-toolbar">
        <view class="add-group-btn" bindtap="onAddGroup">
          <view class="add-group-icon"><text>+</text></view>
          <text>添加分组</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="editor-cta-bar">
    <view bindtap="onCancel" class="editor-cta-btn editor-cta-btn--cancel">取消</view>
    <view bindtap="onConfirm" class="editor-cta-btn {{saving ? 'editor-cta-btn--disabled' : ''}}">确定</view>
  </view>

  <view wx:if="{{groupDeleteModalVisible}}" bindtap="closeGroupDeleteModal" class="editor-modal">
    <view catchtap="stopPropagation" class="editor-dialog">
      <text class="editor-dialog__title">确认删除{{groupDeleteTargetName}}？</text>
      <text class="editor-dialog__desc">删除后该组球员配置将被移除。</text>
      <view class="editor-dialog__actions">
        <view bindtap="closeGroupDeleteModal" class="editor-dialog__btn">取消</view>
        <view bindtap="confirmDeleteGroup" class="editor-dialog__btn editor-dialog__btn--danger">确认删除</view>
      </view>
    </view>
  </view>

  <!-- 修改组合：选择球员（临时 editingPairingSelectedIds，确定前不写 pairingDraft） -->
  <view wx:if="{{pairingEditVisible}}" bindtap="closePairingEditSheet" class="editor-modal">
    <view catchtap="stopPropagation" class="pairing-edit-sheet">
      <text class="pairing-edit-sheet__title">{{pairingEditTitle}}</text>
      <scroll-view class="pairing-edit-sheet__list" scroll-y>
        <view
          wx:for="{{pairingEditOptions}}"
          wx:key="userId"
          class="pairing-edit-row {{item.disabled ? 'is-disabled' : ''}} {{item.checked ? 'is-checked' : ''}}"
          catchtap="onTogglePairingEditPlayer"
          data-index="{{item.index}}"
        >
          <view class="pairing-edit-check {{item.checked ? 'is-on' : ''}}">
            <text wx:if="{{item.checked}}">✓</text>
          </view>
          <image wx:if="{{item.avatar}}" class="pairing-edit-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <view wx:else class="pairing-edit-avatar pairing-edit-avatar--empty"></view>
          <view class="pairing-edit-meta">
            <text class="pairing-edit-name">{{item.name}}</text>
            <text wx:if="{{item.occupiedTip}}" class="pairing-edit-tip">{{item.occupiedTip}}</text>
          </view>
        </view>
        <view wx:if="{{!pairingEditOptions.length}}" class="pairing-edit-empty">当前组暂无球员</view>
      </scroll-view>
      <view class="pairing-edit-sheet__actions">
        <view catchtap="closePairingEditSheet" class="editor-dialog__btn">取消</view>
        <view catchtap="confirmPairingEdit" class="editor-dialog__btn editor-dialog__btn--primary">确定</view>
      </view>
    </view>
  </view>
</view>
