/* 赛事详情页（球队赛 / 队内赛正在进行中）—— 复刻 队内赛正在进行中.html */

/* ===== 主题 Token ===== */
.detail-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --bg-secondary: #1a1a1a;
  --bg-hover: #1a1a1a;
  --border: #222222;
  --border-color: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #cbd5e1;
  --text-muted: #888888;
  --shadow-card: none;
}
.detail-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --bg-secondary: #f1f5f9;
  --bg-hover: #f9fafb;
  --border: #e5e7eb;
  --border-color: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
  --shadow-card: 0 8rpx 12rpx -2rpx rgba(0, 0, 0, 0.05);
}

page {
  height: 100%;
  background: var(--bg-primary);
}

.detail-page {
  /* 设计系统 Token：球队比赛 LOGO 统一直径（固定 px，跨分辨率一致，不随设备 rpx 缩放） */
  --team-logo-size: 72px;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-primary);
  color: var(--text-primary);
}

/* ===== Header ===== */
.gb-header {
  background: var(--tour-blue);
  border-bottom: 2px solid var(--champion-gold);
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

.detail-scroll { flex: 1; min-height: 0; }

/* ===== Hero ===== */
.hero-wrap { position: relative; }
.hero {
  position: relative;
  height: 430rpx;
  overflow: hidden;
  background: #000;
  border-bottom-left-radius: 50% 9%;
  border-bottom-right-radius: 50% 9%;
}
.hero__img { width: 100%; height: 100%; }
.hero__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 45, 98, 0.35) 0%, rgba(0, 0, 0, 0.12) 38%, rgba(0, 0, 0, 0.62) 100%); }
.registered-chip {
  position: absolute; left: 40rpx; bottom: 64rpx; z-index: 10;
  background: var(--tour-blue); color: #fff; border: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 20rpx; font-weight: 900; font-style: italic; padding: 8rpx 24rpx; border-radius: 8rpx;
}
/* translateX 仅用于水平居中(定位)，不参与尺寸控制；bottom = -size/2 维持与 hero 半重叠 */
.event-logo-wrap { position: absolute; left: 50%; bottom: -36px; transform: translateX(-50%); z-index: 20; }
/* 球队比赛 LOGO 标准：固定 64px 直径，min/max 锁定，禁止自适应/容器缩放/padding/transform 控制大小 */
.event-logo {
  width: var(--team-logo-size);
  height: var(--team-logo-size);
  min-width: var(--team-logo-size);
  max-width: var(--team-logo-size);
  min-height: var(--team-logo-size);
  max-height: var(--team-logo-size);
  flex-shrink: 0;
  box-sizing: border-box;
  border-radius: 50%;
  border: 4rpx solid var(--bg-primary);
  background: #76b900;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  object-fit: cover;
  box-shadow: 0 36rpx 80rpx rgba(0, 0, 0, 0.38);
}
.event-logo__ball { font-size: 32px; line-height: 1; }

/* ===== Event intro ===== */
.event-intro { padding: 128rpx 48rpx 0; text-align: center; }
.event-date { display: block; color: var(--champion-gold); font-weight: 900; font-style: italic; letter-spacing: -0.04em; font-size: 60rpx; line-height: 1; margin-bottom: 32rpx; }
.event-title { margin-bottom: 40rpx; }
.event-title__line { display: block; font-size: 40rpx; font-weight: 900; line-height: 1.25; letter-spacing: -0.02em; color: var(--text-primary); }
.meta-chip-row { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-bottom: 56rpx; }
.meta-chip,
.ui-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 28rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  border: 1px solid transparent;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}
.detail-page.bright-mode .meta-chip,
.detail-page.bright-mode .ui-chip {
  background: #eaf2ff;
  color: #2b5ea8;
  border-color: #d7e6ff;
}
.detail-page.dark-mode .meta-chip,
.detail-page.dark-mode .ui-chip {
  background: #1c2430;
  color: #e6efff;
  border-color: #2d3a4f;
}

/* ===== Cards ===== */
.ds-card {
  background: var(--bg-card); border: 1px solid var(--border); border-top: 6rpx solid var(--tour-blue);
  border-radius: 16rpx; box-shadow: var(--shadow-card); overflow: hidden;
}
.pad-card { padding: 32rpx; margin-bottom: 32rpx; }
.info-card { padding: 32rpx; text-align: left; }
.info-row { display: flex; gap: 24rpx; align-items: center; }
.info-row + .info-row { margin-top: 24rpx; }
.info-row-label { width: 84rpx; flex: 0 0 84rpx; font-weight: 900; font-size: 24rpx; }
.detail-page.dark-mode .info-row-label { color: var(--champion-gold); }
.detail-page.bright-mode .info-row-label { color: var(--tour-blue); }
.info-row-value { color: var(--text-secondary); font-size: 26rpx; line-height: 1.45; }

.card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.card-title { color: var(--text-primary); font-size: 28rpx; font-weight: 900; letter-spacing: -0.02em; }
.card-kicker { font-size: 20rpx; font-weight: 900; font-style: italic; color: var(--champion-gold); letter-spacing: 0.18em; }
/* 赛事信息卡片正文：对齐 HTML 原型 .card-text（12px / muted），避免继承默认大字号 */
.card-text,
.event-info-card-desc {
  display: block;
  color: var(--text-muted);
  font-size: 24rpx;
  line-height: 1.75;
  font-weight: 400;
}
.photo-live-card .card-text,
.photo-live-card .event-info-card-desc,
.photo-live-card__desc {
  color: var(--cloud-blue, #002d62);
  font-weight: 700;
}

.ad-image { border-radius: 16rpx; border: 1px solid var(--border); box-shadow: var(--shadow-card); overflow: hidden; background: var(--bg-card); margin-bottom: 32rpx; }
.ad-image__img { width: 100%; display: block; }
.ad-image__img--sm { height: 256rpx; }
.ad-image__img--lg { height: 352rpx; }

.section-divider { display: flex; align-items: center; gap: 24rpx; padding: 0 64rpx; color: var(--champion-gold); margin: 60rpx 0 36rpx; }
.section-divider::before, .section-divider::after { content: ""; height: 1px; flex: 1; background: linear-gradient(90deg, transparent, var(--champion-gold), transparent); opacity: 0.9; }
.section-divider__text { font-size: 20rpx; font-weight: 900; font-style: italic; letter-spacing: 0.28em; white-space: nowrap; }

.partners-section { padding: 24rpx 0 16rpx; }
.partners-title { display: block; text-align: center; font-size: 20rpx; font-weight: 900; font-style: italic; letter-spacing: 0.25em; color: var(--text-muted); margin-bottom: 40rpx; }
/* 占位网格：保留 cell 右/下边框拼成表格（仅 placeholder） */
.partners-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border); border-left: 1px solid var(--border); }
.partners-grid--placeholder .partner-cell {
  height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  color: var(--text-muted);
  background: var(--bg-card);
  opacity: 0.72;
  font-size: 56rpx;
  font-weight: 900;
  font-style: italic;
  box-sizing: border-box;
}
/* Logo 区：无外框；仅中间竖线 + 行间横线 */
.partners-grid--logos {
  display: flex;
  flex-direction: column;
  border: none;
  border-top: none;
  border-right: none;
  border-bottom: none;
  border-left: none;
}
.partners-grid--logos .partner-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  border: none;
  border-top: none;
  border-right: none;
  border-bottom: none;
  border-left: none;
}
.partners-grid--logos .partner-row:not(:first-child) {
  border-top: 1px solid var(--border);
}
.partners-grid--logos .partner-cell,
.partners-grid--logos .partner-cell--logo {
  flex: 1;
  height: 176rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  opacity: 1;
  border: none;
  border-top: none;
  border-right: none;
  border-bottom: none;
  border-left: none;
  box-shadow: none;
  box-sizing: border-box;
}
/* 仅右侧 cell 的左边框 = 两列中间竖线 */
.partners-grid--logos .partner-cell--with-divider {
  border-left: 1px solid var(--border);
}
.partner-item {
  width: 60%;
  height: 60%;
  max-width: 200rpx;
  max-height: 106rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: none;
  background: transparent;
}
.partner-item__img {
  width: 100%;
  height: 100%;
  border: none;
  box-shadow: none;
}

/* ===== Tabs ===== */
.tab-scroll-wrap { position: relative; background: var(--tour-blue); }
/* 上滑吸顶（JS 兜底）：滚动到 TAB 触顶时切为 fixed，吸附在固定头部正下方 */
.tab-scroll-wrap--fixed { position: fixed; left: 0; right: 0; z-index: 130; box-shadow: 0 20rpx 24rpx rgba(0, 0, 0, 0.18); }
.tab-scroll-wrap--hide { opacity: 0; pointer-events: none; }
.tab-scroll-wrap--show { opacity: 1; pointer-events: auto; }
/* TAB 横向溢出提示：叠加在两侧，不拦截点击与滑动手势 */
.tab-overflow-hint {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 52rpx;
  z-index: 2;
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-overflow-hint--left {
  left: 0;
  background: linear-gradient(90deg, #002d62 0%, rgba(0, 45, 98, 0.88) 58%, transparent 100%);
}
.tab-overflow-hint--right {
  right: 0;
  background: linear-gradient(270deg, #002d62 0%, rgba(0, 45, 98, 0.88) 58%, transparent 100%);
}
.tab-overflow-hint__chev {
  color: rgba(255, 255, 255, 0.78);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}
.tab-overflow-hint--left .tab-overflow-hint__chev { margin-right: 12rpx; }
.tab-overflow-hint--right .tab-overflow-hint__chev { margin-left: 12rpx; }
/* TAB 项铺满容器高度（align-items:stretch），文字由 .tab-btn 自身 flex 垂直居中，指示器贴容器底边 */
.gb-tabs { height: var(--tab-height); background: var(--tour-blue); white-space: nowrap; border-bottom: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 20rpx 24rpx rgba(0, 0, 0, 0.18); display: flex; align-items: stretch; }
.gb-tabs::-webkit-scrollbar { display: none; }
/* 统一基线：flex 垂直居中(line-height:1，不用 line-height 撑高居中)，指示器以容器底边为基线 */
.tab-btn {
  position: relative; height: var(--tab-height); line-height: 1; display: flex; align-items: center; justify-content: center; flex: 0 0 25%; min-width: 192rpx; text-align: center;
  font-size: var(--tab-font-size); color: rgba(255, 255, 255, 0.6); white-space: nowrap;
}
.tab-btn.active { color: #fff; }
.tab-btn.active::after { content: ""; position: absolute; height: var(--tab-indicator-height); width: 112rpx; left: 50%; bottom: 0; transform: translateX(-50%); background: var(--tab-indicator-color); opacity: 1; border-radius: 999rpx; }

/* ===== 讨论区围观行（页面级二级 sticky）===== */
.ds-watchers-wrap { flex-shrink: 0; }
.ds-watchers-wrap--fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 129;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}
.ds-watchers-wrap--hide { opacity: 0; pointer-events: none; }
.ds-watchers-wrap--show { opacity: 1; pointer-events: auto; }
.ds-watchers-strip {
  height: 112rpx;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
  box-sizing: border-box;
}
.ds-watchers-track {
  display: inline-flex;
  align-items: center;
  height: 100%;
  min-width: 100%;
  gap: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  vertical-align: top;
}
.ds-watchers-label {
  flex: 0 0 auto;
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
}
.ds-watchers-avatar {
  position: relative;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  border: 2px solid var(--bg-card);
  overflow: hidden;
  background: var(--bg-subtle);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  line-height: 0;
}
.ds-watchers-avatar__img {
  display: block;
  width: 100%;
  height: 100%;
}
.ds-watchers-more {
  flex: 0 0 auto;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  border: 1px solid var(--border);
  background: var(--bg-subtle);
  font-size: 22rpx;
  font-weight: 500;
  white-space: nowrap;
}
.ds-watchers--dark .ds-watchers-more { color: var(--champion-gold); }
.ds-watchers--bright .ds-watchers-more { color: var(--tour-blue); }

/* ===== 报名 TAB 扩展区（页面级二级 sticky）===== */
.register-ext-wrap { flex-shrink: 0; }
.register-ext-wrap--fixed {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 129;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
}
.register-ext-wrap--hide { opacity: 0; pointer-events: none; }
.register-ext-wrap--show { opacity: 1; pointer-events: auto; }
.register-ext {
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
}
.register-ext__summary {
  padding: 20rpx 32rpx 12rpx;
}
.register-ext__summary-text {
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}
.register-ext__summary-count {
  color: var(--champion-gold);
  font-size: 26rpx;
  font-weight: 900;
}
.register-subtabs-wrap {
  border-bottom: 1px solid var(--border);
}
.register-subtabs {
  height: 80rpx;
  white-space: nowrap;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.register-subtabs::-webkit-scrollbar { display: none; }
.register-subtab {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: transparent;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}
.register-subtab__label {
  line-height: 1;
  white-space: nowrap;
}
.register-subtab--active {
  color: var(--tour-blue);
  font-weight: 700;
}
.register-subtab--active::after {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 6rpx;
  background: var(--tour-blue);
  border-radius: 3rpx 3rpx 0 0;
}
.register-subtab--active .register-subtab__label {
  color: var(--tour-blue);
  font-weight: 700;
}
/* DARK 模式：子 TAB 文字使用浅色，指示器横线仍保持 tour-blue */
.detail-page.dark-mode .register-subtab {
  color: var(--text-secondary);
}
.detail-page.dark-mode .register-subtab--active,
.detail-page.dark-mode .register-subtab--active .register-subtab__label {
  color: var(--text-primary);
}
.register-tab-panel { padding: 0; }
/* 空态复用名单卡片内部空间：占据表头以下剩余高度并垂直居中（min-height 由 style 动态注入，下方为兜底） */
.register-user-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 92px - var(--tab-height) - 152rpx - 116rpx - 88rpx - env(safe-area-inset-bottom));
}
.register-user-empty__text { color: var(--text-muted); font-size: 26rpx; }
/* 报名名单表格卡片：卡片容器负责首屏撑高，表头自然高度、人员行正常高度（行不设 flex:1）
   统一详情页视觉：默认 min-height 700px；报名人数超过首屏时卡片继续自然增长（非固定 height）
   名单超出后随 detail-scroll 正常滚动（不改吸顶阈值测量） */
/* 卡片高度由 JS 动态计算并通过 style 注入 min-height（rosterMinHeight）：
   min-height = 窗口高 - HEADER - 主TAB - 报名二级TAB - 底部CTA - 必要间距
   块级承载 min-height 稳定生效；长名单超出后随内容自然增长并可滚动。
   下方 calc 仅作 JS 尚未计算完成时的兜底，避免首帧塌陷导致无法上滑 */
.register-roster-card {
  display: block;
  box-sizing: border-box;
  min-height: calc(100vh - 92px - var(--tab-height) - 152rpx - 116rpx - env(safe-area-inset-bottom));
  margin-bottom: 180rpx;
}
/* 吸顶后内容未溢出锁定标记：不改高度/margin，避免内容变矮把 scrollTop 拉回未吸顶 */
.register-tab-panel.is-locked-after-sticky {
  /* marker class only */
}
/* 吸顶前安全占位：不可见，仅增加可滚距离（与人数无关） */
.register-sticky-spacer {
  width: 100%;
  pointer-events: none;
  visibility: hidden;
}
.roster-head {
  display: grid;
  grid-template-columns: 15% minmax(0, 49%) 12% 24%;
  align-items: center;
  padding: 24rpx 32rpx 24rpx 0;
  background: var(--bg-subtle);
  border-bottom: 1px solid var(--border);
}
.roster-head .roster-col {
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 700;
}
/* 表体为普通块流：行按内容正常堆叠，卡片高度由 .register-roster-card 的 min-height 保证 */
.roster-body {
  display: block;
}
.roster-row {
  display: grid;
  grid-template-columns: 15% minmax(0, 49%) 12% 24%;
  align-items: center;
  padding: 20rpx 32rpx 20rpx 0;
  border-bottom: 1px solid var(--border);
}
.roster-row:last-child { border-bottom: none; }
.roster-col--idx,
.roster-col--payment,
.roster-col--handicap {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.roster-col--idx {
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 700;
}
.roster-head .roster-col--idx {
  color: var(--text-muted);
  font-size: 24rpx;
}
.roster-col--idx text,
.roster-col--payment text,
.roster-col--handicap text {
  text-align: center;
}
.roster-col--player {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  min-width: 0;
  text-align: left;
}
.roster-col--handicap {
  color: var(--champion-gold);
  font-size: 28rpx;
  font-weight: 800;
}
.roster-col--payment {
  min-height: 36rpx;
}
.roster-paid-badge {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 174, 239, 0.12);
  color: var(--data-blue, #00aeef);
  border: 1px solid rgba(0, 174, 239, 0.32);
  font-size: 20rpx;
  font-weight: 800;
}
.roster-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-subtle);
}
.roster-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.roster-gender {
  flex-shrink: 0;
  font-size: 24rpx;
}
/* ===== 报名 bottom sheet（对齐详情页卡片体系：统一左右 40rpx、圆角 16rpx、输入高 88rpx、按钮高 88rpx）===== */
.register-sheet {
  padding-left: 40rpx;
  padding-right: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
.register-sheet__head {
  position: relative;
  padding: 8rpx 0 32rpx;
}
.temp-admin-sheet .register-sheet__head,
.player-manage-sheet .register-sheet__head,
.tee-sheet-manage-sheet .register-sheet__head {
  padding-right: 72rpx;
}
.register-sheet__close {
  position: absolute;
  right: 0;
  top: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 999rpx;
  background: var(--bg-subtle);
  color: var(--text-muted);
  font-size: 36rpx;
  font-weight: 700;
}
.register-sheet__overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--data-blue, #00aeef);
  margin-bottom: 8rpx;
}
.register-sheet__title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text-primary);
}
.register-sheet__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.4;
}
.register-sheet__field {
  padding: 0 0 28rpx;
}
.register-sheet__label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
/* 统一输入 / 只读展示高度 88rpx，与全局表单一致 */
.register-sheet__input,
.register-sheet__readonly {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.register-sheet__readonly { color: var(--text-secondary); }
.register-sheet__placeholder {
  color: var(--text-muted);
  font-weight: 700;
}
.register-sheet__hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
}
.register-sheet__groups {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
/* 性别只读：不可点击，仅展示个人资料中的性别 */
.register-sheet__groups--readonly { pointer-events: none; }
.register-sheet__groups--readonly .register-sheet__group { opacity: 0.9; }
.register-sheet__group {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 16rpx;
  background: var(--bg-secondary);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
}
.register-sheet__group--active {
  background: rgba(0, 45, 98, 0.08);
  border-color: var(--champion-gold);
  color: var(--text-primary);
}
.register-sheet__actions {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0 0;
}
.register-sheet__cancel,
.register-sheet__confirm {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.register-sheet__cancel {
  flex: 1;
  background: var(--bg-secondary);
  font-weight: 800;
  color: var(--text-secondary);
}
.register-sheet__confirm {
  flex: 2;
  background: var(--champion-gold);
  color: #ffffff;
  font-weight: 900;
  letter-spacing: 0.06em;
}
.register-sheet__confirm.is-disabled { opacity: 0.5; }

/* 报名弹窗 — DARK 模式补全（输入区 / 选项 / 按钮） */
.detail-page.dark-mode .register-sheet__title,
.detail-page.dark-mode .register-sheet__sub,
.detail-page.dark-mode .register-sheet__label,
.detail-page.dark-mode .register-sheet__hint {
  color: var(--text-muted);
}
.detail-page.dark-mode .register-sheet__title { color: var(--text-primary); }
.detail-page.dark-mode .register-sheet__input,
.detail-page.dark-mode .register-sheet__readonly,
.detail-page.dark-mode .register-sheet__cancel {
  background: var(--bg-subtle);
  border-color: var(--border);
}
.detail-page.dark-mode .register-sheet__input,
.detail-page.dark-mode .register-sheet__readonly {
  border: 1px solid var(--border);
  color: var(--text-primary);
}
.detail-page.dark-mode .register-sheet__readonly { color: var(--text-secondary); }
/* Tag 选择器 — DARK：未选深色卡片 + 明显边框；选中 PGA 蓝底白字 + ✓ */
.detail-page.dark-mode .register-sheet__group {
  background: var(--bg-card);
  border: 2rpx solid var(--border-hover);
  color: var(--text-primary);
}
.detail-page.dark-mode .register-sheet__groups--readonly .register-sheet__group {
  opacity: 1;
}
.detail-page.dark-mode .register-sheet__group--active {
  background: var(--tour-blue);
  border-color: var(--tour-blue);
  color: #ffffff;
}
.detail-page.dark-mode .register-sheet__group--active::after {
  content: ' ✓';
  font-size: 24rpx;
  font-weight: 900;
}
.detail-page.dark-mode .register-sheet__cancel {
  border: 1px solid var(--border);
  color: var(--text-primary);
}
.detail-page.dark-mode .register-sheet__confirm.is-disabled {
  opacity: 0.45;
  color: rgba(255, 255, 255, 0.72);
}

/* ===== 立即报名固定按钮 ===== */
.register-cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-primary, #ffffff);
  border-top: 2rpx solid var(--border-color, rgba(15, 23, 42, 0.08));
  box-sizing: border-box;
}
.register-cta-btn {
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  background: var(--champion-gold, #c8a24a);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
}
.register-cta-btn--cancel {
  background: transparent;
  color: var(--text-secondary, #475569);
  border: 2rpx solid var(--border-color, rgba(15, 23, 42, 0.16));
}
.register-cta-btn--disabled {
  background: var(--bg-secondary, #f1f5f9);
  color: var(--text-muted, #94a3b8);
  border: 2rpx solid var(--border-color, rgba(15, 23, 42, 0.08));
  pointer-events: none;
}

/* ===== 取消报名确认弹窗 ===== */
.register-cancel-modal {
  position: fixed;
  inset: 0;
  z-index: 220;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  box-sizing: border-box;
}
.register-cancel-dialog {
  width: 100%;
  max-width: 600rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 24rpx;
  background: var(--bg-primary, #ffffff);
  box-sizing: border-box;
}
.register-cancel-dialog__title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text-primary);
  text-align: center;
}
.register-cancel-dialog__desc {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-muted);
  text-align: center;
}
.register-cancel-dialog__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.register-cancel-dialog__btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
}
/* 取消按钮：固定浅色底 + 深色字（BRIGHT/DARK 弹窗背景均保持一致对比） */
.register-cancel-dialog__btn:not(.register-cancel-dialog__btn--danger) {
  background: #f1f5f9;
  color: #374151;
}
.register-cancel-dialog__btn--danger {
  background: #dc2626;
  color: #ffffff;
}
.register-cancel-dialog__btn.is-disabled { opacity: 0.5; }

.register-user-name {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

/* ===== 分组 TAB 内容区（撑满主 TAB 以下首屏剩余空间） ===== */
.groups-tab-panel {
  padding: 0;
  box-sizing: border-box;
  min-height: calc(100vh - 92px - var(--tab-height) - 40rpx - env(safe-area-inset-bottom));
  margin-bottom: 32rpx;
}
.groups-tab-panel--with-cta {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  margin-bottom: 0;
}
.groups-tab-header {
  padding: 4rpx 0 12rpx;
}
.groups-tab-header__title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
}
.groups-tab-toolbar { margin-top: 24rpx; }
.groups-tab-toolbar--first { margin-top: 12rpx; }
.add-group-btn {
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  color: var(--text-muted);
  font-size: 28rpx;
  font-weight: 700;
  background: transparent;
}
.add-group-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1px solid var(--border-hover);
  color: var(--text-muted);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}
.groups-panel-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  min-height: 280rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}
.groups-panel-empty__text {
  color: var(--text-muted);
  font-size: 26rpx;
}
.groups-unscheduled {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 8rpx 8rpx;
}
.groups-unscheduled__text {
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 600;
}
.groups-tab-group-block { margin-bottom: 8rpx; }
/* 分组 TAB 球员项：全局 .gb-group-player*（app.wxss） */
.groups-tab-no-players {
  padding: 24rpx 8rpx 8rpx;
}
.groups-tab-no-players__text {
  color: var(--text-muted);
  font-size: 24rpx;
}
.groups-pairing-block {
  margin: -8rpx 0 24rpx;
  padding: 20rpx 24rpx 16rpx;
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  border-top: none;
  border-radius: 0 0 20rpx 20rpx;
}
.groups-pairing-block__title {
  display: block;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.groups-pairing-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}
.groups-pairing-card__label {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: var(--tour-blue);
  margin-bottom: 10rpx;
}
.groups-pairing-card__members {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
}
.groups-pairing-member {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.groups-pairing-member__avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 9999rpx;
  background: var(--bg-subtle);
}
.groups-pairing-member__name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}
.groups-pairing-incomplete {
  padding-top: 4rpx;
}
.groups-pairing-incomplete__label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 700;
}
.groups-pairing-incomplete__names {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.detail-main { padding: 40rpx 32rpx 80rpx; box-sizing: border-box; }
.detail-main--flush { padding: 0; }
.discussion-inline { display: block; }
.game-tab-panel { margin-bottom: 32rpx; }
.game-tab-body { margin-bottom: 0; }
.game-tab-spacer {
  width: 100%;
  background: var(--bg-card);
  pointer-events: none;
}

/* ===== Leaderboard ===== */
.leaderboard-table-wrap { background: var(--bg-card); border: 1px solid var(--border); border-top: 6rpx solid var(--tour-blue); border-radius: 16rpx; box-shadow: var(--shadow-card); overflow: hidden; }
.leaderboard-view-label { padding: 22rpx 32rpx 4rpx; color: var(--text-muted); font-size: 22rpx; font-weight: 800; letter-spacing: 0.08em; }
.leaderboard-head { display: flex; align-items: center; background: var(--bg-subtle); color: var(--text-muted); border-bottom: 1px solid var(--border); font-size: 20rpx; font-weight: 900; letter-spacing: 0.14em; padding: 24rpx 0; }
.lh-pos { width: 15%; text-align: center; }
.lh-player { width: 45%; padding-left: 16rpx; }
.lh-thru { width: 20%; text-align: center; }
.lh-total { width: 20%; text-align: center; }

.leaderboard-row { display: flex; align-items: center; border-bottom: 1px solid var(--border); color: var(--text-secondary); padding: 28rpx 0; }
.leaderboard-row:active { background: var(--bg-hover); }
.lr-pos { width: 15%; text-align: center; }
.lr-player { width: 45%; padding: 0 16rpx; display: flex; align-items: center; gap: 10rpx; min-width: 0; }
.lr-thru { width: 20%; text-align: center; font-size: 24rpx; color: var(--text-muted); }
.lr-total { width: 20%; text-align: center; }

/* 个人榜五列：POS | PLAYER | TEAM | THRU | TO PAR（不影响分队榜四列） */
.leaderboard-head--personal .lh-pos,
.leaderboard-row--personal .lr-pos { width: 12%; }
.leaderboard-head--personal .lh-player,
.leaderboard-row--personal .lr-player { width: 30%; }
.leaderboard-head--personal .lh-team,
.leaderboard-row--personal .lr-team { width: 22%; }
.leaderboard-head--personal .lh-thru,
.leaderboard-row--personal .lr-thru { width: 16%; }
.leaderboard-head--personal .lh-total,
.leaderboard-row--personal .lr-total { width: 20%; }
.lh-team { padding-left: 8rpx; text-align: left; box-sizing: border-box; }
.lr-team {
  padding: 0 8rpx;
  box-sizing: border-box;
  color: var(--text-muted);
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pos-cell { color: var(--text-muted); font-weight: 800; font-size: 26rpx; }
.player-name { color: var(--text-primary); font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.leaderboard-team-tag { flex-shrink: 0; max-width: 112rpx; padding: 2rpx 8rpx; border-radius: 999rpx; background: rgba(0, 45, 98, 0.08); color: var(--text-muted); font-size: 20rpx; line-height: 1.4; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gender-icon { font-size: 22rpx; flex-shrink: 0; }
.leaderboard-total { font-weight: 900; font-style: italic; font-size: 32rpx; }
.score-under { color: #ef4444; }
.score-even { color: var(--text-muted); }
.score-over { color: var(--text-primary); }
.team-leaderboard-row { margin: 0 0 16rpx; border-bottom: 0; border-radius: 12rpx; background: #e5e7eb; box-shadow: none; overflow: hidden; }
.team-leaderboard-row.is-expanded { margin-bottom: 0; border-radius: 12rpx 12rpx 0 0; background: var(--champion-gold); color: #ffffff; }
.team-leaderboard-row.is-expanded .pos-cell,
.team-leaderboard-row.is-expanded .player-name,
.team-leaderboard-row.is-expanded .lr-thru,
.team-leaderboard-row.is-expanded .leaderboard-total,
.team-leaderboard-row.is-expanded .team-leaderboard-chevron { color: #ffffff; }
.team-leaderboard-total { display: flex; align-items: center; justify-content: center; gap: 8rpx; }
.team-leaderboard-chevron { color: var(--text-muted); font-size: 22rpx; line-height: 1; }
.team-leaderboard-players-wrap { margin: 0 0 16rpx; border: 2rpx solid var(--champion-gold); border-top: 0; border-radius: 0 0 12rpx 12rpx; background: #ffffff; box-shadow: none; overflow: hidden; }
.team-leaderboard-player-head { padding-left: 0; padding-right: 0; background: #ffffff; }
.team-leaderboard-player-row { padding-left: 0; padding-right: 0; background: #ffffff; border-bottom: 1px solid #e5e7eb; }
.team-leaderboard-player-row:active { background: var(--bg-hover); }
.team-leaderboard-player-row.is-non-counting { background: #f8fafc; color: var(--text-secondary); opacity: 0.82; }
.team-leaderboard-player-row.is-non-counting .player-name,
.team-leaderboard-player-row.is-non-counting .leaderboard-total { color: var(--text-secondary); }
.team-leaderboard-divider-strong { height: 2px; margin: 0; background: #9ca3af; }

/* 分队榜 DARK：避免 LIGHT 固定浅色底，金色仅用于选中态与外边框 */
.detail-page.dark-mode .team-leaderboard-row {
  background: #1f1f1f;
  color: var(--text-primary);
}
.detail-page.dark-mode .team-leaderboard-row .pos-cell,
.detail-page.dark-mode .team-leaderboard-row .player-name,
.detail-page.dark-mode .team-leaderboard-row .lr-thru,
.detail-page.dark-mode .team-leaderboard-row .team-leaderboard-chevron {
  color: var(--text-secondary);
}
.detail-page.dark-mode .team-leaderboard-row.is-expanded {
  background: #ce9224;
  color: #ffffff;
}
.detail-page.dark-mode .team-leaderboard-row.is-expanded .pos-cell,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .player-name,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .lr-thru,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .leaderboard-total,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .leaderboard-total.score-under,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .leaderboard-total.score-even,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .leaderboard-total.score-over,
.detail-page.dark-mode .team-leaderboard-row.is-expanded .team-leaderboard-chevron {
  color: #ffffff;
}
.detail-page.dark-mode .team-leaderboard-players-wrap {
  background: var(--bg-card);
  border-color: #ce9224;
}
.detail-page.dark-mode .team-leaderboard-player-head {
  background: var(--bg-subtle);
  color: var(--text-muted);
}
.detail-page.dark-mode .team-leaderboard-player-row {
  background: var(--bg-card);
  color: var(--text-secondary);
  border-bottom-color: #333333;
}
.detail-page.dark-mode .team-leaderboard-player-row .player-name {
  color: var(--text-primary);
}
.detail-page.dark-mode .team-leaderboard-player-row:active {
  background: var(--bg-hover);
}
.detail-page.dark-mode .team-leaderboard-player-row.is-non-counting {
  background: #161616;
  color: var(--text-muted);
  opacity: 0.88;
}
.detail-page.dark-mode .team-leaderboard-player-row.is-non-counting .player-name,
.detail-page.dark-mode .team-leaderboard-player-row.is-non-counting .leaderboard-total {
  color: var(--text-muted);
}
.detail-page.dark-mode .team-leaderboard-divider-strong {
  background: #4b5563;
}

/* ===== 展开成绩卡 ===== */
.scorecard-row { background: var(--bg-card); border-bottom: 1px solid var(--border); }
.scorecard-profile { background: var(--bg-card); color: var(--text-primary); border-bottom: 1px solid var(--border); padding: 32rpx; display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.sc-profile-left { display: flex; align-items: center; gap: 32rpx; min-width: 0; }
.sc-avatar-wrap { position: relative; flex-shrink: 0; }
.sc-avatar { width: 160rpx; height: 160rpx; border-radius: 999rpx; border: 1px solid var(--border); }
.sc-flag { position: absolute; bottom: -8rpx; right: -8rpx; width: 48rpx; height: 48rpx; border-radius: 999rpx; border: 4rpx solid var(--bg-card); overflow: hidden; background: #fff; }
.sc-flag image { width: 100%; height: 100%; }
.sc-profile-meta { min-width: 0; }
.sc-name-line { display: flex; align-items: center; min-width: 0; }
.sc-name { font-size: 40rpx; font-weight: 900; font-style: italic; text-transform: uppercase; color: var(--text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sc-chevron { margin-left: 16rpx; color: var(--text-muted); font-size: 24rpx; }
.sc-sub { font-size: 20rpx; font-weight: 700; color: var(--text-muted); margin-top: 8rpx; text-transform: uppercase; letter-spacing: 0.06em; }
.sc-sub-strong { color: var(--text-primary); font-weight: 900; }
.sc-follow-btn { flex-shrink: 0; padding: 12rpx 24rpx; border-radius: 999rpx; background: var(--champion-gold); color: #fff; font-size: 22rpx; font-weight: 700; white-space: nowrap; }

.scorecard-dark-panel { background: #111111; color: #fff; border-top: 1px solid rgba(255, 255, 255, 0.08); padding: 32rpx 0; }
.detail-page.bright-mode .scorecard-dark-panel { background: #f3f4f6; color: var(--text-primary); border-top: 1px solid var(--border); }
.sc-course { display: block; padding: 0 32rpx; text-align: left; font-size: 20rpx; font-weight: 700; font-style: italic; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(255, 255, 255, 0.45); margin-bottom: 16rpx; }
.detail-page.bright-mode .sc-course { color: var(--text-muted); }
/* 球场名称标题：过长单行省略，不撑破逐洞面板 */
.course-name-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.tour-scorecard { margin: 0 0 24rpx; border: 1px solid #333; border-radius: 8rpx; overflow: hidden; }
.tsc-row { display: flex; }
.tsc-cell { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; font-size: 22rpx; font-weight: 700; background: #fff; color: #111; border: 0; display: flex; align-items: center; justify-content: center; }
.tour-scorecard .tsc-row:nth-child(1) .tsc-cell,
.tour-scorecard .tsc-row:nth-child(2) .tsc-cell { background: var(--tour-blue); color: #fff; }

/* ===== 领先榜逐洞详情面板：成绩状态(颜色/圈框)复用记分卡，尺寸由本面板专用 class 独立控制 ===== */
.ld-scorecard {
  --ld-score-font: 20rpx;       /* 总杆主成绩字号 */
  --ld-score-diff-font: 16rpx;  /* 杆差模式再小一号（仅缩文字） */
  --ld-marker-size: 30rpx;      /* 圈/框直径，固定不随文字缩放 */
}
/* 逐洞单格：整体压缩高度，避免比记分表大 */
.ld-scorecard .tsc-cell { height: 52rpx; line-height: 52rpx; font-size: var(--ld-score-font); }
.ld-scorecard .ld-score-cell { padding: 0; overflow: visible; }
/* 圈/框容器：逐洞面板专用小尺寸 */
.ld-score-marker {
  width: var(--ld-marker-size);
  height: var(--ld-marker-size);
  min-width: var(--ld-marker-size);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.ld-score-marker.circle { border-radius: 999rpx; }
.ld-score-marker.square { border-radius: 4rpx; }
/* 成绩视觉语义（与记分卡一致，diff 决定状态，不受总杆/杆差模式影响） */
/* 老鹰球及更好：圆底白字（沿用记分卡主视觉色，不写死金色） */
.ld-score-marker.score-eagle { background: #ef4444; }
.ld-score-marker.score-eagle .ld-score-value { color: #fff; }
/* 小鸟球：红圈（描边，内部透明，非红色实心） */
.ld-score-marker.score-birdie { background: transparent; border: 2rpx solid #ef4444; }
.ld-score-marker.score-birdie .ld-score-value { color: #ef4444; }
/* 加一：方框（描边，内部透明，非黑色实心） */
.ld-score-marker.score-bogey { background: transparent; border: 2rpx solid #111; }
.ld-score-marker.score-bogey .ld-score-value { color: #111; }
/* 加二及更差：灰底白字（实心灰底，非蓝色实心、非双方框） */
.ld-score-marker.score-double-bogey { background: #6b7280; border: 0; }
.ld-score-marker.score-double-bogey .ld-score-value { color: #fff; }
/* SCORE 文字：默认总杆字号；杆差模式只缩文字、不缩圈框 */
.ld-score-value { font-size: var(--ld-score-font); line-height: 1; font-weight: 700; text-align: center; white-space: nowrap; }
.ld-score-value.diff-mode { font-size: var(--ld-score-diff-font); }

.score-legend-area { display: grid; grid-template-columns: 1fr 1fr; row-gap: 12rpx; font-size: 20rpx; color: #9ca3af; padding: 0 32rpx; margin-bottom: 24rpx; }
.legend-item { display: flex; align-items: center; }
.score-legend-dot { width: 24rpx; height: 24rpx; display: inline-block; margin-right: 16rpx; flex-shrink: 0; }
/* 图例：与成绩视觉语义一致（老鹰=圆底白字 / 小鸟=红圈 / 加一=方框 / 加二+=灰底白字） */
.dot-eagle { background: #ef4444; border-radius: 999rpx; }
.dot-birdie { background: transparent; border: 2rpx solid #ef4444; border-radius: 999rpx; }
.dot-bogey { background: transparent; border: 2rpx solid #9ca3af; }
.dot-double { background: #6b7280; }
.detail-page.bright-mode .dot-bogey { border-color: #111; }
.sc-ad { display: block; margin: 0 32rpx; width: calc(100% - 64rpx); border-radius: 16rpx; }

/* 快捷面板：缩小成绩表、隐藏图例 */
.score-panel-quick .score-legend-area { display: none; }
.score-panel-quick .tsc-cell { height: 56rpx; line-height: 56rpx; font-size: 20rpx; }

/* ===== 出发表 ===== */
.tee-group-card { position: relative; overflow: hidden; background: var(--bg-card); border: 1px solid var(--border); border-top: 6rpx solid var(--tour-blue); border-radius: 24rpx; box-shadow: var(--shadow-card); padding: 96rpx 28rpx 32rpx; margin-bottom: 24rpx; }
/* 分组 TAB 删除入口：沿用创建页全局 delete-group-btn 规范，定位于卡片右上角 */
.tee-group-card .delete-group-btn {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2px solid var(--bg-card);
  background: var(--error, #ef4444);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
  z-index: 4;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.16);
}
.tee-group-meta { position: absolute; left: 0; top: 0; right: 0; height: 72rpx; display: flex; align-items: center; gap: 20rpx; background: linear-gradient(90deg, rgba(0, 45, 98, 0.1), transparent 72%); }
.detail-page.dark-mode .tee-group-meta { background: linear-gradient(90deg, rgba(0, 45, 98, 0.28), transparent 72%); }
.tee-group-badge { height: 72rpx; line-height: 72rpx; display: inline-flex; align-items: center; background: var(--tour-blue); color: #fff; font-size: 26rpx; font-weight: 700; padding: 0 28rpx; border-bottom-right-radius: 20rpx; }
.tee-start-info { display: inline-flex; align-items: center; gap: 12rpx; color: var(--text-secondary); font-size: 22rpx; font-weight: 500; white-space: nowrap; }
.tee-clock { color: var(--champion-gold); font-size: 20rpx; }
.tee-hole-pill { display: inline-flex; align-items: center; height: 36rpx; padding: 0 14rpx; border-radius: 9999rpx; background: rgba(206, 146, 36, 0.12); color: var(--champion-gold); border: 1px solid rgba(206, 146, 36, 0.22); font-size: 20rpx; font-weight: 700; }
.tee-player-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx 8rpx; align-items: start; overflow: visible; }
.tee-player {
  position: relative;
  display: grid;
  grid-template-columns: 88rpx minmax(0, 1fr);
  grid-template-rows: auto auto;
  column-gap: 4rpx;
  row-gap: 4rpx;
  align-items: start;
  min-width: 0;
}
.tee-avatar-wrap {
  grid-column: 1;
  grid-row: 1 / span 2;
  position: relative;
  width: 88rpx;
  height: 96rpx;
  align-self: start;
}
.tee-avatar { width: 80rpx; height: 80rpx; border-radius: 9999rpx; border: 1px solid var(--border); background: var(--bg-subtle); display: block; }
.tee-avatar-plus {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-muted);
  font-size: 38rpx;
  font-weight: 700;
}
.tee-v-badge { position: absolute; right: -4rpx; bottom: -4rpx; width: 40rpx; height: 40rpx; border-radius: 9999rpx; background: #fff; border: 1px solid rgba(206, 146, 36, 0.55); display: flex; align-items: center; justify-content: center; color: var(--champion-gold); font-size: 20rpx; font-weight: 900; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.16); }
.tee-player-name {
  grid-column: 2;
  grid-row: 1;
  min-width: 0;
  align-self: start;
  color: var(--text-primary);
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 横向：两头像水平中点；纵向：与头像下半部分对齐 */
.tee-marker-line {
  position: absolute;
  left: calc(50% + 44rpx);
  top: 60rpx;
  transform: translateX(-50%);
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  line-height: 1;
  pointer-events: none;
}
.tee-marker-dot { width: 10rpx; height: 10rpx; border-radius: 9999rpx; flex-shrink: 0; }
.tee-marker-dot--female { background: #dc2626; }
.tee-marker-dot--male { background: #0284c7; }
.tee-marker-letter { font-size: 20rpx; font-weight: 700; color: var(--text-secondary); line-height: 1; }
.tee-team-red { display: none; }
.tee-team-blue { display: none; }
.tee-status {
  position: absolute;
  right: 28rpx;
  top: 0;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--text-muted);
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
  pointer-events: none;
  z-index: 2;
}
/* 出发表底部悬浮快捷按钮：保留标准按钮视觉（填充/圆角/内边距/点击态），
   仅移除外层背景容器（panel/card/bar）。按钮自身直接 fixed 悬浮，不形成区域块。 */
.tee-quick-entry-float {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 110;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  text-align: center;
  border-radius: 12rpx;
  background: var(--tour-blue);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 36rpx rgba(0, 45, 98, 0.28);
}
.tee-quick-entry-float:active { background: #001d42; }
/* 出发表列表内容容器：
   1) padding-bottom 预留安全间距，最后一组不被底部悬浮按钮遮挡（仅作用于内容区，不动 scroll root）
   2) min-height 保证内容区足够高、可正常滚动，使 TAB 吸顶（JS 克隆）阈值始终可达，避免短内容时吸顶失效 */
.tee-sheet-list {
  box-sizing: border-box;
  min-height: calc(100vh - 200rpx);
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 讨论区 ===== */
/* 讨论区全屏层：固定覆盖 header 以下区域（top 由 JS headerTotalHeight 给定），
   内部 = TAB（flex 不收缩）+ 统一讨论区组件（flex:1，自管围观/聊天滚动/输入/表情）。
   不进入 scroll-view，不影响其它 TAB 的滚动与吸顶逻辑。 */
.ds-fullscreen {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
}
.ds-fullscreen .tab-scroll-wrap { flex: 0 0 auto; }
.ds-fill { flex: 1 1 auto; min-height: 0; display: block; }
.ds-discussion-tabs--ghost {
  visibility: hidden;
  pointer-events: none;
}

/* ===== MORE FAB ===== */
.leaderboard-fab {
  position: fixed;
  right: 16rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: var(--tour-blue);
  color: var(--champion-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  z-index: 120;
  box-shadow: -8rpx 0 36rpx rgba(0, 0, 0, 0.26);
  transition: width 0.18s ease, border-radius 0.18s ease, padding 0.18s ease;
}
.leaderboard-fab--expanded {
  width: 112rpx;
  border-radius: 999rpx;
}
.leaderboard-fab--dragging {
  transition: none;
}
.leaderboard-fab--hit {
  background: var(--champion-gold);
  color: #ffffff;
}
.fab-label {
  letter-spacing: 0.02em;
  line-height: 1;
}

/* ===== Bottom sheet ===== */
.sheet-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 150; }
.bottom-sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; color: var(--tour-blue); border-radius: 80rpx 80rpx 0 0; z-index: 180; box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.35); padding-bottom: env(safe-area-inset-bottom); }
.sheet-handle { width: 96rpx; height: 8rpx; border-radius: 999rpx; background: #e5e7eb; margin: 24rpx auto 40rpx; }
.feature-section { padding: 0 48rpx 24rpx; }
.feature-section-title { display: flex; align-items: baseline; justify-content: space-between; margin: 0 0 24rpx; padding: 0 4rpx; color: var(--tour-blue); }
.fst-main { font-size: 24rpx; font-weight: 800; letter-spacing: 0.12em; }
.fst-sub { font-style: normal; font-size: 20rpx; color: #9ca3af; letter-spacing: 0.08em; }
.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); column-gap: 24rpx; row-gap: 32rpx; }
.feature-item { display: flex; flex-direction: column; align-items: center; min-height: 156rpx; }
.feature-item--empty { visibility: hidden; pointer-events: none; }
.feature-icon { width: 112rpx; height: 112rpx; border-radius: 24rpx; background: var(--tour-blue); color: var(--champion-gold); display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; font-size: 44rpx; box-shadow: 0 12rpx 24rpx rgba(0, 45, 98, 0.18); }
.feature-icon.danger { background: #ff5722; color: #fff; }
.feature-icon.warning { background: #ffc107; color: var(--tour-blue); }
.feature-icon.success { background: #16a34a; color: #fff; }
.feature-icon.state { background: #f97316; color: #fff; }
.feature-label { color: var(--tour-blue); font-size: 20rpx; line-height: 1.2; font-weight: 800; text-align: center; }
.sheet-cancel-wrap { padding: 4rpx 80rpx 48rpx; }
.sheet-cancel-btn { height: 88rpx; line-height: 88rpx; text-align: center; background: var(--tour-blue); color: var(--champion-gold); border-radius: 12rpx; font-weight: 900; font-size: 24rpx; letter-spacing: 0.18em; }

/* 替他人报名 · 手工添加底部弹窗（对齐记分页 manual-sheet） */
.manual-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.46);
  z-index: 700;
}

.manual-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 710;
  background: var(--bg-card);
  border: 1px solid var(--border-color, var(--border));
  border-bottom: 0;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 36rpx rgba(0, 0, 0, 0.24);
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--text-primary);
}

.manual-sheet__handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--border-hover, var(--border-color, var(--border)));
  margin: 0 auto 28rpx;
}

.manual-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.manual-sheet__overline {
  display: block;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 0.12em;
  color: var(--data-blue, #00aeef);
}

.manual-sheet__title {
  display: block;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: var(--text-primary);
}

.manual-sheet__close {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 1px solid var(--border-color, var(--border));
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-muted, var(--text-secondary));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.manual-sheet__body {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.manual-field__label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.manual-field__input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color, var(--border));
  background: var(--bg-subtle, var(--bg-primary));
  color: var(--text-primary);
  font-size: 28rpx;
}

.manual-field__placeholder {
  color: var(--text-muted, #9ca3af);
}

.manual-gender {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.manual-gender__tag {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: 1px solid var(--border-color, var(--border));
  background: var(--bg-subtle, var(--bg-card));
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.manual-gender__tag.is-active {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border-color: var(--champion-gold, #ce9224);
}

.manual-sheet__footer {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.manual-sheet__btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.manual-sheet__btn--cancel {
  color: var(--text-secondary);
  background: var(--bg-subtle, var(--bg-card));
  border: 1px solid var(--border-color, var(--border));
}

.manual-sheet__btn--confirm {
  color: #000000;
  background: var(--champion-gold, #ce9224);
  border: 1px solid var(--champion-gold, #ce9224);
}

/* Bottom sheet — DARK 模式（页面根 .detail-page.dark-mode 继承 themeClass） */
.detail-page.dark-mode .bottom-sheet {
  background: var(--bg-card);
  color: var(--text-primary);
  box-shadow: 0 -48rpx 120rpx rgba(0, 0, 0, 0.55);
}
.detail-page.dark-mode .sheet-handle { background: var(--border); }
.detail-page.dark-mode .feature-section-title,
.detail-page.dark-mode .feature-label { color: var(--text-primary); }
.detail-page.dark-mode .fst-sub { color: var(--text-muted); }

.leaderboard-setting-sheet { padding: 0 40rpx calc(40rpx + env(safe-area-inset-bottom)); }
.leaderboard-setting__head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32rpx; }
.leaderboard-setting__overline { display: block; color: var(--champion-gold); font-size: 20rpx; font-weight: 900; letter-spacing: 0.16em; line-height: 1.2; }
.leaderboard-setting__title { display: block; margin-top: 8rpx; color: var(--text-primary); font-size: 36rpx; font-weight: 900; line-height: 1.2; }
.leaderboard-setting__close { width: 64rpx; height: 64rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; font-size: 36rpx; line-height: 1; }
.leaderboard-setting__section { margin-top: 28rpx; }
.leaderboard-setting__label { display: block; margin-bottom: 16rpx; color: var(--text-secondary); font-size: 24rpx; font-weight: 800; }
.leaderboard-setting__options { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.leaderboard-setting-option { min-height: 88rpx; padding: 18rpx 20rpx; border-radius: 20rpx; border: 2rpx solid var(--border-color); background: var(--bg-subtle); color: var(--text-primary); display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.leaderboard-setting-option.is-active { border-color: var(--champion-gold); background: rgba(201, 164, 92, 0.16); color: var(--champion-gold); }
.leaderboard-setting-option.is-disabled { opacity: 0.46; color: var(--text-muted); }
.leaderboard-setting-option__name { font-size: 26rpx; font-weight: 900; text-align: center; line-height: 1.3; }
.leaderboard-setting__footer { display: flex; gap: 20rpx; margin-top: 40rpx; }
.leaderboard-setting__btn { flex: 1; height: 88rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 900; }
.leaderboard-setting__btn--cancel { color: var(--text-secondary); background: var(--bg-subtle); border: 1px solid var(--border-color); }
.leaderboard-setting__btn--confirm { color: #000; background: var(--champion-gold); border: 1px solid var(--champion-gold); }

/* ===== 风格选择 sheet ===== */
.style-sheet { position: fixed; left: 0; right: 0; bottom: 0; transform: translateY(100%); background: var(--bg-card); color: var(--text-primary); border-radius: 48rpx 48rpx 0 0; border: 1px solid var(--border); z-index: 260; transition: transform 0.25s ease; box-shadow: 0 -36rpx 80rpx rgba(0, 0, 0, 0.35); padding-bottom: max(40rpx, env(safe-area-inset-bottom)); }
.style-sheet.active { transform: translateY(0); }
.style-sheet__head { display: flex; align-items: flex-start; justify-content: space-between; padding: 36rpx 40rpx 8rpx; }
.style-sheet__title { display: block; font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.style-sheet__sub { display: block; font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; }
.style-sheet__close { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; }
.style-section { padding: 36rpx 40rpx 0; }
.style-section-title { display: block; font-size: 24rpx; font-weight: 700; color: var(--text-secondary); margin-bottom: 20rpx; }
.style-option-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.style-option { height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 12rpx; border: 1px solid var(--border-hover); background: var(--bg-subtle); color: var(--text-secondary); font-size: 26rpx; font-weight: 700; }
.style-option.active { border-color: var(--champion-gold); background: var(--tour-blue); color: #fff; box-shadow: inset 0 -6rpx 0 var(--champion-gold); }
.style-done-wrap { padding: 48rpx 40rpx 0; }
.style-done-btn { height: 88rpx; line-height: 88rpx; text-align: center; background: var(--tour-blue); color: #fff; border-radius: 12rpx; font-weight: 700; font-size: 28rpx; }

/* ===== 围观弹层 ===== */
.watchers-modal { position: fixed; inset: 0; z-index: 260; display: flex; align-items: flex-end; justify-content: center; background: rgba(0, 0, 0, 0.45); }
.watchers-sheet { width: 100%; max-height: 72vh; background: var(--bg-card); border: 1px solid var(--border); border-bottom: none; border-radius: 48rpx 48rpx 0 0; overflow: hidden; box-shadow: 0 -36rpx 80rpx rgba(0, 0, 0, 0.22); }
.watchers-sheet-header { display: flex; align-items: center; justify-content: space-between; padding: 32rpx 36rpx; border-bottom: 1px solid var(--border); }
.watchers-sheet-title { display: block; color: var(--text-primary); font-size: 30rpx; font-weight: 700; }
.watchers-sheet-subtitle { display: block; color: var(--text-muted); font-size: 20rpx; margin-top: 4rpx; }
.watchers-close-btn { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: var(--bg-subtle); color: var(--text-muted); display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); }
.watchers-list { max-height: calc(72vh - 148rpx); padding: 16rpx 0 36rpx; }
.watcher-item { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 36rpx; border-bottom: 1px solid var(--border); color: var(--text-primary); }
.watcher-item image { width: 84rpx; height: 84rpx; border-radius: 9999rpx; flex-shrink: 0; }
.watcher-col { display: flex; flex-direction: column; }
.watcher-name { font-size: 28rpx; }
.watcher-hint { color: var(--text-muted); font-size: 22rpx; margin-top: 4rpx; }
.watcher-at { margin-left: auto; color: var(--data-blue); font-size: 24rpx; font-weight: 700; }

/* ===== 本场临时管理员 · 权限管理（复用 register-sheet，仅保留布局辅助） ===== */
.temp-admin-sheet {
