<view class="detail-page {{themeClass}}" bindtap="onPageTap">

  <!-- 讨论区围观行模板（流内 + 吸顶克隆共用） -->
  <template name="discussionWatchersStrip">
    <scroll-view class="ds-watchers-strip" scroll-x>
      <view class="ds-watchers-track">
        <text class="ds-watchers-label">围观</text>
        <view
          wx:for="{{watchers}}"
          wx:key="name"
          class="ds-watchers-avatar"
          data-userid="{{item.userId}}"
          data-name="{{item.name}}"
          bindtouchstart="onWatcherAvatarTouchStart"
          bindtouchmove="onWatcherAvatarTouchMove"
          bindtouchend="onWatcherAvatarTouchEnd"
          bindtouchcancel="onWatcherAvatarTouchEnd"
        >
          <image class="ds-watchers-avatar__img" src="{{item.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="ds-watchers-more" bindtap="openWatchers">更多 ›</view>
      </view>
    </scroll-view>
  </template>

  <!-- 报名 TAB 扩展区模板（流内 + 吸顶克隆共用） -->
  <template name="registerExtensionStrip">
    <view class="register-ext">
      <view class="register-ext__summary">
        <text class="register-ext__summary-text">报名总人数：<text class="register-ext__summary-count">{{registerTotalCount}}</text></text>
      </view>
      <view class="register-subtabs-wrap">
        <scroll-view class="register-subtabs" scroll-x enable-flex>
          <view
            wx:for="{{registerSubTabs}}"
            wx:key="id"
            bindtap="switchRegisterSubTab"
            data-id="{{item.id}}"
            class="register-subtab {{activeRegisterSubTab === item.id ? 'register-subtab--active' : ''}}"
          >
            <text class="register-subtab__label">{{item.name}}（{{item.count}}）</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </template>

  <!-- Header -->
  <view class="gb-header" style="{{headerRootStyle}}">
    <view class="gb-header__inner" style="{{headerBarStyle}}">
      <view class="gb-header__left">
        <view bindtap="onBack" class="gb-header__back" aria-label="返回">
          <text class="gb-header__chevron">‹</text>
        </view>
        <view>
          <text class="gb-header__eyebrow">TOURNAMENT</text>
          <text class="gb-header__title">赛事详情</text>
        </view>
      </view>
      <!-- 右侧不绘制假胶囊：真实微信胶囊避让由 headerBarStyle 的 padding-right 保证 -->
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y scroll-into-view="{{scrollToTopView}}" bindscroll="onScroll">
    <!-- 顶部哨兵：切 TAB 时滚动回此处，确保每个 TAB 从「信息区域」开始，吸顶仅由后续 scroll 触发 -->
    <view id="ds-page-top"></view>
    <!-- Hero -->
    <view class="hero-wrap">
      <view class="hero">
        <image class="hero__img" src="{{match.bannerImage}}" mode="aspectFill"></image>
        <view class="hero__overlay"></view>
        <view class="registered-chip">{{match.statusLabel}}</view>
      </view>
      <view class="event-logo-wrap">
        <view class="event-logo"><image src="{{match.logo}}" mode="aspectFill" style="width:100%;height:100%;"></image></view>
      </view>
    </view>

    <!-- Event Intro -->
    <view class="event-intro">
      <text class="event-date">{{match.dateText}}</text>
      <view class="event-title">
        <text class="event-title__line">{{match.titleMain}}</text>
      </view>
      <view class="meta-chip-row">
        <view class="meta-chip">📅 {{match.formatLabel}}</view>
        <view class="meta-chip">👥 {{match.typeLabel}}</view>
      </view>

      <view class="ds-card info-card">
        <view class="info-row"><text class="info-row-label">主办</text><text class="info-row-value">{{match.organizer}}</text></view>
        <view class="info-row"><text class="info-row-label">球场</text><text class="info-row-value">{{match.venue}}</text></view>
        <view class="info-row"><text class="info-row-label">时间</text><text class="info-row-value">{{match.timeText}}</text></view>
        <view class="info-row">
          <text class="info-row-label">价格</text>
          <view class="info-row-value" style="display:flex;flex-wrap:wrap;gap:8rpx;align-items:center;">
            <view wx:for="{{match.priceTags}}" wx:key="index" class="meta-chip">{{item}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- Divider -->
    <view class="section-divider"><text class="section-divider__text">赛事组织</text></view>

    <!-- Tabs（始终在流内，滚动到顶时由外层固定克隆接管吸顶） -->
    <view class="tab-scroll-wrap tab-scroll-wrap--inflow">
      <scroll-view class="gb-tabs" scroll-x enable-flex bindscroll="onTabHScroll">
        <view wx:for="{{tabs}}" wx:key="id" bindtap="switchTab" data-tab="{{item.id}}" class="tab-btn {{activeTab === item.id ? 'active' : ''}}">{{item.label}}</view>
      </scroll-view>
      <view wx:if="{{tabShowLeftIndicator}}" class="tab-overflow-hint tab-overflow-hint--left" aria-hidden="true"><text class="tab-overflow-hint__chev">‹</text></view>
      <view wx:if="{{tabShowRightIndicator}}" class="tab-overflow-hint tab-overflow-hint--right" aria-hidden="true"><text class="tab-overflow-hint__chev">›</text></view>
    </view>

    <!-- 围观行（讨论 TAB）：独立层，紧随 TAB 之后，二级吸顶 -->
    <view
      wx:if="{{activeTab === 'discussion'}}"
      class="ds-watchers-wrap ds-watchers-wrap--inflow {{themeClass === 'dark-mode' ? 'ds-watchers--dark' : 'ds-watchers--bright'}}"
    >
      <template is="discussionWatchersStrip" data="{{watchers: watchers}}" />
    </view>

    <!-- 报名扩展区（报名 TAB）：独立层，紧随 TAB 之后，二级吸顶 -->
    <view
      wx:if="{{activeTab === 'register'}}"
      class="register-ext-wrap register-ext-wrap--inflow"
    >
      <template is="registerExtensionStrip" data="{{registerTotalCount: registerTotalCount, registerSubTabs: registerSubTabs, activeRegisterSubTab: activeRegisterSubTab}}" />
    </view>

    <!-- Content -->
    <view class="detail-main {{activeTab === 'discussion' ? 'detail-main--flush' : ''}}">

      <!-- 赛事详情 -->
      <block wx:if="{{activeTab === 'details'}}">
        <block wx:for="{{eventInfoList}}" wx:key="id">
          <view wx:if="{{item.type === 'image'}}" class="ad-image">
            <image src="{{item.imageData}}" mode="widthFix" class="ad-image__img"></image>
          </view>
          <view wx:else class="ds-card pad-card">
            <view class="card-head"><text class="card-title">{{item.title}}</text></view>
            <text class="card-text">{{item.content}}</text>
          </view>
        </block>
        <view class="partners-section">
          <text class="partners-title">{{partnerConfig.partnerTitle}}</text>
          <view wx:if="{{partnerLogoRows.length}}" class="partners-grid partners-grid--logos">
            <view
              wx:for="{{partnerLogoRows}}"
              wx:key="index"
              class="partner-row {{item.single ? 'partner-row--single' : ''}}"
            >
              <view class="partner-cell partner-cell--logo">
                <view class="partner-item">
                  <image class="partner-item__img" src="{{item.left.url}}" mode="aspectFit" />
                </view>
              </view>
              <view wx:if="{{!item.single}}" class="partner-cell partner-cell--logo partner-cell--with-divider">
                <view class="partner-item">
                  <image class="partner-item__img" src="{{item.right.url}}" mode="aspectFit" />
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="partners-grid partners-grid--placeholder">
            <view class="partner-cell">🧒</view>
            <view class="partner-cell">🚗</view>
            <view class="partner-cell">Vivata 1872</view>
            <view class="partner-cell">⚛️</view>
          </view>
        </view>
      </block>

      <!-- 报名 -->
      <block wx:if="{{activeTab === 'register'}}">
        <view class="register-tab-panel">
          <view class="register-roster-card ds-card" style="{{rosterMinHeight ? 'min-height:' + rosterMinHeight + 'px;' : ''}}">
            <view class="roster-head">
              <view class="roster-col roster-col--idx"><text>序号</text></view>
              <text class="roster-col roster-col--player">球员</text>
              <view class="roster-col roster-col--handicap"><text>江湖差点</text></view>
            </view>
            <view class="roster-content">
              <view wx:if="{{registerDisplayUsers.length}}" class="roster-body">
                <view wx:for="{{registerDisplayUsers}}" wx:key="listKey" class="roster-row">
                  <view class="roster-col roster-col--idx"><text>{{index + 1}}</text></view>
                  <view class="roster-col roster-col--player">
                    <image class="roster-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                    <text class="roster-name">{{item.competitionName}}</text>
                    <text wx:if="{{item.gender === '男'}}" class="roster-gender">♂</text>
                    <text wx:elif="{{item.gender === '女'}}" class="roster-gender">♀</text>
                  </view>
                  <view class="roster-col roster-col--handicap"><text>{{item.handicap}}</text></view>
                </view>
              </view>
              <view wx:else class="register-user-empty" style="{{rosterMinHeight ? 'min-height:calc(' + rosterMinHeight + 'px - 88rpx);' : ''}}">
                <text class="register-user-empty__text">暂无报名人员</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 分组 TAB：管理态可添加空分组卡片（复用出发表 tee-group-card 结构） -->
      <block wx:if="{{activeTab === 'groups'}}">
        <view class="groups-tab-panel" style="{{groupsPanelMinHeight ? 'min-height:' + groupsPanelMinHeight + 'px;' : ''}}">
          <view class="groups-tab-header">
            <text class="groups-tab-header__title">分组</text>
          </view>
          <block wx:if="{{groupsTabCards.length > 0}}">
            <view wx:for="{{groupsTabCards}}" wx:key="groupId" class="tee-group-card" bindtap="onGroupCardTap" data-group-id="{{item.groupId}}" data-group-name="{{item.badge}}">
              <view wx:if="{{canManageGroups}}" catchtap="onDeleteGroupTap" data-group-id="{{item.groupId}}" data-group-name="{{item.badge}}" class="delete-group-btn">
                <text>×</text>
              </view>
              <view class="tee-group-meta">
                <text class="tee-group-badge">{{item.badge}}</text>
              </view>
              <view class="tee-player-grid">
                <view wx:for="{{item.players}}" wx:for-item="pl" wx:key="position" class="tee-player">
                  <view class="tee-avatar-wrap">
                    <image wx:if="{{pl.avatar}}" class="tee-avatar" src="{{pl.avatar}}" mode="aspectFill"></image>
                    <view wx:else class="tee-avatar tee-avatar-plus">+</view>
                  </view>
                  <text class="tee-player-name">{{pl.name}}</text>
                  <view class="tee-marker-line">
                    <view wx:if="{{pl.teeMarkerClass}}" class="tee-marker-dot {{pl.teeMarkerClass}}"></view>
                    <text class="tee-marker-letter">{{pl.teeLabel}}</text>
                  </view>
                </view>
              </view>
            </view>
            <view wx:if="{{canManageGroups}}" class="groups-tab-toolbar">
              <view class="add-group-btn" bindtap="onAddGroup">
                <view class="add-group-icon"><text>+</text></view>
                <text>添加分组</text>
              </view>
            </view>
          </block>
          <block wx:else>
            <view wx:if="{{canManageGroups}}" class="groups-tab-toolbar groups-tab-toolbar--first">
              <view class="add-group-btn" bindtap="onAddGroup">
                <view class="add-group-icon"><text>+</text></view>
                <text>添加分组</text>
              </view>
            </view>
            <view wx:else class="groups-panel-empty">
              <text class="groups-panel-empty__text">暂无分组信息</text>
            </view>
          </block>
        </view>
      </block>

      <!-- 领先榜 -->
      <block wx:if="{{activeTab === 'leaderboard'}}">
        <view class="leaderboard-table-wrap">
          <view class="leaderboard-head">
            <text class="lh-pos">POS</text>
            <text class="lh-player">PLAYER</text>
            <text class="lh-thru">THRU</text>
            <text class="lh-total">TOTAL</text>
          </view>

          <block wx:for="{{leaderboard}}" wx:key="playerId">
            <view bindtap="toggleScorecard" data-index="{{index}}" class="leaderboard-row">
              <text class="lr-pos pos-cell">{{item.pos}}</text>
              <view class="lr-player">
                <text class="player-name">{{item.name}}</text>
                <text class="gender-icon {{item.isFemale ? 'gender-f' : 'gender-m'}}">{{item.isFemale ? '♀' : '♂'}}</text>
              </view>
              <text class="lr-thru">{{item.thru}}</text>
              <text class="lr-total leaderboard-total {{item.scoreClass}}">{{item.scoreStr}}</text>
            </view>

            <!-- 展开成绩卡 -->
            <view wx:if="{{item.expanded}}" class="scorecard-row {{scorePanel === 'quick' ? 'score-panel-quick' : ''}}">
              <view class="scorecard-profile">
                <view class="sc-profile-left">
                  <view class="sc-avatar-wrap">
                    <image class="sc-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
                    <view class="sc-flag"><image src="https://flagcdn.com/w40/{{item.flag}}.png" mode="aspectFill"></image></view>
                  </view>
                  <view class="sc-profile-meta">
                    <view class="sc-name-line"><text class="sc-name">{{item.name}}</text><text class="sc-chevron">›</text></view>
                    <view class="sc-sub">COUNTRY: <text class="sc-sub-strong">{{item.country}}</text>　AGE: <text class="sc-sub-strong">{{item.age}}</text></view>
                  </view>
                </view>
                <view catchtap="noop" class="sc-follow-btn">加关注</view>
              </view>

              <view wx:if="{{openScorecard}}" class="scorecard-dark-panel ld-scorecard {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">
                <text class="sc-course course-name-title">{{courseName}}</text>

                <view class="tour-scorecard">
                  <view class="tsc-row tsc-head">
                    <text wx:for="{{openScorecard.frontHead}}" wx:for-item="h" wx:key="*this" class="tsc-cell">{{h}}</text>
                  </view>
                  <view class="tsc-row">
                    <text wx:for="{{openScorecard.frontPar}}" wx:for-item="c" wx:key="index" class="tsc-cell">{{c.t}}</text>
                  </view>
                  <view class="tsc-row">
                    <view wx:for="{{openScorecard.frontScore}}" wx:for-item="c" wx:key="index" class="tsc-cell ld-score-cell">
                      <view wx:if="{{c.m}}" class="ld-score-marker {{c.m}} {{c.c}}">
                        <text class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
                      </view>
                      <text wx:else class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
                    </view>
                  </view>
                </view>

                <view class="tour-scorecard">
                  <view class="tsc-row tsc-head">
                    <text wx:for="{{openScorecard.backHead}}" wx:for-item="h" wx:key="*this" class="tsc-cell">{{h}}</text>
                  </view>
                  <view class="tsc-row">
                    <text wx:for="{{openScorecard.backPar}}" wx:for-item="c" wx:key="index" class="tsc-cell">{{c.t}}</text>
                  </view>
                  <view class="tsc-row">
                    <view wx:for="{{openScorecard.backScore}}" wx:for-item="c" wx:key="index" class="tsc-cell ld-score-cell">
                      <view wx:if="{{c.m}}" class="ld-score-marker {{c.m}} {{c.c}}">
                        <text class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
                      </view>
                      <text wx:else class="ld-score-value {{scoreDisplayMode === 'diff' ? 'diff-mode' : ''}}">{{c.t}}</text>
                    </view>
                  </view>
                </view>

                <view class="score-legend-area">
                  <view class="legend-item"><view class="score-legend-dot dot-eagle"></view>EAGLE OR BETTER</view>
                  <view class="legend-item"><view class="score-legend-dot dot-birdie"></view>BIRDIE</view>
                  <view class="legend-item"><view class="score-legend-dot dot-bogey"></view>BOGEY</view>
                  <view class="legend-item"><view class="score-legend-dot dot-double"></view>DOUBLE BOGEY+</view>
                </view>
                <image class="sc-ad" src="https://images.unsplash.com/photo-1535131749006-b7f58c99034b?auto=format&fit=crop&w=900&q=85" mode="widthFix"></image>
              </view>
            </view>
          </block>
        </view>
      </block>

      <!-- 出发表：卡片点击进入任意组（保留）+ 底部固定按钮快捷进入自己组（共存） -->
      <!-- 列表容器预留底部安全间距，确保最后一组不被底部固定按钮遮挡 -->
      <view wx:if="{{activeTab === 'tee-sheet'}}" class="tee-sheet-list">
        <view wx:for="{{teeGroups}}" wx:key="id" bindtap="onEnterGroup" data-group-id="{{item.id}}" class="tee-group-card {{index === 0 ? 'js-first-tee-group' : ''}}">
          <view class="tee-group-meta">
            <text class="tee-group-badge">{{item.badge}}</text>
            <view class="tee-start-info"><text class="tee-clock">🕘</text>{{item.time}} 出发 <text class="tee-hole-pill">{{item.hole}}</text></view>
          </view>
          <view class="tee-player-grid">
            <view wx:for="{{item.players}}" wx:for-item="pl" wx:key="playerId" class="tee-player">
              <view class="tee-avatar-wrap">
                <image class="tee-avatar" src="{{pl.avatar}}" mode="aspectFill"></image>
                <view wx:if="{{pl.v}}" class="tee-v-badge">V</view>
              </view>
              <text class="tee-player-name">{{pl.name}}</text>
              <view class="tee-marker-line">
                <view class="tee-marker-dot {{pl.teeMarkerClass}}"></view>
                <text class="tee-marker-letter">T</text>
              </view>
            </view>
          </view>
          <text class="tee-status">{{item.statusBadge}}</text>
        </view>
      </view>

      <!-- 讨论区：仅切换内容区，保留顶部比赛信息与 TAB 结构 -->
      <block wx:if="{{activeTab === 'discussion'}}">
        <discussion
          class="discussion-inline"
          watchers="{{watchers}}"
          messages="{{chat}}"
          theme="{{themeClass === 'dark-mode' ? 'dark' : 'bright'}}"
          fixed-input="{{true}}"
          show-input-bar="{{scrollYState >= 100}}"
          show-watchers-strip="{{false}}"
          bottom-spacer-height="{{contentSpacerHeight}}"
        ></discussion>
      </block>

      <!-- 游戏 -->
      <block wx:if="{{activeTab === 'game'}}">
        <view class="game-tab-panel ds-card">
          <view class="pad-card game-tab-body">
            <text class="card-title">游戏</text>
            <text class="card-text card-text--mt">游戏内容将在下一步接入。当前页面已预留该 TAB 容器。</text>
          </view>
          <view
            wx:if="{{contentSpacerHeight > 0}}"
            class="game-tab-spacer"
            style="height:{{contentSpacerHeight}}px;"
          ></view>
        </view>
      </block>

    </view>
  </scroll-view>

  <!-- 吸顶 TAB：常驻节点（避免 remount），显示状态仅由 scroll-aware sticky state 控制 -->
  <view class="tab-scroll-wrap tab-scroll-wrap--fixed {{isStickyTab ? 'tab-scroll-wrap--show' : 'tab-scroll-wrap--hide'}}" style="top:{{headerTotalHeight}}px;">
    <scroll-view class="gb-tabs" scroll-x enable-flex scroll-left="{{tabHScrollLeft}}" bindscroll="onTabHScroll">
      <view wx:for="{{tabs}}" wx:key="id" bindtap="switchTab" data-tab="{{item.id}}" class="tab-btn {{activeTab === item.id ? 'active' : ''}}">{{item.label}}</view>
    </scroll-view>
    <view wx:if="{{tabShowLeftIndicator}}" class="tab-overflow-hint tab-overflow-hint--left" aria-hidden="true"><text class="tab-overflow-hint__chev">‹</text></view>
    <view wx:if="{{tabShowRightIndicator}}" class="tab-overflow-hint tab-overflow-hint--right" aria-hidden="true"><text class="tab-overflow-hint__chev">›</text></view>
  </view>

  <!-- 吸顶围观行：二级 sticky，紧贴 TAB 下方（z-index 低于 TAB） -->
  <view
    wx:if="{{activeTab === 'discussion'}}"
    class="ds-watchers-wrap ds-watchers-wrap--fixed {{isStickyWatchers ? 'ds-watchers-wrap--show' : 'ds-watchers-wrap--hide'}} {{themeClass === 'dark-mode' ? 'ds-watchers--dark' : 'ds-watchers--bright'}}"
    style="top:{{stickyWatchersTop}}px;"
  >
    <template is="discussionWatchersStrip" data="{{watchers: watchers}}" />
  </view>

  <!-- 吸顶报名扩展区：二级 sticky，紧贴 TAB 下方 -->
  <view
    wx:if="{{activeTab === 'register'}}"
    class="register-ext-wrap register-ext-wrap--fixed {{isStickyRegisterExt ? 'register-ext-wrap--show' : 'register-ext-wrap--hide'}}"
    style="top:{{stickyRegisterExtTop}}px;"
  >
    <template is="registerExtensionStrip" data="{{registerTotalCount: registerTotalCount, registerSubTabs: registerSubTabs, activeRegisterSubTab: activeRegisterSubTab}}" />
  </view>

  <!-- 出发表 TAB：透明悬浮快捷按钮（仅当"第一组卡片完全进入视口"时显示，固定底部，不参与布局流） -->
  <view
    wx:if="{{activeTab === 'tee-sheet' && quickEntryVisible}}"
    bindtap="onEnterGroup"
    data-group-id="g1"
    class="tee-quick-entry-float"
  >快速进入自己的小组 ›</view>

  <!-- MORE FAB（讨论区为聚焦聊天全屏层，隐藏 FAB，避免遮挡输入栏） -->
  <view
    wx:if="{{activeTab !== 'discussion'}}"
    catchtap="onMoreFabTap"
    bindtouchstart="onMoreFabTouchStart"
    bindtouchmove="onMoreFabTouchMove"
    bindtouchend="onMoreFabTouchEnd"
    bindtouchcancel="onMoreFabTouchEnd"
    class="leaderboard-fab {{moreFabExpanded ? 'leaderboard-fab--expanded' : ''}} {{moreFabDragging ? 'leaderboard-fab--dragging' : ''}} {{moreFabHitTarget ? 'leaderboard-fab--hit' : ''}}"
    style="{{fabStyle}}"
  >
    <text class="fab-label">{{moreFabExpanded ? 'MORE' : 'M'}}</text>
  </view>

  <!-- 更多功能 bottom sheet -->
  <view wx:if="{{showMoreSheet}}" bindtap="closeMoreSheet" class="sheet-overlay"></view>
  <view wx:if="{{showMoreSheet}}" class="bottom-sheet" catchtap="stopPropagation">
    <view class="sheet-handle"></view>
    <view class="feature-section">
      <view class="feature-section-title"><text class="fst-main">{{featuresSectionCommonMain}}</text><text wx:if="{{featuresSectionCommonSub}}" class="fst-sub">{{featuresSectionCommonSub}}</text></view>
      <view class="feature-grid">
        <view wx:for="{{featuresCommon}}" wx:key="permission" bindtap="onFeatureTap" data-permission="{{item.permission}}" class="feature-item">
          <view class="feature-icon"><text>{{item.glyph}}</text></view>
          <text class="feature-label">{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="feature-section">
      <view class="feature-section-title"><text class="fst-main">{{featuresSectionPermissionMain}}</text><text wx:if="{{featuresSectionPermissionSub}}" class="fst-sub">{{featuresSectionPermissionSub}}</text></view>
      <view class="feature-grid">
        <view wx:for="{{featuresPermission}}" wx:key="permission" bindtap="onFeatureTap" data-permission="{{item.permission}}" class="feature-item">
          <view class="feature-icon {{item.tone}}"><text>{{item.glyph}}</text></view>
          <text class="feature-label">{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="sheet-cancel-wrap">
      <view bindtap="closeMoreSheet" class="sheet-cancel-btn">取 消</view>
    </view>
  </view>

  <!-- 替他人报名：来源三选一 bottom sheet（对齐创建普通球局「添加人员」弹窗） -->
  <view wx:if="{{registerForOtherSheetVisible}}" bindtap="closeRegisterForOtherSheet" class="sheet-overlay"></view>
  <view wx:if="{{registerForOtherSheetVisible}}" class="bottom-sheet register-for-other-sheet" catchtap="stopPropagation">
    <view class="sheet-handle"></view>
    <view class="sheet-header">
      <view>
        <text class="sheet-overline">ADD PLAYER</text>
        <text class="sheet-header__h3">选择添加方式</text>
      </view>
      <view class="sheet-close" bindtap="closeRegisterForOtherSheet"><text>×</text></view>
    </view>
    <view class="game-mode-list">
      <view
        wx:for="{{registerForOtherSourceOptions}}"
        wx:key="source"
        bindtap="onRegisterForOtherSourceTap"
        data-source="{{item.source}}"
        class="game-mode-option {{item.disabled ? 'game-mode-option--disabled' : ''}}"
      >
        <view class="mode-icon {{item.locked ? 'mode-icon--locked' : ''}}">
          <text wx:if="{{!item.locked}}">{{item.glyph}}</text>
          <text wx:else>🔒</text>
        </view>
        <view class="mode-text">
          <text class="mode-text__strong">{{item.label}}</text>
          <text class="mode-text__em ds-desc-text">{{item.desc}}</text>
        </view>
        <text class="mode-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 风格选择 sheet -->
  <view wx:if="{{showStyleSheet}}" bindtap="closeStyleSheet" class="sheet-overlay"></view>
  <view class="style-sheet {{showStyleSheet ? 'active' : ''}}" catchtap="stopPropagation">
    <view class="style-sheet__head">
      <view>
        <text class="style-sheet__title">风格选择</text>
        <text class="style-sheet__sub">这些设置会影响所有记分相关页面。</text>
      </view>
      <view bindtap="closeStyleSheet" class="style-sheet__close">✕</view>
    </view>
    <view class="style-section">
      <text class="style-section-title">记分显示</text>
      <view class="style-option-row">
        <view bindtap="setScoringDisplay" data-value="gross" class="style-option {{scoringDisplay === 'gross' ? 'active' : ''}}">总杆记分</view>
        <view bindtap="setScoringDisplay" data-value="strokeDiff" class="style-option {{scoringDisplay === 'strokeDiff' ? 'active' : ''}}">杆差记分</view>
      </view>
    </view>
    <view class="style-section">
      <text class="style-section-title">记分面板</text>
      <view class="style-option-row">
        <view bindtap="setScorePanel" data-value="technical" class="style-option {{scorePanel === 'technical' ? 'active' : ''}}">技术面板</view>
        <view bindtap="setScorePanel" data-value="quick" class="style-option {{scorePanel === 'quick' ? 'active' : ''}}">快捷面板</view>
      </view>
    </view>
    <view class="style-done-wrap">
      <view bindtap="closeStyleSheet" class="style-done-btn">完成</view>
    </view>
  </view>

  <!-- 围观弹层 -->
  <view wx:if="{{showWatchers}}" bindtap="closeWatchers" class="watchers-modal show">
    <view catchtap="stopPropagation" class="watchers-sheet">
      <view class="watchers-sheet-header">
        <view>
          <text class="watchers-sheet-title">全部围观用户</text>
          <text class="watchers-sheet-subtitle">点击 @ 可提及用户</text>
        </view>
        <view bindtap="closeWatchers" class="watchers-close-btn">✕</view>
      </view>
      <scroll-view scroll-y class="watchers-list">
        <view wx:for="{{allWatchers}}" wx:key="name" class="watcher-item">
          <image src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="watcher-col">
            <text class="watcher-name">{{item.name}}</text>
            <text class="watcher-hint">围观用户</text>
          </view>
          <text class="watcher-at">@</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 报名/取消报名固定按钮：报名 TAB + 报名中赛事 -->
  <view
    wx:if="{{activeTab === 'register' && matchStatus.isRegistering && !hideRegisterCTA}}"
    class="register-cta-bar"
  >
    <view
      wx:if="{{!registerPermission.isOpen}}"
      class="register-cta-btn register-cta-btn--disabled"
    >报名已关闭</view>
    <view
      wx:elif="{{currentUserRegisterStatus.isRegistered}}"
      bindtap="openCancelRegisterModal"
      class="register-cta-btn register-cta-btn--cancel"
    >取消报名</view>
    <view
      wx:else
      bindtap="openRegisterSheet"
      class="register-cta-btn"
    >立即报名</view>
  </view>

  <!-- 报名弹窗：分组选择 + 比赛名 + 手机号 + 确认报名 -->
  <view wx:if="{{registerSheetVisible}}" bindtap="closeRegisterSheet" class="sheet-overlay"></view>
  <view wx:if="{{registerSheetVisible}}" class="bottom-sheet register-sheet" catchtap="stopPropagation">
    <view class="sheet-handle"></view>
    <view class="register-sheet__head">
      <text class="register-sheet__title">赛事报名</text>
      <text class="register-sheet__sub">比赛名将用于报名列表、出发表与成绩榜</text>
    </view>

    <view class="register-sheet__field">
      <text class="register-sheet__label">报名分组</text>
      <view class="register-sheet__groups">
        <view
          wx:for="{{registerSubTabs}}"
          wx:key="id"
          bindtap="selectRegisterSheetGroup"
          data-id="{{item.id}}"
          class="register-sheet__group {{registerSheetGroupId === item.id ? 'register-sheet__group--active' : ''}}"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="register-sheet__field">
      <text class="register-sheet__label">比赛名</text>
      <input
        class="register-sheet__input"
        type="text"
        value="{{registerCompetitionNameDraft}}"
        bindinput="onRegisterCompetitionNameInput"
        placeholder="请输入比赛名"
        placeholder-class="register-sheet__placeholder"
        maxlength="32"
      />
      <text class="register-sheet__hint">优先使用资料中的比赛名；未设置时默认取昵称</text>
    </view>

    <view class="register-sheet__field">
      <text class="register-sheet__label">性别</text>
      <view class="register-sheet__groups register-sheet__groups--readonly">
        <view class="register-sheet__group {{registerGenderDraft === '男' ? 'register-sheet__group--active' : ''}}">男</view>
        <view class="register-sheet__group {{registerGenderDraft === '女' ? 'register-sheet__group--active' : ''}}">女</view>
      </view>
      <text class="register-sheet__hint">性别来自个人资料，报名弹窗不可修改</text>
    </view>

    <view class="register-sheet__field">
      <text class="register-sheet__label">手机号</text>
      <view class="register-sheet__readonly">{{registerPhone || '未绑定手机号'}}</view>
    </view>

    <view class="register-sheet__actions">
      <view bindtap="closeRegisterSheet" class="register-sheet__cancel">取 消</view>
      <view bindtap="confirmRegister" class="register-sheet__confirm {{registerSubmitting ? 'is-disabled' : ''}}">确认报名</view>
    </view>
  </view>

  <!-- 取消报名确认弹窗 -->
  <view wx:if="{{registerCancelModalVisible}}" bindtap="closeCancelRegisterModal" class="register-cancel-modal">
    <view catchtap="stopPropagation" class="register-cancel-dialog">
      <text class="register-cancel-dialog__title">确认取消报名？</text>
      <text class="register-cancel-dialog__desc">取消后，你将从本场赛事报名名单中移除。</text>
      <view class="register-cancel-dialog__actions">
        <view bindtap="closeCancelRegisterModal" class="register-cancel-dialog__btn">取消</view>
        <view
          bindtap="confirmCancelRegister"
          class="register-cancel-dialog__btn register-cancel-dialog__btn--danger {{registerCancelSubmitting ? 'is-disabled' : ''}}"
        >确认取消</view>
      </view>
    </view>
  </view>

  <!-- 删除分组确认弹窗（页面态，不写 teamMatchStore） -->
  <view wx:if="{{groupDeleteModalVisible}}" bindtap="closeGroupDeleteModal" class="register-cancel-modal">
    <view catchtap="stopPropagation" class="register-cancel-dialog">
      <text class="register-cancel-dialog__title">确认删除{{groupDeleteTargetName}}？</text>
      <text class="register-cancel-dialog__desc">删除后该组球员配置将被移除。</text>
      <view class="register-cancel-dialog__actions">
        <view bindtap="closeGroupDeleteModal" class="register-cancel-dialog__btn">取消</view>
        <view bindtap="confirmDeleteGroup" class="register-cancel-dialog__btn register-cancel-dialog__btn--danger">确认删除</view>
      </view>
    </view>
  </view>

  <half-course-sheet
    visible="{{halfSheetVisible}}"
    source="tournament"
    mode="individual_stroke"
    bind:close="closeHalfSheet"
    bind:confirm="onHalfCourseConfirmed"
  />
</view>
