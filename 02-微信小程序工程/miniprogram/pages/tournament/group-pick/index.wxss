/* ===== 主题 Token（对齐赛事详情页） ===== */
.group-pick-page.dark-mode {
  --bg-primary: #000000;
  --bg-card: #111111;
  --bg-subtle: #0a0a0a;
  --bg-hover: #1a1a1a;
  --border: #222222;
  --border-hover: #333333;
  --text-primary: #f1f5f9;
  --text-secondary: #e5e7f9;
  --text-muted: #888888;
}

.group-pick-page.bright-mode {
  --bg-primary: #fcfcfc;
  --bg-card: #ffffff;
  --bg-subtle: #f3f4f6;
  --bg-hover: #f9fafb;
  --border: #e5e7eb;
  --border-hover: #d1d5db;
  --text-primary: #002d62;
  --text-secondary: #374151;
  --text-muted: #6b7280;
}

page {
  height: 100%;
  background: #fcfcfc;
}

.group-pick-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary, #fcfcfc);
  color: var(--text-primary, #002d62);
}

.gb-header {
  background: #002d62;
  border-bottom: 2px solid #c8a24a;
  color: #fff;
  flex-shrink: 0;
}
.gb-header__inner { display: flex; align-items: center; justify-content: space-between; }
.gb-header__left { display: flex; align-items: center; gap: 20rpx; }
.gb-header__back { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.gb-header__chevron { color: #fff; font-size: 52rpx; line-height: 1; }
.gb-header__eyebrow { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 0.24em; color: rgba(255, 255, 255, 0.5); line-height: 1; margin-bottom: 6rpx; }
.gb-header__title { display: block; color: #fff; font-size: 32rpx; font-weight: 900; font-style: italic; line-height: 1; }

.slots-fixed {
  flex-shrink: 0;
  background: var(--bg-card, #ffffff);
  border-bottom: 1px solid var(--border, #e5e7eb);
  padding: 24rpx 32rpx 20rpx;
}
.group-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary, #002d62);
  margin-bottom: 16rpx;
}

/* 球员项已统一为全局 .gb-group-player*（app.wxss） */
.slot-item {
  border: 1px solid transparent;
  border-radius: 12rpx;
}

.pick-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: 24rpx;
  background: var(--bg-primary, #fcfcfc);
}
.pick-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary, #002d62);
  padding: 24rpx 32rpx 12rpx;
}

.register-subtabs-wrap {
  border-bottom: 1px solid var(--border, #e5e7eb);
  background: var(--bg-primary, #fcfcfc);
}
.register-subtabs {
  height: 80rpx;
  white-space: nowrap;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.register-subtabs::-webkit-scrollbar { display: none; }
.register-subtab {
  position: relative;
  display: inline-flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: transparent;
  color: var(--text-muted, #6b7280);
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}
.register-subtab__label {
  line-height: 1;
  white-space: nowrap;
}
.register-subtab--active {
  color: var(--text-primary, #002d62);
  font-weight: 700;
}
.register-subtab--active::after {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 6rpx;
  background: #002d62;
  border-radius: 3rpx 3rpx 0 0;
}

.roster-body {
  display: block;
  padding: 0 32rpx 32rpx;
}
.roster-row {
  display: grid;
  grid-template-columns: 48rpx 1fr 120rpx;
  column-gap: 16rpx;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--border, #e5e7eb);
}
.roster-row--selected {
  background: rgba(0, 45, 98, 0.05);
}
.roster-row--disabled {
  opacity: 0.42;
}
.roster-row:last-child { border-bottom: none; }
.roster-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #9ca3af;
  background: var(--bg-card, #ffffff);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.roster-checkbox--checked {
  border-color: #002d62;
  background: #002d62;
}
.roster-checkbox--occupied {
  border-color: #9ca3af;
  background: #9ca3af;
}
.roster-checkbox__mark {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
}
.roster-col--player {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  min-width: 0;
}
.roster-player-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.roster-player-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.roster-col--handicap {
  display: flex;
  justify-content: center;
  align-items: center;
  color: #c8a24a;
  font-size: 28rpx;
  font-weight: 800;
}
.roster-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--bg-subtle, #f3f4f6);
}
.roster-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary, #002d62);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.roster-gender {
  flex-shrink: 0;
  font-size: 24rpx;
}
.roster-occupied-tip {
  font-size: 22rpx;
  color: var(--text-muted, #6b7280);
  line-height: 1.2;
}

.pick-empty {
  padding: 48rpx 32rpx;
  color: var(--text-muted, #6b7280);
  font-size: 26rpx;
  text-align: center;
}

/* 底部固定 CTA：对齐赛事详情报名按钮规范 */
.group-pick-cta-bar {
  flex-shrink: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card, #ffffff);
  border-top: 2rpx solid rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}
.group-pick-cta-btn {
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  background: #c8a24a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 0.08em;
}
.group-pick-cta-btn:active {
  opacity: 0.9;
}

/* ===== DARK：选中态 / 指示线 / 复选框 / 主按钮保持可辨识 ===== */
.group-pick-page.dark-mode .roster-row--selected {
  background: rgba(0, 174, 239, 0.12);
}

.group-pick-page.dark-mode .register-subtab--active {
  color: #f1f5f9;
}

.group-pick-page.dark-mode .register-subtab--active::after {
  background: #00aeef;
}

.group-pick-page.dark-mode .roster-checkbox--checked {
  border-color: #00aeef;
  background: #00aeef;
}

.group-pick-page.dark-mode .group-pick-cta-bar {
  border-top-color: rgba(255, 255, 255, 0.08);
}
